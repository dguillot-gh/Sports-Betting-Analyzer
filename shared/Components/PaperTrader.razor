@page "/mobile-paper-trading"
@using System.Text.Json
@using System.Net.Http.Json
@using SportsBettingAnalyzer.Shared.Services
@inject IServerConfigService ConfigService
@inject HttpClient Http

<div class="page custom-scrollbar">
    <div class="top-row px-4">
        <span>Paper Trading</span>
    </div>

    <div class="content px-4">
        <div class="home-hero">
            <h1>Paper Trading Deck</h1>
            <p>Mock trades and CLV tracking</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="app-alert app-alert-error mb-3">
                @errorMessage
            </div>
        }

        <!-- Stats Overview -->
        <div class="app-card mb-4 mt-3">
            <div class="app-card-body">
                <div class="row text-center mb-3">
                    <div class="col-6">
                        <div class="result-label">Net Profit</div>
                        <div class="result-winner-name @(_netProfit >= 0 ? "text-success" : "text-danger")" style="font-size: 24px;">
                            @(_netProfit >= 0 ? "+" : "")$@_netProfit.ToString("F2")
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="result-label">ROI</div>
                        <div class="result-winner-name @(_roi >= 0 ? "text-success" : "text-danger")" style="font-size: 24px;">
                            @($"{(_roi >= 0 ? "+" : "")}{_roi:F1}%")
                        </div>
                    </div>
                </div>
                <div class="row text-center">
                    <div class="col-6">
                        <div class="result-label">Win Rate</div>
                        <div class="result-winner-name" style="font-size: 20px; color: var(--text-primary);">
                            @($"{_winRate:F1}%")
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="result-label">Total Mock Bets</div>
                        <div class="result-winner-name" style="font-size: 20px; color: var(--text-primary);">
                            @_totalBets.ToString()
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Mock Entry -->
        <div class="app-card mb-4">
             <div class="app-card-header" style="padding: 12px; background: var(--surface-overlay);">
                <h3 style="margin: 0; font-size: 16px;">Quick Mock Entry</h3>
            </div>
            <div class="app-card-body">
                <div class="mb-3">
                    <label class="app-label">Description</label>
                    <input class="app-input" type="text" @bind="_entryDesc" placeholder="Ex: Lakers ML" />
                </div>
                
                <div class="row mb-3">
                    <div class="col-6">
                        <label class="app-label">Odds</label>
                        <input class="app-input" type="number" @bind="_entryOdds" />
                    </div>
                    <div class="col-6">
                        <label class="app-label">Stake ($)</label>
                        <input class="app-input" type="number" @bind="_entryStake" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="app-label">Sport</label>
                    <select class="app-select" @bind="_entrySport">
                        <option value="nba">NBA</option>
                        <option value="nfl">NFL</option>
                        <option value="nhl">NHL</option>
                        <option value="ncaaf">NCAAF</option>
                        <option value="ncaab">NCAAB</option>
                        <option value="nascar">NASCAR</option>
                    </select>
                </div>

                <button class="app-btn app-btn-primary" @onclick="PlaceMockBet" disabled="@(string.IsNullOrWhiteSpace(_entryDesc) || _entryStake <= 0)">
                    Place Mock Trade
                </button>
            </div>
        </div>

        <!-- History -->
        <div class="app-card mb-4" style="background: transparent; border: none; box-shadow: none;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 style="font-size: 18px; margin: 0; color: var(--text-primary);">History</h2>
                <button class="btn btn-sm btn-outline-secondary" @onclick="LoadData" style="font-size: 12px; border-color: var(--border);">
                    Refresh
                </button>
            </div>

            @if (_loading)
            {
                <div style="text-align: center; padding: 30px;">
                    <div class="spinner"></div>
                    <p style="margin-top: 10px; opacity: 0.7;">Loading mock bets...</p>
                </div>
            }
            else if (_bets.Any())
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var b in _bets)
                    {
                        <div class="app-card">
                            <div class="app-card-body" style="padding: 16px;">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <div style="font-weight: 600; font-size: 15px;">@b.Description</div>
                                        <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">
                                            @b.Sport.ToUpper() @(string.IsNullOrEmpty(b.GameName) ? "" : "• " + b.GameName)
                                        </div>
                                    </div>
                                    <div style="text-align: right;">
                                        <div style="font-weight: 700; font-size: 15px; color: var(--text-primary);">
                                            $@b.Stake.ToString("0") <span style="font-weight: normal; font-size: 12px; color: var(--text-muted);">@@</span> @FormatOdds(b.Odds)
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="d-flex justify-content-between align-items-end mt-3 border-top pt-2" style="border-color: var(--border) !important;">
                                    <div>
                                        @if (b.Outcome == "pending")
                                        {
                                            <span class="badge" style="background: var(--surface-overlay); color: var(--text-secondary); font-weight: 600;">Pending</span>
                                        }
                                        else
                                        {
                                             <span class="badge @(b.Outcome == "win" ? "bg-success" : "bg-danger")" style="font-weight: 600;">@b.Outcome.ToUpper()</span>
                                        }

                                        @if (b.ClvPercent.HasValue)
                                        {
                                            <span style="font-size: 11px; margin-left: 8px; color: var(--text-secondary);">
                                                CLV: <span class="@(b.ClvPercent >= 0 ? "text-primary" : "text-warning")">@(b.ClvPercent >= 0 ? "+" : "")@b.ClvPercent.Value.ToString("F1")%</span>
                                            </span>
                                        }
                                    </div>
                                    
                                     <div style="font-weight: 800; font-size: 16px;" class="@(b.Profit >= 0 ? "text-success" : "text-danger")">
                                        @if (b.Outcome != "pending")
                                        {
                                            @((b.Profit >= 0 ? "+" : "") + "$" + b.Profit.Value.ToString("F2"))
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-muted); font-weight: normal;">--</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="app-card">
                    <div class="app-card-body" style="text-align: center; padding: 40px 20px;">
                        <span style="display: block; font-size: 32px; margin-bottom: 10px; opacity: 0.5;">📋</span>
                        <p style="margin: 0; color: var(--text-muted);">No mock trades recorded yet.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool _loading = true;
    private string errorMessage = "";
    private List<PaperBet> _bets = new();
    
    // Quick entry state
    private string _entryDesc = "";
    private int _entryOdds = -110;
    private decimal _entryStake = 10;
    private string _entrySport = "nba";
    
    // Stats
    private decimal _netProfit = 0;
    private decimal _roi = 0;
    private decimal _avgClv = 0;
    private decimal _winRate = 0;
    private int _totalBets = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        errorMessage = "";
        StateHasChanged();

        await LoadMockBets();
        await LoadStats();
        
        _loading = false;
        StateHasChanged();
    }

    private async Task LoadMockBets()
    {
        try
        {
            var baseUrl = ConfigService.GetBaseUrl();
            if (string.IsNullOrEmpty(baseUrl)) return;
            
            var content = await Http.GetStringAsync($"{baseUrl}/bets?is_mock=true&limit=50");
            using var doc = JsonDocument.Parse(content);
            if (doc.RootElement.TryGetProperty("bets", out var arr))
            {
                _bets.Clear();
                foreach (var b in arr.EnumerateArray())
                {
                    _bets.Add(new PaperBet
                    {
                        Id = b.GetProperty("id").GetInt32(),
                        CreatedAt = b.GetProperty("created_at").GetString() ?? "",
                        Description = b.GetProperty("description").GetString() ?? "",
                        Stake = b.GetProperty("stake").GetDecimal(),
                        Odds = b.GetProperty("odds").GetInt32(),
                        Outcome = b.GetProperty("outcome").GetString() ?? "pending",
                        GameName = b.TryGetProperty("game_name", out var gn) && gn.ValueKind == JsonValueKind.String ? gn.GetString() : null,
                        Sport = b.GetProperty("sport").GetString() ?? "unknown",
                        Profit = b.TryGetProperty("profit", out var p) && p.ValueKind == JsonValueKind.Number ? p.GetDecimal() : null,
                        ClvPercent = b.TryGetProperty("clv_percent", out var clv) && clv.ValueKind == JsonValueKind.Number ? (double)clv.GetDecimal() : null
                    });
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load mock trades.";
            Console.WriteLine($"Error loading mock bets: {ex.Message}");
        }
    }

    private async Task LoadStats()
    {
        try
        {
            var baseUrl = ConfigService.GetBaseUrl();
            if (string.IsNullOrEmpty(baseUrl)) return;

            var content = await Http.GetStringAsync($"{baseUrl}/bets/stats/summary?is_mock=true");
            using var doc = JsonDocument.Parse(content);
            var root = doc.RootElement;
            
            _totalBets = root.TryGetProperty("total_bets", out var total) ? total.GetInt32() : 0;
            var wins = root.TryGetProperty("wins", out var w) ? w.GetInt32() : 0;
            var losses = root.TryGetProperty("losses", out var l) ? l.GetInt32() : 0;
            _netProfit = root.TryGetProperty("net_profit", out var p) && p.ValueKind == JsonValueKind.Number ? p.GetDecimal() : 0;
            
            var totalDecided = wins + losses;
            _winRate = totalDecided > 0 ? (wins * 100m / totalDecided) : 0;
            
            var totalStake = root.TryGetProperty("total_stake", out var ts) && ts.ValueKind == JsonValueKind.Number ? ts.GetDecimal() : 0;
            _roi = totalStake > 0 ? (_netProfit * 100m / totalStake) : 0;

            // Average CLV calculation from loaded bets
            var clvBets = _bets.Where(b => b.ClvPercent.HasValue).ToList();
            _avgClv = clvBets.Any() ? (decimal)clvBets.Average(b => b.ClvPercent.Value) : 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stats: {ex.Message}");
        }
    }

    private async Task PlaceMockBet()
    {
        errorMessage = "";
        
        try
        {
            var baseUrl = ConfigService.GetBaseUrl();
            if (string.IsNullOrEmpty(baseUrl)) return;

            var req = new
            {
                sport = _entrySport,
                bet_type = "single",
                sportsbook = "paper",
                stake = _entryStake,
                odds = _entryOdds,
                description = _entryDesc,
                is_mock = true,
                source = "manual"
            };
            
            var resp = await Http.PostAsJsonAsync($"{baseUrl}/bets", req);
            if (resp.IsSuccessStatusCode)
            {
                _entryDesc = "";
                await LoadData();
            }
            else
            {
                errorMessage = "Failed to place mock trade.";
            }
        }
        catch (Exception ex)
        {
             errorMessage = "Failed to communicate with server.";
             Console.WriteLine(ex.Message);
        }
    }

    private string FormatOdds(int odds) => odds > 0 ? $"+{odds}" : odds.ToString();

    public class PaperBet
    {
        public int Id { get; set; }
        public string CreatedAt { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Stake { get; set; }
        public int Odds { get; set; }
        public string Outcome { get; set; } = "pending";
        public string? GameName { get; set; }
        public string Sport { get; set; } = "";
        public decimal? Profit { get; set; }
        public double? ClvPercent { get; set; }
    }
}
