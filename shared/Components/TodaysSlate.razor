        to { transform: rotate(360deg); }
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.6; }
    }
</style>

@code {
    private bool _loading = false;
    private string? _error = null;
    private bool _hasAnyData = false;
    private DateTime? _lastUpdated = null;
    private bool _autoRefreshEnabled = true;
    private System.Threading.Timer? _refreshTimer;

    private Dictionary<string, List<SlateGame>> _gamesBySport = new();

    private List<SportConfig> _sports = new()
    {
        new("nfl", "NFL", "🏈"),
        new("nba", "NBA", "🏀"),
        new("nhl", "NHL", "🏒"),
        new("ncaab", "NCAAB", "🏀"),
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAllGames();
        StartAutoRefresh();
    }

    private void StartAutoRefresh()
    {
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            if (_autoRefreshEnabled && !_loading)
            {
                await InvokeAsync(async () =>
                {
                    await LoadAllGames();
                });
            }
        }, null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
    }

    private void ToggleAutoRefresh()
    {
        _autoRefreshEnabled = !_autoRefreshEnabled;
    }

    private async Task LoadAllGames()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var baseUrl = ServerConfig.GetBaseUrl();
            var tasks = new Dictionary<string, Task<List<SlateGame>>>
            {
                ["nfl"] = FetchEspnGames(baseUrl, "nfl"),
                ["nba"] = FetchEspnGames(baseUrl, "nba"),
                ["nhl"] = FetchEspnGames(baseUrl, "nhl"),
                ["ncaab"] = FetchEspnGames(baseUrl, "ncaab"),
            };

            await Task.WhenAll(tasks.Values);

            _gamesBySport.Clear();
            foreach (var kvp in tasks)
            {
                try
                {
                    _gamesBySport[kvp.Key] = await kvp.Value;
                }
                catch
                {
                    _gamesBySport[kvp.Key] = new List<SlateGame>();
                }
            }

            _hasAnyData = _gamesBySport.Values.Any(g => g.Count > 0);
            _lastUpdated = DateTime.Now;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load games: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task<List<SlateGame>> FetchEspnGames(string baseUrl, string sport)
    {
        var games = new List<SlateGame>();
        try
        {
            var json = await Http.GetStringAsync($"{baseUrl}/espn/{sport}");
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            if (root.TryGetProperty("games", out var gamesArr))
            {
                foreach (var g in gamesArr.EnumerateArray())
                {
                    // Parse spread - ESPN returns as string like "PHI -3.5" or numeric
                    double? spread = null;
                    if (g.TryGetProperty("spread", out var spEl))
                    {
                        if (spEl.ValueKind == JsonValueKind.Number)
                            spread = spEl.GetDouble();
                        else if (spEl.ValueKind == JsonValueKind.String)
                        {
                            var spStr = spEl.GetString() ?? "";
                            // Extract numeric portion from "TEAM -3.5" format
                            var parts = spStr.Split(' ');
                            if (parts.Length >= 2 && double.TryParse(parts[^1], out var spVal))
                                spread = spVal;
                        }
                    }

                    // Parse over/under
                    double? overUnder = null;
                    if (g.TryGetProperty("over_under", out var ouEl) && ouEl.ValueKind == JsonValueKind.Number)
                        overUnder = ouEl.GetDouble();

                    games.Add(new SlateGame
                    {
                        Sport = sport,
                        HomeTeam = g.GetProperty("home_team").GetString() ?? "",
                        HomeAbbrev = g.GetProperty("home_abbrev").GetString() ?? "",
                        HomeScore = g.TryGetProperty("home_score", out var hs) ? hs.GetString() ?? "0" : "0",
                        HomeRecord = g.TryGetProperty("home_record", out var hr) ? hr.GetString() ?? "" : "",
                        AwayTeam = g.GetProperty("away_team").GetString() ?? "",
                        AwayAbbrev = g.GetProperty("away_abbrev").GetString() ?? "",
                        AwayScore = g.TryGetProperty("away_score", out var aws) ? aws.GetString() ?? "0" : "0",
                        AwayRecord = g.TryGetProperty("away_record", out var ar) ? ar.GetString() ?? "" : "",
                        Status = g.TryGetProperty("status", out var st) ? st.GetString() ?? "Scheduled" : "Scheduled",
                        GameTime = g.TryGetProperty("game_time", out var gt) ? gt.GetString() ?? "" : "",
                        Spread = spread,
                        OverUnder = overUnder,
                    });
                }
            }
        }
        catch { }
        return games;
    }

    private List<SlateGame> GetGamesForSport(string sport) =>
        _gamesBySport.TryGetValue(sport, out var g) ? g : new();

    private string GetStatusClass(string status)
    {
        if (IsLive(status)) return "live";
        if (IsFinal(status)) return "final";
        return "";
    }

    private string GetStatusBadgeClass(string status)
    {
        if (IsLive(status)) return "live";
        if (IsFinal(status)) return "final";
        return "scheduled";
    }

    private bool IsLive(string status) =>
        status.Contains("In Progress", StringComparison.OrdinalIgnoreCase) ||
        status.Contains("Halftime", StringComparison.OrdinalIgnoreCase) ||
        status.Contains("End of", StringComparison.OrdinalIgnoreCase) ||
        (status.Contains("Quarter", StringComparison.OrdinalIgnoreCase) && !status.Contains("Final")) ||
        (status.Contains("Period", StringComparison.OrdinalIgnoreCase) && !status.Contains("Final")) ||
        (status.Contains("Half", StringComparison.OrdinalIgnoreCase) && !status.Contains("Final"));

    private bool IsFinal(string status) =>
        status.Contains("Final", StringComparison.OrdinalIgnoreCase) ||
        status.Contains("Postponed", StringComparison.OrdinalIgnoreCase);

    private bool IsLiveOrFinal(string status) => IsLive(status) || IsFinal(status);

    private string FormatStatus(string status)
    {
        if (IsLive(status)) return "LIVE";
        if (IsFinal(status)) return status.Length > 12 ? "FINAL" : status.ToUpper();
        return "UPCOMING";
    }

    private string FormatTime(string isoTime)
    {
        if (string.IsNullOrEmpty(isoTime)) return "";
        try
        {
            if (DateTime.TryParse(isoTime, out var dt))
            {
                var local = dt.Kind == DateTimeKind.Utc ? dt.ToLocalTime() : dt;
                return local.ToString("h:mm tt");
            }
        }
        catch { }
        return isoTime;
    }

    private string FormatSpread(double spread) =>
        spread > 0 ? $"+{spread:F1}" : $"{spread:F1}";

    private record SportConfig(string Key, string Label, string Icon);

    private class SlateGame
    {
        public string Sport { get; set; } = "";
        public string HomeTeam { get; set; } = "";
        public string HomeAbbrev { get; set; } = "";
        public string HomeScore { get; set; } = "0";
        public string HomeRecord { get; set; } = "";
        public string AwayTeam { get; set; } = "";
        public string AwayAbbrev { get; set; } = "";
        public string AwayScore { get; set; } = "0";
        public string AwayRecord { get; set; } = "";
        public string Status { get; set; } = "Scheduled";
        public string GameTime { get; set; } = "";
        public double? Spread { get; set; }
        public double? OverUnder { get; set; }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
