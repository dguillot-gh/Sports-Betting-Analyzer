@page "/mobile-todays-slate"
@using System.Text.Json
@using System.Net.Http.Json
@implements IDisposable
@inject HttpClient Http
@inject SportsBettingAnalyzer.Shared.Services.IServerConfigService ServerConfig

<div class="slate-container">
    <div class="slate-header">
        <h1>Today's Slate</h1>
        <p class="slate-date">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</p>
        <div class="slate-meta">
            @if (_lastUpdated.HasValue)
            {
                <span class="slate-updated">Updated @_lastUpdated.Value.ToString("h:mm:ss tt")</span>
            }
            <span class="slate-auto-badge">Auto-refresh @(_autoRefreshEnabled ? "ON" : "OFF")</span>
        </div>
        <div class="slate-actions">
            <button class="slate-refresh-btn" @onclick="LoadAllGames" disabled="@_loading">
                @if (_loading)
                {
                    <span class="slate-spinner"></span>
                }
                else
                {
                    <span>Refresh</span>
                }
            </button>
            <button class="slate-toggle-btn @(_autoRefreshEnabled ? "active" : "")" @onclick="ToggleAutoRefresh">
                @(_autoRefreshEnabled ? "Pause" : "Auto")
            </button>
        </div>
    </div>

    @if (_loading && !_hasAnyData)
    {
        <div class="slate-loading">
            <div class="slate-spinner-lg"></div>
            <p>Loading today's games...</p>
        </div>
    }
    else if (_error != null && !_hasAnyData)
    {
        <div class="slate-error">
            <p>@_error</p>
            <button class="slate-refresh-btn" @onclick="LoadAllGames">Try Again</button>
        </div>
    }
    else
    {
        @foreach (var sport in _sports)
        {
            var games = GetGamesForSport(sport.Key);
            <div class="slate-sport-section">
                <div class="slate-sport-header">
                    <span class="slate-sport-icon">@sport.Icon</span>
                    <span class="slate-sport-name">@sport.Label</span>
                    <span class="slate-game-count">@games.Count game@(games.Count != 1 ? "s" : "")</span>
                </div>

                @if (games.Count == 0)
                {
                    <div class="slate-no-games">
                        <span>No games scheduled today</span>
                    </div>
                }
                else
                {
                    <div class="slate-games-list">
                        @foreach (var game in games)
                        {
                            <div class="slate-game-card @GetStatusClass(game.Status)">
                                <div class="slate-game-status-bar">
                                    <span class="slate-status @GetStatusBadgeClass(game.Status)">@FormatStatus(game.Status)</span>
                                    @if (!string.IsNullOrEmpty(game.GameTime))
                                    {
                                        <span class="slate-time">@FormatTime(game.GameTime)</span>
                                    }
                                </div>
                                <div class="slate-matchup">
                                    <div class="slate-team">
                                        <span class="slate-team-name">@game.AwayAbbrev</span>
                                        <span class="slate-team-record">@game.AwayRecord</span>
                                    </div>
                                    <div class="slate-score-block">
                                        @if (IsLiveOrFinal(game.Status))
                                        {
                                            <span class="slate-score">@game.AwayScore</span>
                                            <span class="slate-score-sep">-</span>
                                            <span class="slate-score">@game.HomeScore</span>
                                        }
                                        else
                                        {
                                            <span class="slate-vs">@FormatTime(game.GameTime)</span>
                                        }
                                    </div>
                                    <div class="slate-team slate-team-right">
                                        <span class="slate-team-name">@game.HomeAbbrev</span>
                                        <span class="slate-team-record">@game.HomeRecord</span>
                                    </div>
                                </div>
                                @if (game.Spread != null || game.OverUnder != null)
                                {
                                    <div class="slate-odds-row">
                                        @if (game.Spread != null)
                                        {
                                            <span class="slate-odds-chip">Spread: @FormatSpread(game.Spread.Value)</span>
                                        }
                                        @if (game.OverUnder != null)
                                        {
                                            <span class="slate-odds-chip">O/U: @game.OverUnder.Value.ToString("F1")</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (!_hasAnyData)
        {
            <div class="slate-empty">
                <p>No games found for today across any sport.</p>
            </div>
        }
    }
</div>

<style>
