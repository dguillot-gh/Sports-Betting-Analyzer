@namespace SportsBettingAnalyzer.Components.Shared.Tailwind

<div class="@ComputedClass" role="alert">
    <div class="flex items-start gap-3">
        @if (ShowIcon)
        {
            <span class="flex-shrink-0 mt-0.5">@IconContent</span>
        }
        <div class="flex-1 @(Dismissible ? "pr-6" : "")">
            @if (!string.IsNullOrEmpty(Title))
            {
                <h4 class="font-semibold mb-1">@Title</h4>
            }
            <div class="text-sm opacity-90">@ChildContent</div>
        </div>
        @if (Dismissible)
        {
            <button @onclick="OnDismiss" class="absolute top-3 right-3 opacity-60 hover:opacity-100 transition-opacity">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Severity { get; set; } = "info"; // info, success, warning, error
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool Dismissible { get; set; } = false;
    [Parameter] public bool ShowIcon { get; set; } = true;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback OnDismiss { get; set; }

    private string ComputedClass => $"relative rounded-xl p-4 {SeverityClass} {Class}";

    private string SeverityClass => Severity switch
    {
        "info" => "bg-blue-500/10 border border-blue-500/20 text-blue-300",
        "success" => "bg-emerald-500/10 border border-emerald-500/20 text-emerald-300",
        "warning" => "bg-amber-500/10 border border-amber-500/20 text-amber-300",
        "error" => "bg-red-500/10 border border-red-500/20 text-red-300",
        _ => "bg-slate-800 border border-slate-700 text-slate-300"
    };

    private MarkupString IconContent => Severity switch
    {
        "info" => new MarkupString("<svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'></path></svg>"),
        "success" => new MarkupString("<svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'></path></svg>"),
        "warning" => new MarkupString("<svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z'></path></svg>"),
        "error" => new MarkupString("<svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z'></path></svg>"),
        _ => new MarkupString("")
    };
}
