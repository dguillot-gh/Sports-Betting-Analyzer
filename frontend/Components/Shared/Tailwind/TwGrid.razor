@namespace SportsBettingAnalyzer.Components.Shared.Tailwind

<div class="grid @ColumnsClass @GapClass @Class">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int Cols { get; set; } = 1; // Default columns
    [Parameter] public int? ColsSm { get; set; }
    [Parameter] public int? ColsMd { get; set; }
    [Parameter] public int? ColsLg { get; set; }
    [Parameter] public int? ColsXl { get; set; }
    [Parameter] public int Gap { get; set; } = 4; // Gap size (tailwind scale)
    [Parameter] public string Class { get; set; } = "";

    private string ColumnsClass
    {
        get
        {
            var classes = new List<string> { $"grid-cols-{Cols}" };
            if (ColsSm.HasValue) classes.Add($"sm:grid-cols-{ColsSm}");
            if (ColsMd.HasValue) classes.Add($"md:grid-cols-{ColsMd}");
            if (ColsLg.HasValue) classes.Add($"lg:grid-cols-{ColsLg}");
            if (ColsXl.HasValue) classes.Add($"xl:grid-cols-{ColsXl}");
            return string.Join(" ", classes);
        }
    }

    private string GapClass => $"gap-{Gap}";
}
