@implements IDisposable

@if (Parent != null && Parent.ActiveTabId == Id)
{
    <div class="@Class">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter] public TwTabs? Parent { get; set; }
    
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? TabIcon { get; set; }
    [Parameter] public string? BadgeContent { get; set; }
    [Parameter] public RenderFragment? IconContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Disabled { get; set; }

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(Id))
        {
            Id = Title.Replace(" ", "-").ToLower();
        }
        
        Parent?.RegisterPanel(this);
    }

    public void Refresh() => StateHasChanged();

    public void Dispose()
    {
        Parent?.UnregisterPanel(this);
    }
}
