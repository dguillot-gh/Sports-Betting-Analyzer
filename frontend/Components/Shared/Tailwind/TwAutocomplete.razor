@* TwAutocomplete.razor - Simple Searchable Input using Datalist *@
@namespace SportsBettingAnalyzer.Components.Shared.Tailwind

<div class="relative @(FullWidth ? "w-full" : "")">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-xs text-slate-500 mb-1 font-medium">@Label</label>
    }
    <div class="relative">
        <div class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
        </div>
        <input list="@_datalistId"
               value="@Value"
               @onchange="OnChange"
               @oninput="HandleInput"
               placeholder="@Placeholder"
               class="@GetInputClasses()" />
        
        <datalist id="@_datalistId">
            @foreach (var item in Items)
            {
                <option value="@item">@item</option>
            }
        </datalist>
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public IEnumerable<string> Items { get; set; } = Array.Empty<string>();
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool FullWidth { get; set; } = true;
    [Parameter] public string? Class { get; set; }

    private string _datalistId = "dl-" + Guid.NewGuid().ToString("n")[..8];

    private async Task OnChange(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        // For real-time sync if needed, but OnChange is usually enough for datalists
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }

    private string GetInputClasses()
    {
        var classes = "appearance-none bg-slate-800 text-sm text-slate-100 border border-slate-700 rounded-xl pl-10 pr-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition-all placeholder-slate-500";
        if (FullWidth) classes += " w-full";
        if (!string.IsNullOrEmpty(Class)) classes += $" {Class}";
        return classes;
    }
}
