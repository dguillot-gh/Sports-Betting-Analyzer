@* TwAvatar.razor - Tailwind CSS Avatar Component *@

<div class="@GetClasses()" title="@Alt">
    @if (!string.IsNullOrEmpty(Src))
    {
        <img src="@Src" alt="@Alt" class="w-full h-full object-cover" />
    }
    else if (ChildContent != null)
    {
        <span class="@GetTextSize()">@ChildContent</span>
    }
    else
    {
        <span class="@GetTextSize()">@GetInitials()</span>
    }
</div>

@code {
    [Parameter] public string? Src { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Alt { get; set; } = "";
    [Parameter] public string Size { get; set; } = "md"; // sm, md, lg, xl
    [Parameter] public string Color { get; set; } = "blue"; // blue, emerald, amber, purple, red, slate
    [Parameter] public string? Class { get; set; }

    private string GetClasses()
    {
        var size = Size switch
        {
            "sm" => "w-8 h-8",
            "lg" => "w-14 h-14",
            "xl" => "w-20 h-20",
            _ => "w-10 h-10"
        };

        var color = Color switch
        {
            "emerald" => "bg-emerald-600",
            "amber" => "bg-amber-600",
            "purple" => "bg-purple-600",
            "red" => "bg-red-600",
            "slate" => "bg-slate-600",
            _ => "bg-blue-600"
        };

        var classes = $"{size} {color} rounded-full flex items-center justify-center text-white font-bold overflow-hidden";
        if (!string.IsNullOrEmpty(Class)) classes += $" {Class}";
        return classes;
    }

    private string GetTextSize() => Size switch
    {
        "sm" => "text-xs",
        "lg" => "text-xl",
        "xl" => "text-2xl",
        _ => "text-sm"
    };

    private string GetInitials()
    {
        if (string.IsNullOrEmpty(Alt)) return "?";
        var parts = Alt.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return Alt.Length > 0 ? Alt[0].ToString().ToUpper() : "?";
    }
}
