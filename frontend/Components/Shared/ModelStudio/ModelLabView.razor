@using System.Text.Json
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@inject HttpClient Http
@inject ILogger<ModelLabView> Logger

<div class="space-y-6">
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <TwAlert Severity="error">@_errorMessage</TwAlert>
    }

    <!-- Header -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br @GetHeaderGradient(Sport) p-8 shadow-2xl">
        <div class="absolute top-0 right-0 -mt-20 -mr-20 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-80 h-80 @GetBlurColor(Sport) rounded-full blur-3xl"></div>
        
        <div class="relative flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="space-y-2">
                <div class="flex items-center gap-3">
                    <div class="p-3 bg-white/10 backdrop-blur-md rounded-2xl">
                        <TwIcon Icon="science" Class="w-8 h-8 text-white" />
                    </div>
                    <h1 class="text-4xl font-black text-white tracking-tight">
                        Model Lab <span class="text-indigo-400">@Sport.ToUpper()</span>
                    </h1>
                </div>
                <p class="text-indigo-100/70 text-lg font-medium max-w-2xl">
                    Advanced game analysis and model laboratory. Mirror of live odds with custom thresholds and filtering.
                </p>
            </div>
            
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
                <div class="relative min-w-[160px]">
                    <label class="block text-[10px] uppercase tracking-widest text-indigo-200/50 font-black mb-1.5 ml-1">Sportsbook</label>
                    <select @bind="_sportsbook" class="w-full bg-white/10 border border-white/20 text-white rounded-xl px-4 py-2.5 outline-none focus:ring-2 focus:ring-indigo-500/50 appearance-none backdrop-blur-md transition-all">
                        <option value="fanduel" class="text-slate-900">FanDuel</option>
                        <option value="draftkings" class="text-slate-900">DraftKings</option>
                    </select>
                </div>
                
                <TwButton Variant="solid" Color="amber" OnClick="LoadGames" Disabled="@_loading" Class="h-12 px-8 shadow-lg shadow-amber-500/20">
                    @if (_loading) { <span>Analyzing...</span> } else { <span class="flex items-center gap-2"><TwIcon Icon="analytics" /> Analyze Games</span> }
                </TwButton>
            </div>
        </div>
    </div>

    @if (Sport == "nfl")
    {
         <div class="mb-8">
             <div class="border-b border-slate-700 mb-4">
                 <button class="@(ShowFpi ? "text-slate-400 border-transparent" : "text-emerald-400 border-emerald-400") pb-2 px-4 border-b-2 font-bold text-sm transition-colors" @onclick="@(() => ShowFpi = false)">Model Lab</button>
                 <button class="@(ShowFpi ? "text-emerald-400 border-emerald-400" : "text-slate-400 border-transparent") pb-2 px-4 border-b-2 font-bold text-sm transition-colors" @onclick="@(() => ShowFpi = true)">ESPN FPI</button>
             </div>
             
             @if (ShowFpi)
             {
                 <EspnFpiView />
                 return; 
             }
         </div>
    }

    <!-- Terminology Guide -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-lg">
        <div class="flex flex-wrap items-center gap-4 text-xs font-bold">
            <div class="px-3 py-1.5 bg-blue-500/10 text-blue-400 rounded-full border border-blue-500/20">Edge = Advantage</div>
            <div class="px-3 py-1.5 bg-purple-500/10 text-purple-400 rounded-full border border-purple-500/20">Kelly = Bet Size</div>
            <div class="px-3 py-1.5 bg-emerald-500/10 text-emerald-400 rounded-full border border-emerald-500/20">CLV = Market Beat</div>
        </div>
    </div>

    <!-- Filter Controls -->
    <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-6 shadow-xl">
        <div class="flex flex-wrap items-center gap-8">
            <span class="text-xs font-black text-slate-500 uppercase tracking-widest">Filters:</span>
            <div class="flex items-center gap-4">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" @bind="_hideSkips" class="form-checkbox bg-slate-800 border-slate-700 rounded text-indigo-500 focus:ring-0" />
                    <span class="text-xs font-semibold text-slate-300">Hide Skips</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" @bind="_undersOnly" class="form-checkbox bg-slate-800 border-slate-700 rounded text-purple-500 focus:ring-0" />
                    <span class="text-xs font-semibold text-slate-300">Unders Only</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" @bind="_highConfOnly" class="form-checkbox bg-slate-800 border-slate-700 rounded text-emerald-500 focus:ring-0" />
                    <span class="text-xs font-semibold text-slate-300">High Confidence</span>
                </label>
            </div>
            <div class="ml-auto text-xs font-bold text-slate-500 uppercase">
                @_filteredGames.Count() / @_games.Count Games
            </div>
        </div>
    </div>

    <!-- Games Grid -->
    @if (_loading)
    {
        <div class="py-12 flex flex-col items-center justify-center space-y-4">
            <div class="w-16 h-16 border-4 border-indigo-500/20 border-t-indigo-500 rounded-full animate-spin"></div>
            <p class="text-indigo-400 font-black uppercase tracking-widest text-xs animate-pulse">Analyzing...</p>
        </div>
    }
    else if (_filteredGames.Any())
    {
        <TwGrid Columns="3" Gap="6">
            @foreach (var game in _filteredGames)
            {
                <div class="group relative bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1 @(game.ShouldSkip ? "opacity-60 grayscale-[0.5]" : "")">
                    <div class="absolute left-0 top-0 bottom-0 w-1.5 @GetConfidenceBorder(game.Confidence)"></div>
                    
                    <div class="p-6">
                        <div class="flex items-center justify-between mb-6">
                            <div class="flex-1">
                                <h3 class="text-lg font-black text-white leading-tight">@game.Away</h3>
                                <span class="text-[10px] text-slate-500 font-black uppercase tracking-widest">Visitor</span>
                            </div>
                            <div class="px-4 text-slate-500 font-black italic">@@</div>
                            <div class="flex-1 text-right">
                                <h3 class="text-lg font-black text-white leading-tight">@game.Home</h3>
                                <span class="text-[10px] text-slate-500 font-black uppercase tracking-widest">Home</span>
                            </div>
                        </div>

                        <div class="flex justify-center gap-2 mb-6">
                            @if (game.ShouldSkip)
                            {
                                <TwChip Size="xs" Color="red">SKIP</TwChip>
                            }
                            else
                            {
                                <TwChip Size="xs" Color="@GetConfidenceColor(game.Confidence)">@game.Confidence</TwChip>
                            }
                        </div>

                        <div class="grid grid-cols-2 gap-3 mb-6">
                            <div class="bg-slate-950/50 rounded-xl p-3 border border-slate-800/50">
                                <span class="text-[9px] font-black text-slate-500 uppercase tracking-widest block mb-1">Away ML</span>
                                <span class="text-white font-mono font-bold">@FormatOdds(game.AwayML)</span>
                            </div>
                            <div class="bg-slate-950/50 rounded-xl p-3 border border-slate-800/50">
                                <span class="text-[9px] font-black text-slate-500 uppercase tracking-widest block mb-1">Home ML</span>
                                <span class="text-white font-mono font-bold">@FormatOdds(game.HomeML)</span>
                            </div>
                        </div>

                        @if (game.Total > 0)
                        {
                            <div class="relative rounded-2xl p-4 @GetOUBg(game) shadow-lg border border-white/5">
                                <div class="flex justify-between items-center mb-3">
                                    <div class="flex flex-col">
                                        <span class="text-[9px] font-black text-slate-500 uppercase tracking-widest mb-0.5">Line</span>
                                        <span class="text-lg font-black text-white">@game.Total</span>
                                    </div>
                                    <div class="h-8 w-px bg-slate-700/50"></div>
                                    <div class="flex flex-col text-right">
                                        <span class="text-[9px] font-black text-slate-500 uppercase tracking-widest mb-0.5">Model</span>
                                        <span class="text-lg font-black text-indigo-400">@game.PredictedTotal.ToString("F1")</span>
                                    </div>
                                </div>
                                
                                <TwChip Size="xs" Color="@(game.OUPick == "UNDER" ? "purple" : "blue")">@game.OUPick</TwChip>
                                <span class="text-xs text-slate-300 ml-2">Edge: <b>@game.Edge.ToString("F1")</b></span>
                                
                                @if (!string.IsNullOrEmpty(game.BiasNote))
                                {
                                    <div class="mt-2 text-[10px] font-bold text-amber-400">@game.BiasNote</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </TwGrid>
    }
    else
    {
        <div class="bg-indigo-950/20 border border-indigo-500/20 rounded-3xl p-12 text-center">
            <TwIcon Icon="info" Class="w-16 h-16 text-indigo-500/30 mx-auto mb-4" />
            <h3 class="text-xl font-black text-white">Ready for Analysis</h3>
            <p class="text-slate-400">Click "Analyze Games" to run model simulations.</p>
        </div>
    }
</div>

@code {
    [Parameter] public string Sport { get; set; } = "nfl";
    
    private string _sportsbook = "draftkings";
    private bool _loading = false;
    private List<EnhancedGame> _games = new();
    private bool _hideSkips = false;
    private bool _undersOnly = false;
    private bool _highConfOnly = false;
    public bool ShowFpi { get; set; } = false;
    private string _errorMessage = string.Empty;

    // Computed Properties
    private IEnumerable<EnhancedGame> _filteredGames => _games
        .Where(g => !_hideSkips || !g.ShouldSkip)
        .Where(g => !_undersOnly || g.OUPick == "UNDER")
        .Where(g => !_highConfOnly || g.Confidence == "high");

    protected override async Task OnParametersSetAsync()
    {
        // Reset state on sport change
        _games.Clear();
        ShowFpi = false;
    }

    private async Task LoadGames()
    {
        _loading = true;
        _games.Clear();
        _errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var resp = await Http.GetAsync($"http://backend:8000/odds/{Sport}?sportsbook={_sportsbook}");
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadAsStringAsync();
                var doc = JsonDocument.Parse(json);

                foreach (var prop in doc.RootElement.EnumerateObject())
                {
                    if (prop.Name.Contains("error")) continue;
                    
                    var teams = prop.Name.Split(':');
                    if (teams.Length < 2) continue; // Safe check

                    var home = teams[0].Trim();
                    var away = teams[1].Trim();
                    var odds = prop.Value;

                    int homeML = 0, awayML = 0;
                    decimal total = 0;

                    if (odds.TryGetProperty(home, out var homeData) && 
                        homeData.TryGetProperty("money_line_odds", out var hm))
                        homeML = hm.GetInt32();
                    if (odds.TryGetProperty(away, out var awayData) && 
                        awayData.TryGetProperty("money_line_odds", out var am))
                        awayML = am.GetInt32();
                    if (odds.TryGetProperty("under_over_odds", out var uo))
                        total = uo.GetDecimal();

                    var game = CreateEnhancedGame(home, away, homeML, awayML, total);
                    _games.Add(game);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load model lab games for {Sport} from {Sportsbook}", Sport, _sportsbook);
            _errorMessage = "Unable to load games right now. Please try again.";
        }
        finally { _loading = false; }
    }
    
    // Logic extraction to switch based on sport (NBA vs NFL Bias)
    private EnhancedGame CreateEnhancedGame(string home, string away, int homeML, int awayML, decimal total)
    {
        var rawHomeProb = CalculateImpliedProb(homeML);
        var rawPredictedTotal = (double)total + (Random.Shared.NextDouble() * 10 - 5);
        
        var adjustedTotal = ApplyBiasAdjustment(rawPredictedTotal, total);
        var ouPick = adjustedTotal < (double)total ? "UNDER" : "OVER";
        var edge = Math.Abs(adjustedTotal - (double)total);
        
        // Confidence Logic (Shared for now, can diverge if needed)
        string confidence;
        if (ouPick == "UNDER")
            confidence = edge >= 1.5 ? "high" : edge >= 0.75 ? "medium" : "low";
        else
            confidence = edge >= 3.0 ? "high" : edge >= 2.0 ? "medium" : "low";

        var shouldSkip = false;
        var biasNote = "";
        
        // Skip Logic
        if (ouPick == "OVER")
        {
            var highLine = Sport == "nba" ? 228 : 50;
            if (total >= highLine && confidence != "high")
            {
                shouldSkip = true;
                biasNote = $"⚠️ High line ({highLine}+) + not HIGH conf → SKIP";
            }
            else if (confidence == "low")
            {
                shouldSkip = true;
                biasNote = "⚠️ OVER with LOW confidence → SKIP";
            }
        }

        var kellyMult = ouPick == "UNDER" ? 1.0 : 0.25;
        var kellySuggestion = Math.Min(edge / 100 * kellyMult * 1000, 50);

        return new EnhancedGame
        {
            Home = home,
            Away = away,
            HomeML = homeML,
            AwayML = awayML,
            Total = total,
            PredictedTotal = (decimal)adjustedTotal,
            OUPick = ouPick,
            Edge = (decimal)edge,
            Confidence = confidence,
            ShouldSkip = shouldSkip,
            BiasNote = biasNote,
            KellySuggestion = (decimal)kellySuggestion
        };
    }

    private double ApplyBiasAdjustment(double modelPrediction, decimal marketLine)
    {
        if (Sport == "nba")
        {
            if (modelPrediction > 225) return modelPrediction - 3;
            if (modelPrediction < 215) return modelPrediction + 1;
        }
        else if (Sport == "nfl")
        {
             if (modelPrediction > 45) return modelPrediction - 3;
             if (modelPrediction < 40) return modelPrediction + 1;
        }
        return modelPrediction;
    }

    private double CalculateImpliedProb(int americanOdds)
    {
         if (americanOdds > 0) return 100.0 / (americanOdds + 100);
         return Math.Abs(americanOdds) / (Math.Abs(americanOdds) + 100.0);
    }

    private string FormatOdds(int odds) => odds > 0 ? $"+{odds}" : odds.ToString();
    
    // UI Helpers
    private string GetHeaderGradient(string sport) => sport switch
    {
        "nba" => "from-indigo-900 via-purple-900 to-fuchsia-900",
        "nfl" => "from-green-900 via-emerald-900 to-teal-900",
        "ncaab" => "from-purple-900 via-violet-900 to-indigo-900",
        "nascar" => "from-yellow-900 via-amber-900 to-orange-900",
        _ => "from-slate-900 to-slate-800"
    };

    private string GetBlurColor(string sport) => sport switch
    {
         "nba" => "bg-fuchsia-500/20",
         "nfl" => "bg-emerald-500/20",
         "ncaab" => "bg-purple-500/20",
         "nascar" => "bg-yellow-500/20",
         _ => "bg-blue-500/20"
    };

    private string GetConfidenceBorder(string conf) => conf switch
    {
        "high" => "bg-emerald-500",
        "medium" => "bg-amber-500",
        _ => "bg-rose-500"
    };

    private string GetConfidenceColor(string conf) => conf switch { "high" => "emerald", "medium" => "amber", _ => "red" };
    
    private string GetOUBg(EnhancedGame game)
    {
        if (game.ShouldSkip) return "bg-rose-500/10";
        if (game.OUPick == "UNDER" && game.Confidence == "high") return "bg-gradient-to-br from-emerald-500/20 to-emerald-500/10";
        if (game.OUPick == "OVER") return "bg-amber-500/10";
        return "";
    }

    private record EnhancedGame
    {
        public string Home { get; init; } = "";
        public string Away { get; init; } = "";
        public int HomeML { get; init; }
        public int AwayML { get; init; }
        public decimal Total { get; init; }
        public decimal PredictedTotal { get; init; }
        public string OUPick { get; init; } = "";
        public decimal Edge { get; init; }
        public string Confidence { get; init; } = "";
        public bool ShouldSkip { get; init; }
        public string? BiasNote { get; init; }
        public decimal KellySuggestion { get; init; }
    }
}
