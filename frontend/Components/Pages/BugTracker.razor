@page "/bug-tracker"
@using MudBlazor
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IConfiguration Configuration
@rendermode InteractiveServer

<PageTitle>Bug Tracker - Sports Betting Analyzer</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudStack Spacing="4">
        <MudPaper Class="pa-4" Elevation="3" Style="background: linear-gradient(135deg, #2c3e50 0%, #000000 100%);">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <div>
                    <MudText Typo="Typo.h4" Style="color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.BugReport" Class="mr-2" />
                        Bug Tracker
                    </MudText>
                    <MudText Typo="Typo.subtitle1" Style="color: #bdc3c7;">Track issues, feature requests, and system health.</MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog">
                    Report Bug
                </MudButton>
            </MudStack>
        </MudPaper>

        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Surface">
            <MudTabPanel Text="Active Issues" Icon="@Icons.Material.Filled.BugReport">
                <MudDataGrid T="Bug" Items="@_bugs.Where(b => b.Status != "Resolved")" Filterable="true" SortMode="SortMode.Multiple" Hover="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Severity" Title="Severity">
                            <CellTemplate>
                                <MudChip T="string" Color="@GetSeverityColor(context.Item.Severity)" Size="Size.Small" Variant="Variant.Filled">@context.Item.Severity</MudChip>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Title" Title="Title" />
                        <PropertyColumn Property="x => x.CreatedAt" Title="Reported" />
                        <TemplateColumn Title="Status">
                            <CellTemplate>
                                <MudSelect T="string" Value="@context.Item.Status" ValueChanged="@(v => UpdateStatus(context.Item.Id, v))" Dense="true" Variant="Variant.Text" Margin="Margin.None">
                                    <MudSelectItem Value="@("New")">New</MudSelectItem>
                                    <MudSelectItem Value="@("In Progress")">In Progress</MudSelectItem>
                                    <MudSelectItem Value="@("Testing")">Testing</MudSelectItem>
                                    <MudSelectItem Value="@("Resolved")">Resolved</MudSelectItem>
                                </MudSelect>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn CellClass="d-flex justify-end">
                            <CellTemplate>
                                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditDialog(context.Item))" />
                                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteBug(context.Item.Id))" />
                                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" OnClick="@(() => UpdateStatus(context.Item.Id, "Resolved"))" Title="Quick Resolve" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudText>No active bugs found. Great job!</MudText>
                    </NoRecordsContent>
                </MudDataGrid>
            </MudTabPanel>
            
            <MudTabPanel Text="Resolved" Icon="@Icons.Material.Filled.CheckCircle">
                <MudDataGrid T="Bug" Items="@_bugs.Where(b => b.Status == "Resolved")" Hover="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Title" Title="Issue" />
                        <PropertyColumn Property="x => x.CreatedAt" Title="Reported" />
                        <PropertyColumn Property="x => x.Severity" Title="Severity" />
                        <TemplateColumn Title="Actions">
                            <CellTemplate>
                                <MudButton Size="@Size.Small" Variant="Variant.Outlined" OnClick="@(() => UpdateStatus(context.Item.Id, "New"))">Re-open</MudButton>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudContainer>

<MudDialog @bind-Visible="_dialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEdit ? "Edit Issue" : "Report New Issue")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_currentBug.Title" Label="Title" Required="true" Variant="Variant.Outlined" Placeholder="e.g. NBA Odds not loading" />
            <MudTextField @bind-Value="_currentBug.Description" Label="Description" Lines="3" Variant="Variant.Outlined" Placeholder="Describe what happened..." />
            <MudSelect @bind-Value="_currentBug.Severity" Label="Severity" Variant="Variant.Outlined">
                <MudSelectItem Value="@("Low")">Low</MudSelectItem>
                <MudSelectItem Value="@("Medium")">Medium</MudSelectItem>
                <MudSelectItem Value="@("High")">High</MudSelectItem>
                <MudSelectItem Value="@("Critical")">Critical</MudSelectItem>
            </MudSelect>
            <MudSelect @bind-Value="_currentBug.Type" Label="Type" Variant="Variant.Outlined">
                <MudSelectItem Value="@("Bug")">Bug</MudSelectItem>
                <MudSelectItem Value="@("Feature")">Feature Request</MudSelectItem>
                <MudSelectItem Value="@("UI")">UI Tweak</MudSelectItem>
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogOpen = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveBug">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Bug> _bugs = new();
    private bool _dialogOpen = false;
    private bool _isEdit = false;
    private Bug _currentBug = new();
    private string _apiBaseUrl = "http://backend:8000";

    protected override async Task OnInitializedAsync()
    {
        _apiBaseUrl = Configuration["PythonApiUrl"] ?? "http://backend:8000";
        await LoadBugs();
    }

    private async Task LoadBugs()
    {
        try
        {
            // Note: We'll add /bugs endpoint to Python in the next step
            var response = await Http.GetFromJsonAsync<BugResponse>($"{_apiBaseUrl}/bugs");
            if (response != null) _bugs = response.Bugs;
        }
        catch (Exception) 
        {
            // Silent fail if endpoint doesn't exist yet
        }
    }

    private void OpenAddDialog()
    {
        _isEdit = false;
        _currentBug = new Bug { Severity = "Medium", Status = "New", Type = "Bug" };
        _dialogOpen = true;
    }

    private void OpenEditDialog(Bug bug)
    {
        _isEdit = true;
        _currentBug = new Bug 
        { 
            Id = bug.Id, 
            Title = bug.Title, 
            Description = bug.Description, 
            Severity = bug.Severity, 
            Status = bug.Status,
            Type = bug.Type 
        };
        _dialogOpen = true;
    }

    private async Task SaveBug()
    {
        if (string.IsNullOrWhiteSpace(_currentBug.Title)) return;

        try
        {
            HttpResponseMessage response;
            if (_isEdit)
                response = await Http.PutAsJsonAsync($"{_apiBaseUrl}/bugs/{_currentBug.Id}", _currentBug);
            else
                response = await Http.PostAsJsonAsync($"{_apiBaseUrl}/bugs", _currentBug);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(_isEdit ? "Issue updated" : "Issue reported", Severity.Success);
                _dialogOpen = false;
                await LoadBugs();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task UpdateStatus(int id, string status)
    {
        try
        {
            var response = await Http.PatchAsJsonAsync($"{_apiBaseUrl}/bugs/{id}/status", new { status = status });
            if (response.IsSuccessStatusCode)
            {
                await LoadBugs();
                Snackbar.Add($"Status updated to {status}", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating status: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteBug(int id)
    {
        var confirm = await DialogService.ShowMessageBox("Delete Issue", "Are you sure you want to delete this report?", yesText: "Delete", cancelText: "Cancel");
        if (confirm == true)
        {
            try
            {
                await Http.DeleteAsync($"{_apiBaseUrl}/bugs/{id}");
                await LoadBugs();
                Snackbar.Add("Issue deleted", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }

    private Color GetSeverityColor(string severity) => severity switch
    {
        "Critical" => Color.Error,
        "High" => Color.Warning,
        "Medium" => Color.Info,
        _ => Color.Default
    };

    public class Bug
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Severity { get; set; } = "Medium";
        public string Status { get; set; } = "New";
        public string Type { get; set; } = "Bug";
        public DateTime CreatedAt { get; set; } = DateTime.Now;
    }

    public class BugResponse
    {
        public List<Bug> Bugs { get; set; } = new();
    }
}
