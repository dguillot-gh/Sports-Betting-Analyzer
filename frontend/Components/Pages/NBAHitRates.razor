@page "/nba-hit-rates"
@using SportsBettingAnalyzer.Services
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@inject HttpClient Http
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>NBA Hit Rates</PageTitle>

<div class="min-h-screen bg-slate-950 text-slate-100 p-4 md:p-8 font-sans">
    <TwContainer MaxWidth="7xl">
        <!-- Header -->
        <header class="mb-8">
            <div class="flex items-center gap-3 mb-2">
                <div class="bg-orange-600 p-3 rounded-xl shadow-lg shadow-orange-900/20">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-3xl font-bold tracking-tight">NBA Hit Rates</h1>
                    <p class="text-slate-400 text-sm">Prop bet analysis - Find consistent NBA performers</p>
                </div>
            </div>
        </header>

        <!-- Search and Filters -->
        <TwCard Class="mb-8" Color="slate">
            <div class="flex flex-col md:flex-row gap-4 items-end">
                <div class="w-full md:w-1/6">
                    <TwSelect TValue="int" Label="Season" @bind-Value="_selectedSeason" 
                              Items="_availableSeasons.Select(s => new KeyValuePair<string, int>(s.ToString(), s))" />
                </div>
                
                <div class="w-full md:w-1/3">
                    <TwInput Label="Player Search" @bind-Value="_searchPlayer" 
                             Placeholder="LeBron James, Shai Gilgeous-Alexander..." 
                             ShowSearchIcon="true" />
                </div>
                
                <div class="w-full md:w-1/6">
                    <TwSelect TValue="string" Label="Stat Type" Value="_selectedStat" 
                              Items="_statOptions" ValueChanged="@((string val) => OnStatChanged(val))" />
                </div>
                
                <div class="w-full md:w-1/6">
                    <div class="flex flex-col gap-1">
                        <label class="text-xs font-semibold uppercase tracking-wider text-slate-400 ml-1">Over Line</label>
                        <input type="number" @bind="_threshold" min="0" max="100" 
                               class="w-full bg-slate-800 text-white border border-slate-700 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition-all placeholder-slate-500 hover:border-slate-600" />
                    </div>
                </div>

                <div class="w-full md:w-auto">
                    <TwButton Variant="primary" OnClick="CalculateHitRates" IsLoading="_isLoading" Disabled="_isLoading">
                        Calculate
                    </TwButton>
                </div>
            </div>
        </TwCard>

        @if (_isLoading)
        {
            <div class="flex flex-col items-center justify-center py-12">
                <TwProgressBar Indeterminate="true" Color="orange" Class="w-1/2 mb-4" />
                <p class="text-slate-400 animate-pulse">Calculating hit rates...</p>
            </div>
        }
        else if (_hitRates.Any())
        {
            <!-- Summary Cards -->
            <TwGrid Cols="1" ColsMd="3" Gap="6" Class="mb-8">
                @foreach (var player in _hitRates.Take(3))
                {
                    <TwCard Hoverable="true" Class="@($"h-full border-l-4 {GetBorderClass(player.SeasonRate)}")" Color="slate">
                        <div class="flex justify-between items-start mb-4">
                            <div>
                                <h3 class="font-bold text-lg text-white">@player.PlayerName</h3>
                                <p class="text-sm text-slate-400">
                                    Over @_threshold @GetStatLabel(_selectedStat) (@_selectedSeason)
                                </p>
                            </div>
                            <TwAvatar Size="lg" Color="@GetRateColorName(player.SeasonRate)">
                                @player.SeasonRate.ToString("P0")
                            </TwAvatar>
                        </div>
                        
                        <div class="w-full h-px bg-slate-700 my-4"></div>
                        
                        <div class="grid grid-cols-3 gap-2">
                            <div class="text-center">
                                <div class="@($"text-xl font-bold {GetTextClass(player.Last5Rate)}")">
                                    @player.Last5Hits/@player.Last5Games
                                </div>
                                <div class="text-xs text-slate-500 uppercase tracking-wider mt-1">Last 5</div>
                            </div>
                            <div class="text-center">
                                <div class="@($"text-xl font-bold {GetTextClass(player.Last10Rate)}")">
                                    @player.Last10Hits/@player.Last10Games
                                </div>
                                <div class="text-xs text-slate-500 uppercase tracking-wider mt-1">Last 10</div>
                            </div>
                            <div class="text-center">
                                <div class="@($"text-xl font-bold {GetTextClass(player.SeasonRate)}")">
                                    @player.SeasonHits/@player.SeasonGames
                                </div>
                                <div class="text-xs text-slate-500 uppercase tracking-wider mt-1">Season</div>
                            </div>
                        </div>
                    </TwCard>
                }
            </TwGrid>
            
            <!-- Full Table -->
            <TwCard Color="slate" Class="overflow-hidden mb-8">
                <div class="overflow-x-auto max-h-[600px]">
                    <TwTable>
                        <HeaderContent>
                            <TwTh>Player</TwTh>
                            <TwTh>Team</TwTh>
                            <TwTh Class="text-center">L5</TwTh>
                            <TwTh Class="text-center">L10</TwTh>
                            <TwTh Class="text-center">Season</TwTh>
                            <TwTh Class="text-center">Avg</TwTh>
                            <TwTh Class="text-center">Trend</TwTh>
                        </HeaderContent>
                        <ChildContent>
                            @foreach (var player in _hitRates)
                            {
                                <TwTr>
                                    <TwTd>
                                        <TwLink Href="@($"/nba-player-profiles?player={Uri.EscapeDataString(player.PlayerName)}")">
                                            @player.PlayerName
                                        </TwLink>
                                    </TwTd>
                                    <TwTd>@player.Team</TwTd>
                                    <TwTd Class="text-center">
                                        <TwChip Size="sm" Color="@GetRateColorName(player.Last5Rate)">
                                            @player.Last5Hits/@player.Last5Games
                                        </TwChip>
                                    </TwTd>
                                    <TwTd Class="text-center">
                                        <TwChip Size="sm" Color="@GetRateColorName(player.Last10Rate)">
                                            @player.Last10Hits/@player.Last10Games
                                        </TwChip>
                                    </TwTd>
                                    <TwTd Class="text-center">
                                        <TwChip Size="sm" Color="@GetRateColorName(player.SeasonRate)">
                                            @player.SeasonRate.ToString("P0")
                                        </TwChip>
                                    </TwTd>
                                    <TwTd Class="text-center font-bold text-white">
                                        @player.SeasonAvg.ToString("F1")
                                    </TwTd>
                                    <TwTd Class="text-center">
                                        @if (player.Last5Rate > player.SeasonRate)
                                        {
                                            <svg class="w-5 h-5 text-emerald-500 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                                            </svg>
                                        }
                                        else if (player.Last5Rate < player.SeasonRate)
                                        {
                                            <svg class="w-5 h-5 text-rose-500 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"></path>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg class="w-5 h-5 text-slate-500 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14"></path>
                                            </svg>
                                        }
                                    </TwTd>
                                </TwTr>
                            }
                        </ChildContent>
                    </TwTable>
                </div>

                <!-- Averages Summary -->
                <div class="mt-6 pt-6 border-t border-slate-700">
                    <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-4 flex items-center">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                        Season Averages (Selected Players)
                    </h4>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div class="bg-slate-800/50 rounded-lg p-3 text-center border border-slate-700">
                            <div class="text-xl font-bold text-indigo-400">@GetOverallAvg("pts").ToString("F1")</div>
                            <div class="text-xs text-slate-500">Avg Points</div>
                        </div>
                        <div class="bg-slate-800/50 rounded-lg p-3 text-center border border-slate-700">
                            <div class="text-xl font-bold text-emerald-400">@GetOverallAvg("reb").ToString("F1")</div>
                            <div class="text-xs text-slate-500">Avg Rebounds</div>
                        </div>
                        <div class="bg-slate-800/50 rounded-lg p-3 text-center border border-slate-700">
                            <div class="text-xl font-bold text-amber-400">@GetOverallAvg("ast").ToString("F1")</div>
                            <div class="text-xs text-slate-500">Avg Assists</div>
                        </div>
                        <div class="bg-slate-800/50 rounded-lg p-3 text-center border border-slate-700">
                            <div class="text-xl font-bold text-blue-400">@GetOverallAvg("fg3").ToString("F1")</div>
                            <div class="text-xs text-slate-500">Avg 3PM</div>
                        </div>
                    </div>
                </div>
            </TwCard>
        }
        else if (!_isLoading && _searchCompleted)
        {
            <TwAlert Severity="info" Class="max-w-md mx-auto">
                No hit rate data found. Try searching for a player or adjusting filters.
            </TwAlert>
        }
    </TwContainer>
</div>

@code {
    private string _searchPlayer = "";
    private string _selectedStat = "pts";
    private int _threshold = 20;
    private int _selectedSeason = 2025;
    private bool _isLoading = false;
    private bool _searchCompleted = false;
    
    private List<int> _availableSeasons = new() { 2025, 2024, 2023 };
    private List<HitRateResult> _hitRates = new();
    private List<GameResult> _allGameResults = new(); // For computing multi-stat averages
    
    private List<KeyValuePair<string, string>> _statOptions = new()
    {
        new("Points", "pts"),
        new("Rebounds", "reb"),
        new("Assists", "ast"),
        new("3-Pointers Made", "fg3"),
        new("Steals", "stl"),
        new("Blocks", "blk")
    };
    
    protected override async Task OnInitializedAsync()
    {
        await LoadSeasons();
    }
    
    private async Task LoadSeasons()
    {
        try
        {
            // Query seasons from the nba_game_log data (not schedules)
            var response = await Http.GetFromJsonAsync<SeasonsResponse>(
                "http://backend:8000/db/games/nba/seasons?series=nba_game_log");
            if (response?.Seasons?.Any() == true)
            {
                _availableSeasons = response.Seasons;
                _selectedSeason = _availableSeasons.First();
            }
        }
        catch { }
    }
    
    private void OnStatChanged(string newStat)
    {
        _selectedStat = newStat;
        // Auto-adjust thresholds based on stat type
        _threshold = newStat switch
        {
            "pts" => 20,
            "reb" => 8,
            "ast" => 6,
            "fg3" => 3,
            "stl" => 2,
            "blk" => 2,
            _ => 10
        };
    }
    
    private async Task SearchPlayers()
    {
        if (string.IsNullOrWhiteSpace(_searchPlayer) || _searchPlayer.Length < 2)
            return;
        
        await CalculateHitRates();
    }
    
    private async Task CalculateHitRates()
    {
        try
        {
            _isLoading = true;
            _searchCompleted = false;
            StateHasChanged();
            
            // Fetch game results filtered by season
            var url = $"http://backend:8000/db/games/nba/list?limit=1000&season={_selectedSeason}";
            if (!string.IsNullOrEmpty(_searchPlayer))
                url += $"&player={Uri.EscapeDataString(_searchPlayer)}";
            
            var response = await Http.GetAsync(url);
            if (!response.IsSuccessStatusCode)
            {
                // Simplified error handling
                _hitRates = new();
                _searchCompleted = true;
                return;
            }
            
            var json = await response.Content.ReadAsStringAsync();
            var games = System.Text.Json.JsonSerializer.Deserialize<GameResultsResponse>(json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            
            if (games?.Results == null || !games.Results.Any())
            {
                _hitRates = new();
                _searchCompleted = true;
                return;
            }
            
            // Store for multi-stat averages
            _allGameResults = games.Results.Where(g => !string.IsNullOrEmpty(g.PlayerName)).ToList();
            
            // Group by player
            var playerGames = _allGameResults
                .GroupBy(g => g.PlayerName)
                .ToList();
            
            _hitRates = playerGames.Select(pg =>
            {
                var allGames = pg.OrderByDescending(g => g.GameDate ?? "").ToList();
                var last5 = allGames.Take(5).ToList();
                var last10 = allGames.Take(10).ToList();
                
                int GetStatValue(GameResult g) => _selectedStat switch
                {
                    "pts" => g.Pts ?? 0,
                    "reb" => g.Reb ?? 0,
                    "ast" => g.Ast ?? 0,
                    "stl" => g.Stl ?? 0,
                    "blk" => g.Blk ?? 0,
                    "fg3" => g.Fg3 ?? 0,
                    _ => 0
                };
                
                return new HitRateResult
                {
                    PlayerName = pg.Key!,
                    Team = pg.FirstOrDefault()?.Team ?? "",
                    Last5Games = last5.Count,
                    Last5Hits = last5.Count(g => GetStatValue(g) >= _threshold),
                    Last10Games = last10.Count,
                    Last10Hits = last10.Count(g => GetStatValue(g) >= _threshold),
                    SeasonGames = allGames.Count,
                    SeasonHits = allGames.Count(g => GetStatValue(g) >= _threshold),
                    SeasonAvg = allGames.Count > 0 ? allGames.Average(g => GetStatValue(g)) : 0,
                };
            })
            .Where(h => h.SeasonGames > 0)
            .OrderByDescending(h => h.SeasonRate)
            .ThenByDescending(h => h.SeasonGames)
            .Take(50)
            .ToList();
            
            _searchCompleted = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            _hitRates = new();
        }
        finally
        {
            _isLoading = false;
        }
    }
    
    private string GetRateColorName(double rate)
    {
        if (rate >= 0.80) return "emerald";
        if (rate >= 0.60) return "amber";
        return "rose";
    }
    
    private string GetBorderClass(double rate)
    {
        if (rate >= 0.80) return "border-emerald-500";
        if (rate >= 0.60) return "border-amber-500";
        return "border-rose-500";
    }
    
    private string GetTextClass(double rate)
    {
        if (rate >= 0.80) return "text-emerald-400";
        if (rate >= 0.60) return "text-amber-400";
        return "text-rose-400";
    }
    
    private string GetStatLabel(string stat) => stat switch
    {
        "pts" => "Points",
        "reb" => "Rebounds",
        "ast" => "Assists",
        "stl" => "Steals",
        "blk" => "Blocks",
        "fg3" => "3PM",
        _ => stat
    };
    
    // Calculate overall average for any stat across all displayed players
    private double GetOverallAvg(string stat)
    {
        if (!_allGameResults.Any()) return 0;
        
        var values = _allGameResults.Select(g => stat switch
        {
            "pts" => g.Pts ?? 0,
            "reb" => g.Reb ?? 0,
            "ast" => g.Ast ?? 0,
            "stl" => g.Stl ?? 0,
            "blk" => g.Blk ?? 0,
            "fg3" => g.Fg3 ?? 0,
            _ => 0
        }).Where(v => v > 0); // Only count games with stats
        
        return values.Any() ? values.Average() : 0;
    }
    
    // Models
    public class SeasonsResponse
    {
        public List<int> Seasons { get; set; } = new();
    }
    
    public class HitRateResult
    {
        public string PlayerName { get; set; } = "";
        public string Team { get; set; } = "";
        public int Last5Games { get; set; }
        public int Last5Hits { get; set; }
        public int Last10Games { get; set; }
        public int Last10Hits { get; set; }
        public int SeasonGames { get; set; }
        public int SeasonHits { get; set; }
        public double SeasonAvg { get; set; }
        
        public double Last5Rate => Last5Games > 0 ? (double)Last5Hits / Last5Games : 0;
        public double Last10Rate => Last10Games > 0 ? (double)Last10Hits / Last10Games : 0;
        public double SeasonRate => SeasonGames > 0 ? (double)SeasonHits / SeasonGames : 0;
    }
    
    public class GameResultsResponse
    {
        public List<GameResult> Results { get; set; } = new();
    }
    
    public class GameResult
    {
        [System.Text.Json.Serialization.JsonPropertyName("season")]
        public int Season { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("game_date")]
        public string? GameDate { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("player_name")]
        public string? PlayerName { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("team")]
        public string? Team { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("pts")]
        public int? Pts { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("reb")]
        public int? Reb { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("ast")]
        public int? Ast { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("stl")]
        public int? Stl { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("blk")]
        public int? Blk { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("fg3")]
        public int? Fg3 { get; set; }
    }
}
