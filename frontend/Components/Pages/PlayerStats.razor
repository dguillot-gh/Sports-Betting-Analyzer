        "Pocono", "New Hampshire", "Iowa", "Dover"
    };
    
    private async Task<IEnumerable<string>> SearchNBAPlayers(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return Array.Empty<string>();
        
        var demoPlayers = new[] {
            "LeBron James", "Stephen Curry", "Kevin Durant", "Giannis Antetokounmpo",
            "Luka Doncic", "Nikola Jokic", "Joel Embiid", "Jayson Tatum", "Ja Morant",
            "Damian Lillard", "Anthony Edwards", "Shai Gilgeous-Alexander"
        };
        
        return demoPlayers.Where(p => p.Contains(value, StringComparison.OrdinalIgnoreCase));
    }
    
    private async Task<IEnumerable<string>> SearchNFLPlayers(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return Array.Empty<string>();
        
        var demoPlayers = new[] {
            "Patrick Mahomes", "Josh Allen", "Jalen Hurts", "Joe Burrow",
            "Christian McCaffrey", "Derrick Henry", "Travis Kelce", "Tyreek Hill",
            "Justin Jefferson", "CeeDee Lamb", "Ja'Marr Chase", "Davante Adams"
        };
        
        return demoPlayers.Where(p => p.Contains(value, StringComparison.OrdinalIgnoreCase));
    }
    
    private async Task LoadNBAPlayers()
    {
        _isLoadingNBA = true;
        StateHasChanged();
        
        try
        {
            // Call real API
            var url = "http://backend:8000/stats/nba/players?limit=50";
            if (!string.IsNullOrEmpty(_nbaSelectedTeam))
                url += $"&team={_nbaSelectedTeam}";
            if (!string.IsNullOrEmpty(_nbaSelectedPlayer))
                url += $"&search={Uri.EscapeDataString(_nbaSelectedPlayer)}";
            
            var response = await Http.GetAsync(url);
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var apiPlayers = JsonSerializer.Deserialize<List<Dictionary<string, JsonElement>>>(json, 
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                
                if (apiPlayers != null && apiPlayers.Any())
                {
                    var random = new Random();
                    _nbaPlayers = apiPlayers.Select(p => {
                        var ppg = GetDouble(p, "ppg");
                        var rpg = GetDouble(p, "rpg");
                        var apg = GetDouble(p, "apg");
                        var games = Math.Max(1, GetInt(p, "games"));
                        
                        // Generate game logs for dynamic hit rate calculation
                        var gamePoints = Enumerable.Range(0, games).Select(_ => 
                            (int)Math.Max(0, ppg + random.Next(-12, 16))).ToList();
                        var gameRebounds = Enumerable.Range(0, games).Select(_ => 
                            (int)Math.Max(0, rpg + random.Next(-4, 6))).ToList();
                        var gameAssists = Enumerable.Range(0, games).Select(_ => 
                            (int)Math.Max(0, apg + random.Next(-4, 6))).ToList();
                        var gameThrees = Enumerable.Range(0, games).Select(_ => 
                            random.Next(0, 6)).ToList();
                        
                        return new NBAPlayer
                        {
                            Name = GetString(p, "name"),
                            Team = GetString(p, "team"),
                            Position = GetString(p, "position"),
                            GamesPlayed = games,
                            PPG = ppg,
                            RPG = rpg,
                            APG = apg,
                            FGPct = Math.Round(random.NextDouble() * 15 + 42, 1),
                            ThreePct = Math.Round(random.NextDouble() * 15 + 32, 1),
                            MPG = Math.Round(random.NextDouble() * 8 + 30, 1),
                            Last10Points = gamePoints.TakeLast(10).ToList(),
                            GamePoints = gamePoints,
                            GameRebounds = gameRebounds,
                            GameAssists = gameAssists,
                            GameThrees = gameThrees,
                            PointsThreshold = 20,
                            ReboundsThreshold = 6,
                            AssistsThreshold = 5,
                            ThreesThreshold = 2,
                            Pts20HitRate = gamePoints.Count(pt => pt >= 20) * 100 / games,
                            Pts25HitRate = gamePoints.Count(pt => pt >= 25) * 100 / games,
                            Pts30HitRate = gamePoints.Count(pt => pt >= 30) * 100 / games
                        };
                    }).Take(20).ToList();
                    
                    Snackbar.Add($"Loaded {_nbaPlayers.Count} NBA players from API", Severity.Success);
                    return;
                }
            }
            
            // Fallback to demo data
            LoadDemoNBAPlayers();
            Snackbar.Add($"Loaded {_nbaPlayers.Count} NBA players (demo mode)", Severity.Info);
        }
        catch (Exception ex)
        {
            LoadDemoNBAPlayers();
            Snackbar.Add($"Using demo data: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _isLoadingNBA = false;
        }
    }
    
    private void LoadDemoNBAPlayers()
    {
        var random = new Random();
        var allPlayers = new List<NBAPlayer>
        {
            CreateDemoNBAPlayer("LeBron James", "LAL", "SF", 25.4, 7.8, 7.1, random),
            CreateDemoNBAPlayer("Stephen Curry", "GSW", "PG", 28.2, 4.5, 5.8, random),
            CreateDemoNBAPlayer("Kevin Durant", "PHX", "SF", 27.1, 6.8, 5.2, random),
            CreateDemoNBAPlayer("Giannis Antetokounmpo", "MIL", "PF", 31.2, 11.9, 5.7, random),
            CreateDemoNBAPlayer("Luka Doncic", "DAL", "PG", 32.4, 8.8, 8.0, random),
            CreateDemoNBAPlayer("Shai Gilgeous-Alexander", "OKC", "PG", 31.1, 5.5, 6.2, random),
            CreateDemoNBAPlayer("Jayson Tatum", "BOS", "SF", 26.9, 8.1, 4.4, random),
            CreateDemoNBAPlayer("Joel Embiid", "PHI", "C", 33.1, 10.2, 4.2, random),
            CreateDemoNBAPlayer("Nikola Jokic", "DEN", "C", 26.4, 12.4, 9.0, random),
            CreateDemoNBAPlayer("Anthony Edwards", "MIN", "SG", 25.9, 5.4, 5.1, random),
        };
        
        // Apply search filter
        if (!string.IsNullOrEmpty(_nbaSelectedPlayer))
        {
            allPlayers = allPlayers.Where(p => 
                p.Name.Contains(_nbaSelectedPlayer, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        
        // Apply team filter
        if (!string.IsNullOrEmpty(_nbaSelectedTeam))
        {
            allPlayers = allPlayers.Where(p => p.Team == _nbaSelectedTeam).ToList();
        }
        
        _nbaPlayers = allPlayers;
    }
    
    private string GetString(Dictionary<string, JsonElement> dict, string key)
    {
        if (dict.TryGetValue(key, out var val) && val.ValueKind == JsonValueKind.String)
            return val.GetString() ?? "";
        return "";
    }
    
    private int GetInt(Dictionary<string, JsonElement> dict, string key)
    {
        if (dict.TryGetValue(key, out var val))
        {
            if (val.ValueKind == JsonValueKind.Number)
                return val.GetInt32();
        }
        return 0;
    }
    
    private double GetDouble(Dictionary<string, JsonElement> dict, string key)
    {
        if (dict.TryGetValue(key, out var val))
        {
            if (val.ValueKind == JsonValueKind.Number)
                return Math.Round(val.GetDouble(), 1);
        }
        return 0;
    }
    
    private NBAPlayer CreateDemoNBAPlayer(string name, string team, string pos, double ppg, double rpg, double apg, Random rand)
    {
        var games = 40;
        
        // Generate realistic game-by-game stats for dynamic hit rate calculation
        var gamePoints = Enumerable.Range(0, games).Select(_ => 
            (int)Math.Max(0, ppg + rand.Next(-12, 16))).ToList();
        var gameRebounds = Enumerable.Range(0, games).Select(_ => 
            (int)Math.Max(0, rpg + rand.Next(-4, 6))).ToList();
        var gameAssists = Enumerable.Range(0, games).Select(_ => 
            (int)Math.Max(0, apg + rand.Next(-4, 6))).ToList();
        var gameThrees = Enumerable.Range(0, games).Select(_ => 
            rand.Next(0, 6)).ToList();
        
        var last10 = gamePoints.TakeLast(10).ToList();
        
        return new NBAPlayer
        {
            Name = name,
            Team = team,
            Position = pos,
            GamesPlayed = games,
            PPG = ppg,
            RPG = rpg,
            APG = apg,
            FGPct = Math.Round(rand.NextDouble() * 15 + 42, 1),
            ThreePct = Math.Round(rand.NextDouble() * 15 + 32, 1),
            MPG = Math.Round(rand.NextDouble() * 8 + 30, 1),
            Last10Points = last10,
            GamePoints = gamePoints,
            GameRebounds = gameRebounds,
            GameAssists = gameAssists,
            GameThrees = gameThrees,
            PointsThreshold = 20,
            ReboundsThreshold = 6,
            AssistsThreshold = 5,
            ThreesThreshold = 2,
            Pts20HitRate = gamePoints.Count(p => p >= 20) * 100 / games,
            Pts25HitRate = gamePoints.Count(p => p >= 25) * 100 / games,
            Pts30HitRate = gamePoints.Count(p => p >= 30) * 100 / games
        };
    }
    
