    // Models
    private class NBAPlayer
    {
        public string Name { get; set; } = "";
        public string Team { get; set; } = "";
        public string Position { get; set; } = "";
        public int GamesPlayed { get; set; }
        public double PPG { get; set; }
        public double RPG { get; set; }
        public double APG { get; set; }
        public double FGPct { get; set; }
        public double ThreePct { get; set; }
        public double MPG { get; set; }
        public List<int> Last10Points { get; set; } = new();
        public bool IsExpanded { get; set; }
        
        // Game logs for real-time recalculation
        public List<int> GamePoints { get; set; } = new();
        public List<int> GameRebounds { get; set; } = new();
        public List<int> GameAssists { get; set; } = new();
        public List<int> GameThrees { get; set; } = new();
        
        // Thresholds (user adjustable)
        public int PointsThreshold { get; set; } = 20;
        public int ReboundsThreshold { get; set; } = 6;
        public int AssistsThreshold { get; set; } = 5;
        public int ThreesThreshold { get; set; } = 2;
        
        // Quick hit rates (static for display)
        public int Pts20HitRate { get; set; }
        public int Pts25HitRate { get; set; }
        public int Pts30HitRate { get; set; }
        
        // Dynamic hit counts based on threshold and game logs
        public int PointsHits => GamePoints.Count(p => p >= PointsThreshold);
        public int ReboundsHits => GameRebounds.Count(r => r >= ReboundsThreshold);
        public int AssistsHits => GameAssists.Count(a => a >= AssistsThreshold);
        public int ThreesHits => GameThrees.Count(t => t >= ThreesThreshold);
        
        // Computed hit rates - recalculate dynamically!
        public double PointsHitRate => GamePoints.Count > 0 ? Math.Round(PointsHits * 100.0 / GamePoints.Count, 0) : 0;
        public double ReboundsHitRate => GameRebounds.Count > 0 ? Math.Round(ReboundsHits * 100.0 / GameRebounds.Count, 0) : 0;
        public double AssistsHitRate => GameAssists.Count > 0 ? Math.Round(AssistsHits * 100.0 / GameAssists.Count, 0) : 0;
        public double ThreesHitRate => GameThrees.Count > 0 ? Math.Round(ThreesHits * 100.0 / GameThrees.Count, 0) : 0;
    }
    
