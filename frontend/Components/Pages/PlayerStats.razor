@page "/player-stats"
@rendermode InteractiveServer
@using System.Text.Json
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@using SportsBettingAnalyzer.Models
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Player Stats - Sports Betting Analyzer</PageTitle>

<TwContainer MaxWidth="extraLarge" Class="mt-8">
    <div class="space-y-6">
        <!-- Header -->
        <TwCard Class="p-6">
            <div class="flex items-center justify-between flex-wrap gap-4">
                <div class="flex items-center gap-4">
                    <div class="p-3 bg-blue-500/10 rounded-xl">
                        <svg class="w-8 h-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-slate-100">Player Stats & Hit Rates</h1>
                        <p class="text-slate-400">Analyze player performance with adjustable thresholds</p>
                    </div>
                </div>
            </div>
        </TwCard>
        
        <!-- Sport Tabs -->
        <TwTabs DefaultTab="0">
            <!-- NBA Tab -->
            <TwTabPanel Title="NBA" Icon="@GetSportsIcon("NBA")">
                <div class="space-y-6 pt-6">
                    <!-- Search & Filter Row -->
                    <TwCard Class="p-4">
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
                            <div class="md:col-span-4 relative">
                                <label class="block text-xs text-slate-500 mb-1 font-medium">Search Player</label>
                                <div class="relative">
                                    <input type="text"
                                           @bind="_nbaSearchTerm"
                                           @bind:event="oninput"
                                           @onkeyup="OnNbaSearchKeyUp"
                                           placeholder="LeBron James, Curry..."
                                           class="appearance-none bg-slate-800 text-sm text-slate-100 border border-slate-700 rounded-xl pl-4 pr-10 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition-all placeholder-slate-500 w-full" />
                                    <div class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                        </svg>
                                    </div>
                                    
                                    <!-- Custom Autocomplete Dropdown -->
                                    @if (_nbaSuggestions.Any())
                                    {
                                        <div class="absolute z-50 left-0 right-0 mt-2 bg-slate-800 border border-slate-700 rounded-xl shadow-xl overflow-hidden max-h-60 overflow-y-auto">
                                            @foreach (var suggestion in _nbaSuggestions)
                                            {
                                                <button class="w-full text-left px-4 py-2 hover:bg-slate-700 text-slate-200 transition-colors text-sm"
                                                        @onclick="() => SelectNbaPlayer(suggestion)">
                                                    @suggestion
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="md:col-span-3">
                                <TwSelect TValue="string" @bind-Value="_nbaSelectedTeam" Label="Team Filter" FullWidth="true">
                                    <option value="">All Teams</option>
                                    @foreach (var team in _nbaTeams)
                                    {
                                        <option value="@team">@team</option>
                                    }
                                </TwSelect>
                            </div>
                            <div class="md:col-span-2">
                                <TwButton Variant="solid" OnClick="LoadNBAPlayers" Disabled="@_isLoadingNBA" FullWidth="true">
                                    @if (_isLoadingNBA) { <span>Loading...</span> } else { <span>Load Stats</span> }
                                </TwButton>
                            </div>
                        </div>
                    </TwCard>
                    
                    <!-- Player Cards -->
                    @if (_nbaPlayers.Any())
                    {
                        @foreach (var player in _nbaPlayers)
                        {
                            <div class="border border-slate-700 rounded-xl overflow-hidden bg-slate-900/50">
                                <div class="p-4 cursor-pointer hover:bg-slate-800/50 transition-colors flex items-center justify-between"
                                     @onclick="() => player.IsExpanded = !player.IsExpanded">
                                    <div class="flex items-center gap-4">
                                        <TwAvatar Text="@player.Name.Substring(0, 1)" Size="md" Color="blue" />
                                        <div>
                                            <h3 class="text-lg font-bold text-slate-100">@player.Name</h3>
                                            <p class="text-sm text-slate-400">@player.Team • @player.Position</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <TwChip Color="blue" Size="sm" Variant="outline">@player.PPG PPG</TwChip>
                                        <TwChip Color="emerald" Size="sm" Variant="outline">@player.RPG RPG</TwChip>
                                        <TwChip Color="amber" Size="sm" Variant="outline">@player.APG APG</TwChip>
                                        <svg class="w-5 h-5 text-slate-500 transform transition-transform @(player.IsExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                        </svg>
                                    </div>
                                </div>
                                
                                @if (player.IsExpanded)
                                {
                                    <div class="p-4 border-t border-slate-700 bg-slate-900">
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                            <!-- Hit Rate Calculator -->
                                            <TwCard Class="p-4 h-full">
                                                <h4 class="text-md font-bold text-slate-100 mb-4 flex items-center gap-2">
                                                    <span>📈</span> Hit Rate Calculator
                                                </h4>
                                                
                                                <div class="space-y-6">
                                                    <!-- Points -->
                                                    <div>
                                                        <div class="flex items-center justify-between mb-2">
                                                            <span class="text-sm font-medium text-slate-300">Points</span>
                                                            <div class="flex items-center gap-2">
                                                                <button class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition-colors"
                                                                        @onclick="() => { player.PointsThreshold = Math.Max(1, player.PointsThreshold - 1); StateHasChanged(); }">-</button>
                                                                <input type="number" @bind="player.PointsThreshold" class="w-16 bg-slate-800 border-none rounded-lg text-center text-sm font-bold text-slate-100 py-1" />
                                                                <button class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition-colors"
                                                                        @onclick="() => { player.PointsThreshold++; StateHasChanged(); }">+</button>
                                                            </div>
                                                        </div>
                                                        <TwProgressBar Value="@player.PointsHitRate" Color="blue" Height="h-3" Label="@($"{player.PointsThreshold}+ pts: {player.PointsHitRate}% ({player.PointsHits}/{player.GamesPlayed})")" />
                                                    </div>

                                                    <!-- Rebounds -->
                                                    <div>
                                                        <div class="flex items-center justify-between mb-2">
                                                            <span class="text-sm font-medium text-slate-300">Rebounds</span>
                                                            <div class="flex items-center gap-2">
                                                                <button class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition-colors"
                                                                        @onclick="() => { player.ReboundsThreshold = Math.Max(1, player.ReboundsThreshold - 1); StateHasChanged(); }">-</button>
                                                                <input type="number" @bind="player.ReboundsThreshold" class="w-16 bg-slate-800 border-none rounded-lg text-center text-sm font-bold text-slate-100 py-1" />
                                                                <button class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition-colors"
                                                                        @onclick="() => { player.ReboundsThreshold++; StateHasChanged(); }">+</button>
                                                            </div>
                                                        </div>
                                                        <TwProgressBar Value="@player.ReboundsHitRate" Color="emerald" Height="h-3" Label="@($"{player.ReboundsThreshold}+ reb: {player.ReboundsHitRate}% ({player.ReboundsHits}/{player.GamesPlayed})")" />
                                                    </div>

                                                    <!-- Assists -->
                                                    <div>
                                                        <div class="flex items-center justify-between mb-2">
                                                            <span class="text-sm font-medium text-slate-300">Assists</span>
                                                            <div class="flex items-center gap-2">
                                                                <button class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition-colors"
                                                                        @onclick="() => { player.AssistsThreshold = Math.Max(1, player.AssistsThreshold - 1); StateHasChanged(); }">-</button>
                                                                <input type="number" @bind="player.AssistsThreshold" class="w-16 bg-slate-800 border-none rounded-lg text-center text-sm font-bold text-slate-100 py-1" />
                                                                <button class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition-colors"
                                                                        @onclick="() => { player.AssistsThreshold++; StateHasChanged(); }">+</button>
                                                            </div>
                                                        </div>
                                                        <TwProgressBar Value="@player.AssistsHitRate" Color="amber" Height="h-3" Label="@($"{player.AssistsThreshold}+ ast: {player.AssistsHitRate}% ({player.AssistsHits}/{player.GamesPlayed})")" />
                                                    </div>
                                                </div>
                                            </TwCard>

                                            <!-- Stats & Trends -->
                                            <TwCard Class="p-4 h-full">
                                                <h4 class="text-md font-bold text-slate-100 mb-4 flex items-center gap-2">
                                                    <span>📊</span> Season Stats
                                                </h4>
                                                <div class="overflow-x-auto mb-6">
                                                    <table class="w-full text-sm text-left text-slate-300">
                                                        <thead class="text-xs text-slate-500 uppercase bg-slate-800/50">
                                                            <tr>
                                                                <th class="px-2 py-2 rounded-l-lg">PPG</th>
                                                                <th class="px-2 py-2">RPG</th>
                                                                <th class="px-2 py-2">APG</th>
                                                                <th class="px-2 py-2">FG%</th>
                                                                <th class="px-2 py-2">3P%</th>
                                                                <th class="px-2 py-2 rounded-r-lg">MPG</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr class="border-b border-slate-800">
                                                                <td class="px-2 py-2 font-bold text-slate-100">@player.PPG</td>
                                                                <td class="px-2 py-2 font-bold text-slate-100">@player.RPG</td>
                                                                <td class="px-2 py-2 font-bold text-slate-100">@player.APG</td>
                                                                <td class="px-2 py-2">@player.FGPct%</td>
                                                                <td class="px-2 py-2">@player.ThreePct%</td>
                                                                <td class="px-2 py-2">@player.MPG</td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>

                                                <h4 class="text-md font-bold text-slate-100 mb-4 flex items-center gap-2">
                                                    <span>📉</span> Trend (Last 10)
                                                </h4>
                                                <div class="flex items-end gap-1 h-32 p-3 bg-slate-800/50 rounded-xl mb-4">
                                                    @foreach (var pts in player.Last10Points)
                                                    {
                                                        var height = Math.Min(100, Math.Max(10, pts * 2));
                                                        var isHit = pts >= player.PointsThreshold;
                                                        <div class="flex-1 rounded-t-sm transition-all duration-300 hover:opacity-80 relative group" 
                                                             style="height: @(height)%; background-color: @(isHit ? "#10b981" : "#ef4444")">
                                                            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-1 px-2 py-1 bg-slate-900 text-xs text-white rounded opacity-0 group-hover:opacity-100 whitespace-nowrap z-10 pointer-events-none">
                                                                @pts pts
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="flex justify-between text-xs text-slate-500 px-1">
                                                    <span>Oldest</span>
                                                    <span>Newest</span>
                                                </div>
                                            </TwCard>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (!_isLoadingNBA)
                    {
                        <TwAlert Severity="info">
                            Search for a player or click "Load Stats" to see player data with hit rates.
                        </TwAlert>
                    }
                </div>
            </TwTabPanel>

            <!-- NFL Tab -->
            <TwTabPanel Title="NFL" Icon="@GetSportsIcon("NFL")">
                <div class="space-y-6 pt-6">
                    <TwCard Class="p-4">
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
                            <div class="md:col-span-4 relative">
                                <label class="block text-xs text-slate-500 mb-1 font-medium">Search Player</label>
                                <div class="relative">
                                    <input type="text"
                                           @bind="_nflSearchTerm"
                                           @bind:event="oninput"
                                           @onkeyup="OnNflSearchKeyUp"
                                           placeholder="Patrick Mahomes..."
                                           class="appearance-none bg-slate-800 text-sm text-slate-100 border border-slate-700 rounded-xl pl-4 pr-10 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition-all placeholder-slate-500 w-full" />
                                    <!-- Simple autocomplete dropdown would go here similar to NBA -->
                                </div>
                            </div>
                            <div class="md:col-span-3">
                                <TwSelect TValue="string" @bind-Value="_nflSelectedPosition" Label="Position" FullWidth="true">
                                    <option value="">All Positions</option>
                                    <option value="QB">Quarterbacks</option>
                                    <option value="RB">Running Backs</option>
                                    <option value="WR">Wide Receivers</option>
                                    <option value="TE">Tight Ends</option>
                                </TwSelect>
                            </div>
                            <div class="md:col-span-2">
                                <TwButton Variant="solid" OnClick="LoadNFLPlayers" Disabled="@_isLoadingNFL" FullWidth="true">
                                    @if (_isLoadingNFL) { <span>Loading...</span> } else { <span>Load Stats</span> }
                                </TwButton>
                            </div>
                        </div>
                    </TwCard>

                    @if (_nflPlayers.Any())
                    {
                        @foreach (var player in _nflPlayers)
                        {
                            <div class="border border-slate-700 rounded-xl overflow-hidden bg-slate-900/50">
                                <div class="p-4 cursor-pointer hover:bg-slate-800/50 transition-colors flex items-center justify-between"
                                     @onclick="() => player.IsExpanded = !player.IsExpanded">
                                    <div class="flex items-center gap-4">
                                        <TwAvatar Text="@player.Name.Substring(0, 1)" Size="md" Color="emerald" />
                                        <div>
                                            <h3 class="text-lg font-bold text-slate-100">@player.Name</h3>
                                            <p class="text-sm text-slate-400">@player.Team • @player.Position</p>
                                        </div>
                                    </div>
                                    <!-- Chips based on position -->
                                    <div class="flex items-center gap-2">
                                        @if (player.Position == "QB") {
                                            <TwChip Color="blue" Size="sm" Variant="outline">@player.PassYards Pass Yds</TwChip>
                                            <TwChip Color="emerald" Size="sm" Variant="outline">@player.PassTD TDs</TwChip>
                                        } else if (player.Position == "RB") {
                                            <TwChip Color="blue" Size="sm" Variant="outline">@player.RushYards Rush Yds</TwChip>
                                        } else {
                                            <TwChip Color="blue" Size="sm" Variant="outline">@player.RecYards Rec Yds</TwChip>
                                            <TwChip Color="amber" Size="sm" Variant="outline">@player.Receptions Rec</TwChip>
                                        }
                                        <svg class="w-5 h-5 text-slate-500 transform transition-transform @(player.IsExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                        </svg>
                                    </div>
                                </div>
                                
                                @if (player.IsExpanded)
                                {
                                    <div class="p-4 border-t border-slate-700 bg-slate-900">
                                         <TwCard Class="p-4">
                                             <h4 class="text-md font-bold text-slate-100 mb-4">Season Stats</h4>
                                             <!-- Simple Table for NFL Stats -->
                                             <table class="w-full text-sm text-left text-slate-300">
                                                 <tbody>
                                                     @if (player.Position == "QB")
                                                     {
                                                         <tr class="border-b border-slate-800"><td class="py-2">Pass Yards</td><td class="py-2 font-bold text-slate-100">@player.PassYards</td></tr>
                                                         <tr class="border-b border-slate-800"><td class="py-2">Pass TDs</td><td class="py-2 font-bold text-slate-100">@player.PassTD</td></tr>
                                                     }
                                                     else if (player.Position == "RB")
                                                     {
                                                          <tr class="border-b border-slate-800"><td class="py-2">Rush Yards</td><td class="py-2 font-bold text-slate-100">@player.RushYards</td></tr>
                                                     }
                                                     else
                                                     {
                                                          <tr class="border-b border-slate-800"><td class="py-2">Rec Yards</td><td class="py-2 font-bold text-slate-100">@player.RecYards</td></tr>
                                                          <tr class="border-b border-slate-800"><td class="py-2">Receptions</td><td class="py-2 font-bold text-slate-100">@player.Receptions</td></tr>
                                                     }
                                                 </tbody>
                                             </table>
                                         </TwCard>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (!_isLoadingNFL)
                    {
                        <TwAlert Severity="info">
                            Select a position and click "Load Stats" to see NFL player data.
                        </TwAlert>
                    }
                </div>
            </TwTabPanel>

            <!-- NASCAR Tab -->
            <TwTabPanel Title="NASCAR" Icon="@GetSportsIcon("NASCAR")">
                 <div class="space-y-6 pt-6">
                    <TwCard Class="p-4">
                         <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
                              <div class="md:col-span-2">
                                <TwSelect TValue="string" @bind-Value="_nascarSeries" Label="Series" FullWidth="true">
                                    <option value="cup">Cup</option>
                                    <option value="xfinity">Xfinity</option>
                                    <option value="trucks">Trucks</option>
                                </TwSelect>
                            </div>
                            <div class="md:col-span-3">
                                 <div class="relative">
                                    <label class="block text-xs text-slate-500 mb-1 font-medium">Search Driver</label>
                                    <input type="text" @bind="_nascarDriverSearch" placeholder="Larson..." class="appearance-none bg-slate-800 text-sm text-slate-100 border border-slate-700 rounded-xl px-4 py-2.5 w-full focus:outline-none focus:ring-2 focus:ring-blue-500/50" />
                                </div>
                            </div>
                             <div class="md:col-span-3">
                                <TwSelect TValue="string" @bind-Value="_nascarTeam" Label="Team" FullWidth="true">
                                    <option value="">All Teams</option>
                                    @foreach(var t in _nascarTeams) { <option value="@t">@t</option> }
                                </TwSelect>
                            </div>
                             <div class="md:col-span-2">
                                <TwButton Variant="solid" OnClick="LoadNASCARDrivers" Disabled="@_isLoadingNASCAR" FullWidth="true">
                                    @if (_isLoadingNASCAR) { <span>Loading...</span> } else { <span>Load Stats</span> }
                                </TwButton>
                            </div>
                         </div>
                    </TwCard>
                    
                    @if (_nascarDrivers.Any())
                    {
                         @foreach (var driver in _nascarDrivers)
                        {
                            <div class="border border-slate-700 rounded-xl overflow-hidden bg-slate-900/50">
                                <div class="p-4 cursor-pointer hover:bg-slate-800/50 transition-colors flex items-center justify-between"
                                     @onclick="() => driver.IsExpanded = !driver.IsExpanded">
                                    <div class="flex items-center gap-4">
                                        <TwAvatar Text="@driver.Name.Substring(0, 1)" Size="md" Color="amber" />
                                        <div>
                                            <h3 class="text-lg font-bold text-slate-100">@driver.Name</h3>
                                            <p class="text-sm text-slate-400">@driver.Team</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <TwChip Color="emerald" Size="sm" Variant="outline">@driver.Wins Wins</TwChip>
                                        <TwChip Color="blue" Size="sm" Variant="outline">@driver.AvgFinish Avg</TwChip>
                                        <svg class="w-5 h-5 text-slate-500 transform transition-transform @(driver.IsExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                 </div>
            </TwTabPanel>
        </TwTabs>
    </div>
</TwContainer>

@code {
    // Custom Search State
    private string _nbaSearchTerm = "";
    private string _nflSearchTerm = "";
    private List<string> _nbaSuggestions = new();
    
    // Original State
    private int _activeSport = 0;
    
    // NBA State
    private bool _isLoadingNBA = false;
    private string _nbaSelectedPlayer = ""; // Kept for logic compatibility
    private string _nbaSelectedTeam = "";
    private List<NBAPlayer> _nbaPlayers = new();
    private List<string> _nbaTeams = new() {
        "LAL", "BOS", "GSW", "MIA", "MIL", "PHX", "DEN", "PHI", "DAL", "LAC",
        "ATL", "BKN", "CHI", "CLE", "DET", "HOU", "IND", "MEM", "MIN", "NOP",
        "NYK", "OKC", "ORL", "POR", "SAC", "SAS", "TOR", "UTA", "WAS", "CHA"
    };
    
    // NFL State
    private bool _isLoadingNFL = false;
    private string _nflSelectedPosition = "";
    private List<NFLPlayer> _nflPlayers = new();
    
    // NASCAR State
    private bool _isLoadingNASCAR = false;
    private string _nascarSeries = "cup";
    private string _nascarTeam = "";
    private string _nascarDriverSearch = "";
    private string _nascarTrackType = "";
    private List<NASCARDriver> _nascarDrivers = new();
    private NASCARTeamStats? _nascarTeamStats = null;
    private List<string> _nascarTeams = new() {
        "Hendrick Motorsports", "Joe Gibbs Racing", "Team Penske", "Stewart-Haas Racing",
        "23XI Racing", "Trackhouse Racing", "Richard Childress Racing", "JR Motorsports"
    };

    // Helper for icons
    private RenderFragment GetSportsIcon(string sport)
    {
        return sport switch
        {
            "NBA" => @<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>,
            "NFL" => @<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>,
            "NASCAR" => @<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>,
            _ => @<span />
        };
    }

    private async Task OnNbaSearchKeyUp(KeyboardEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(_nbaSearchTerm) || _nbaSearchTerm.Length < 2)
        {
            _nbaSuggestions.Clear();
            return;
        }

        // Debounce could be added here
        var results = await SearchNBAPlayers(_nbaSearchTerm, CancellationToken.None);
        _nbaSuggestions = results.ToList();
    }

    private void SelectNbaPlayer(string name)
    {
        _nbaSearchTerm = name;
        _nbaSelectedPlayer = name;
        _nbaSuggestions.Clear();
    }
    
