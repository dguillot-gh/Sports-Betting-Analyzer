                    <!-- Driver Cards -->
                    @if (_nascarDrivers.Any())
                    {
                        @foreach (var driver in _nascarDrivers)
                        {
                            <MudItem xs="12">
                                <MudExpansionPanels>
                                    <MudExpansionPanel @bind-IsExpanded="driver.IsExpanded">
                                        <TitleContent>
                                            <div class="d-flex align-center justify-space-between" style="width: 100%;">
                                                <div class="d-flex align-center">
                                                    <MudAvatar Color="Color.Warning" Size="Size.Medium" Class="mr-3">
                                                        @driver.Name.Split(' ').Last().Substring(0, 1)
                                                    </MudAvatar>
                                                    <div>
                                                        <MudText Typo="Typo.h6">@driver.Name</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@driver.Team</MudText>
                                                    </div>
                                                </div>
                                                <div class="d-flex" style="gap: 12px;">
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@driver.Wins Wins</MudChip>
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@driver.AvgFinish Avg</MudChip>
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">@driver.Top10Pct% Top10</MudChip>
                                                </div>
                                            </div>
                                        </TitleContent>
                                        <ChildContent>
                                            <MudDivider Class="mb-4" />
                                            <MudGrid Spacing="3">
                                                <!-- Hit Rate Calculator -->
                                                <MudItem xs="12" md="6">
                                                    <MudPaper Class="pa-4" Elevation="1">
                                                        <MudText Typo="Typo.h6" Class="mb-3">🏁 Finish Position Thresholds</MudText>
                                                        
                                                        <!-- Top N Finish Threshold -->
                                                        <div class="mb-4">
                                                            <div class="d-flex align-center justify-space-between mb-2">
                                                                <MudText Typo="Typo.subtitle2">Finish Position</MudText>
                                                                <div class="d-flex align-center" style="gap: 8px;">
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" 
                                                                                   OnClick="@(() => driver.FinishThreshold = Math.Max(1, driver.FinishThreshold - 1))" />
                                                                    <MudNumericField T="int" @bind-Value="driver.FinishThreshold" 
                                                                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                      Style="width: 70px;" Min="1" Max="40" />
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" 
                                                                                   OnClick="@(() => driver.FinishThreshold++)" />
                                                                </div>
                                                            </div>
                                                            <MudProgressLinear Value="@driver.FinishHitRate" Color="Color.Success" Size="Size.Large" Rounded="true" />
                                                            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-1">
                                                                Top @driver.FinishThreshold: <strong>@driver.FinishHitRate%</strong> (@driver.FinishHits/@driver.Races races)
                                                            </MudText>
                                                        </div>
                                                        
                                                        <!-- Laps Led Threshold -->
                                                        <div class="mb-4">
                                                            <div class="d-flex align-center justify-space-between mb-2">
                                                                <MudText Typo="Typo.subtitle2">Laps Led</MudText>
                                                                <div class="d-flex align-center" style="gap: 8px;">
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" 
                                                                                   OnClick="@(() => driver.LapsLedThreshold = Math.Max(1, driver.LapsLedThreshold - 5))" />
                                                                    <MudNumericField T="int" @bind-Value="driver.LapsLedThreshold" 
                                                                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                      Style="width: 70px;" Min="1" Max="200" Step="5" />
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" 
                                                                                   OnClick="@(() => driver.LapsLedThreshold += 5)" />
                                                                </div>
                                                            </div>
                                                            <MudProgressLinear Value="@driver.LapsLedHitRate" Color="Color.Warning" Size="Size.Large" Rounded="true" />
                                                            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-1">
                                                                @driver.LapsLedThreshold+ laps led: <strong>@driver.LapsLedHitRate%</strong>
                                                            </MudText>
                                                        </div>
                                                    </MudPaper>
                                                </MudItem>
                                                
                                                <!-- Season Stats & Quick Rates -->
                                                <MudItem xs="12" md="6">
                                                    <MudPaper Class="pa-4" Elevation="1">
                                                        <MudText Typo="Typo.h6" Class="mb-3">📊 Season Stats</MudText>
                                                        <MudSimpleTable Dense="true" Hover="true">
                                                            <tbody>
                                                                <tr><td>Races</td><td><strong>@driver.Races</strong></td></tr>
                                                                <tr><td>Wins</td><td><strong>@driver.Wins</strong></td></tr>
                                                                <tr><td>Avg Finish</td><td><strong>@driver.AvgFinish</strong></td></tr>
                                                                <tr><td>Avg Start</td><td>@driver.AvgStart</td></tr>
                                                                <tr><td>Laps Led</td><td>@driver.TotalLapsLed</td></tr>
                                                            </tbody>
                                                        </MudSimpleTable>
                                                        
                                                        <MudDivider Class="my-4" />
                                                        
                                                        <MudText Typo="Typo.h6" Class="mb-2">🎯 Quick Hit Rates</MudText>
                                                        <MudGrid Spacing="1">
                                                            <MudItem xs="4">
                                                                <MudPaper Class="pa-2 text-center" Elevation="0" Style="background: #E8F5E9;">
                                                                    <MudText Typo="Typo.overline">Top 5</MudText>
                                                                    <MudText Typo="Typo.h6" Color="Color.Success">@driver.Top5Pct%</MudText>
                                                                </MudPaper>
                                                            </MudItem>
                                                            <MudItem xs="4">
                                                                <MudPaper Class="pa-2 text-center" Elevation="0" Style="background: #E3F2FD;">
                                                                    <MudText Typo="Typo.overline">Top 10</MudText>
                                                                    <MudText Typo="Typo.h6" Color="Color.Primary">@driver.Top10Pct%</MudText>
                                                                </MudPaper>
                                                            </MudItem>
                                                            <MudItem xs="4">
                                                                <MudPaper Class="pa-2 text-center" Elevation="0" Style="background: #FFF3E0;">
                                                                    <MudText Typo="Typo.overline">Win Rate</MudText>
                                                                    <MudText Typo="Typo.h6" Color="Color.Warning">@driver.WinPct%</MudText>
                                                                </MudPaper>
                                                            </MudItem>
                                                        </MudGrid>
                                                    </MudPaper>
                                                </MudItem>
                                            </MudGrid>
                                        </ChildContent>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            </MudItem>
                        }
                    }
                    else if (!_isLoadingNASCAR)
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info">
                                Select filters and click "Load Stats" to see NASCAR driver data. 
                                Select a team to see team-level performance at specific tracks.
                            </MudAlert>
                        </MudItem>
                    }
                </MudGrid>
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudContainer>

@code {
