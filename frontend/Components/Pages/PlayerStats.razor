                                        </MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <div class="d-flex justify-end" style="gap: 24px;">
                                            <div class="text-center">
                                                <MudText Typo="Typo.h4">@_nascarTeamStats.WinPct%</MudText>
                                                <MudText Typo="Typo.caption">Win Rate</MudText>
                                            </div>
                                            <div class="text-center">
                                                <MudText Typo="Typo.h4">@_nascarTeamStats.Top5Pct%</MudText>
                                                <MudText Typo="Typo.caption">Top 5 Rate</MudText>
                                            </div>
                                            <div class="text-center">
                                                <MudText Typo="Typo.h4">@_nascarTeamStats.Top10Pct%</MudText>
                                                <MudText Typo="Typo.caption">Top 10 Rate</MudText>
                                            </div>
                                            <div class="text-center">
                                                <MudText Typo="Typo.h4">@_nascarTeamStats.TotalRaces</MudText>
                                                <MudText Typo="Typo.caption">Races</MudText>
                                            </div>
                                        </div>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
