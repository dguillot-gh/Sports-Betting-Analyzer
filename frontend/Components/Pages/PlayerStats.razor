                        <MudItem xs="12">
                            <MudPaper Class="pa-4" Elevation="2" Style="background: linear-gradient(135deg, #1e3a5f 0%, #2d5a87 100%); color: white;">
                                <MudGrid>
                                    <MudItem xs="12" md="6">
                                        <MudText Typo="Typo.h5">@_nascarTeam</MudText>
                                        <MudText Typo="Typo.caption" Style="opacity: 0.8;">
