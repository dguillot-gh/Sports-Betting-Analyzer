    private class NASCARDriver
    {
        public string Name { get; set; } = "";
        public string Team { get; set; } = "";
        public int Races { get; set; }
        public int Wins { get; set; }
        public int Top5 { get; set; }
        public int Top10 { get; set; }
        public double AvgFinish { get; set; }
        public double AvgStart { get; set; }
        public int TotalLapsLed { get; set; }
        public bool IsExpanded { get; set; }
        
        // Hit rate percentages
        public double WinPct { get; set; }
        public double Top5Pct { get; set; }
        public double Top10Pct { get; set; }
        
        // Thresholds (user adjustable)
        public int FinishThreshold { get; set; } = 10;
        public int LapsLedThreshold { get; set; } = 1;
        
        // Computed hit counts
        public int FinishHits { get; set; }
        public int LapsLedHits { get; set; }
        
        // Computed hit rates based on threshold
        public double FinishHitRate => Races > 0 ? Math.Round(FinishHits * 100.0 / Races, 0) : 0;
        public double LapsLedHitRate => Races > 0 ? Math.Round(LapsLedHits * 100.0 / Races, 0) : 0;
    }
    
