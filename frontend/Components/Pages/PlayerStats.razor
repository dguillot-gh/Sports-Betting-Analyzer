    // Original Logic Methods, adapted
    private async Task<IEnumerable<string>> SearchNBAPlayers(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value) || value.Length < 2)
            return Array.Empty<string>();
        
        try
        {
            var response = await Http.GetAsync($"http://backend:8000/stats/nba/players?search={Uri.EscapeDataString(value)}&limit=10");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var players = JsonSerializer.Deserialize<List<Dictionary<string, JsonElement>>>(json,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (players != null)
                {
                    // Helper function replacement
                    return players.Select(p => p.ContainsKey("name") ? p["name"].ToString() : "").Where(n => !string.IsNullOrEmpty(n));
                }
            }
        }
        catch { /* Fall back to demo data */ }
        
        var demoPlayers = new[] {
            "LeBron James", "Stephen Curry", "Kevin Durant", "Giannis Antetokounmpo",
            "Luka Doncic", "Nikola Jokic", "Joel Embiid", "Jayson Tatum", "Ja Morant"
        };
        return demoPlayers.Where(p => p.Contains(value, StringComparison.OrdinalIgnoreCase));
    }
    
