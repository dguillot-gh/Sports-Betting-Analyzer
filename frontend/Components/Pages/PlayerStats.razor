    private async Task<IEnumerable<string>> SearchNASCARTracks(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return _nascarTracks;
        
        return _nascarTracks.Where(t => t.Contains(value, StringComparison.OrdinalIgnoreCase));
    }
    
    private async Task<IEnumerable<string>> SearchNASCARDrivers(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return _nascarDriverNames;
        
        return _nascarDriverNames.Where(d => d.Contains(value, StringComparison.OrdinalIgnoreCase));
    }
    
    private async Task LoadNASCARDrivers()
    {
        _isLoadingNASCAR = true;
        _nascarTeamStats = null;
        StateHasChanged();
        
        try
        {
            // Build API URL with filters
            var url = $"http://backend:8000/stats/nascar/drivers?series={_nascarSeries}&limit=50";
            if (!string.IsNullOrEmpty(_nascarTeam))
                url += $"&team={Uri.EscapeDataString(_nascarTeam)}";
            if (!string.IsNullOrEmpty(_nascarDriverSearch))
                url += $"&search={Uri.EscapeDataString(_nascarDriverSearch)}";
            if (!string.IsNullOrEmpty(_nascarTrackType))
                url += $"&track_type={_nascarTrackType}";
            
            var response = await Http.GetAsync(url);
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var apiDrivers = JsonSerializer.Deserialize<List<Dictionary<string, JsonElement>>>(json, 
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                
                if (apiDrivers != null && apiDrivers.Any())
                {
                    _nascarDrivers = apiDrivers.Select(d => new NASCARDriver
                    {
                        Name = GetString(d, "name"),
                        Team = GetString(d, "team"),
                        Races = GetInt(d, "races"),
                        Wins = GetInt(d, "wins"),
                        Top5 = GetInt(d, "top5"),
                        Top10 = GetInt(d, "top10"),
                        AvgFinish = GetDouble(d, "avg_finish"),
                        AvgStart = GetDouble(d, "avg_start"),
                        TotalLapsLed = GetInt(d, "total_laps_led"),
                        WinPct = GetDouble(d, "win_pct"),
                        Top5Pct = GetDouble(d, "top5_pct"),
                        Top10Pct = GetDouble(d, "top10_pct"),
                        FinishThreshold = 10,
                        LapsLedThreshold = 1,
                        FinishHits = GetInt(d, "top10"),
                        LapsLedHits = GetInt(d, "races") / 3
                    }).Take(20).ToList();
                    
                    // Calculate team stats if team selected
                    if (!string.IsNullOrEmpty(_nascarTeam) && _nascarDrivers.Any())
                    {
                        var totalRaces = _nascarDrivers.Sum(d => d.Races);
                        _nascarTeamStats = new NASCARTeamStats
                        {
                            TotalRaces = totalRaces,
                            TotalWins = _nascarDrivers.Sum(d => d.Wins),
                            TotalTop5 = _nascarDrivers.Sum(d => d.Top5),
                            TotalTop10 = _nascarDrivers.Sum(d => d.Top10),
                            WinPct = totalRaces > 0 ? Math.Round(_nascarDrivers.Sum(d => d.Wins) * 100.0 / totalRaces, 1) : 0,
                            Top5Pct = totalRaces > 0 ? Math.Round(_nascarDrivers.Sum(d => d.Top5) * 100.0 / totalRaces, 1) : 0,
                            Top10Pct = totalRaces > 0 ? Math.Round(_nascarDrivers.Sum(d => d.Top10) * 100.0 / totalRaces, 1) : 0
                        };
                    }
                    
                    Snackbar.Add($"Loaded {_nascarDrivers.Count} NASCAR drivers from API", Severity.Success);
                    return;
                }
            }
            
            // Fallback to demo
            LoadDemoNASCARDrivers();
            Snackbar.Add($"Loaded {_nascarDrivers.Count} NASCAR drivers (demo mode)", Severity.Info);
        }
        catch (Exception ex)
        {
            LoadDemoNASCARDrivers();
            Snackbar.Add($"Using demo data: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _isLoadingNASCAR = false;
        }
    }
    
