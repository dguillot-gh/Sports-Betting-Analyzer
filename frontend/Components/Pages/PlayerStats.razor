@page "/player-stats"
@rendermode InteractiveServer
@using MudBlazor
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Player Stats - Sports Betting Analyzer</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex align-center justify-space-between flex-wrap" style="gap: 16px;">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.QueryStats" Size="Size.Large" Color="Color.Primary" Class="mr-3" />
                    <div>
                        <MudText Typo="Typo.h5">Player Stats & Hit Rates</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Analyze player performance with adjustable thresholds</MudText>
                    </div>
                </div>
            </div>
        </MudPaper>
        
        <!-- Sport Tabs -->
        <MudTabs @bind-ActivePanelIndex="_activeSport" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
            
            <!-- NBA Tab -->
            <MudTabPanel Text="NBA" Icon="@Icons.Material.Filled.SportsBasketball">
                <MudGrid Spacing="3">
                    <!-- Search & Filter Row -->
                    <MudItem xs="12">
                        <MudPaper Class="pa-3" Elevation="1">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="4">
                                    <MudAutocomplete T="string" @bind-Value="_nbaSelectedPlayer" Label="Search Player" 
                                                     SearchFunc="@SearchNBAPlayers" Variant="Variant.Outlined" Dense="true"
                                                     AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary" />
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudSelect T="string" @bind-Value="_nbaSelectedTeam" Label="Team Filter" 
                                               Variant="Variant.Outlined" Dense="true" Clearable="true">
                                        <MudSelectItem Value="@((string)null)">All Teams</MudSelectItem>
                                        @foreach (var team in _nbaTeams)
                                        {
                                            <MudSelectItem Value="@team">@team</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadNBAPlayers"
                                               Disabled="@_isLoadingNBA" FullWidth="true" Size="Size.Large">
                                        @if (_isLoadingNBA) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                                        Load Stats
                                    </MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>
                    
                    <!-- Player Cards -->
                    @if (_nbaPlayers.Any())
                    {
                        @foreach (var player in _nbaPlayers)
                        {
                            <MudItem xs="12">
                                <MudExpansionPanels>
                                    <MudExpansionPanel @bind-IsExpanded="player.IsExpanded">
                                        <TitleContent>
                                            <div class="d-flex align-center justify-space-between" style="width: 100%;">
                                                <div class="d-flex align-center">
                                                    <MudAvatar Color="Color.Primary" Size="Size.Medium" Class="mr-3">
                                                        @player.Name.Substring(0, 1)
                                                    </MudAvatar>
                                                    <div>
                                                        <MudText Typo="Typo.h6">@player.Name</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@player.Team • @player.Position</MudText>
                                                    </div>
                                                </div>
                                                <div class="d-flex" style="gap: 16px;">
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@player.PPG PPG</MudChip>
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@player.RPG RPG</MudChip>
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">@player.APG APG</MudChip>
                                                </div>
                                            </div>
                                        </TitleContent>
                                        <ChildContent>
                                            <MudDivider Class="mb-4" />
                                            <MudGrid Spacing="3">
                                                <!-- Hit Rate Calculator -->
                                                <MudItem xs="12" md="6">
                                                    <MudPaper Class="pa-4" Elevation="1">
                                                        <MudText Typo="Typo.h6" Class="mb-3">📈 Hit Rate Calculator</MudText>
                                                        
                                                        <!-- Points Threshold -->
                                                        <div class="mb-4">
                                                            <div class="d-flex align-center justify-space-between mb-2">
                                                                <MudText Typo="Typo.subtitle2">Points</MudText>
                                                                <div class="d-flex align-center" style="gap: 8px;">
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" 
                                                                                   OnClick="@(() => player.PointsThreshold = Math.Max(1, player.PointsThreshold - 1))" />
                                                                    <MudNumericField T="int" @bind-Value="player.PointsThreshold" 
                                                                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                      Style="width: 70px;" Min="1" Max="60" />
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" 
                                                                                   OnClick="@(() => player.PointsThreshold++)" />
                                                                </div>
                                                            </div>
                                                            <MudProgressLinear Value="@player.PointsHitRate" Color="Color.Primary" Size="Size.Large" Rounded="true" />
                                                            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-1">
                                                                @player.PointsThreshold+ pts: <strong>@player.PointsHitRate%</strong> (@player.PointsHits/@player.GamesPlayed games)
                                                            </MudText>
                                                        </div>
                                                        
                                                        <!-- Rebounds Threshold -->
                                                        <div class="mb-4">
                                                            <div class="d-flex align-center justify-space-between mb-2">
                                                                <MudText Typo="Typo.subtitle2">Rebounds</MudText>
                                                                <div class="d-flex align-center" style="gap: 8px;">
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" 
                                                                                   OnClick="@(() => player.ReboundsThreshold = Math.Max(1, player.ReboundsThreshold - 1))" />
                                                                    <MudNumericField T="int" @bind-Value="player.ReboundsThreshold" 
                                                                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                      Style="width: 70px;" Min="1" Max="30" />
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" 
                                                                                   OnClick="@(() => player.ReboundsThreshold++)" />
                                                                </div>
                                                            </div>
                                                            <MudProgressLinear Value="@player.ReboundsHitRate" Color="Color.Success" Size="Size.Large" Rounded="true" />
                                                            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-1">
                                                                @player.ReboundsThreshold+ reb: <strong>@player.ReboundsHitRate%</strong> (@player.ReboundsHits/@player.GamesPlayed games)
                                                            </MudText>
                                                        </div>
                                                        
                                                        <!-- Assists Threshold -->
                                                        <div class="mb-4">
                                                            <div class="d-flex align-center justify-space-between mb-2">
                                                                <MudText Typo="Typo.subtitle2">Assists</MudText>
                                                                <div class="d-flex align-center" style="gap: 8px;">
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" 
                                                                                   OnClick="@(() => player.AssistsThreshold = Math.Max(1, player.AssistsThreshold - 1))" />
                                                                    <MudNumericField T="int" @bind-Value="player.AssistsThreshold" 
                                                                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                      Style="width: 70px;" Min="1" Max="20" />
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" 
                                                                                   OnClick="@(() => player.AssistsThreshold++)" />
                                                                </div>
                                                            </div>
                                                            <MudProgressLinear Value="@player.AssistsHitRate" Color="Color.Warning" Size="Size.Large" Rounded="true" />
                                                            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-1">
                                                                @player.AssistsThreshold+ ast: <strong>@player.AssistsHitRate%</strong> (@player.AssistsHits/@player.GamesPlayed games)
                                                            </MudText>
                                                        </div>
                                                        
                                                        <!-- 3-Pointers Threshold -->
                                                        <div>
                                                            <div class="d-flex align-center justify-space-between mb-2">
                                                                <MudText Typo="Typo.subtitle2">3-Pointers Made</MudText>
                                                                <div class="d-flex align-center" style="gap: 8px;">
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" 
                                                                                   OnClick="@(() => player.ThreesThreshold = Math.Max(1, player.ThreesThreshold - 1))" />
                                                                    <MudNumericField T="int" @bind-Value="player.ThreesThreshold" 
                                                                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                      Style="width: 70px;" Min="1" Max="15" />
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" 
                                                                                   OnClick="@(() => player.ThreesThreshold++)" />
                                                                </div>
                                                            </div>
                                                            <MudProgressLinear Value="@player.ThreesHitRate" Color="Color.Secondary" Size="Size.Large" Rounded="true" />
                                                            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-1">
                                                                @player.ThreesThreshold+ 3PM: <strong>@player.ThreesHitRate%</strong> (@player.ThreesHits/@player.GamesPlayed games)
                                                            </MudText>
                                                        </div>
                                                    </MudPaper>
                                                </MudItem>
                                                
                                                <!-- Season Stats & Trend Chart -->
                                                <MudItem xs="12" md="6">
                                                    <MudPaper Class="pa-4" Elevation="1">
                                                        <MudText Typo="Typo.h6" Class="mb-3">📊 Season Averages</MudText>
                                                        <MudSimpleTable Dense="true" Hover="true">
                                                            <thead>
                                                                <tr>
                                                                    <th>PPG</th><th>RPG</th><th>APG</th><th>FG%</th><th>3P%</th><th>MPG</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr>
                                                                    <td><strong>@player.PPG</strong></td>
                                                                    <td><strong>@player.RPG</strong></td>
                                                                    <td><strong>@player.APG</strong></td>
                                                                    <td>@player.FGPct%</td>
                                                                    <td>@player.ThreePct%</td>
                                                                    <td>@player.MPG</td>
                                                                </tr>
                                                            </tbody>
                                                        </MudSimpleTable>
                                                        
                                                        <MudDivider Class="my-4" />
                                                        
                                                        <MudText Typo="Typo.h6" Class="mb-3">📉 Last 10 Games Trend</MudText>
                                                        <div style="display: flex; align-items: end; gap: 4px; height: 120px; padding: 10px; background: #f5f5f5; border-radius: 8px;">
                                                            @foreach (var pts in player.Last10Points)
                                                            {
                                                                var height = Math.Max(10, pts * 3);
                                                                var color = pts >= player.PointsThreshold ? "#4CAF50" : "#F44336";
                                                                <div style="flex: 1; height: @(height)px; background: @color; border-radius: 2px;" 
                                                                     title="@pts points"></div>
                                                            }
                                                        </div>
                                                        <div class="d-flex justify-space-between mt-1">
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">10 games ago</MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Most recent</MudText>
                                                        </div>
                                                        
                                                        <MudDivider Class="my-4" />
                                                        
                                                        <MudText Typo="Typo.h6" Class="mb-2">🎯 Quick Hit Rates</MudText>
                                                        <MudGrid Spacing="1">
                                                            <MudItem xs="4">
                                                                <MudPaper Class="pa-2 text-center" Elevation="0" Style="background: #E3F2FD;">
                                                                    <MudText Typo="Typo.overline">20+ PTS</MudText>
                                                                    <MudText Typo="Typo.h6" Color="Color.Primary">@player.Pts20HitRate%</MudText>
                                                                </MudPaper>
                                                            </MudItem>
                                                            <MudItem xs="4">
                                                                <MudPaper Class="pa-2 text-center" Elevation="0" Style="background: #E8F5E9;">
                                                                    <MudText Typo="Typo.overline">25+ PTS</MudText>
                                                                    <MudText Typo="Typo.h6" Color="Color.Success">@player.Pts25HitRate%</MudText>
                                                                </MudPaper>
                                                            </MudItem>
                                                            <MudItem xs="4">
                                                                <MudPaper Class="pa-2 text-center" Elevation="0" Style="background: #FFF3E0;">
                                                                    <MudText Typo="Typo.overline">30+ PTS</MudText>
                                                                    <MudText Typo="Typo.h6" Color="Color.Warning">@player.Pts30HitRate%</MudText>
                                                                </MudPaper>
                                                            </MudItem>
                                                        </MudGrid>
                                                    </MudPaper>
                                                </MudItem>
                                            </MudGrid>
                                        </ChildContent>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            </MudItem>
                        }
                    }
                    else if (!_isLoadingNBA)
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info">
                                Search for a player or click "Load Stats" to see player data with hit rates.
                            </MudAlert>
                        </MudItem>
                    }
                </MudGrid>
            </MudTabPanel>
            
            <!-- NFL Tab -->
            <MudTabPanel Text="NFL" Icon="@Icons.Material.Filled.SportsFootball">
                <MudGrid Spacing="3">
                    <MudItem xs="12">
                        <MudPaper Class="pa-3" Elevation="1">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="4">
                                    <MudAutocomplete T="string" @bind-Value="_nflSelectedPlayer" Label="Search Player" 
                                                     SearchFunc="@SearchNFLPlayers" Variant="Variant.Outlined" Dense="true"
                                                     AdornmentIcon="@Icons.Material.Filled.Search" />
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudSelect T="string" @bind-Value="_nflSelectedPosition" Label="Position" 
                                               Variant="Variant.Outlined" Dense="true" Clearable="true">
                                        <MudSelectItem Value="@((string)null)">All Positions</MudSelectItem>
                                        <MudSelectItem Value="@("QB")">Quarterbacks</MudSelectItem>
                                        <MudSelectItem Value="@("RB")">Running Backs</MudSelectItem>
                                        <MudSelectItem Value="@("WR")">Wide Receivers</MudSelectItem>
                                        <MudSelectItem Value="@("TE")">Tight Ends</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadNFLPlayers"
                                               Disabled="@_isLoadingNFL" FullWidth="true" Size="Size.Large">
                                        @if (_isLoadingNFL) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                                        Load Stats
                                    </MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>
                    
                    @if (_nflPlayers.Any())
                    {
                        @foreach (var player in _nflPlayers)
                        {
                            <MudItem xs="12">
                                <MudExpansionPanels>
                                    <MudExpansionPanel>
                                        <TitleContent>
                                            <div class="d-flex align-center justify-space-between" style="width: 100%;">
                                                <div class="d-flex align-center">
                                                    <MudAvatar Color="Color.Success" Size="Size.Medium" Class="mr-3">
                                                        @player.Name.Substring(0, 1)
                                                    </MudAvatar>
                                                    <div>
                                                        <MudText Typo="Typo.h6">@player.Name</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@player.Team • @player.Position</MudText>
                                                    </div>
                                                </div>
                                                <div class="d-flex" style="gap: 8px;">
                                                    @if (player.Position == "QB")
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@player.PassYards Pass Yds</MudChip>
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Success">@player.PassTD TDs</MudChip>
                                                    }
                                                    else if (player.Position == "RB")
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@player.RushYards Rush Yds</MudChip>
                                                    }
                                                    else
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@player.RecYards Rec Yds</MudChip>
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">@player.Receptions Rec</MudChip>
                                                    }
                                                </div>
                                            </div>
                                        </TitleContent>
                                        <ChildContent>
                                            <MudDivider Class="mb-4" />
                                            <MudGrid Spacing="3">
                                                <MudItem xs="12" md="6">
                                                    <MudPaper Class="pa-4" Elevation="1">
                                                        <MudText Typo="Typo.h6" Class="mb-3">📈 Hit Rate Calculator</MudText>
                                                        
                                                        @if (player.Position == "QB")
                                                        {
                                                            <!-- Passing Yards -->
                                                            <div class="mb-4">
                                                                <div class="d-flex align-center justify-space-between mb-2">
                                                                    <MudText Typo="Typo.subtitle2">Passing Yards</MudText>
                                                                    <div class="d-flex align-center" style="gap: 8px;">
                                                                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" 
                                                                                       OnClick="@(() => player.PassYardsThreshold = Math.Max(100, player.PassYardsThreshold - 25))" />
                                                                        <MudNumericField T="int" @bind-Value="player.PassYardsThreshold" 
                                                                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                          Style="width: 80px;" Min="100" Max="500" Step="25" />
                                                                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" 
                                                                                       OnClick="@(() => player.PassYardsThreshold += 25)" />
                                                                    </div>
                                                                </div>
                                                                <MudProgressLinear Value="@player.PassYardsHitRate" Color="Color.Primary" Size="Size.Large" Rounded="true" />
                                                                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-1">
                                                                    @player.PassYardsThreshold+ yds: <strong>@player.PassYardsHitRate%</strong>
                                                                </MudText>
                                                            </div>
                                                        }
                                                        else if (player.Position == "RB")
                                                        {
                                                            <!-- Rushing Yards -->
                                                            <div class="mb-4">
                                                                <div class="d-flex align-center justify-space-between mb-2">
                                                                    <MudText Typo="Typo.subtitle2">Rushing Yards</MudText>
                                                                    <div class="d-flex align-center" style="gap: 8px;">
                                                                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" 
                                                                                       OnClick="@(() => player.RushYardsThreshold = Math.Max(25, player.RushYardsThreshold - 10))" />
                                                                        <MudNumericField T="int" @bind-Value="player.RushYardsThreshold" 
                                                                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                          Style="width: 80px;" Min="25" Max="200" Step="10" />
                                                                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" 
                                                                                       OnClick="@(() => player.RushYardsThreshold += 10)" />
                                                                    </div>
                                                                </div>
                                                                <MudProgressLinear Value="@player.RushYardsHitRate" Color="Color.Success" Size="Size.Large" Rounded="true" />
                                                                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-1">
                                                                    @player.RushYardsThreshold+ yds: <strong>@player.RushYardsHitRate%</strong>
                                                                </MudText>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <!-- Receiving Yards -->
                                                            <div class="mb-4">
                                                                <div class="d-flex align-center justify-space-between mb-2">
                                                                    <MudText Typo="Typo.subtitle2">Receiving Yards</MudText>
                                                                    <div class="d-flex align-center" style="gap: 8px;">
                                                                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" 
                                                                                       OnClick="@(() => player.RecYardsThreshold = Math.Max(20, player.RecYardsThreshold - 10))" />
                                                                        <MudNumericField T="int" @bind-Value="player.RecYardsThreshold" 
                                                                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                          Style="width: 80px;" Min="20" Max="200" Step="10" />
                                                                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" 
                                                                                       OnClick="@(() => player.RecYardsThreshold += 10)" />
                                                                    </div>
                                                                </div>
                                                                <MudProgressLinear Value="@player.RecYardsHitRate" Color="Color.Warning" Size="Size.Large" Rounded="true" />
                                                                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-1">
                                                                    @player.RecYardsThreshold+ yds: <strong>@player.RecYardsHitRate%</strong>
                                                                </MudText>
                                                            </div>
                                                            
                                                            <!-- Receptions -->
                                                            <div>
                                                                <div class="d-flex align-center justify-space-between mb-2">
                                                                    <MudText Typo="Typo.subtitle2">Receptions</MudText>
                                                                    <div class="d-flex align-center" style="gap: 8px;">
                                                                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" 
                                                                                       OnClick="@(() => player.ReceptionsThreshold = Math.Max(1, player.ReceptionsThreshold - 1))" />
                                                                        <MudNumericField T="int" @bind-Value="player.ReceptionsThreshold" 
                                                                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                          Style="width: 70px;" Min="1" Max="15" />
                                                                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" 
                                                                                       OnClick="@(() => player.ReceptionsThreshold++)" />
                                                                    </div>
                                                                </div>
                                                                <MudProgressLinear Value="@player.ReceptionsHitRate" Color="Color.Info" Size="Size.Large" Rounded="true" />
                                                                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-1">
                                                                    @player.ReceptionsThreshold+ rec: <strong>@player.ReceptionsHitRate%</strong>
                                                                </MudText>
                                                            </div>
                                                        }
                                                    </MudPaper>
                                                </MudItem>
                                                
                                                <MudItem xs="12" md="6">
                                                    <MudPaper Class="pa-4" Elevation="1">
                                                        <MudText Typo="Typo.h6" Class="mb-3">📊 Season Stats</MudText>
                                                        <MudSimpleTable Dense="true" Hover="true">
                                                            <tbody>
                                                                @if (player.Position == "QB")
                                                                {
                                                                    <tr><td>Pass Yards</td><td><strong>@player.PassYards</strong></td></tr>
                                                                    <tr><td>Pass TDs</td><td><strong>@player.PassTD</strong></td></tr>
                                                                    <tr><td>Completion %</td><td>@player.CompPct%</td></tr>
                                                                    <tr><td>Interceptions</td><td>@player.Interceptions</td></tr>
                                                                }
                                                                else if (player.Position == "RB")
                                                                {
                                                                    <tr><td>Rush Yards</td><td><strong>@player.RushYards</strong></td></tr>
                                                                    <tr><td>Rush TDs</td><td><strong>@player.RushTD</strong></td></tr>
                                                                    <tr><td>YPC</td><td>@player.YPC</td></tr>
                                                                    <tr><td>Receptions</td><td>@player.Receptions</td></tr>
                                                                }
                                                                else
                                                                {
                                                                    <tr><td>Rec Yards</td><td><strong>@player.RecYards</strong></td></tr>
                                                                    <tr><td>Receptions</td><td><strong>@player.Receptions</strong></td></tr>
                                                                    <tr><td>Rec TDs</td><td>@player.RecTD</td></tr>
                                                                    <tr><td>Targets</td><td>@player.Targets</td></tr>
                                                                }
                                                            </tbody>
                                                        </MudSimpleTable>
                                                    </MudPaper>
                                                </MudItem>
                                            </MudGrid>
                                        </ChildContent>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            </MudItem>
                        }
                    }
                    else if (!_isLoadingNFL)
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info">
                                Select a position and click "Load Stats" to see NFL player data.
                            </MudAlert>
                        </MudItem>
                    }
                </MudGrid>
            </MudTabPanel>
            
            <!-- NASCAR Tab -->
            <MudTabPanel Text="NASCAR" Icon="@Icons.Material.Filled.SportsMotorsports">
