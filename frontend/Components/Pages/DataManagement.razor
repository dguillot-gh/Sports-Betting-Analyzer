    private void OpenBaseballImportDialog()
    {
        _showBaseballImportDialog = true;
    }
    
    private void CloseBaseballImportDialog()
    {
        _showBaseballImportDialog = false;
        _isBaseballImporting = false;
        _baseballPollTimer?.Dispose();
        _baseballPollTimer = null;
    }
    
    private async Task StartBaseballImport()
    {
        _isBaseballImporting = true;
        _baseballStatus = new BaseballImportStatus { Status = "running", Message = "Starting import..." };
        StateHasChanged();
        
        try
        {
            using var http = HttpClientFactory.CreateClient("PythonML");
            http.Timeout = TimeSpan.FromMinutes(10);
            
            // Start polling for status
            _baseballPollTimer = new System.Threading.Timer(
                async _ => await PollBaseballStatus(),
                null,
                TimeSpan.FromSeconds(1),
                TimeSpan.FromSeconds(2)
            );
            
            var response = await http.PostAsync($"/db/import/college-baseball?division={_baseballDivision}&start_year={_baseballYear}&end_year={_baseballYear}&source={_baseballSource}", null);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BaseballImportSummary>();
                _baseballSummary = result;
                _baseballStatus = new BaseballImportStatus { Status = "completed", Message = "Import complete!" };
                Snackbar.Add($"College baseball {(_baseballDivision == 0 ? "All Divisions" : $"D{_baseballDivision}")} import complete!", Severity.Success);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _baseballStatus = new BaseballImportStatus { Status = "error", Message = error };
            }
        }
        catch (Exception ex)
        {
            _baseballStatus = new BaseballImportStatus { Status = "error", Message = ex.Message };
            Logger.LogError(ex, "Error importing college baseball");
        }
        finally
        {
            StateHasChanged();
        }
    }
    
    private async Task PollBaseballStatus()
    {
        try
        {
            using var http = HttpClientFactory.CreateClient("PythonML");
            http.Timeout = TimeSpan.FromSeconds(5);
            
            var status = await http.GetFromJsonAsync<BaseballImportStatus>("/db/import/college-baseball/status");
            if (status != null)
            {
                _baseballStatus = status;
                await InvokeAsync(StateHasChanged);
                
                // Stop polling when complete or error/failed
                if (status.Status == "completed" || status.Status == "error" || status.Status == "failed")
                {
                    _baseballPollTimer?.Dispose();
                    _baseballPollTimer = null;
                    
                    if (status.Status == "completed")
                    {
                        await InvokeAsync(async () => {
                            await LoadStatus();
                            await LoadBaseballSummary();
                        });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error polling baseball import status");
        }
    }
    
