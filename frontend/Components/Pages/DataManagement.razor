@page "/data-management"
@using SportsBettingAnalyzer.Services
@inject PythonMLServiceClient MLClient
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject ILogger<DataManagement> Logger
@rendermode InteractiveServer

<PageTitle>Data Management</PageTitle>

<TwContainer MaxWidth="extraLarge" Class="mt-8 px-4">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white">Data Management</h1>
            <p class="text-slate-400 mt-1">Manage data sources, check for updates, and retrain models.</p>
        </div>
        <TwButton Variant="primary" OnClick="LoadStatus" IsLoading="_isLoading" Disabled="_isLoading">
            <PrefixContent><TwIcon Icon="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" Class="w-4 h-4" /></PrefixContent>
            Refresh Status
        </TwButton>
    </div>

    @if (_isLoading)
    {
        <div class="mb-6">
            <TwProgressBar Value="100" IsIndeterminate="true" Color="blue" />
        </div>
    }

    <TwGrid Columns="1" md="2" lg="3" Gap="6" Class="mb-8">
        <!-- NASCAR Card -->
        <TwCard Class="p-5 flex flex-col h-full bg-slate-900 border-slate-800">
            <div class="flex items-center gap-4 mb-6">
                <div class="bg-red-500/20 p-3 rounded-xl">
                    <TwIcon Icon="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" Class="w-6 h-6 text-red-400" />
                </div>
                <div>
                    <h3 class="text-xl font-bold text-white">NASCAR</h3>
                    <p class="text-xs text-slate-500">nascaR.data (GitHub)</p>
                </div>
            </div>

            <div class="flex-grow">
                @if (_dataStatus?.Nascar != null)
                {
                    <div class="space-y-4">
                        <div class="flex items-center gap-2 text-sm text-slate-300">
                            <TwIcon Icon="M4 7v10c0 1.1.9 2 2 2h12a2 2 0 002-2V7a2 2 0 00-2-2H6a2 2 0 00-2 2z" Class="w-4 h-4 text-slate-500" />
                            Files: <span class="font-semibold ml-auto text-white">@GetFileCount(_dataStatus.Nascar.Files)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(_dataStatus.Nascar.LastCommit))
                        {
                            <div class="flex items-center gap-2 text-sm text-slate-300">
                                <TwIcon Icon="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-4 h-4 text-slate-500" />
                                Last Commit: <span class="font-semibold ml-auto text-white">@FormatDate(_dataStatus.Nascar.LastCommit)</span>
                            </div>
                        }
                        
                        <div class="border-t border-slate-800 my-4"></div>
                        
                        <div class="flex items-center gap-2 text-sm text-slate-300">
                            <TwIcon Icon="M9.663 17h4.674a1 1 0 00.908-.588l3.333-6.666A1 1 0 0017.671 8h-4.674a1 1 0 00-.908.588l-3.333 6.666A1 1 0 009.663 17z" Class="w-4 h-4 text-slate-500" />
                            Models: <span class="font-semibold text-white ml-auto">@_dataStatus.Nascar.Models</span>
                            @if (_dataStatus.Nascar.ModelAccuracy.HasValue)
                            {
                                <TwChip Color="emerald" Size="sm" Class="ml-2">
                                    @((_dataStatus.Nascar.ModelAccuracy.Value * 100).ToString("F1"))% acc
                                </TwChip>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="grid grid-cols-2 gap-2 mt-6">
                <TwButton Variant="primary" Size="sm" OnClick="@(() => UpdateData("nascar"))" Disabled="@_isUpdating">
                    <PrefixContent><TwIcon Icon="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" Class="w-4 h-4" /></PrefixContent>
                    Update
                </TwButton>
                <TwButton Variant="secondary" Size="sm" OnClick="@(() => EnhanceData("nascar"))" Disabled="@_isUpdating">
                    <PrefixContent><TwIcon Icon="M13 10V3L4 14h7v7l9-11h-7z" Class="w-4 h-4" /></PrefixContent>
                    Enhance
                </TwButton>
                <TwButton Variant="outline" Size="sm" OnClick="@(() => RetrainModel("nascar"))" Disabled="@_isUpdating">
                    <PrefixContent><TwIcon Icon="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0-4V4" Class="w-4 h-4" /></PrefixContent>
                    Train
                </TwButton>
                <TwButton Variant="outline" Size="sm" OnClick="@OpenRdaImportDialog" Disabled="@(_isUpdating || _isRdaImporting)" Color="amber">
                    <PrefixContent><TwIcon Icon="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z" Class="w-4 h-4" /></PrefixContent>
                    Import RDA
                </TwButton>
            </div>
        </TwCard>

        <!-- NFL Card -->
        <TwCard Class="p-5 flex flex-col h-full bg-slate-900 border-slate-800">
            <div class="flex items-center gap-4 mb-6">
                <div class="bg-emerald-500/20 p-3 rounded-xl">
                    <TwIcon Icon="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" Class="w-6 h-6 text-emerald-400" />
                </div>
                <div>
                    <h3 class="text-xl font-bold text-white">NFL</h3>
                    <p class="text-xs text-slate-500">NFLverse Data</p>
                </div>
            </div>

            <div class="flex-grow">
                @if (_dataStatus?.Nfl != null)
                {
                    <div class="space-y-4">
                        <div class="flex items-center gap-2 text-sm text-slate-300">
                            <TwIcon Icon="M4 7v10c0 1.1.9 2 2 2h12a2 2 0 002-2V7a2 2 0 00-2-2H6a2 2 0 00-2 2z" Class="w-4 h-4 text-slate-500" />
                            Files: <span class="font-semibold ml-auto text-white">@GetFileCount(_dataStatus.Nfl.Files)</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm text-slate-300">
                            <TwIcon Icon="M9.663 17h4.674a1 1 0 00.908-.588l3.333-6.666A1 1 0 0017.671 8h-4.674a1 1 0 00-.908.588l-3.333 6.666A1 1 0 009.663 17z" Class="w-4 h-4 text-slate-500" />
                            Models: <span class="font-semibold text-white ml-auto">@_dataStatus.Nfl.Models</span>
                        </div>
                        <p class="text-[10px] text-slate-500 italic mt-4">
                            Source: nflverse-data (play-by-play, Next Gen Stats, contracts, injuries)
                        </p>
                    </div>
                }
            </div>

            <div class="grid grid-cols-2 gap-2 mt-6">
                <TwButton Variant="primary" Size="sm" OnClick="@(() => OpenSportImportDialog("nfl"))" Disabled="@(_isUpdating || _isSportImporting)">
                    <PrefixContent><TwIcon Icon="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" Class="w-4 h-4" /></PrefixContent>
                    Import Data
                </TwButton>
                <TwButton Variant="outline" Size="sm" OnClick="@(() => RetrainModel("nfl"))" Disabled="@_isUpdating">
                    <PrefixContent><TwIcon Icon="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0-4V4" Class="w-4 h-4" /></PrefixContent>
                    Train Model
                </TwButton>
            </div>
        </TwCard>
        
        <!-- NBA Card -->
        <TwCard Class="p-5 flex flex-col h-full bg-slate-900 border-slate-800">
            <div class="flex items-center gap-4 mb-6">
                <div class="bg-amber-500/20 p-3 rounded-xl">
                    <TwIcon Icon="M12 2a10 10 0 1010 10A10 10 0 0012 2zm0 18a8 8 0 118-8 8 8 0 01-8 8z" Class="w-6 h-6 text-amber-400" />
                </div>
                <div>
                    <h3 class="text-xl font-bold text-white">NBA</h3>
                    <p class="text-xs text-slate-500">NBA Stats API</p>
                </div>
            </div>

            <div class="flex-grow">
                @if (_dataStatus?.Nba != null)
                {
                    <div class="space-y-4">
                        <div class="flex items-center gap-2 text-sm text-slate-300">
                            <TwIcon Icon="M4 7v10c0 1.1.9 2 2 2h12a2 2 0 002-2V7a2 2 0 00-2-2H6a2 2 0 00-2 2z" Class="w-4 h-4 text-slate-500" />
                            Files: <span class="font-semibold ml-auto text-white">@GetFileCount(_dataStatus.Nba.Files)</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm text-slate-300">
                            <TwIcon Icon="M9.663 17h4.674a1 1 0 00.908-.588l3.333-6.666A1 1 0 0017.671 8h-4.674a1 1 0 00-.908.588l-3.333 6.666A1 1 0 009.663 17z" Class="w-4 h-4 text-slate-500" />
                            Models: <span class="font-semibold text-white ml-auto">@_dataStatus.Nba.Models</span>
                        </div>
                        <p class="text-[10px] text-slate-500 italic mt-4">
                            Source: stats.nba.com + hoopR (live game data)
                        </p>
                    </div>
                }
            </div>

            <div class="grid grid-cols-2 gap-2 mt-6">
                <TwButton Variant="primary" Size="sm" OnClick="@(() => OpenSportImportDialog("nba"))" Disabled="@(_isUpdating || _isSportImporting)" Color="amber">
                    <PrefixContent><TwIcon Icon="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" Class="w-4 h-4" /></PrefixContent>
                    Import Data
                </TwButton>
                <TwButton Variant="outline" Size="sm" OnClick="@(() => RetrainModel("nba"))" Disabled="@_isUpdating">
                    <PrefixContent><TwIcon Icon="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0-4V4" Class="w-4 h-4" /></PrefixContent>
                    Train Model
                </TwButton>
            </div>
        </TwCard>
        
        <!-- College Baseball Card -->
        <TwCard Class="p-5 flex flex-col h-full bg-slate-900 border-slate-800">
            <div class="flex items-center gap-4 mb-6">
                <div class="bg-blue-500/20 p-3 rounded-xl">
                    <TwIcon Icon="M12 2a10 10 0 1010 10A10 10 0 0012 2zm0 18a8 8 0 118-8 8 8 0 01-8 8z" Class="w-6 h-6 text-blue-400" />
                </div>
                <div>
                    <h3 class="text-xl font-bold text-white">College Baseball</h3>
                    <p class="text-xs text-slate-500">Python + R Hybrid</p>
                </div>
            </div>

            <div class="flex-grow">
                <div class="space-y-3">
                    @if (_baseballSummary != null)
                    {
                        <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-lg p-3">
                            <p class="text-[11px] text-emerald-400 font-bold uppercase tracking-wider mb-1">Last Import</p>
                            <p class="text-sm text-white">@FormatDate(_baseballSummary.GeneratedAt)</p>
                            <p class="text-xs text-slate-400 mt-1">D@(_baseballSummary.Division) - @_baseballSummary.ImportedTeams teams</p>
                        </div>
                    }
                    
                    <div class="bg-blue-500/10 border border-blue-500/20 rounded-lg p-3">
                        <div class="flex gap-2">
                            <TwIcon Icon="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-5 h-5 text-blue-400 shrink-0" />
                            <p class="text-xs text-blue-200">Fetches all divisions (D1, D2, D3) and current season rosters/stats.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-2 mt-6">
                <TwButton Variant="primary" Size="sm" OnClick="@OpenBaseballImportDialog" Disabled="@(_isUpdating || _isBaseballImporting)">
                    <PrefixContent><TwIcon Icon="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" Class="w-4 h-4" /></PrefixContent>
                    Full Import
                </TwButton>
                <TwButton Variant="outline" Size="sm" OnClick="@ViewBaseballTeams" Disabled="@(_baseballSummary == null)">
                    <PrefixContent><TwIcon Icon="M4 6h16M4 10h16M4 14h16M4 18h16" Class="w-4 h-4" /></PrefixContent>
                    View Teams
                </TwButton>
            </div>
        </TwCard>
        <!-- NCAAB Card -->
        <TwCard Class="p-5 flex flex-col h-full bg-slate-900 border-slate-800">
            <div class="flex items-center gap-4 mb-6">
                <div class="bg-indigo-500/20 p-3 rounded-xl">
                    <TwIcon Icon="M12 2a10 10 0 1010 10A10 10 0 0012 2zm0 18a8 8 0 118-8 8 8 0 01-8 8z" Class="w-6 h-6 text-indigo-400" />
                </div>
                <div>
                    <h3 class="text-xl font-bold text-white">NCAA Basketball</h3>
                    <p class="text-xs text-slate-500">sportsdataverse (mbb)</p>
                </div>
            </div>

            <div class="flex-grow">
                <div class="space-y-4">
                    <div class="flex items-center gap-2 text-sm text-slate-300">
                        <TwIcon Icon="M4 7v10c0 1.1.9 2 2 2h12a2 2 0 002-2V7a2 2 0 00-2-2H6a2 2 0 00-2 2z" Class="w-4 h-4 text-slate-500" />
                        <p>Fetches historical schedules and boxscores.</p>
                    </div>
                    <p class="text-[10px] text-slate-500 italic mt-4">
                        Source: Used for O/U and Moneyline modeling.
                    </p>
                </div>
            </div>

            <div class="mt-6">
                <TwButton Variant="primary" Size="sm" OnClick="@OpenNcaabImportDialog" Disabled="@_isSportImporting" Class="w-full">
                    <PrefixContent><TwIcon Icon="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" Class="w-4 h-4" /></PrefixContent>
                    Import History
                </TwButton>
            </div>
        </TwCard>
    </TwGrid>

    <!-- Import History Section -->
    <TwCard NoPadding="true" Class="bg-slate-900 border-slate-800 overflow-hidden shadow-xl">
        <div class="p-6 border-b border-slate-800 flex items-center justify-between bg-slate-900/50">
            <h2 class="text-lg font-bold text-white flex items-center gap-3">
                <TwIcon Icon="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-5 h-5 text-blue-400" />
                Import History
            </h2>
            <TwButton Variant="ghost" Size="sm" OnClick="LoadHistory">
                <PrefixContent><TwIcon Icon="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" Class="w-4 h-4" /></PrefixContent>
            </TwButton>
        </div>
        
        <div class="overflow-x-auto">
            @if (_history.Any())
            {
                <TwTable TItem="object">
                    <thead>
                        <tr class="text-slate-500 text-xs uppercase tracking-wider">
                            <TwTh>Date</TwTh>
                            <TwTh>Sport</TwTh>
                            <TwTh>Details</TwTh>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var context in _history.Take(10))
                        {
                            <tr class="border-b border-slate-800/50 hover:bg-slate-800/30">
                                <TwTd class="text-slate-400">@FormatDate(context["date"]?.ToString())</TwTd>
                                <TwTd>
                                    <TwChip Color="blue" Size="sm">@context["topic"]</TwChip>
                                </TwTd>
                                <TwTd>
                                    <code class="text-[10px] text-slate-500 font-mono block max-w-md truncate" title="@System.Text.Json.JsonSerializer.Serialize(context["details"])">
                                        @System.Text.Json.JsonSerializer.Serialize(context["details"])
                                    </code>
                                </TwTd>
                            </tr>
                        }
                    </tbody>
                </TwTable>
            }
            else
            {
                <div class="p-12 text-center">
                    <TwIcon Icon="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-12 h-12 text-slate-700 mx-auto mb-4" />
                    <p class="text-slate-500">No import history yet. Import data to see history here.</p>
                </div>
            }
        </div>
    </TwCard>
</TwContainer>

<!-- RDA Import Progress Dialog -->
<TwDialog @bind-IsOpen="_showRdaDialog" Title="NASCAR RDA Import" MaxWidth="md">
    <ChildContent>
        @if (!_isRdaImporting)
        {
            <!-- Import Options -->
            <div class="space-y-6">
                <div class="bg-blue-500/10 border border-blue-500/20 rounded-lg p-3 flex gap-3">
                    <TwIcon Icon="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-5 h-5 text-blue-400 shrink-0" />
                    <p class="text-sm text-blue-200">Import directly from .rda files with pre-computed season stats.</p>
                </div>
                
                <div class="space-y-4">
                    <label class="block text-sm font-medium text-slate-400">Series</label>
                    <TwSelect @bind-Value="_rdaSeries" Class="w-full">
                        <option value="all">All Series</option>
                        <option value="cup">Cup Series</option>
                        <option value="xfinity">Xfinity Series</option>
                        <option value="trucks">Trucks Series</option>
                    </TwSelect>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1">
                            <label class="block text-sm font-medium text-slate-400">Year Start</label>
                            <TwNumericField @bind-Value="_rdaYearStart" min="2000" max="2030" />
                        </div>
                        <div class="space-y-1">
                            <label class="block text-sm font-medium text-slate-400">Year End</label>
                            <TwNumericField @bind-Value="_rdaYearEnd" min="2000" max="2030" />
                        </div>
                    </div>
                    
                    <label class="flex items-center gap-3 p-3 rounded-lg border border-slate-800 hover:bg-slate-800/50 transition-colors cursor-pointer">
                        <input type="checkbox" @bind="_rdaClearExisting" class="w-4 h-4 rounded border-slate-700 bg-slate-900 text-amber-500 focus:ring-amber-500/20" />
                        <span class="text-sm text-slate-300">Clear existing NASCAR data before import</span>
                    </label>
                </div>
            </div>
        }
        else
        {
            <!-- Progress Display -->
            <div class="space-y-6">
                <TwProgressBar Value="100" IsIndeterminate="@(_rdaStatus?.Status == "running")" Color="blue" />
                
                <div class="flex items-center justify-between">
                    <span class="text-sm text-slate-400">Status</span>
                    <TwChip Color="@(_rdaStatus?.Status == "completed" ? "emerald" : _rdaStatus?.Status == "failed" ? "red" : "blue")" Size="sm">
                        @(_rdaStatus?.Status ?? "unknown")
                    </TwChip>
                </div>
                
                @if (_rdaStatus?.StartedAt != null)
                {
                    <p class="text-xs text-slate-500">Started: @FormatDate(_rdaStatus.StartedAt)</p>
                }
                
                <div class="bg-slate-950 border border-slate-800 rounded-lg p-3 h-48 overflow-y-auto font-mono text-[11px] space-y-1">
                    @if (_rdaStatus?.Progress != null)
                    {
                        @foreach (var line in _rdaStatus.Progress)
                        {
                            <p class="text-emerald-400/80">@line</p>
                        }
                    }
                </div>
                
                @if (_rdaStatus?.Error != null)
                {
                    <div class="bg-red-500/10 border border-red-500/20 rounded-lg p-3 text-sm text-red-400">
                        @_rdaStatus.Error
                    </div>
                }
            </div>
        }
    </ChildContent>
    <ActionsContent>
        @if (!_isRdaImporting)
        {
            <TwButton Variant="ghost" OnClick="@CloseRdaDialog">Cancel</TwButton>
            <TwButton Variant="primary" OnClick="@StartRdaImport">Start Import</TwButton>
        }
        else if (_rdaStatus?.Status == "completed" || _rdaStatus?.Status == "failed")
        {
            <TwButton Variant="primary" OnClick="@CloseRdaDialog">Close</TwButton>
        }
    </ActionsContent>
</TwDialog>

<!-- NFL/NBA Import Dialog -->
<TwDialog @bind-IsOpen="_showSportImportDialog" Title="@($"Import {_sportImportTarget?.ToUpper()} Data")" MaxWidth="md">
    <ChildContent>
        @if (!_isSportImporting)
        {
            <div class="space-y-6">
                <div class="bg-blue-500/10 border border-blue-500/20 rounded-lg p-4">
                    <p class="text-sm text-blue-200 mb-3">This will download and import @(_sportImportTarget) data from:</p>
                    <ul class="space-y-2">
                        @if (_sportImportTarget == "nfl")
                        {
                            <li class="flex items-center gap-2 text-sm text-slate-300">
                                <TwIcon Icon="M17.22 8.98L12 3.75 6.78 8.98l1.06 1.06L11 6.81V15h2V6.81l3.16 3.24 1.06-1.07z" Class="w-4 h-4 text-emerald-400" />
                                nflverse-data (GitHub releases)
                            </li>
                        }
                        else
                        {
                            <li class="flex items-center gap-2 text-sm text-slate-300">
                                <TwIcon Icon="M17.22 8.98L12 3.75 6.78 8.98l1.06 1.06L11 6.81V15h2V6.81l3.16 3.24 1.06-1.07z" Class="w-4 h-4 text-amber-400" />
                                hoopR + stats.nba.com
                            </li>
                        }
                    </ul>
                </div>
                
                <label class="flex items-center gap-3 p-3 rounded-lg border border-slate-800 hover:bg-slate-800/50 transition-colors cursor-pointer">
                    <input type="checkbox" @bind="_sportClearExisting" class="w-4 h-4 rounded border-slate-700 bg-slate-900 text-blue-500 focus:ring-blue-500/20" />
                    <span class="text-sm text-slate-300">Clear existing @(_sportImportTarget?.ToUpper()) data before import</span>
                </label>
            </div>
        }
        else
        {
            <div class="space-y-6">
                <TwProgressBar Value="100" IsIndeterminate="@(_sportStatus?.Status == "running")" Color="blue" />
                
                <div class="flex items-center justify-between">
                    <span class="text-sm text-slate-400">Status</span>
                    <TwChip Color="@(_sportStatus?.Status == "completed" ? "emerald" : _sportStatus?.Status == "failed" ? "red" : "blue")" Size="sm">
                        @(_sportStatus?.Status ?? "starting...")
                    </TwChip>
                </div>
                
                <div class="bg-slate-950 border border-slate-800 rounded-lg p-3 h-48 overflow-y-auto font-mono text-[11px] space-y-1">
                    @if (_sportStatus?.Progress != null)
                    {
                        @foreach (var line in _sportStatus.Progress)
                        {
                            <p class="text-emerald-400/80">@line</p>
                        }
                    }
                </div>
                
                @if (_sportStatus?.Error != null)
                {
                    <div class="bg-red-500/10 border border-red-500/20 rounded-lg p-3 text-sm text-red-400">
                        @_sportStatus.Error
                    </div>
                }
            </div>
        }
    </ChildContent>
    <ActionsContent>
        @if (!_isSportImporting)
        {
            <TwButton Variant="ghost" OnClick="@CloseSportImportDialog">Cancel</TwButton>
            <TwButton Variant="primary" OnClick="@StartSportImport">Start Import</TwButton>
        }
        else if (_sportStatus?.Status == "completed" || _sportStatus?.Status == "failed")
        {
            <TwButton Variant="primary" OnClick="@CloseSportImportDialog">Close</TwButton>
        }
    </ActionsContent>
</TwDialog>

