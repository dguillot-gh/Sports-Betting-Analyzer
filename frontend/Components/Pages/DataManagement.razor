                        </div>
                        <div class="flex items-center gap-2 text-sm text-slate-300">
                            <TwIcon Icon="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6" Class="w-4 h-4 text-blue-400" />
                            Batting statistics
                        </div>
                        <div class="flex items-center gap-2 text-sm text-slate-300">
                            <TwIcon Icon="M13 10V3L4 14h7v7l9-11h-7z" Class="w-4 h-4 text-blue-400" />
                            Pitching statistics
                        </div>
                        <div class="flex items-center gap-2 text-sm text-slate-300">
                            <TwIcon Icon="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" Class="w-4 h-4 text-blue-400" />
                            Schedules & results
                        </div>
                    </div>
                </div>

                <div class="bg-blue-500/5 border border-blue-500/10 rounded-lg p-3">
                    <p class="text-[11px] text-blue-400 italic">This performs a full bulk import of all teams and players for the selected division and year.</p>
                </div>
            </div>
        }
        else
        {
            <div class="space-y-6">
                <TwProgressBar Value="100" IsIndeterminate="@(_baseballStatus?.Status == "running")" Color="blue" />
                
                <div class="flex items-center justify-between">
                    <span class="text-sm text-slate-400">Status</span>
                    <TwChip Color="@(_baseballStatus?.Status == "completed" ? "emerald" : (_baseballStatus?.Status == "error" || _baseballStatus?.Status == "failed") ? "red" : "blue")" Size="sm">
                        @(_baseballStatus?.Status ?? "starting...")
                    </TwChip>
                </div>
                
                @if (_baseballStatus?.Progress?.Any() == true)
                {
                    <div class="bg-slate-950 border border-slate-800 rounded-lg p-3 h-48 overflow-y-auto font-mono text-[11px] space-y-1">
                        @foreach (var msg in _baseballStatus.Progress.TakeLast(20))
                        {
                            <p class="text-blue-400/80">@msg</p>
                        }
                    </div>
                }
                
                @if (_baseballStatus?.Status == "completed")
                {
                    <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-lg p-3 text-sm text-emerald-400">
                        Import completed successfully!
                    </div>
                }
                @if (_baseballStatus?.Status == "error" || _baseballStatus?.Status == "failed")
                {
                    <div class="bg-red-500/10 border border-red-500/20 rounded-lg p-3 text-sm text-red-400">
                        @(_baseballStatus?.Error ?? _baseballStatus?.Message ?? "Import failed")
                    </div>
                }
            </div>
        }
    </ChildContent>
    <ActionsContent>
        @if (!_isBaseballImporting)
        {
            <TwButton Variant="ghost" OnClick="@CloseBaseballImportDialog">Cancel</TwButton>
            <TwButton Variant="primary" OnClick="@StartBaseballImport">Start Import</TwButton>
        }
        else if (_baseballStatus?.Status == "completed" || _baseballStatus?.Status == "error" || _baseballStatus?.Status == "failed")
        {
            <TwButton Variant="primary" OnClick="@CloseBaseballImportDialog">Close</TwButton>
        }
    </ActionsContent>
</TwDialog>

@code {
    private DataStatusResponse? _dataStatus;
    private bool _isLoading = true;
    private bool _isUpdating = false;
    
    
    // History
    private List<Dictionary<string, object>> _history = new();
    
    // RDA Import Dialog
    private bool _showRdaDialog = false;
    private bool _isRdaImporting = false;
    private string _rdaSeries = "all";
    private double _rdaYearStart = 2012;
    private double _rdaYearEnd = DateTime.Now.Year;
    private bool _rdaClearExisting = false;
    private RdaImportStatus? _rdaStatus;
    private System.Threading.Timer? _rdaPollTimer;
    private DialogOptions _rdaDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
    
    // NFL/NBA Import Dialog
    private bool _showSportImportDialog = false;
    private bool _isSportImporting = false;
    private string? _sportImportTarget;
    private bool _sportClearExisting = false;
    private SportImportStatus? _sportStatus;
    private System.Threading.Timer? _sportPollTimer;
    
    // College Baseball Import
    private bool _showBaseballImportDialog = false;
    private bool _isBaseballImporting = false;
    private string _baseballDivision = "0";
    private double _baseballYear = 0;
    private string _baseballSource = "auto";
    private BaseballImportStatus? _baseballStatus;
    private BaseballImportSummary? _baseballSummary;
    private System.Threading.Timer? _baseballPollTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadStatus();
        await LoadHistory();
        await LoadBaseballSummary();
    }

    private async Task LoadStatus()
    {
        try
        {
            _isLoading = true;
            _dataStatus = await MLClient.GetDataStatusAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading status");
        }
        finally
        {
            _isLoading = false;
        }
    }
    
    private async Task LoadHistory()
    {
        // Load history for all sports and merge?
        // Or just show generic list. For now let's load NASCAr + NBA history
        var allHistory = new List<Dictionary<string, object>>();
        foreach(var sport in new[]{"nascar", "nba", "nfl"})
        {
            var h = await MLClient.GetHistoryAsync(sport);
            allHistory.AddRange(h);
        }
        
        // Sort by date desc
        _history = allHistory.OrderByDescending(x => x.ContainsKey("date") ? x["date"].ToString() : "").ToList();
    }



    private async Task UpdateData(string sport, string? dataset = null)
    {
        try
        {
            _isUpdating = true;
            Snackbar.Add($"Updating {sport}{(dataset!=null ? " - "+dataset : "")}...", Severity.Info);
            
            var result = await MLClient.UpdateDataAsync(sport, dataset);
            
            if (result.Success)
            {
                Snackbar.Add("Update successful!", Severity.Success);
                await LoadStatus();
                await LoadHistory();
            }
            else
            {
                Snackbar.Add("Update failed.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUpdating = false;
        }
    }

    private int GetFileCount(System.Text.Json.JsonElement? files)
    {
        if (files == null || !files.HasValue) return 0;
        var elem = files.Value;
        if (elem.ValueKind == System.Text.Json.JsonValueKind.Array) return elem.GetArrayLength();
        if (elem.ValueKind == System.Text.Json.JsonValueKind.Object) return elem.EnumerateObject().Count();
        return 0;
    }

    private async Task RetrainModel(string sport)
    {
        try
        {
            _isUpdating = true;
            Snackbar.Add($"Starting Training for {sport}...", Severity.Info);
            var result = await MLClient.RetrainModelAsync(sport);
            if (result.Success)
            {
                Snackbar.Add("Training Complete!", Severity.Success);
                await LoadStatus();
            }
            else
            {
                Snackbar.Add("Training Failed.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUpdating = false;
        }
    }
    
    private async Task EnhanceData(string sport)
    {
        try
        {
            _isUpdating = true;
            Snackbar.Add($"Enhancing {sport}...", Severity.Info);
            var result = await MLClient.EnhanceDataAsync(sport);
            if (result.Success)
            {
                Snackbar.Add("Enhanced successfully!", Severity.Success);
                await LoadStatus();
            }
            else
            {
                Snackbar.Add("Enhance Failed.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUpdating = false;
        }
    }

    private string FormatDate(string? isoDate)
    {
        if (string.IsNullOrEmpty(isoDate)) return "";
        if (DateTime.TryParse(isoDate, out var date))
            return date.ToLocalTime().ToString("MMM d, HH:mm");
        return isoDate;
    }
    
    // ===== RDA Import Methods =====
    
    private void OpenRdaImportDialog()
    {
        _isRdaImporting = false;
        _rdaStatus = null;
        _showRdaDialog = true;
    }
    
    private void CloseRdaDialog()
    {
        _showRdaDialog = false;
        _rdaPollTimer?.Dispose();
        _rdaPollTimer = null;
        _isRdaImporting = false;
    }
    
    private async Task StartRdaImport()
    {
        _isRdaImporting = true;
        _rdaStatus = new RdaImportStatus { Status = "starting", Progress = new List<string>() };
        StateHasChanged();
        
        try
        {
            using var http = new HttpClient();
            http.Timeout = TimeSpan.FromMinutes(30);
            
            var url = $"http://backend:8000/db/import/nascar/rda?series={_rdaSeries}&year_start={_rdaYearStart}&year_end={_rdaYearEnd}&clear_existing={_rdaClearExisting.ToString().ToLower()}";
            var response = await http.PostAsync(url, null);
            
            if (response.IsSuccessStatusCode)
            {
                // Start polling for status
                _rdaPollTimer = new System.Threading.Timer(async _ => await PollRdaStatus(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(2));
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _rdaStatus = new RdaImportStatus { Status = "failed", Error = error };
            }
        }
        catch (HttpRequestException)
        {
            // Try localhost
            try
            {
                using var http2 = new HttpClient();
                http2.Timeout = TimeSpan.FromMinutes(30);
                var url = $"http://localhost:8000/db/import/nascar/rda?series={_rdaSeries}&year_start={_rdaYearStart}&year_end={_rdaYearEnd}&clear_existing={_rdaClearExisting.ToString().ToLower()}";
                var response = await http2.PostAsync(url, null);
                
                if (response.IsSuccessStatusCode)
                {
                    _rdaPollTimer = new System.Threading.Timer(async _ => await PollRdaStatus(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(2));
                }
            }
            catch (Exception ex)
            {
                _rdaStatus = new RdaImportStatus { Status = "failed", Error = ex.Message };
            }
        }
        catch (Exception ex)
        {
            _rdaStatus = new RdaImportStatus { Status = "failed", Error = ex.Message };
        }
        
        StateHasChanged();
    }
    
    private async Task PollRdaStatus()
    {
        try
        {
            using var http = new HttpClient();
            RdaImportStatus? status = null;
            
            try
            {
                status = await http.GetFromJsonAsync<RdaImportStatus>("http://backend:8000/db/import/nascar/status");
            }
            catch
            {
                status = await http.GetFromJsonAsync<RdaImportStatus>("http://localhost:8000/db/import/nascar/status");
            }
            
            if (status != null)
            {
                _rdaStatus = status;
                await InvokeAsync(StateHasChanged);
                
                // Stop polling when complete or failed
                if (status.Status == "completed" || status.Status == "failed")
                {
                    _rdaPollTimer?.Dispose();
                    _rdaPollTimer = null;
                    
                    if (status.Status == "completed")
                    {
                        await InvokeAsync(async () =>
                        {
                            Snackbar.Add("RDA import completed successfully!", Severity.Success);
                            await LoadStatus();
                        });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error polling RDA status");
        }
    }
    
    // Model for RDA import status
    public class RdaImportStatus
    {
        public string Status { get; set; } = "idle";
        public string? StartedAt { get; set; }
        public string? CompletedAt { get; set; }
        public List<string>? Progress { get; set; }
        public object? Result { get; set; }
        public string? Error { get; set; }
    }
    
    // Model for NFL/NBA import status (same structure)
    public class SportImportStatus
    {
        public string Status { get; set; } = "idle";
        public string? StartedAt { get; set; }
        public string? CompletedAt { get; set; }
        public List<string>? Progress { get; set; }
        public object? Result { get; set; }
        public string? Error { get; set; }
    }
    
    // Sport Import Methods
    private void OpenSportImportDialog(string sport)
    {
        _sportImportTarget = sport;
        _sportClearExisting = false;
        _sportStatus = null;
        _showSportImportDialog = true;
    }
    
    private void OpenNcaabImportDialog()
    {
        OpenSportImportDialog("ncaab");
    }
    
    private void CloseSportImportDialog()
    {
        _showSportImportDialog = false;
        _isSportImporting = false;
        _sportPollTimer?.Dispose();
        _sportPollTimer = null;
    }
    
    private async Task StartSportImport()
    {
        if (string.IsNullOrEmpty(_sportImportTarget)) return;
        
        try
        {
            _isSportImporting = true;
            _sportStatus = new SportImportStatus { Status = "running", Progress = new List<string> { $"Starting {_sportImportTarget.ToUpper()} import..." } };
            StateHasChanged();
            
            // Call the import API
            var http = HttpClientFactory.CreateClient("PythonML");
            string url = $"/db/import/{_sportImportTarget}?clear_existing={_sportClearExisting.ToString().ToLower()}";
            
            if (_sportImportTarget == "ncaab")
            {
                url = "/ncaab/import";
            }
            
            var response = await http.PostAsync(url, null);
            
            if (!response.IsSuccessStatusCode)
            {
                _sportStatus.Status = "failed";
                _sportStatus.Error = "Failed to start import";
                return;
            }
            
            // Start polling
            _sportPollTimer = new System.Threading.Timer(
                async _ => await PollSportStatus(),
                null,
                TimeSpan.FromSeconds(2),
                TimeSpan.FromSeconds(2)
            );
        }
        catch (Exception ex)
        {
            _sportStatus = new SportImportStatus 
            { 
                Status = "failed", 
                Error = ex.Message,
                Progress = new List<string> { $"Error: {ex.Message}" }
            };
        }
    }
    
    private async Task PollSportStatus()
    {
        if (string.IsNullOrEmpty(_sportImportTarget)) return;
        
        try
        {
            var http = HttpClientFactory.CreateClient("PythonML");
            var response = await http.GetAsync($"/db/import/{_sportImportTarget}/status");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var status = System.Text.Json.JsonSerializer.Deserialize<SportImportStatus>(json, new System.Text.Json.JsonSerializerOptions 
                { 
                    PropertyNameCaseInsensitive = true 
                });
                
                if (status != null)
                {
                    _sportStatus = status;
                    await InvokeAsync(StateHasChanged);
                    
                    // Stop polling when complete or failed
                    if (status.Status == "completed" || status.Status == "failed")
                    {
                        _sportPollTimer?.Dispose();
                        _sportPollTimer = null;
                        
                        if (status.Status == "completed")
                        {
                            await InvokeAsync(async () =>
                            {
                                Snackbar.Add($"{_sportImportTarget?.ToUpper()} import completed successfully!", Severity.Success);
                                await LoadStatus();
                            });
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error polling sport import status");
        }
    }
    
    // ========== College Baseball Import Methods ==========
    
    private void OpenBaseballImportDialog()
    {
        _showBaseballImportDialog = true;
    }
    
    private void CloseBaseballImportDialog()
    {
        _showBaseballImportDialog = false;
        _isBaseballImporting = false;
        _baseballPollTimer?.Dispose();
        _baseballPollTimer = null;
    }
    
    private async Task StartBaseballImport()
    {
        _isBaseballImporting = true;
        _baseballStatus = new BaseballImportStatus { Status = "running", Message = "Starting import..." };
        StateHasChanged();
        
        try
        {
            using var http = HttpClientFactory.CreateClient("PythonML");
            http.Timeout = TimeSpan.FromMinutes(10);
            
            // Start polling for status
            _baseballPollTimer = new System.Threading.Timer(
                async _ => await PollBaseballStatus(),
                null,
                TimeSpan.FromSeconds(1),
                TimeSpan.FromSeconds(2)
            );
            
            var response = await http.PostAsync($"/db/import/college-baseball?division={_baseballDivision}&start_year={_baseballYear}&end_year={_baseballYear}&source={_baseballSource}", null);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BaseballImportSummary>();
                _baseballSummary = result;
                _baseballStatus = new BaseballImportStatus { Status = "completed", Message = "Import complete!" };
                Snackbar.Add($"College baseball {(_baseballDivision == "0" ? "All Divisions" : $"D{_baseballDivision}")} import complete!", Severity.Success);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _baseballStatus = new BaseballImportStatus { Status = "error", Message = error };
            }
        }
        catch (Exception ex)
        {
            _baseballStatus = new BaseballImportStatus { Status = "error", Message = ex.Message };
            Logger.LogError(ex, "Error importing college baseball");
        }
        finally
        {
            StateHasChanged();
        }
    }
    
    private async Task PollBaseballStatus()
    {
        try
        {
            using var http = HttpClientFactory.CreateClient("PythonML");
            http.Timeout = TimeSpan.FromSeconds(5);
            
            var status = await http.GetFromJsonAsync<BaseballImportStatus>("/db/import/college-baseball/status");
            if (status != null)
            {
                _baseballStatus = status;
                await InvokeAsync(StateHasChanged);
                
                // Stop polling when complete or error/failed
                if (status.Status == "completed" || status.Status == "error" || status.Status == "failed")
                {
                    _baseballPollTimer?.Dispose();
                    _baseballPollTimer = null;
                    
                    if (status.Status == "completed")
                    {
                        await InvokeAsync(async () => {
                            await LoadStatus();
                            await LoadBaseballSummary();
                        });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error polling baseball import status");
        }
    }
    
    private async Task ViewBaseballTeams()
    {
        // Could navigate to a teams list page or show a dialog
        Snackbar.Add($"D{_baseballDivision} teams available via API: /baseball/ncaa/teams?division={_baseballDivision}", Severity.Info);
    }
    
    private async Task LoadBaseballSummary()
    {
        try
        {
            using var http = HttpClientFactory.CreateClient("PythonML");
            var summary = await http.GetFromJsonAsync<BaseballImportSummary>($"/baseball/ncaa/summary?division={_baseballDivision}");
            _baseballSummary = summary;
        }
        catch
        {
            // No summary yet, that's ok
        }
    }
    
    // Model classes for Baseball
    private class BaseballImportStatus
    {
        public string? Status { get; set; }
        public string? Message { get; set; }
        public List<string>? Progress { get; set; }
        public string? Error { get; set; }
        public string? CompletedAt { get; set; }
    }
    
    private class BaseballImportSummary
    {
        public int Division { get; set; }
        public int Year { get; set; }
        public int TotalTeams { get; set; }
        public int ImportedTeams { get; set; }
        public string? GeneratedAt { get; set; }
    }
}

