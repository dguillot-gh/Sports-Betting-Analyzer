<TwDialog @bind-IsOpen="_showBaseballImportDialog" Title="@($"Import NCAA Baseball - {(_baseballDivision == "0" ? "All Divisions" : $"Division {_baseballDivision}")}")" MaxWidth="md">
    <ChildContent>
        @if (!_isBaseballImporting)
        {
            <div class="space-y-6">
                <div class="bg-blue-500/10 border border-blue-500/20 rounded-lg p-4">
                    <p class="text-sm text-blue-200 mb-4">This will download NCAA @(_baseballDivision == "0" ? "All Divisions" : $"Division {_baseballDivision}") baseball data for @_baseballYear:</p>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="flex items-center gap-2 text-sm text-slate-300">
                            <TwIcon Icon="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" Class="w-4 h-4 text-blue-400" />
