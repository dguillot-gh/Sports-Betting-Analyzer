@page "/nfl-stats"
@page "/nfl/statboard"
@rendermode InteractiveServer
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ILogger<NFLStatBoard> Logger
@inject IDialogService DialogService

<PageTitle>NFL Stat Board</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true">NFL Comprehensive Stat Board</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">
        Advanced analytics powered by nflverse - Next Gen Stats, Snap Counts, Combine Data & more
    </MudText>
    
    @* Data Status Banner *@
    @if (!_dataLoaded)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText>Comprehensive NFL data not yet downloaded or verified.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="DownloadData" 
                           Disabled="@_showDownloadDialog">
                    Download All Data
                </MudButton>
            </MudStack>
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Outlined">
             <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText>
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" Color="Color.Success" />
                    Data loaded and ready.
                </MudText>
                 <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="DownloadData" Size="Size.Small"
                           Disabled="@_showDownloadDialog">
                    Check for Updates
                </MudButton>
            </MudStack>
        </MudAlert>
    }
    
    @* File Status Details *@
    <MudExpansionPanel Text="Data File Status" Class="mb-4" Dense="true">
        <MudSimpleTable Dense="true" Hover="true" Striped="true">
            <thead>
                <tr>
                    <th>Dataset</th>
                    <th>Status</th>
                    <th>Last Updated</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kvp in _fileStatus.OrderBy(x => x.Key))
                {
                    <tr>
                        <td><code>@kvp.Key</code></td>
                        <td>
                            @if (kvp.Value.Exists)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Available</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small">Missing</MudChip>
                            }
                        </td>
                        <td>
                            @if (kvp.Value.LastModified.HasValue)
                            {
                                @kvp.Value.LastModified.Value.ToString("g")
                                
                                var age = DateTime.Now - kvp.Value.LastModified.Value;
                                if (age.TotalDays > 7 && DateTime.Now.Month >= 9 && DateTime.Now.Month <= 12) 
                                {
                                     <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="ml-2">Update Available?</MudChip>
                                }
                            }
                            else
                            {
                                <span class="mud-text-secondary">N/A</span>
                            }
                        </td>
                        <td>
                            @if (!kvp.Value.Exists) { <MudText Typo="Typo.caption" Color="Color.Error">Required for some features</MudText> }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudExpansionPanel>
    
    <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="2" Rounded="true" 
             ApplyEffectsToContainer="true" PanelClass="pa-4">
        
        @* Tab 1: Next Gen Stats *@
        <MudTabPanel Text="Next Gen Stats" Icon="@Icons.Material.Filled.Speed">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Filters</MudText>
                        
                        <MudSelect T="int" @bind-Value="_selectedSeason" Label="Season" 
                                   Variant="Variant.Outlined" Class="mb-3">
                            @for (int y = DateTime.Now.Year; y >= 2016; y--)
                            {
                                var year = y;
                                <MudSelectItem Value="@year">@year</MudSelectItem>
                            }
                        </MudSelect>
                        
                        <MudSelect T="string" @bind-Value="_ngsCategory" Label="Category" 
                                   Variant="Variant.Outlined" Class="mb-3">
                            <MudSelectItem Value="@("passing")">Passing</MudSelectItem>
                            <MudSelectItem Value="@("rushing")">Rushing</MudSelectItem>
                            <MudSelectItem Value="@("receiving")">Receiving</MudSelectItem>
                        </MudSelect>
                        
                        <MudSelect T="string" @bind-Value="_teamFilter" Label="Team (Optional)" 
                                   Variant="Variant.Outlined" Class="mb-3" Clearable="true">
                            <MudSelectItem Value="@("")">All Teams</MudSelectItem>
                            @foreach (var team in NFL_TEAMS)
                            {
                                <MudSelectItem Value="@team">@team</MudSelectItem>
                            }
                        </MudSelect>
                        
                        <MudTextField @bind-Value="_playerFilter" Label="Player Name" 
                                      Placeholder="Search by name..."
                                      Variant="Variant.Outlined" Class="mb-3" />
                        
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   OnClick="LoadNGSData" Disabled="@_isLoading">
                            @if (_isLoading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                            Load Stats
                        </MudButton>
                    </MudPaper>
                </MudItem>
                
                <MudItem xs="12" md="9">
                    @if (_ngsData != null && _ngsData.Any())
                    {
                        <MudPaper Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">
                                @_ngsCategory.ToUpper() Stats (@_selectedSeason) - @_ngsData.Count results
                            </MudText>
                            
                            <MudSimpleTable Dense="true" Hover="true" Striped="true" Style="overflow-x: auto;">
                                <thead>
                                    <tr>
                                        <th>Player</th>
                                        <th>Team</th>
                                        @if (_ngsCategory == "passing")
                                        {
                                            <th>
                                                <MudTooltip Text="Average time from snap to pass release. Faster = quicker decision making.">
                                                    Time to Throw
                                                </MudTooltip>
                                            </th>
                                            <th>
                                                <MudTooltip Text="Average air yards on completed passes. Higher = deeper completions.">
                                                    Comp Air Yds
                                                </MudTooltip>
                                            </th>
                                            <th>
                                                <MudTooltip Text="% of throws into tight windows. Higher = more aggressive/risky passing.">
                                                    Aggressiveness
                                                </MudTooltip>
                                            </th>
                                            <th>
                                                <MudTooltip Text="Completion % Above Expectation. Positive = outperforming expected completion rate.">
                                                    CPOE
                                                </MudTooltip>
                                            </th>
                                        }
                                        else if (_ngsCategory == "rushing")
                                        {
                                            <th>
                                                <MudTooltip Text="Rush efficiency rating based on yards gained vs expected.">
                                                    Efficiency
                                                </MudTooltip>
                                            </th>
                                            <th>
                                                <MudTooltip Text="Rush Yards Over Expected. Positive = gaining more yards than expected.">
                                                    RYOE
                                                </MudTooltip>
                                            </th>
                                            <th>
                                                <MudTooltip Text="RYOE per attempt. Measures consistent value above expectation per carry.">
                                                    RYOE/Att
                                                </MudTooltip>
                                            </th>
                                            <th>
                                                <MudTooltip Text="Total rush attempts for the season/week.">
                                                    Attempts
                                                </MudTooltip>
                                            </th>
                                        }
                                        else
                                        {
                                            <th>
                                                <MudTooltip Text="Average separation from defender at catch point. Higher = more open.">
                                                    Separation
                                                </MudTooltip>
                                            </th>
                                            <th>
                                                <MudTooltip Text="Average distance from defender at snap. Higher = playing off coverage.">
                                                    Cushion
                                                </MudTooltip>
                                            </th>
                                            <th>
                                                <MudTooltip Text="Number of times targeted on pass plays.">
                                                    Targets
                                                </MudTooltip>
                                            </th>
                                            <th>
                                                <MudTooltip Text="Average Yards After Catch. Higher = more elusive with ball in hands.">
                                                    YAC
                                                </MudTooltip>
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var player in _ngsData.Take(50))
                                    {
                                        <tr>
                                            <td><strong>@GetString(player, "player_display_name")</strong></td>
                                            <td>@GetString(player, "team_abbr")</td>
                                            @if (_ngsCategory == "passing")
                                            {
                                                <td>@GetDouble(player, "avg_time_to_throw").ToString("F2")s</td>
                                                <td>@GetDouble(player, "avg_completed_air_yards").ToString("F1")</td>
                                                <td>
                                                    @{
                                                        var agg = GetDouble(player, "aggressiveness") * 100;
                                                    }
                                                    @agg.ToString("F1")%
                                                </td>
                                                <td>
                                                    @{ var cpoe = GetDouble(player, "completion_percentage_above_expectation"); }
                                                    <MudChip T="string" Size="Size.Small" 
                                                             Color="@(cpoe > 0 ? Color.Success : Color.Error)">
                                                        @(cpoe > 0 ? "+" : "")@cpoe.ToString("F1")%
                                                    </MudChip>
                                                </td>
                                            }
                                            else if (_ngsCategory == "rushing")
                                            {
                                                <td>@GetDouble(player, "efficiency").ToString("F1")</td>
                                                <td>@GetDouble(player, "rush_yards_over_expected").ToString("F1")</td>
                                                <td>@GetDouble(player, "rush_yards_over_expected_per_att").ToString("F2")</td>
                                                <td>@GetDouble(player, "rush_attempts").ToString("F0")</td>
                                            }
                                            else
                                            {
                                                <td>@GetDouble(player, "avg_separation").ToString("F1")</td>
                                                <td>@GetDouble(player, "avg_cushion").ToString("F1")</td>
                                                <td>@GetDouble(player, "targets").ToString("F0")</td>
                                                <td>@GetDouble(player, "avg_yac").ToString("F1")</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    }
                    else if (!_isLoading)
                    {
                        <MudPaper Class="pa-16 d-flex flex-column align-center justify-center" Style="min-height: 400px;">
                            <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="Size.Large" Color="Color.Primary" Class="mb-4" />
                            <MudText Typo="Typo.h5">Next Gen Stats</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="text-center">
                                Player tracking data including speed, separation, and efficiency metrics
                            </MudText>
                        </MudPaper>
                    }
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        
        @* Tab 2: Snap Counts *@
        <MudTabPanel Text="Snap Counts" Icon="@Icons.Material.Filled.Timer">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Filters</MudText>
                        
                        <MudSelect T="int" @bind-Value="_snapSeason" Label="Season" 
                                   Variant="Variant.Outlined" Class="mb-3">
                            @for (int y = DateTime.Now.Year; y >= 2012; y--)
                            {
                                var year = y;
                                <MudSelectItem Value="@year">@year</MudSelectItem>
                            }
                        </MudSelect>
                        
                        <MudTextField @bind-Value="_snapTeam" Label="Team (abbr)" 
                                      Variant="Variant.Outlined" Class="mb-3" />
                        
                        <MudTextField @bind-Value="_snapPlayer" Label="Player Name" 
                                      Variant="Variant.Outlined" Class="mb-3" />
                        
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   OnClick="LoadSnapCounts" Disabled="@_isLoading">
                            @if (_isLoading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                            Load Snaps
                        </MudButton>
                    </MudPaper>
                </MudItem>
                
                <MudItem xs="12" md="9">
                    @if (_snapData != null && _snapData.Any())
                    {
                        <MudPaper Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">
                                Snap Counts (@_snapSeason) - @_snapData.Count results
                            </MudText>
                            
                            <MudSimpleTable Dense="true" Hover="true" Striped="true">
                                <thead>
                                    <tr>
                                        <th>Player</th>
                                        <th>Team</th>
                                        <th>Position</th>
                                        <th>Week</th>
                                        <th>Off Snaps</th>
                                        <th>Off %</th>
                                        <th>Def Snaps</th>
                                        <th>ST Snaps</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var snap in _snapData.Take(50))
                                    {
                                        <tr>
                                            <td><strong>@GetString(snap, "player")</strong></td>
                                            <td>@GetString(snap, "team")</td>
                                            <td>@GetString(snap, "position")</td>
                                            <td>@GetDouble(snap, "week").ToString("F0")</td>
                                            <td>@GetDouble(snap, "offense_snaps").ToString("F0")</td>
                                            <td>
                                                @{ var offPct = GetDouble(snap, "offense_pct"); }
                                                <MudChip T="string" Size="Size.Small" 
                                                         Color="@(offPct >= 0.75 ? Color.Success : offPct >= 0.5 ? Color.Warning : Color.Default)">
                                                    @(offPct * 100).ToString("F0")%
                                                </MudChip>
                                            </td>
                                            <td>@GetDouble(snap, "defense_snaps").ToString("F0")</td>
                                            <td>@GetDouble(snap, "st_snaps").ToString("F0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    }
                    else if (!_isLoading)
                    {
                        <MudPaper Class="pa-16 d-flex flex-column align-center justify-center" Style="min-height: 400px;">
                            <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Large" Color="Color.Info" Class="mb-4" />
                            <MudText Typo="Typo.h5">Snap Counts</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Player participation data by game (2012+)
                            </MudText>
                        </MudPaper>
                    }
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        
        @* Tab 3: Combine Data *@
        <MudTabPanel Text="Combine" Icon="@Icons.Material.Filled.FitnessCenter">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Filters</MudText>
                        
                        <MudSelect T="string" @bind-Value="_combinePosition" Label="Position" 
                                   Variant="Variant.Outlined" Class="mb-3">
                            <MudSelectItem Value="@("")">All Positions</MudSelectItem>
                            <MudSelectItem Value="@("QB")">QB</MudSelectItem>
                            <MudSelectItem Value="@("RB")">RB</MudSelectItem>
                            <MudSelectItem Value="@("WR")">WR</MudSelectItem>
                            <MudSelectItem Value="@("TE")">TE</MudSelectItem>
                            <MudSelectItem Value="@("OL")">OL</MudSelectItem>
                            <MudSelectItem Value="@("DL")">DL</MudSelectItem>
                            <MudSelectItem Value="@("LB")">LB</MudSelectItem>
                            <MudSelectItem Value="@("CB")">CB</MudSelectItem>
                            <MudSelectItem Value="@("S")">S</MudSelectItem>
                        </MudSelect>
                        
                        <MudSelect T="int?" @bind-Value="_combineYear" Label="Draft Year" 
                                   Variant="Variant.Outlined" Class="mb-3">
                            <MudSelectItem Value="@((int?)null)">All Years</MudSelectItem>
                            @for (int y = DateTime.Now.Year; y >= 2000; y--)
                            {
                                var year = y;
                                <MudSelectItem Value="@((int?)year)">@year</MudSelectItem>
                            }
                        </MudSelect>
                        
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   OnClick="LoadCombineData" Disabled="@_isLoading">
                            @if (_isLoading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                            Load Combine
                        </MudButton>
                    </MudPaper>
                </MudItem>
                
                <MudItem xs="12" md="9">
                    @if (_combineData != null && _combineData.Any())
                    {
                        <MudPaper Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">
                                NFL Combine Results - @_combineData.Count athletes
                            </MudText>
                            
                            <MudSimpleTable Dense="true" Hover="true" Striped="true">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Pos</th>
                                        <th>Year</th>
                                        <th>40 Yard</th>
                                        <th>Bench</th>
                                        <th>Vertical</th>
                                        <th>Broad</th>
                                        <th>3 Cone</th>
                                        <th>Shuttle</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var athlete in _combineData.Take(50))
                                    {
                                        <tr>
                                            <td><strong>@GetString(athlete, "player_name")</strong></td>
                                            <td>@GetString(athlete, "pos")</td>
                                            <td>@GetDouble(athlete, "draft_year").ToString("F0")</td>
                                            <td>
                                                @{ var forty = GetDouble(athlete, "forty"); }
                                                @if (forty > 0)
                                                {
                                                    <MudChip T="string" Size="Size.Small" 
                                                             Color="@(forty < 4.4 ? Color.Success : forty < 4.6 ? Color.Info : Color.Default)">
                                                        @forty.ToString("F2")s
                                                    </MudChip>
                                                }
                                                else { <span>-</span> }
                                            </td>
                                            <td>@(GetDouble(athlete, "bench") > 0 ? GetDouble(athlete, "bench").ToString("F0") : "-")</td>
                                            <td>@(GetDouble(athlete, "vertical") > 0 ? GetDouble(athlete, "vertical").ToString("F1") + "\"" : "-")</td>
                                            <td>@(GetDouble(athlete, "broad_jump") > 0 ? GetDouble(athlete, "broad_jump").ToString("F0") + "\"" : "-")</td>
                                            <td>@(GetDouble(athlete, "cone") > 0 ? GetDouble(athlete, "cone").ToString("F2") + "s" : "-")</td>
                                            <td>@(GetDouble(athlete, "shuttle") > 0 ? GetDouble(athlete, "shuttle").ToString("F2") + "s" : "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    }
                    else if (!_isLoading)
                    {
                        <MudPaper Class="pa-16 d-flex flex-column align-center justify-center" Style="min-height: 400px;">
                            <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Color="Color.Warning" Class="mb-4" />
                            <MudText Typo="Typo.h5">NFL Combine</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Athletic measurables from the NFL Combine (2000+)
                            </MudText>
                        </MudPaper>
                    }
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        
        @* Tab 4: Data Status *@
        <MudTabPanel Text="Data Status" Icon="@Icons.Material.Filled.Storage">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Dataset Availability</MudText>
                        
                        @if (_fileStatus != null)
                        {
                            <MudList T="string" Dense="true">
                                @foreach (var kvp in _fileStatus.OrderBy(x => x.Key))
                                {
                                    <MudListItem>
                                        <MudStack Row="true" AlignItems="AlignItems.Center">
                                            <MudIcon Icon="@(kvp.Value.Exists ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                                     Color="@(kvp.Value.Exists ? Color.Success : Color.Error)" />
                                            <MudText>
                                                @kvp.Key
                                                @if (kvp.Value.LastModified.HasValue)
                                                {
                                                    <span style="font-size: 0.8em; opacity: 0.7; margin-left: 8px;">
                                                        (@kvp.Value.LastModified.Value.ToString("g"))
                                                    </span>
                                                }
                                            </MudText>
                                        </MudStack>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                        
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-4" FullWidth="true"
                                   OnClick="CheckDataStatus">
                            Refresh Status
                        </MudButton>
                    </MudPaper>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Download Data</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">
                            Download comprehensive nflverse datasets including Next Gen Stats, 
                            snap counts, combine data, and more.
                        </MudText>
                        
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   OnClick="DownloadData" Disabled="@_isDownloading" Class="mb-3">
                            @if (_isDownloading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                @:Downloading...
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CloudDownload" Class="mr-2" />
                                @:Download All Datasets
                            }
                        </MudButton>
                        
                        @if (_downloadResult != null)
                        {
                            <MudAlert Severity="Severity.Success">
                                Download complete! Check status for results.
                            </MudAlert>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        
        @* Tab 4: Draft Picks *@
        <MudTabPanel Text="Draft Picks" Icon="@Icons.Material.Filled.School">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Filters</MudText>
                        <MudSelect T="int?" @bind-Value="_draftYear" Label="Year" Variant="Variant.Outlined" Clearable="true" Class="mb-3">
                            @for (int y = DateTime.Now.Year; y >= 2000; y--) { var year = y; <MudSelectItem T="int?" Value="@year">@year</MudSelectItem> }
                        </MudSelect>
                        <MudSelect T="string" @bind-Value="_draftTeam" Label="Team" Variant="Variant.Outlined" Clearable="true" Class="mb-3">
                            @foreach (var team in NFL_TEAMS) { <MudSelectItem Value="@team">@team</MudSelectItem> }
                        </MudSelect>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="LoadDraftData" Disabled="@_isLoading">Load Draft</MudButton>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="9">
                    <MudTable Items="@_draftData" Dense="true" Hover="true" Striped="true" Loading="@_isLoading">
                        <HeaderContent>
                            <MudTh>Year</MudTh><MudTh>Rnd</MudTh><MudTh>Pick</MudTh><MudTh>Team</MudTh><MudTh>Player</MudTh><MudTh>Pos</MudTh><MudTh>College</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@GetString(context, "season")</MudTd>
                            <MudTd>@GetString(context, "round")</MudTd>
                            <MudTd>@GetString(context, "pick")</MudTd>
                            <MudTd>@GetString(context, "team")</MudTd>
                            <MudTd>@GetString(context, "pfr_player_name")</MudTd>
                            <MudTd>@GetString(context, "position")</MudTd>
                            <MudTd>@GetString(context, "college")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        @* Tab 5: Injuries *@
        <MudTabPanel Text="Injuries" Icon="@Icons.Material.Filled.LocalHospital">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Filters</MudText>
