@code {
    private int _activeTab = 0;
    private bool _isLoading = false;
    private bool _isDownloading = false;
    private bool _dataLoaded = false;
    
    // NGS state
    private int _selectedSeason = DateTime.Now.Year;
    private string _ngsCategory = "passing";
    private string _playerFilter = "";
    private string _teamFilter = "";
    private List<Dictionary<string, object>>? _ngsData;
    
    // Snap counts state
    private int _snapSeason = DateTime.Now.Year;
    private string _snapTeam = "";
    private string _snapPlayer = "";
    private List<Dictionary<string, object>>? _snapData;
    
    // Combine state
    private string _combinePosition = "";
    private int? _combineYear;
    private List<Dictionary<string, object>>? _combineData;
    
    // Draft Picks state
    private int? _draftYear;
    private string _draftTeam = "";
    private List<Dictionary<string, object>>? _draftData;
    
    // Injuries state
    private int? _injuryYear = DateTime.Now.Year;
    private string _injuryTeam = "";
    private List<Dictionary<string, object>>? _injuryData;
    
    // Contracts state
    private string _contractTeam = "";
    private List<Dictionary<string, object>>? _contractData;
    
    // Teams state
    private List<Dictionary<string, object>>? _teamData;

    // Advanced Stats state
    private int? _advSeason = DateTime.Now.Year;
    private string _advCategory = "passing";
    private string _advTeam = "";
    private List<Dictionary<string, object>>? _advData;
    
    // Data status
    private Dictionary<string, string> _datasetStatus = new();
    private string? _downloadResult;
    
    // Dialog state
    private bool _showDownloadDialog = false;
    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
    
    // Leaderboard state
    private List<Dictionary<string, object>> _qbLeaders = new();
    private List<Dictionary<string, object>> _rbLeaders = new();
    private List<Dictionary<string, object>> _wrLeaders = new();
    private List<Dictionary<string, object>> _teLeaders = new();
    
    // Status tracking
    private class DatasetInfo
    {
        public bool Exists { get; set; }
        public DateTime? LastModified { get; set; }
    }
    private Dictionary<string, DatasetInfo> _fileStatus = new();
    
    protected override async Task OnInitializedAsync()
    {
        await CheckDataStatus();
    }
    
    private async Task CheckDataStatus()
    {
        try
        {
            var response = await Http.GetAsync("http://backend:8000/nfl/data/status");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var root = JsonSerializer.Deserialize<JsonElement>(json);
                
                _fileStatus.Clear();
                
                void ParseRecursive(JsonElement element, string prefix)
                {
                    if (element.ValueKind == JsonValueKind.Object)
                    {
                        // Check if leaf node (has "exists" property)
                        if (element.TryGetProperty("exists", out var existsProp))
                        {
                            var info = new DatasetInfo { Exists = existsProp.GetBoolean() };
                            if (element.TryGetProperty("timestamp", out var tsProp) && tsProp.ValueKind == JsonValueKind.String)
                            {
                                if (DateTime.TryParse(tsProp.GetString(), out var dt))
                                    info.LastModified = dt;
                            }
                            _fileStatus[prefix] = info;
                        }
                        else
                        {
                            // Recurse
                            foreach (var prop in element.EnumerateObject())
                            {
                                var key = string.IsNullOrEmpty(prefix) ? prop.Name : $"{prefix}.{prop.Name}";
                                ParseRecursive(prop.Value, key);
                            }
                        }
                    }
                }
                
                ParseRecursive(root, "");
                _dataLoaded = _fileStatus.Values.Any(x => x.Exists);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error checking data status");
        }
    }
    
