    // Leaderboard methods
    private async Task LoadQBLeaders()
    {
        try
        {
            var response = await Http.GetAsync($"http://backend:8000/nfl/ngs?season={_selectedSeason}&category=passing&limit=20");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var data = JsonSerializer.Deserialize<List<Dictionary<string, object>>>(json, 
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (data != null)
                {
                    _qbLeaders = data.OrderByDescending(x => GetDouble(x, "passing_yards")).Take(10).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading QB leaders");
        }
    }
    
