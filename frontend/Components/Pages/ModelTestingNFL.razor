    // ESPN FPI Methods
    private async Task LoadEspnData()
    {
        _espnLoading = true;
        _espnError = null;
        _espnGames.Clear();
        StateHasChanged();

        try
        {
            var resp = await Http.GetAsync("http://backend:8000/espn/nfl");
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadAsStringAsync();
                var doc = JsonDocument.Parse(json);
                
                if (doc.RootElement.TryGetProperty("games", out var gamesArray))
                {
                    foreach (var game in gamesArray.EnumerateArray())
                    {
                        _espnGames.Add(new EspnNflGame
                        {
                            EventId = game.GetProperty("event_id").GetString() ?? "",
                            HomeTeam = game.GetProperty("home_team").GetString() ?? "",
                            AwayTeam = game.GetProperty("away_team").GetString() ?? "",
                            HomeAbbrev = game.GetProperty("home_abbrev").GetString() ?? "",
                            AwayAbbrev = game.GetProperty("away_abbrev").GetString() ?? "",
                            HomeRecord = game.GetProperty("home_record").GetString() ?? "",
                            AwayRecord = game.GetProperty("away_record").GetString() ?? "",
                            Status = game.GetProperty("status").GetString() ?? "",
                            HomeWinProb = game.GetProperty("home_win_prob").GetDouble(),
                            AwayWinProb = game.GetProperty("away_win_prob").GetDouble(),
                            TotalOverProb = game.GetProperty("total_over_prob").GetDouble(),
                            SpreadCoverHomeProb = game.GetProperty("spread_cover_home_prob").GetDouble(),
                            HasFpi = game.GetProperty("has_fpi").GetBoolean()
                        });
                    }
                }

                if (_espnGames.Count == 0)
                {
                    _espnError = "No NFL games found in ESPN data.";
                }
                else
                {
                    Snackbar.Add($"Loaded ESPN FPI for {_espnGames.Count} games", Severity.Success);
                }
            }
            else
            {
                _espnError = $"Failed to load ESPN data: {resp.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _espnError = $"Error: {ex.Message}";
        }

        _espnLoading = false;
        StateHasChanged();
    }

    private string GetEspnCardStyle(EspnNflGame game)
    {
        if (!game.HasFpi) return "opacity: 0.7;";
        if (game.TotalOverProb < 0.35) return "border-left: 4px solid #9c27b0;";
        if (game.TotalOverProb > 0.65) return "border-left: 4px solid #f44336;";
        return "";
    }

    private Color GetEspnStatusColor(string status)
    {
        if (status.Contains("Final")) return Color.Success;
        if (status.Contains("progress") || status.Contains("Half") || status.Contains("Q")) return Color.Warning;
        return Color.Default;
    }

