@page "/model-testing-nfl"
@page "/live-nfl-odds"
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ILogger<ModelTestingNFL> Logger
@inject PythonMLServiceClient MLServiceClient

<PageTitle>NFL Model Testing</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <div>
                    <MudText Typo="Typo.h4">
                        <MudIcon Icon="@Icons.Material.Filled.SportsFootball" Class="mr-2" />
                        NFL Model Testing
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Using nflverse data (EPA, success rate, etc.) - no hardcoded values
                    </MudText>
                </div>
                <MudStack Row="true" Spacing="2">
                    <MudSelect T="string" @bind-Value="_selectedSportsbook" Label="Sportsbook" 
                               Variant="Variant.Outlined" Dense="true" Style="width: 150px;">
                        <MudSelectItem Value="@("fanduel")">FanDuel</MudSelectItem>
                        <MudSelectItem Value="@("draftkings")">DraftKings</MudSelectItem>
                        <MudSelectItem Value="@("betmgm")">BetMGM</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="@RunAnalysis" Disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Analyzing...</span>
                        }
                        else
                        {
                            <span>Analyze Games</span>
                        }
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.History"
                               Href="/daily-analysis">
                        View Cache
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
        
        <!-- Quick Reference Card -->
        <MudPaper Class="pa-3" Elevation="1" Style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap" Style="gap: 12px;">
                <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                    <MudTooltip Text="Expected Value: (Win% × Profit) - (Loss% × Stake). Positive = value bet, Negative = sportsbook has edge.">
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Class="mr-1" />
                            EV = Edge
                        </MudChip>
                    </MudTooltip>
                    <MudTooltip Text="Kelly %: Optimal bet size based on your edge. Higher = more confident. 0% = don't bet.">
                        <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Class="mr-1" />
                            Kelly = Bet Size
                        </MudChip>
                    </MudTooltip>
                    <MudTooltip Text="Models Agree: Strongest signal - bet with confidence. Models Disagree: Proceed with caution or skip.">
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.Handshake" Size="Size.Small" Class="mr-1" />
                            Agree = Strong
                        </MudChip>
                    </MudTooltip>
                    <MudTooltip Text="Simple model uses current season stats. XGBoost is ML-trained on historical data.">
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" Class="mr-1" />
                            XGB = ML Model
                        </MudChip>
                    </MudTooltip>
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />
                    Hover chips for details
                </MudText>
            </MudStack>
        </MudPaper>

        @if (_error != null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_error</MudAlert>
        }

        <ApiQuotaTracker />

        <!-- Tabs for Games and ESPN -->
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
            <!-- Games Tab -->
            <MudTabPanel Text="Games" Icon="@Icons.Material.Filled.SportsFootball">
                @if (_games.Any())
                {
                    <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                        @_games.Count game(s) found • @_date • Stats from nflverse
                    </MudText>
                    
                    <MudGrid Spacing="3">
                        @foreach (var game in _games)
                        {
                            <MudItem xs="12" md="6" lg="4">
                                <MudCard Elevation="3" Class="h-100" Style="border-left: 4px solid #4caf50;">
                                    <MudCardHeader>
                                        <CardHeaderContent>
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                <MudText Typo="Typo.h6">@game.AwayTeam</MudText>
                                                <MudText Typo="Typo.caption">@@</MudText>
                                                <MudText Typo="Typo.h6">@game.HomeTeam</MudText>
                                            </MudStack>
                                        </CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudStack Spacing="2">
                                            <!-- Odds Row -->
                                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                                <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                                    Away: @FormatOdds(game.AwayMoneyline)
                                                </MudChip>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                                    Home: @FormatOdds(game.HomeMoneyline)
                                                </MudChip>
                                            </MudStack>
                                            
                                            <MudDivider />
                                            
                                            <!-- Model Comparison Table -->
                                            <MudSimpleTable Dense="true" Hover="true" Style="background: transparent;">
                                                <thead>
                                                    <tr style="background: rgba(0,0,0,0.1);">
                                                        <th></th>
                                                        <th style="text-align: center;">📊 Simple</th>
                                                        <th style="text-align: center;">🤖 XGBoost</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td><MudText Typo="Typo.caption">Home Win %</MudText></td>
                                                        <td style="text-align: center;">
                                                            <strong style="color: #4caf50;">
                                                                @(((game.SimpleModel?.HomeWinProb ?? 0) * 100).ToString("F1"))%
                                                            </strong>
                                                        </td>
                                                        <td style="text-align: center;">
                                                            @if (game.XgbModel?.Error == null)
                                                            {
                                                                <strong style="color: #2196f3;">
                                                                    @(((game.XgbModel?.HomeWinProb ?? 0) * 100).ToString("F1"))%
                                                                </strong>
                                                            }
                                                            else
                                                            {
                                                                <MudText Typo="Typo.caption" Color="Color.Warning">Train Required</MudText>
                                                            }
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td><MudText Typo="Typo.caption">Pick (ML)</MudText></td>
                                                        <td style="text-align: center; color: #4caf50;">
                                                            @(game.SimpleModel?.PredictedWinner ?? "—")
                                                        </td>
                                                        <td style="text-align: center; color: #2196f3;">
                                                            @(game.XgbModel?.PredictedWinner ?? "—")
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td><MudText Typo="Typo.caption">EV (Home)</MudText></td>
                                                        <td style="text-align: center;">
                                                            <span style="color: @(game.SimpleModel?.EvHome > 0 ? "#4caf50" : "#f44336")">
                                                                @(game.SimpleModel?.EvHome?.ToString("+0.00;-0.00") ?? "—")
                                                            </span>
                                                        </td>
                                                        <td style="text-align: center;">
                                                            <span style="color: @(game.XgbModel?.EvHome > 0 ? "#4caf50" : "#f44336")">
                                                                @(game.XgbModel?.EvHome?.ToString("+0.00;-0.00") ?? "—")
                                                            </span>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td><MudText Typo="Typo.caption">Kelly %</MudText></td>
                                                        <td style="text-align: center;">
                                                            @(game.SimpleModel?.KellyHome?.ToString("F1") ?? "—")%
                                                        </td>
                                                        <td style="text-align: center;">
                                                            @(game.XgbModel?.KellyHome?.ToString("F1") ?? "—")%
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </MudSimpleTable>
                                            
                                            <!-- Agreement Badge -->
                                            @{
                                                var simpleWinner = game.SimpleModel?.PredictedWinner;
                                                var xgbWinner = game.XgbModel?.PredictedWinner;
                                                var modelsAgree = simpleWinner == xgbWinner && simpleWinner != null;
                                            }
                                            <MudStack Row="true" Justify="Justify.Center">
                                                @if (modelsAgree)
                                                {
                                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">
                                                        ✓ Models Agree: @simpleWinner
                                                    </MudChip>
                                                }
                                                else if (xgbWinner != null)
                                                {
                                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">
                                                        ⚠ Models Disagree
                                                    </MudChip>
                                                }
                                            </MudStack>
                                            <!-- Save to Cache Button -->
                                            <MudDivider Class="my-2" />
                                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" FullWidth="true"
                                                       StartIcon="@Icons.Material.Filled.Save"
                                                       OnClick="@(() => SaveGameToCache(game))" Disabled="@game.IsSaving">
                                                @if (game.IsSaving)
                                                {
                                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                                    <span>Saving...</span>
                                                }
                                                else
                                                {
                                                    <span>Save to Daily Cache</span>
                                                }
                                            </MudButton>
                                        </MudStack>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else if (!_isLoading)
                {
                    <MudAlert Severity="Severity.Info">
                        Click "Analyze Games" to fetch today's NFL games and run predictions.
                    </MudAlert>
                }
            </MudTabPanel>
            
            <!-- ESPN FPI Tab -->
            <MudTabPanel Text="ESPN FPI" Icon="@Icons.Material.Filled.Analytics">
                <MudStack Spacing="3">
                    <MudPaper Class="pa-4" Elevation="2" Style="background: linear-gradient(135deg, #c62828 0%, #e53935 100%);">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <div>
                                <MudText Typo="Typo.h5" Style="color: white;">
                                    <MudIcon Icon="@Icons.Material.Filled.SportsFootball" Class="mr-2" />
                                    ESPN FPI Predictions
                                </MudText>
                                <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.8);">
                                    Football Power Index • External "Second Opinion"
                                </MudText>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="LoadEspnData" Disabled="@_espnLoading">
                                @(_espnLoading ? "Loading..." : "Load ESPN Data")
                            </MudButton>
                        </MudStack>
                    </MudPaper>

                    @if (_espnError != null)
                    {
                        <MudAlert Severity="Severity.Error">@_espnError</MudAlert>
                    }

                    @if (_espnLoading)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Error" />
                    }
                    else if (_espnGames.Any())
                    {
                        <MudGrid Spacing="3">
                            @foreach (var game in _espnGames)
                            {
                                <MudItem xs="12" md="6" lg="4">
                                    <MudCard Elevation="3" Style="@GetEspnCardStyle(game)">
                                        <MudCardHeader>
                                            <CardHeaderContent>
                                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                    <MudStack>
                                                        <MudText Typo="Typo.subtitle1">@game.AwayTeam</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@game.AwayRecord</MudText>
                                                    </MudStack>
                                                    <MudText Typo="Typo.caption">@@</MudText>
                                                    <MudStack>
                                                        <MudText Typo="Typo.subtitle1">@game.HomeTeam</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@game.HomeRecord</MudText>
                                                    </MudStack>
                                                </MudStack>
                                            </CardHeaderContent>
                                            <CardHeaderActions>
                                                <MudChip T="string" Size="Size.Small" Color="@GetEspnStatusColor(game.Status)">@game.Status</MudChip>
                                            </CardHeaderActions>
                                        </MudCardHeader>
                                        <MudCardContent>
                                            <MudStack Spacing="2">
                                                @if (game.HasFpi)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Win Probability (FPI)</MudText>
                                                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                                                        <MudChip T="string" Size="Size.Small" Color="@(game.AwayWinProb > 0.5 ? Color.Success : Color.Default)">
                                                            @game.AwayAbbrev: @((game.AwayWinProb * 100).ToString("F0"))%
                                                        </MudChip>
                                                        <MudChip T="string" Size="Size.Small" Color="@(game.HomeWinProb > 0.5 ? Color.Success : Color.Default)">
                                                            @game.HomeAbbrev: @((game.HomeWinProb * 100).ToString("F0"))%
                                                        </MudChip>
                                                    </MudStack>
                                                    <MudDivider />
                                                    <MudPaper Class="pa-2" Style="background: rgba(0,0,0,0.05);">
                                                        <MudStack Spacing="1">
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Over/Under Probability</MudText>
                                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                                <MudChip T="string" Size="Size.Small" 
                                                                         Color="@(game.TotalOverProb > 0.5 ? Color.Info : Color.Secondary)">
                                                                    @(game.TotalOverProb > 0.5 ? "OVER" : "UNDER") Favored
                                                                </MudChip>
                                                                <MudText>
                                                                    <strong>@((Math.Max(game.TotalOverProb, 1 - game.TotalOverProb) * 100).ToString("F0"))%</strong>
                                                                </MudText>
                                                            </MudStack>
                                                            <MudProgressLinear Value="@(game.TotalOverProb * 100)" Color="Color.Error" Size="Size.Small" />
                                                        </MudStack>
                                                    </MudPaper>
                                                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                                                        <MudText Typo="Typo.caption">Spread Cover (Home):</MudText>
                                                        <MudText Typo="Typo.caption"><strong>@((game.SpreadCoverHomeProb * 100).ToString("F0"))%</strong></MudText>
                                                    </MudStack>
                                                }
                                                else
                                                {
                                                    <MudAlert Severity="Severity.Info" Dense="true">FPI data not available</MudAlert>
                                                }
                                            </MudStack>
                                        </MudCardContent>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">
                            Click "Load ESPN Data" to fetch ESPN's FPI predictions for current NFL games.
                        </MudAlert>
                    }

                    <MudPaper Class="pa-3" Elevation="1" Style="background: rgba(198, 40, 40, 0.1);">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Warning" />
                            <MudText Typo="Typo.caption">
                                Data from ESPN's unofficial FPI API. Use as a "second opinion" alongside your model predictions.
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudStack>
            </MudTabPanel>

            <!-- AI Predictions Tab -->
            <MudTabPanel Text="AI Predictions" Icon="@Icons.Material.Filled.Psychology">
                <MudStack Spacing="3">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        <strong>NFL Intelligence:</strong> Multi-engine analysis + Google Gemini Insights.
                    </MudAlert>
                    
                    @if (_games.Any())
                    {
                        <MudGrid Spacing="3">
                            @foreach (var game in _games)
                            {
                                <MudItem xs="12" md="6">
                                    <MudCard Elevation="3">
                                        <MudCardHeader Style="background: linear-gradient(135deg, #1a237e 0%, #0d47a1 100%);">
                                            <CardHeaderContent>
                                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                    <MudText Typo="Typo.h6" Style="color: white;">@game.AwayTeam @@ @game.HomeTeam</MudText>
                                                </MudStack>
                                            </CardHeaderContent>
                                        </MudCardHeader>
                                        <MudCardContent>
                                            <div class="mt-2">
                                                @if (game.GeminiAnalysis == null)
                                                {
                                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" 
                                                               StartIcon="@Icons.Material.Filled.AutoFixHigh" 
                                                               OnClick="@(() => GetGeminiAnalysis(game))" Disabled="@game.IsGeneratingAi">
                                                        @if (game.IsGeneratingAi)
                                                        {
                                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                                            <span>Generating AI Analysis...</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Run AI Advisor</span>
                                                        }
                                                    </MudButton>
                                                }
                                                else
                                                {
                                                    <!-- Engine Summary -->
                                                    <MudSimpleTable Dense="true" Hover="true" Class="mb-3">
                                                        <thead>
                                                            <tr>
                                                                <th>Engine</th>
                                                                <th style="text-align: center;">Home Win %</th>
                                                                <th style="text-align: center;">Pred Score</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var engine in game.GeminiAnalysis.Engines)
                                                            {
                                                                <tr>
                                                                    <td>@engine.Key</td>
                                                                    <td style="text-align: center;">@((engine.Value.HomeWinProb * 100).ToString("F1"))%</td>
                                                                    <td style="text-align: center;">@engine.Value.AwayScore - @engine.Value.HomeScore</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </MudSimpleTable>

                                                    <!-- Gemini Rationale -->
                                                    <MudPaper Class="pa-4" Style="background: #fafafa; border: 1px solid #e0e0e0; border-radius: 8px;">
                                                        <div class="d-flex align-center mb-2">
                                                            <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" Color="Color.Secondary" Class="mr-2" />
                                                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Gemini Analysis</MudText>
                                                        </div>
                                                        
                                                        <div class="d-flex align-center mb-3 pa-2 rounded" style="background: #fff8e1; border-left: 3px solid #ffc107;">
                                                            <MudText Typo="Typo.caption"><b>Key Factor:</b> @game.GeminiAnalysis.LlmInsight?.KeyFactor</MudText>
                                                        </div>
                                                        
                                                        <div style="font-family: 'Inter', 'Roboto', sans-serif; font-size: 0.9rem; line-height: 1.75; color: #37474f;">
                                                            @((MarkupString)(game.GeminiAnalysis.LlmInsight?.Rationale ?? ""))
                                                        </div>
                                                    </MudPaper>
                                                }
                                            </div>
                                        </MudCardContent>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">
                            Load NFL games from the "Games" tab first.
                        </MudAlert>
                    }
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudContainer>

@code {
    private bool _isLoading = false;
    private bool _isTraining = false;
    private string? _error = null;
    private string _selectedSportsbook = "fanduel";
    private string _date = "";
    private List<GamePrediction> _games = new();
    
    // ESPN FPI state
    private bool _espnLoading = false;
    private string? _espnError = null;
    private List<EspnNflGame> _espnGames = new();

    private async Task RunAnalysis()
    {
        _isLoading = true;
        _error = null;
        _games.Clear();
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync(
                $"http://backend:8000/model-testing/nfl/predictions?sportsbook={_selectedSportsbook}", 
                null
            );
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var data = JsonSerializer.Deserialize<JsonElement>(json);
                
                _date = data.TryGetProperty("date", out var d) ? d.GetString() ?? "" : "";
                
                if (data.TryGetProperty("games", out var games))
                {
                    foreach (var game in games.EnumerateArray())
                    {
                        var gp = new GamePrediction
                        {
                            HomeTeam = game.TryGetProperty("home_team", out var ht) ? ht.GetString() ?? "" : "",
                            AwayTeam = game.TryGetProperty("away_team", out var at) ? at.GetString() ?? "" : "",
                            HomeMoneyline = game.TryGetProperty("home_moneyline", out var hm) && hm.ValueKind == JsonValueKind.Number ? hm.GetInt32() : null,
                            AwayMoneyline = game.TryGetProperty("away_moneyline", out var am) && am.ValueKind == JsonValueKind.Number ? am.GetInt32() : null,
                        };
                        
                        // Parse simple model
                        if (game.TryGetProperty("simple_model", out var sm))
                        {
                            gp.SimpleModel = new ModelResult
                            {
                                HomeWinProb = sm.TryGetProperty("home_win_probability", out var shp) && shp.ValueKind == JsonValueKind.Number ? shp.GetDouble() : null,
                                PredictedWinner = sm.TryGetProperty("predicted_winner", out var spw) ? spw.GetString() : null,
                                EvHome = sm.TryGetProperty("ev_home", out var seh) && seh.ValueKind == JsonValueKind.Number ? seh.GetDouble() : null,
                                EvAway = sm.TryGetProperty("ev_away", out var sea) && sea.ValueKind == JsonValueKind.Number ? sea.GetDouble() : null,
                                KellyHome = sm.TryGetProperty("kelly_home", out var skh) && skh.ValueKind == JsonValueKind.Number ? skh.GetDouble() : null,
                                KellyAway = sm.TryGetProperty("kelly_away", out var ska) && ska.ValueKind == JsonValueKind.Number ? ska.GetDouble() : null,
                            };
                        }
                        
                        // Parse XGBoost model
                        if (game.TryGetProperty("xgboost_model", out var xm))
                        {
                            gp.XgbModel = new ModelResult
                            {
                                HomeWinProb = xm.TryGetProperty("home_win_probability", out var xhp) && xhp.ValueKind == JsonValueKind.Number ? xhp.GetDouble() : null,
                                PredictedWinner = xm.TryGetProperty("predicted_winner", out var xpw) ? xpw.GetString() : null,
                                EvHome = xm.TryGetProperty("ev_home", out var xeh) && xeh.ValueKind == JsonValueKind.Number ? xeh.GetDouble() : null,
                                EvAway = xm.TryGetProperty("ev_away", out var xea) && xea.ValueKind == JsonValueKind.Number ? xea.GetDouble() : null,
                                KellyHome = xm.TryGetProperty("kelly_home", out var xkh) && xkh.ValueKind == JsonValueKind.Number ? xkh.GetDouble() : null,
                                KellyAway = xm.TryGetProperty("kelly_away", out var xka) && xka.ValueKind == JsonValueKind.Number ? xka.GetDouble() : null,
                                Error = xm.TryGetProperty("error", out var xerr) ? xerr.GetString() : null,
                            };
                            
                            // Parse over/under prediction
                            if (xm.TryGetProperty("over_under", out var ou) && ou.ValueKind == JsonValueKind.Object)
                            {
                                gp.XgbModel.OverUnder = new OverUnderPick
                                {
                                    Pick = ou.TryGetProperty("pick", out var oP) ? oP.GetString() ?? "" : "",
                                    TotalLine = ou.TryGetProperty("total_line", out var oT) && oT.ValueKind == JsonValueKind.Number ? oT.GetDouble() : 0,
                                    Confidence = ou.TryGetProperty("confidence", out var oC) && oC.ValueKind == JsonValueKind.Number ? oC.GetDouble() : 0,
                                };
                            }
                        }
                        
                        // Parse team stats for detail view
                        if (game.TryGetProperty("home_stats", out var hs) && hs.ValueKind == JsonValueKind.Object)
                        {
                            gp.HomeStats = new Dictionary<string, object>();
                            foreach (var prop in hs.EnumerateObject())
                            {
                                gp.HomeStats[prop.Name] = prop.Value.ValueKind == JsonValueKind.Number 
                                    ? prop.Value.GetDouble() 
                                    : prop.Value.ToString();
                            }
                        }
                        if (game.TryGetProperty("away_stats", out var aws) && aws.ValueKind == JsonValueKind.Object)
                        {
                            gp.AwayStats = new Dictionary<string, object>();
                            foreach (var prop in aws.EnumerateObject())
                            {
                                gp.AwayStats[prop.Name] = prop.Value.ValueKind == JsonValueKind.Number 
                                    ? prop.Value.GetDouble() 
                                    : prop.Value.ToString();
                            }
                        }
                        
                        _games.Add(gp);
                    }
                }
                
                Snackbar.Add($"Analyzed {_games.Count} games", Severity.Success);
            }
            else
            {
                _error = $"API Error: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogError(ex, "Error analyzing games");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunCachedAnalysis()
    {
        _isTraining = true;
        _error = null;
        _games.Clear();
        StateHasChanged();

        try
        {
            // Use the cached endpoint - stores results and merges with previous games
            var response = await Http.PostAsync(
                $"http://backend:8000/odds/nfl/analyze-cached?sportsbook={_selectedSportsbook}&include_cached=true", 
                null
            );
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var data = JsonSerializer.Deserialize<JsonElement>(json);
                
                _date = data.TryGetProperty("date", out var d) ? d.GetString() ?? "" : "";
                
                // Get cache stats
                var cachedCount = data.TryGetProperty("cached_count", out var cc) ? cc.GetInt32() : 0;
                var freshCount = data.TryGetProperty("fresh_count", out var fc) ? fc.GetInt32() : 0;
                
                if (data.TryGetProperty("games", out var games))
                {
                    foreach (var game in games.EnumerateArray())
                    {
                        var gp = new GamePrediction
                        {
                            HomeTeam = game.TryGetProperty("home_team", out var ht) ? ht.GetString() ?? "" : "",
                            AwayTeam = game.TryGetProperty("away_team", out var at) ? at.GetString() ?? "" : "",
                            HomeMoneyline = game.TryGetProperty("home_moneyline", out var hm) && hm.ValueKind == JsonValueKind.Number ? hm.GetInt32() : null,
                            AwayMoneyline = game.TryGetProperty("away_moneyline", out var am) && am.ValueKind == JsonValueKind.Number ? am.GetInt32() : null,
                            IsCached = game.TryGetProperty("is_cached", out var ic) && ic.ValueKind == JsonValueKind.True,
                        };
                        
                        // Parse simple model
                        if (game.TryGetProperty("simple_model", out var sm) && sm.ValueKind == JsonValueKind.Object)
                        {
                            gp.SimpleModel = new ModelResult
                            {
                                HomeWinProb = sm.TryGetProperty("home_win_probability", out var shp) && shp.ValueKind == JsonValueKind.Number ? shp.GetDouble() : null,
                                PredictedWinner = sm.TryGetProperty("predicted_winner", out var spw) ? spw.GetString() : null,
                                EvHome = sm.TryGetProperty("ev_home", out var seh) && seh.ValueKind == JsonValueKind.Number ? seh.GetDouble() : null,
                                KellyHome = sm.TryGetProperty("kelly_home", out var skh) && skh.ValueKind == JsonValueKind.Number ? skh.GetDouble() : null,
                            };
                        }
                        
                        // Parse XGBoost model
                        if (game.TryGetProperty("xgboost_model", out var xm) && xm.ValueKind == JsonValueKind.Object)
                        {
                            gp.XgbModel = new ModelResult
                            {
                                HomeWinProb = xm.TryGetProperty("home_win_probability", out var xhp) && xhp.ValueKind == JsonValueKind.Number ? xhp.GetDouble() : null,
                                PredictedWinner = xm.TryGetProperty("predicted_winner", out var xpw) ? xpw.GetString() : null,
                                EvHome = xm.TryGetProperty("ev_home", out var xeh) && xeh.ValueKind == JsonValueKind.Number ? xeh.GetDouble() : null,
                                KellyHome = xm.TryGetProperty("kelly_home", out var xkh) && xkh.ValueKind == JsonValueKind.Number ? xkh.GetDouble() : null,
                                Error = xm.TryGetProperty("error", out var xerr) ? xerr.GetString() : null,
                            };
                        }
                        
                        _games.Add(gp);
                    }
                }
                
                var msg = $"Analyzed {_games.Count} games ({freshCount} fresh, {cachedCount} from cache)";
                Snackbar.Add(msg, Severity.Success);
            }
            else
            {
                _error = $"API Error: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogError(ex, "Error running cached analysis");
        }
        finally
        {
            _isTraining = false;
        }
    }

    private string FormatOdds(int? odds)
    {
        if (!odds.HasValue) return "N/A";
        return odds.Value > 0 ? $"+{odds.Value}" : odds.Value.ToString();
    }

    private string FormatPercent(object? value)
    {
        if (value == null) return "—";
        if (double.TryParse(value.ToString(), out var d))
        {
            return d > 1 ? $"{d:F1}%" : $"{d * 100:F1}%";
        }
        return value.ToString() ?? "—";
    }

    private string FormatEPA(object? value)
    {
        if (value == null) return "—";
        if (double.TryParse(value.ToString(), out var d))
        {
            var sign = d >= 0 ? "+" : "";
            return $"{sign}{d:F3}";
        }
        return value.ToString() ?? "—";
    }

