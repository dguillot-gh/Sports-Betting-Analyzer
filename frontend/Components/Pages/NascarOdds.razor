@page "/nascar-odds"
@using SportsBettingAnalyzer.Services
@using System.Text.Json
@using SportsBettingAnalyzer.Components.Dialogs
@using SportsBettingAnalyzer.Models
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@inject DataCollectionService DataCollectionService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>NASCAR Live Odds</PageTitle>

<TwContainer>
    <div class="flex flex-col gap-6">
        <!-- Header & Loading Status -->
        <TwCard Class="p-1 relative overflow-hidden">
            @if (_loading || _analyzing)
            {
                <div class="absolute top-0 left-0 right-0 h-1 bg-slate-800">
                    <div class="h-full bg-red-600 animate-progress" style="width: 60%"></div>
                </div>
            }
            <div class="p-6 flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
                <div>
                    <h1 class="text-3xl font-bold text-white flex items-center gap-3">
                        <svg class="w-8 h-8 text-red-500" fill="currentColor" viewBox="0 0 24 24"><path d="M21 16.5C21 16.88 20.79 17.21 20.47 17.38L12.57 21.82C12.41 21.94 12.21 22 12 22C11.79 22 11.59 21.94 11.43 21.82L3.53 17.38C3.21 17.21 3 16.88 3 16.5V7.5C3 7.12 3.21 6.79 3.53 6.62L11.43 2.18C11.59 2.06 11.79 2 12 2C12.21 2 12.41 2.06 12.57 2.18L20.47 6.62C20.79 6.79 21 7.12 21 7.5V16.5Z"></path></svg>
                        NASCAR Live Odds
                        @if (_loading || _analyzing)
                        {
                            <span class="text-xs font-normal text-red-400 animate-pulse ml-2 flex items-center gap-1">
                                <span class="block w-1.5 h-1.5 rounded-full bg-red-600"></span>
                                @(_analyzing ? "Generating AI race report..." : "Processing race data...")
                            </span>
                        }
                    </h1>
                    <p class="text-slate-400 mt-1">AI-powered predictions for upcoming NASCAR races. <span class="text-[10px] opacity-70 italic">(Live odds coming soon via Action Network)</span></p>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <TwButton Variant="secondary" StartIcon="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" 
                              OnClick="OpenManualEntry">
                        Manual Entry
                    </TwButton>
                    <TwButton Variant="primary" StartIcon="M13 10V3L4 14h7v7l9-11h-7z" 
                              OnClick="GenerateRaceAnalysis" IsLoading="@_analyzing" Disabled="@(!_drivers.Any() || _analyzing)">
                        Analyze Race Value
                    </TwButton>
                    <TwFileUpload ButtonText="Upload Screenshot" StartIcon="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
                                  Accept=".jpg, .jpeg, .png" OnFilesChanged="UploadOddsImage" IsLoading="@_loading" />
                </div>
            </div>
        </TwCard>

        @if (_loading)
        {
            <div class="py-20 flex flex-col items-center justify-center">
                <TwProgressBar Indeterminate="true" Color="primary" Class="w-64 mb-4" />
                <span class="text-slate-400 font-medium">Fetching Race Data...</span>
            </div>
        }
        else if (_drivers.Any())
        {
            <TwGrid Columns="1" ColumnsSm="2" ColumnsMd="3" ColumnsLg="4" Gap="6">
                @foreach (var driver in _drivers)
                {
                    <TwCard NoPadding="true" Class="flex flex-col h-full group hover:border-red-500/50 transition-all duration-300">
                        <div class="p-5 border-b border-slate-800 bg-slate-900/40 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <TwAvatar Text="@driver.Rank.ToString()" Color="@GetConfidenceColorStr(driver.Confidence)" Size="md" />
                                <div>
                                    <h3 class="text-base font-bold text-white group-hover:text-red-400 transition-colors">@driver.DriverName</h3>
                                    <p class="text-[10px] text-slate-500 font-mono">Car #@driver.CarNumber</p>
                                </div>
                            </div>
                            @if (driver.WinProbability > 0.05) 
                            {
                                <div class="text-orange-500 animate-pulse">
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C12 2 12 2 12 2C11.55 2 11.13 2.19 10.83 2.51C10.53 2.82 10.38 3.25 10.42 3.68C10.5 4.5 10.15 5.3 9.5 5.86C8.85 6.42 8 6.53 7.25 6.18C6.12 5.61 4.71 6.07 4.14 7.21C3.57 8.34 4.03 9.75 5.17 10.33C5.92 10.69 6.27 11.48 6.08 12.28C5.89 13.08 5.18 13.62 4.38 13.56C3.12 13.51 2.06 14.49 2.01 15.75C1.96 17.01 2.94 18.07 4.2 18.12H4.22H4.24C4.24 18.12 4.25 18.12 4.25 18.12H19.75C19.75 18.12 19.76 18.12 19.76 18.12H19.78H19.8C21.06 18.07 22.04 17.01 21.99 15.75C21.94 14.49 20.88 13.51 19.62 13.56C18.82 13.62 18.11 13.08 17.92 12.28C17.73 11.48 18.08 10.69 18.83 10.33C19.97 9.75 20.43 8.34 19.86 7.21C19.29 6.07 17.88 5.61 16.75 6.18C16 6.53 15.15 6.42 14.5 5.86C13.85 5.3 13.5 4.5 13.58 3.68C13.62 3.25 13.47 2.82 13.17 2.51C12.87 2.19 12.45 2 12 2Z"></path></svg>
                                </div>
                            }
                        </div>

                        <div class="p-5 flex-1 space-y-4">
                            <div class="grid grid-cols-2 gap-2">
                                <div class="p-2 rounded bg-slate-800/50 border border-slate-700/50">
                                    <p class="text-[10px] text-slate-500 uppercase tracking-tighter">Win Prob</p>
                                    <p class="text-base font-bold text-white">@((driver.WinProbability * 100).ToString("F1"))%</p>
                                </div>
                                <div class="p-2 rounded bg-slate-800/50 border border-slate-700/50">
                                    <p class="text-[10px] text-slate-500 uppercase tracking-tighter">Proj Finish</p>
                                    <p class="text-base font-bold text-white">@driver.ProjectedFinish.ToString("F1")</p>
                                </div>
                            </div>
                            
                            <div class="flex items-center justify-between">
                                @if (driver.MarketOdds != "N/A")
                                {
                                     <TwChip Color="emerald" Variant="outline" Size="sm">Odds: @driver.MarketOdds</TwChip>
                                }
                                <div class="flex-1"></div>
                            </div>

                            <TwButton Variant="outline" Size="sm" Class="w-full" OnClick="@(() => OpenAnalysisDialog(driver))" StartIcon="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z">
                                Analyze Details
                            </TwButton>
                        </div>
                    </TwCard>
                }
            </TwGrid>
        }
        else
        {
            <TwAlert Severity="info">
                No active race data found. Check back closer to race day!
            </TwAlert>
        }
    </div>
</TwContainer>

@code {
    private bool _loading = true;
    private bool _analyzing = false;
    private List<DriverPrediction> _drivers = new();
    private int _raceId = -1; // -1 means finding next race
    private string _trackName = "Upcoming Race";
    
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            // 1. Fetch live odds from DraftKings (via Apify or Manual API)
            var oddsResult = await DataCollectionService.GetNascarOddsAsync();
            if (oddsResult.HasValue && oddsResult.Value.TryGetProperty("drivers", out var oddsDrivers))
            {
                var oddsList = JsonSerializer.Deserialize<List<DriverPrediction>>(oddsDrivers.GetRawText()) ?? new();
                UpdateDriversWithOdds(oddsList);
            }
            
            // 2. If no odds, try to get predictions (fallback)
            if (!_drivers.Any())
            {
                var status = await DataCollectionService.GetNascarStatusAsync();
                if (status.HasValue && status.Value.TryGetProperty("race_id", out var rid) && rid.GetInt32() > 0)
                {
                   _raceId = rid.GetInt32();
                   if (status.Value.TryGetProperty("track_name", out var tn))
                   {
                       _trackName = tn.GetString() ?? "Upcoming Race";
                   }
                }
                else
                {
                    _raceId = 5400;
                }
                
                var result = await DataCollectionService.GetNascarPredictionsAsync(_raceId);
                if (result.HasValue && result.Value.TryGetProperty("predictions", out var preds))
                {
                    _drivers = JsonSerializer.Deserialize<List<DriverPrediction>>(preds.GetRawText()) ?? new();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading NASCAR data: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task UploadOddsImage(IBrowserFile file)
    {
        if (file == null) return;
        _loading = true;
        try
        {
            var result = await DataCollectionService.UploadNascarOddsAsync(file);
            if (result.HasValue && result.Value.TryGetProperty("drivers", out var driversJson))
            {
                var extractedDrivers = JsonSerializer.Deserialize<List<DriverPrediction>>(driversJson.GetRawText());
                if (extractedDrivers != null && extractedDrivers.Any())
                {
                    UpdateDriversWithOdds(extractedDrivers);
                    Snackbar.Add($"Successfully extracted odds for {extractedDrivers.Count} drivers!", Severity.Success);
                }
                else
                {
                    Snackbar.Add("No odds found in image. Try a clearer screenshot.", Severity.Warning);
                }
            }
            else 
            {
                 Snackbar.Add("Failed to process image.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void UpdateDriversWithOdds(List<DriverPrediction> oddsList)
    {
        var driverMap = _drivers.ToDictionary(d => d.DriverName.ToLower(), d => d);
        
        foreach (var odd in oddsList)
        {
            var key = odd.DriverName.ToLower().Trim();
            
            if (driverMap.TryGetValue(key, out var existing))
            {
                existing.MarketOdds = odd.MarketOdds;
                existing.WinProbability = EstimateWinProbFromOdds(odd.MarketOdds);
            }
            else
            {
                odd.Rank = _drivers.Count + 1;
                odd.WinProbability = EstimateWinProbFromOdds(odd.MarketOdds);
                odd.ProjectedFinish = odd.Rank * 1.5;
                odd.Confidence = "Unknown";
                _drivers.Add(odd);
            }
        }
        
        _drivers = _drivers.OrderByDescending(d => d.WinProbability).ToList();
        
        for(int i=0; i<_drivers.Count; i++) _drivers[i].Rank = i+1;
        
        StateHasChanged();
    }

    private double EstimateWinProbFromOdds(string oddsStr)
    {
        try
        {
            var odds = int.Parse(oddsStr.Replace("+", ""));
            if (odds > 0)
                return 100.0 / (odds + 100);
            else
                return Math.Abs(odds) / (Math.Abs(odds) + 100.0);
        }
        catch
        {
            return 0.01;
        }
    }

    private string GetConfidenceColorStr(string conf) => conf.ToLower() switch
    {
        "high" => "emerald",
        "medium" => "orange",
        _ => "red"
    };

    private async Task OpenAnalysisDialog(DriverPrediction driver)
    {
        var gameData = new
        {
            home_team = driver.DriverName,
            away_team = "Field",
            sport_key = "nascar",
            home_moneyline = driver.MarketOdds, 
            game_time = DateTime.Now.ToString("g"),
            ai_summary = $"Win Probability: {(driver.WinProbability*100):F1}%"
        };
        
        var jsonElement = JsonSerializer.Deserialize<JsonElement>(JsonSerializer.Serialize(gameData));

        var parameters = new DialogParameters<Dialogs.AnalysisDialog>
        {
            { x => x.FullGameData, jsonElement },
            { x => x.Sportsbook, "fanduel" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<Dialogs.AnalysisDialog>($"{driver.DriverName} Analysis", parameters, options);
    }

    private async Task GenerateRaceAnalysis()
    {
        if (!_drivers.Any()) return;
        
        _analyzing = true;
        try
        {
            var result = await DataCollectionService.GetNascarRaceAnalysisAsync(_drivers, _trackName);
            
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
            var parameters = new DialogParameters();
            parameters.Add("AnalysisText", result);
            
            await DialogService.ShowAsync<RaceAnalysisDialog>("Global AI Betting Report", parameters, options);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Analysis failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _analyzing = false;
        }
    }

    private async Task OpenManualEntry()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var parameters = new DialogParameters();
        
        var dialog = await DialogService.ShowAsync<ManualOddsDialog>("Enter Odds Manually", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is List<DriverPrediction> manualDrivers)
        {
            if (manualDrivers.Any())
            {
                await DataCollectionService.SubmitManualOddsAsync(manualDrivers);
                UpdateDriversWithOdds(manualDrivers);
                Snackbar.Add($"Added manual odds for {manualDrivers.Count} drivers.", Severity.Success);
            }
        }
    }
}
