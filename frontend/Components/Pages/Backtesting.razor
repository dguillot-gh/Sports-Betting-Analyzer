@page "/backtesting"
@rendermode InteractiveServer
@using MudBlazor
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Backtesting - Sports Betting Analyzer</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex align-center justify-space-between flex-wrap" style="gap: 16px;">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Large" Color="Color.Primary" Class="mr-3" />
                    <div>
                        <MudText Typo="Typo.h5">Backtesting</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Test betting strategies on historical data</MudText>
                    </div>
                </div>
            </div>
        </MudPaper>
        
        <!-- Strategy Configuration -->
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">⚙️ Strategy Configuration</MudText>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="3">
                    <MudSelect T="string" @bind-Value="_selectedSport" Label="Sport" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("nba")">🏀 NBA</MudSelectItem>
                        <MudSelectItem Value="@("nfl")">🏈 NFL</MudSelectItem>
                        <MudSelectItem Value="@("nascar")">🏎️ NASCAR</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="string" @bind-Value="_selectedSeason" Label="Season" Variant="Variant.Outlined">
                        @foreach (var season in GetSeasons())
                        {
                            <MudSelectItem Value="@season">@season</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="string" @bind-Value="_selectedBetType" Label="Bet Type" Variant="Variant.Outlined">
                        @foreach (var betType in GetBetTypes())
                        {
                            <MudSelectItem Value="@betType">@FormatBetType(betType)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudNumericField T="double" @bind-Value="_minEdge" Label="Min Edge %" 
                                     Variant="Variant.Outlined" Min="0" Max="50" Step="1" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudNumericField T="int" @bind-Value="_minOdds" Label="Min Odds" 
                                     Variant="Variant.Outlined" Step="50" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudNumericField T="int" @bind-Value="_maxOdds" Label="Max Odds" 
                                     Variant="Variant.Outlined" Step="50" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudNumericField T="double" @bind-Value="_stakeAmount" Label="Stake $" 
                                     Variant="Variant.Outlined" Min="1" Step="10" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudNumericField T="double" @bind-Value="_bankroll" Label="Bankroll $" 
                                     Variant="Variant.Outlined" Min="100" Step="100" />
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex align-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunBacktest"
                               Disabled="@_isRunning" FullWidth="true" Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.PlayArrow">
                        @if (_isRunning)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Run Backtest
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
        
        @if (_result != null)
        {
            <!-- Summary Cards -->
            <MudGrid Spacing="3">
                <MudItem xs="6" md="2">
                    <MudPaper Class="pa-3 text-center" Elevation="2">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">TOTAL BETS</MudText>
                        <MudText Typo="Typo.h4">@_result.TotalBets</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudPaper Class="pa-3 text-center" Elevation="2">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">RECORD</MudText>
                        <MudText Typo="Typo.h4" Color="@(_result.Wins > _result.Losses ? Color.Success : Color.Error)">
                            @_result.Wins-@_result.Losses
                        </MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudPaper Class="pa-3 text-center" Elevation="2">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">WIN RATE</MudText>
                        <MudText Typo="Typo.h4">@_result.WinRate%</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudPaper Class="pa-3 text-center" Elevation="2">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">STAKED</MudText>
                        <MudText Typo="Typo.h4">$@_result.TotalStaked.ToString("N0")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudPaper Class="pa-3 text-center" Elevation="2" Style="@($"background: {(_result.TotalProfit >= 0 ? "#E8F5E9" : "#FFEBEE")}")">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">PROFIT</MudText>
                        <MudText Typo="Typo.h4" Color="@(_result.TotalProfit >= 0 ? Color.Success : Color.Error)">
                            @(_result.TotalProfit >= 0 ? "+" : "")$@_result.TotalProfit.ToString("N0")
                        </MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudPaper Class="pa-3 text-center" Elevation="2" Style="@($"background: {(_result.Roi >= 0 ? "#E8F5E9" : "#FFEBEE")}")">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">ROI</MudText>
                        <MudText Typo="Typo.h4" Color="@(_result.Roi >= 0 ? Color.Success : Color.Error)">
                            @(_result.Roi >= 0 ? "+" : "")@_result.Roi%
                        </MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
            
            <!-- Cumulative Profit Chart -->
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">📈 Cumulative Profit</MudText>
                <div style="height: 250px; display: flex; align-items: end; gap: 2px; padding: 10px; background: #f5f5f5; border-radius: 8px;">
                    @{
                        var profits = _result.CumulativeProfit ?? new List<double>();
                        var maxProfit = profits.Any() ? Math.Max(Math.Abs(profits.Max()), Math.Abs(profits.Min())) : 100;
                        if (maxProfit == 0) maxProfit = 100;
                    }
                    @foreach (var (profit, idx) in profits.Select((p, i) => (p, i)))
                    {
                        var height = Math.Abs(profit) / maxProfit * 200;
                        var color = profit >= 0 ? "#4CAF50" : "#F44336";
                        var bottom = profit >= 0 ? "0" : "auto";
                        <div style="flex: 1; max-width: 10px; height: @(height)px; background: @color; border-radius: 2px;" 
                             title="Bet @idx: $@profit.ToString("F0")"></div>
                    }
                </div>
                <div class="d-flex justify-space-between mt-2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Bet 1</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Bet @profits.Count</MudText>
                </div>
            </MudPaper>
            
            <!-- Bet History Table -->
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">📋 Bet History</MudText>
                <MudSimpleTable Dense="true" Hover="true" Striped="true" FixedHeader="true" Style="max-height: 400px;">
                    <thead>
                        <tr style="background: var(--mud-palette-surface);">
                            <th>Date</th>
                            <th>Matchup</th>
                            <th>Pick</th>
                            <th>Odds</th>
                            <th>Edge</th>
                            <th>Result</th>
                            <th>Profit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bet in _result.BetHistory ?? new List<BacktestBet>())
                        {
                            <tr>
                                <td>@bet.Date</td>
                                <td><strong>@bet.Matchup</strong></td>
                                <td>@bet.Pick</td>
                                <td>@bet.Odds</td>
                                <td>@bet.Edge%</td>
                                <td>
                                    <MudChip T="string" Size="Size.Small" 
                                             Color="@(bet.Result == "W" ? Color.Success : Color.Error)">
                                        @bet.Result
                                    </MudChip>
                                </td>
                                <td style="color: @(bet.Profit >= 0 ? "green" : "red"); font-weight: bold;">
                                    @(bet.Profit >= 0 ? "+" : "")$@bet.Profit.ToString("F0")
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        }
        else if (!_isRunning)
        {
            <MudAlert Severity="Severity.Info">
                Configure your strategy above and click <strong>Run Backtest</strong> to see how it would have performed!
            </MudAlert>
        }
    </MudStack>
</MudContainer>

@code {
    private bool _isRunning = false;
    private string _selectedSport = "nba";
    private string _selectedSeason = "2024-25";
    private string _selectedBetType = "moneyline";
    private double _minEdge = 5.0;
    private int _minOdds = -300;
    private int _maxOdds = 300;
    private double _stakeAmount = 100;
    private double _bankroll = 1000;
    
    private BacktestResultModel? _result;
    
    private List<string> GetSeasons()
    {
        return _selectedSport switch
        {
            "nba" => new List<string> { "2024-25", "2023-24", "2022-23", "2021-22" },
            "nfl" => new List<string> { "2025", "2024", "2023", "2022", "2021" },
            "nascar" => new List<string> { "2026", "2025", "2024", "2023" },
            _ => new List<string> { "2024" }
        };
    }
    
    private List<string> GetBetTypes()
    {
        return _selectedSport switch
        {
            "nba" => new List<string> { "moneyline", "spread", "over_under" },
            "nfl" => new List<string> { "moneyline", "spread", "over_under" },
            "nascar" => new List<string> { "race_winner", "top5", "top10" },
            _ => new List<string> { "moneyline" }
        };
    }
    
    private string FormatBetType(string betType) => betType switch
    {
        "moneyline" => "Moneyline",
        "spread" => "Spread",
        "over_under" => "Over/Under",
        "race_winner" => "Race Winner",
        "top5" => "Top 5 Finish",
        "top10" => "Top 10 Finish",
        _ => betType
    };
    
    private async Task RunBacktest()
    {
        _isRunning = true;
        _result = null;
        StateHasChanged();
        
        try
        {
            var request = new
            {
                sport = _selectedSport,
                season = _selectedSeason,
                bet_type = _selectedBetType,
                min_edge = _minEdge,
                min_odds = _minOdds,
                max_odds = _maxOdds,
                stake_type = "flat",
                stake_amount = _stakeAmount,
                bankroll = _bankroll,
                simulations = 300
            };
            
            var response = await Http.PostAsJsonAsync("http://backend:8000/backtest", request);
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _result = JsonSerializer.Deserialize<BacktestResultModel>(json, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });
                
                if (_result != null)
                {
                    var emoji = _result.Roi >= 0 ? "📈" : "📉";
                    Snackbar.Add($"{emoji} Backtest complete: {_result.TotalBets} bets, {_result.Roi}% ROI", 
                        _result.Roi >= 0 ? Severity.Success : Severity.Warning);
                }
            }
            else
            {
                Snackbar.Add("Backtest failed - check backend logs", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isRunning = false;
        }
    }
    
    private class BacktestResultModel
    {
        public string Sport { get; set; } = "";
        public string Season { get; set; } = "";
        public string BetType { get; set; } = "";
        public int TotalBets { get; set; }
        public int Wins { get; set; }
        public int Losses { get; set; }
        public int Pushes { get; set; }
        public double WinRate { get; set; }
        public double TotalStaked { get; set; }
        public double TotalProfit { get; set; }
        public double Roi { get; set; }
        public List<BacktestBet>? BetHistory { get; set; }
        public List<double>? CumulativeProfit { get; set; }
    }
    
    private class BacktestBet
    {
        public string Date { get; set; } = "";
        public string Matchup { get; set; } = "";
        public string Pick { get; set; } = "";
        public string Odds { get; set; } = "";
        public double Edge { get; set; }
        public string Result { get; set; } = "";
        public double Stake { get; set; }
        public double Profit { get; set; }
    }
}
