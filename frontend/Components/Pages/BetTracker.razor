    private void ParseDialogGame(JsonElement g)
    {
        var home = g.TryGetProperty("home_team", out var h) ? h.GetString() ?? "" : "";
        var away = g.TryGetProperty("away_team", out var a) ? a.GetString() ?? "" : "";
        var gid = g.TryGetProperty("game_id", out var id) ? id.GetString() ?? $"{home}:{away}" : $"{home}:{away}";
        int homeML = 0, awayML = 0;
        decimal total = 0;

        if (g.TryGetProperty("odds_data", out var odds) && odds.ValueKind == JsonValueKind.Object)
        {
            if (odds.TryGetProperty("home_ml", out var hm) && hm.ValueKind == JsonValueKind.Number)
                homeML = (int)Math.Round(hm.GetDouble());
            if (odds.TryGetProperty("away_ml", out var am) && am.ValueKind == JsonValueKind.Number)
                awayML = (int)Math.Round(am.GetDouble());
            if (odds.TryGetProperty("total", out var t) && t.ValueKind == JsonValueKind.Number)
                total = t.GetDecimal();
        }

        if (homeML == 0 && g.TryGetProperty("home_moneyline", out var hlm) && hlm.ValueKind == JsonValueKind.Number)
            homeML = (int)Math.Round(hlm.GetDouble());
        if (awayML == 0 && g.TryGetProperty("away_moneyline", out var alm) && alm.ValueKind == JsonValueKind.Number)
            awayML = (int)Math.Round(alm.GetDouble());
        if (total == 0 && g.TryGetProperty("over_under", out var ou) && ou.ValueKind == JsonValueKind.Number)
            total = ou.GetDecimal();

        if (!string.IsNullOrEmpty(home) && !string.IsNullOrEmpty(away))
        {
            decimal? homeSpread = g.TryGetProperty("home_spread", out var hs) && hs.ValueKind == JsonValueKind.Number ? hs.GetDecimal() : null;
            decimal? awaySpread = g.TryGetProperty("away_spread", out var ars) && ars.ValueKind == JsonValueKind.Number ? ars.GetDecimal() : null;

            _dialogGames.Add(new Game { 
                GameId = gid, 
                Home = home, 
                Away = away, 
                HomeML = homeML, 
                AwayML = awayML, 
                Total = total,
                HomeSpread = homeSpread,
                AwaySpread = awaySpread
            });
        }
    }

    private void AddToDeck(Game game, string type, string team, int odds, decimal? value)
