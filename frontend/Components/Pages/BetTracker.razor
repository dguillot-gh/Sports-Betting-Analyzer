    private int CalculateParlayOdds(List<Leg> legs)
    {
        if (!legs.Any()) return 0;
        
        decimal decimalOdds = 1.0m;
        foreach (var leg in legs)
        {
            if (leg.Odds > 0)
                decimalOdds *= (decimal)leg.Odds / 100m + 1;
            else
                decimalOdds *= 100m / (decimal)Math.Abs(leg.Odds) + 1;
        }
        
        if (decimalOdds >= 2)
            return (int)((decimalOdds - 1) * 100);
        else
            return (int)(-100m / (decimalOdds - 1));
    }

