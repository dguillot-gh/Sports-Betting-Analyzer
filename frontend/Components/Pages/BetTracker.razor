    private async Task LoadBets()
    {
        try
        {
            var content = await Http.GetStringAsync("http://backend:8000/bets?limit=1000");
            using var doc = JsonDocument.Parse(content);
            if (doc.RootElement.TryGetProperty("bets", out var arr))
            {
                _bets.Clear();
                foreach (var b in arr.EnumerateArray())
                {
                    try 
                    {
                        var bet = new Bet
                        {
                            Id = b.TryGetProperty("id", out var id) && id.ValueKind == JsonValueKind.Number ? (int)Math.Round(id.GetDouble()) : 0,
                            Description = b.TryGetProperty("description", out var d) ? (d.ValueKind == JsonValueKind.String ? d.GetString() ?? "" : d.ToString()) : "",
                            Stake = b.TryGetProperty("stake", out var s) && s.ValueKind == JsonValueKind.Number ? s.GetDecimal() : 0,
                            Odds = b.TryGetProperty("odds", out var o) && o.ValueKind == JsonValueKind.Number ? (int)Math.Round(o.GetDouble()) : 0,
                            Outcome = b.TryGetProperty("outcome", out var oc) ? (oc.ValueKind == JsonValueKind.String ? oc.GetString() ?? "pending" : "pending") : "pending",
                            GameName = b.TryGetProperty("game_name", out var gn) ? (gn.ValueKind == JsonValueKind.String ? gn.GetString() : null) : null,
                            Source = b.TryGetProperty("source", out var src) ? (src.ValueKind == JsonValueKind.String ? src.GetString() ?? "manual" : "manual") : "manual",
                            IsMock = b.TryGetProperty("is_mock", out var im) && im.ValueKind == JsonValueKind.True
                        };
                        _bets.Add(bet);
                    }
                    catch (Exception itemEx)
                    {
                        Console.WriteLine($"Skipping invalid bet item: {itemEx.Message}");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading bets: {ex.Message}", Severity.Error);
        }
        StateHasChanged();
    }

    private async Task ResolvePendingBets()
    {
        try
        {
            _isResolving = true;
            _resolveStatus = _resolveMessages[0];
            StateHasChanged();

            // Start a background task to cycle through funny messages
            var cts = new CancellationTokenSource();
            var messageTask = Task.Run(async () =>
            {
                int idx = 0;
                while (!cts.Token.IsCancellationRequested)
                {
                    await Task.Delay(1500);
                    idx = (idx + 1) % _resolveMessages.Length;
                    _resolveStatus = _resolveMessages[idx];
                    await InvokeAsync(StateHasChanged);
                }
            }, cts.Token);

            // Call the API
            var resp = await Http.PostAsync("http://backend:8000/bets/resolve-pending", null);
            cts.Cancel();

            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadAsStringAsync();
                var doc = JsonDocument.Parse(json);
                var resolved = doc.RootElement.TryGetProperty("summary", out var summary)
                    ? summary.GetProperty("resolved").GetInt32()
                    : 0;
                var wins = summary.TryGetProperty("wins", out var w) ? w.GetInt32() : 0;
                var losses = summary.TryGetProperty("losses", out var l) ? l.GetInt32() : 0;

                if (resolved > 0)
                {
                    Snackbar.Add($"✅ Resolved {resolved} bets! ({wins}W/{losses}L)", Severity.Success);
                }
                else
                {
                    Snackbar.Add("No pending bets to resolve (games may not be final yet).", Severity.Info);
                }

                await LoadBets();
                await LoadStats();
                await LoadChartData();
            }
            else
            {
                var errorBody = await resp.Content.ReadAsStringAsync();
                Snackbar.Add($"Resolution failed: {errorBody}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isResolving = false;
            StateHasChanged();
        }
    }

