@page "/bet-tracker"
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject DataCollectionService DataCollectionService
@using SportsBettingAnalyzer.Services
@using SportsBettingAnalyzer.Models
@using SportsBettingAnalyzer.Components.Shared.Tailwind

<PageTitle>Bet Tracker</PageTitle>

<TwContainer MaxWidth="extraLarge" Class="pa-4 mt-8">
    <!-- Loading Overlay for Import -->
    <TwLoadingOverlay 
        IsVisible="@_isImporting"
        Title="Importing Bet History"
        Color="blue"
        CurrentStatusMessage="@_importStatus"
        ShowProgress="false" />
    <div class="space-y-6">
        <!-- Header -->
        <div class="p-6 rounded-xl shadow-lg bg-gradient-to-br from-slate-900 to-slate-800 text-white border border-slate-700">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                <div>
                    <h1 class="text-3xl font-bold flex items-center gap-3">
                        <svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                        Bet Tracker
                    </h1>
                </div>
                <div class="flex items-center gap-3">
                    <TwChip Color="emerald" Size="sm" Variant="solid">@_wins W</TwChip>
                    <TwChip Color="red" Size="sm" Variant="solid">@_losses L</TwChip>
                    <TwChip Color="@(_netProfit >= 0 ? "emerald" : "red")" Size="sm" Variant="outline">
                        @(_netProfit >= 0 ? "+" : "")$@_netProfit.ToString("F2")
                    </TwChip>
                    
                    <div class="relative">
                        <label class="cursor-pointer inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-md shadow-sm transition-colors border border-transparent">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                            @(_isImporting ? "Processing..." : "Import")
                            <InputFile OnChange="OnImportFileSelected" class="hidden" accept=".csv, .xlsx, .xls" disabled="@_isImporting" />
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
            <!-- Left: Available Games -->
            <div class="md:col-span-5">
                <TwCard Class="flex flex-col h-[600px]">
                    <div class="flex justify-between items-center mb-4 pb-2 border-b border-slate-700">
                        <h2 class="text-lg font-bold text-white">Available Games</h2>
                        <div class="flex gap-2">
                            <button @onclick="@(() => { _sport = "nfl"; _ = LoadGames(); })" class="px-2 py-1 text-xs font-bold rounded border @(_sport == "nfl" ? "bg-blue-500 border-blue-500 text-white" : "border-slate-600 text-slate-400 hover:text-white")">NFL</button>
                            <button @onclick="@(() => { _sport = "nba"; _ = LoadGames(); })" class="px-2 py-1 text-xs font-bold rounded border @(_sport == "nba" ? "bg-orange-500 border-orange-500 text-white" : "border-slate-600 text-slate-400 hover:text-white")">NBA</button>
                            <button @onclick="LoadGames" class="p-1 text-slate-400 hover:text-white">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            </button>
                        </div>
                    </div>

                    <div class="flex-1 overflow-y-auto pr-2 custom-scrollbar space-y-2">
                        @if (_loadingGames)
                        {
                            <TwProgressBar Indeterminate="true" Color="blue" />
                        }
                        else if (_games.Any())
                        {
                            @foreach (var game in _games)
                            {
                                <div class="bg-slate-900 border border-slate-800 rounded-lg p-3 hover:border-slate-600 transition-colors">
                                    <div class="text-xs font-medium text-slate-300 mb-2">@game.Away @@ @game.Home</div>
                                    <div class="flex flex-wrap gap-2">
                                        @if (game.HomeML != 0)
                                        {
                                            <button @onclick="@(() => AddLeg($"{game.Home} ML", game.HomeML, game.GameId, $"{game.Away} @ {game.Home}"))" 
                                                    class="px-2 py-1 bg-slate-800 hover:bg-blue-600 border border-slate-700 rounded text-xs text-white transition-colors">
                                                @game.Home.Split(' ').Last() @FormatOdds(game.HomeML)
                                            </button>
                                            <button @onclick="@(() => AddLeg($"{game.Away} ML", game.AwayML, game.GameId, $"{game.Away} @ {game.Home}"))" 
                                                    class="px-2 py-1 bg-slate-800 hover:bg-blue-600 border border-slate-700 rounded text-xs text-white transition-colors">
                                                @game.Away.Split(' ').Last() @FormatOdds(game.AwayML)
                                            </button>
                                        }
                                        @if (game.Total > 0)
                                        {
                                            <button @onclick="@(() => AddLeg($"O {game.Total}", -110, game.GameId, $"{game.Away} @ {game.Home}"))" 
                                                    class="px-2 py-1 bg-slate-800 hover:bg-emerald-600 border border-slate-700 rounded text-xs text-white transition-colors">
                                                O @game.Total
                                            </button>
                                            <button @onclick="@(() => AddLeg($"U {game.Total}", -110, game.GameId, $"{game.Away} @ {game.Home}"))" 
                                                    class="px-2 py-1 bg-slate-800 hover:bg-emerald-600 border border-slate-700 rounded text-xs text-white transition-colors">
                                                U @game.Total
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <TwAlert Severity="info">No live games found. Try analyzing odds first.</TwAlert>
                        }
                    </div>
                </TwCard>
            </div>

            <!-- Right: Bet Slip + History -->
            <div class="md:col-span-7 space-y-6">
                <!-- Bet Slip -->
                <TwCard>
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-lg font-bold text-white flex items-center gap-2">
                            Bet Slip
                            @if (_legs.Any())
                            {
                                <TwChip Color="blue" Size="xs" Variant="solid">@(_legs.Count == 1 ? "Single" : $"{_legs.Count}-Leg Parlay")</TwChip>
                            }
                        </h2>
                    </div>

                    @if (!_legs.Any())
                    {
                        <div class="text-slate-500 text-sm py-4 italic text-center border-2 border-dashed border-slate-800 rounded-lg">
                            Click a bet from available games to add to slip.
                        </div>
                    }
                    else
                    {
                        <div class="space-y-2 mb-4">
                            @foreach (var leg in _legs)
                            {
                                <div class="flex justify-between items-center p-3 bg-slate-900/50 border border-slate-800 rounded-lg group">
                                    <span class="text-sm font-medium text-white">@leg.Description <span class="text-blue-400">(@FormatOdds(leg.Odds))</span></span>
                                    <button @onclick="@(() => _legs.Remove(leg))" class="text-slate-500 hover:text-red-400 p-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                    </button>
                                </div>
                            }
                        </div>

                        @if (_legs.Count > 1)
                        {
                             <div class="mb-4 text-right">
                                <span class="text-sm text-slate-400">Parlay Odds:</span>
                                <span class="text-lg font-bold text-blue-400 ml-2">@FormatOdds(GetParlayOdds())</span>
                            </div>
                        }

                        <div class="grid grid-cols-12 gap-3 items-end bg-slate-900/30 p-4 rounded-xl border border-slate-800">
                            <div class="col-span-4">
                                <TwSelect TValue="string" @bind-Value="_sportsbook" Label="Sportsbook" FullWidth="true">
                                    <option value="fanduel">FanDuel</option>
                                    <option value="draftkings">DraftKings</option>
                                    <option value="betmgm">BetMGM</option>
                                </TwSelect>
                            </div>
                            <div class="col-span-3">
                                <div class="relative w-full">
                                    <label class="block text-xs text-slate-500 mb-1 font-medium">Stake</label>
                                    <div class="relative">
                                        <div class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-500">$</div>
                                        <input type="number" @bind="_stake" class="appearance-none bg-slate-800 text-sm text-slate-100 border border-slate-700 rounded-xl px-4 py-2.5 pl-7 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition-all placeholder-slate-500 w-full" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-span-5 text-right pb-1">
                                <div class="text-xs text-slate-500 uppercase font-bold">Payout</div>
                                <div class="text-xl font-bold text-emerald-400">$@CalcPayout().ToString("F2")</div>
                                <div class="text-xs text-emerald-600">+$@CalcWin().ToString("F2") profit</div>
                            </div>
                        </div>
                        
                        <TwButton Variant="primary" FullWidth="true" OnClick="PlaceBet" Disabled="@(_stake <= 0)" Class="mt-4 font-bold py-3 shadow-lg shadow-blue-500/20">
                            Place Bet
                        </TwButton>
                    }
                </TwCard>

                <!-- Manual Add -->
                <div class="border border-slate-800 rounded-xl overflow-hidden">
                    <details class="group bg-slate-900">
                        <summary class="flex items-center justify-between p-4 cursor-pointer hover:bg-slate-800/50 transition-colors">
                            <span class="font-bold text-white text-sm">Manual Entry</span>
                            <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </summary>
                        <div class="p-4 border-t border-slate-800 bg-slate-950/50">
                            <div class="grid grid-cols-12 gap-3 mb-3">
                                <div class="col-span-8">
                                    <TwInput @bind-Value="_manualDesc" Label="Description" Placeholder="Ex: Chiefs ML" FullWidth="true" />
                                </div>
                                <div class="col-span-4">
                                     <div class="relative w-full">
                                        <label class="block text-xs text-slate-500 mb-1 font-medium">Odds</label>
                                        <input type="number" @bind="_manualOdds" class="appearance-none bg-slate-800 text-sm text-slate-100 border border-slate-700 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition-all placeholder-slate-500 w-full" />
                                    </div>
                                </div>
                            </div>
                            <div class="flex gap-3 items-end">
                                <div class="flex-1">
                                    <TwInput @bind-Value="_manualGame" Label="Game (Optional)" Placeholder="Ex: Chiefs vs Bills" FullWidth="true" />
                                </div>
                                <TwButton Variant="outline" OnClick="AddManualLeg" StartIcon="M12 6v6m0 0v6m0-6h6m-6 0H6">Add</TwButton>
                            </div>
                        </div>
                    </details>
                </div>

                <!-- History -->
                <TwCard>
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-lg font-bold text-white">Recent Bets</h2>
                    </div>
                    
                    @if (_bets.Any())
                    {
                        <div class="overflow-x-auto max-h-[300px] overflow-y-auto custom-scrollbar rounded-lg border border-slate-800">
                            <table class="w-full text-sm text-left text-slate-300">
                                <thead class="text-xs text-slate-400 uppercase bg-slate-900 sticky top-0">
                                    <tr>
                                        <th class="px-4 py-2">Type</th>
                                        <th class="px-4 py-2">Game</th>
                                        <th class="px-4 py-2">Bet</th>
                                        <th class="px-4 py-2">Stake</th>
                                        <th class="px-4 py-2">Odds</th>
                                        <th class="px-4 py-2">Result</th>
                                        <th class="px-4 py-2 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-800 bg-slate-900/30">
                                    @foreach (var b in _bets)
                                    {
                                        <tr class="hover:bg-slate-800/50 transition-colors">
                                            <td class="px-4 py-2">
                                                @if (b.Source == "manual")
                                                {
                                                    <span title="Manual" class="text-slate-500"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg></span>
                                                }
                                                else
                                                {
                                                     <span title="Auto" class="text-blue-500"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg></span>
                                                }
                                            </td>
                                            <td class="px-4 py-2 text-xs text-slate-500">@(b.GameName ?? "-")</td>
                                            <td class="px-4 py-2 font-medium text-white">@b.Description</td>
                                            <td class="px-4 py-2 text-emerald-400">$@b.Stake.ToString("F2")</td>
                                            <td class="px-4 py-2">@FormatOdds(b.Odds)</td>
                                            <td class="px-4 py-2">
                                                <div class="flex gap-1">
                                                    <button @onclick="@(()=>SetOutcome(b.Id, b.Outcome=="win"?"pending":"win"))" class="px-2 py-0.5 text-xs rounded border @(b.Outcome=="win" ? "bg-emerald-500 text-white border-emerald-500" : "border-slate-700 hover:border-emerald-500 text-slate-500")">W</button>
                                                    <button @onclick="@(()=>SetOutcome(b.Id, b.Outcome=="loss"?"pending":"loss"))" class="px-2 py-0.5 text-xs rounded border @(b.Outcome=="loss" ? "bg-red-500 text-white border-red-500" : "border-slate-700 hover:border-red-500 text-slate-500")">L</button>
                                                    <button @onclick="@(()=>CashOut(b))" class="px-2 py-0.5 text-xs rounded border @(b.Outcome=="cashout" ? "bg-amber-500 text-white border-amber-500" : "border-slate-700 hover:border-amber-500 text-slate-500")">C</button>
                                                </div>
                                            </td>
                                            <td class="px-4 py-2 text-right">
                                                <div class="flex justify-end gap-2">
                                                    <button @onclick="@(() => OpenEditDialog(b))" class="text-blue-400 hover:text-white"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg></button>
                                                    <button @onclick="@(() => DeleteBet(b.Id))" class="text-red-400 hover:text-white"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-slate-500 text-sm">No bets yet.</p>
                    }
                </TwCard>
            </div>
        </div>

        <!-- Analytics Section -->
        <div class="border border-slate-800 rounded-xl overflow-hidden mt-4">
             <details class="group bg-slate-900" open>
                 <summary class="flex items-center justify-between p-4 cursor-pointer hover:bg-slate-800/50 transition-colors bg-slate-900/80">
                    <span class="font-bold text-white text-base flex items-center gap-2">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                        Analytics
                    </span>
                    <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </summary>
                <div class="p-6 border-t border-slate-800 bg-slate-950/30">
                     <div class="flex flex-wrap gap-4 mb-6">
                        <TwButton Size="sm" Variant="outline" OnClick="LoadChartData" IsLoading="@_loadingCharts" Disabled="@_loadingCharts">
                            Refresh Charts
                        </TwButton>
                        <div class="w-32">
                             <TwSelect TValue="string" @bind-Value="_chartDays" Label="Period" Dense="true" FullWidth="true" Class="text-sm">
                                <option value="7">7 Days</option>
                                <option value="30">30 Days</option>
                                <option value="90">90 Days</option>
                                <option value="0">All Time</option>
                            </TwSelect>
                        </div>
                    </div>

                    @if (_chartData != null)
                    {
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
                            <!-- Summary Cards -->
                            <TwStatCard Label="ROI" Value="@($"{(_chartRoi >= 0 ? "+" : "")}{_chartRoi:F1}%")" Color="@(_chartRoi >= 0 ? "emerald" : "red")" />
                            <TwStatCard Label="Total Profit" Value="@($"{(_chartProfit >= 0 ? "+" : "")}${_chartProfit:F2}")" Color="@(_chartProfit >= 0 ? "emerald" : "red")" />
                            <TwStatCard Label="Win Rate" Value="@($"{_chartWinRate:F1}%")" Color="blue" />
                            <TwStatCard Label="Total Bets" Value="@_chartTotalBets.ToString()" Color="slate" />
                        </div>

                         <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                            <!-- Outcomes -->
                            <div class="md:col-span-4">
                                <TwCard Class="h-full">
                                    <h3 class="text-sm font-bold text-slate-300 uppercase tracking-wider mb-4">Outcome Distribution</h3>
                                    @{
                                        var totalOutcomes = _outcomeWins + _outcomeLosses + _outcomeCashouts;
                                        var winPct = totalOutcomes > 0 ? (_outcomeWins * 100.0 / totalOutcomes) : 0;
                                        var lossPct = totalOutcomes > 0 ? (_outcomeLosses * 100.0 / totalOutcomes) : 0;
                                        var cashPct = totalOutcomes > 0 ? (_outcomeCashouts * 100.0 / totalOutcomes) : 0;
                                    }
                                    <div class="space-y-4">
                                        <TwProgressBar Value="@((int)winPct)" Color="emerald" Label="@($"Wins ({_outcomeWins})")" Size="md" />
                                        <TwProgressBar Value="@((int)lossPct)" Color="red" Label="@($"Losses ({_outcomeLosses})")" Size="md" />
                                        <TwProgressBar Value="@((int)cashPct)" Color="amber" Label="@($"Cashouts ({_outcomeCashouts})")" Size="md" />
                                    </div>
                                </TwCard>
                            </div>

                            <!-- Daily Trend -->
                            <div class="md:col-span-8">
                                <TwCard Class="h-full flex flex-col">
                                    <h3 class="text-sm font-bold text-slate-300 uppercase tracking-wider mb-4">Daily Trend (Last 10 Active Days)</h3>
                                    @if (_dailyData.Any())
                                    {
                                        <div class="overflow-x-auto flex-1">
                                            <table class="w-full text-xs text-left text-slate-400">
                                                <thead>
                                                    <tr class="border-b border-slate-800">
                                                        <th class="py-2">Date</th>
                                                        <th class="py-2">Bets</th>
                                                        <th class="py-2">W/L/C</th>
                                                        <th class="py-2">Profit</th>
                                                        <th class="py-2">ROI</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-slate-800/50">
                                                    @foreach (var d in _dailyData.TakeLast(10).Reverse())
                                                    {
                                                        <tr>
                                                            <td class="py-2">@d.Date</td>
                                                            <td class="py-2 text-white">@d.Bets</td>
                                                            <td class="py-2"><span class="text-emerald-500">@d.Wins</span>/<span class="text-red-500">@d.Losses</span>@if(d.Cashouts>0){<span class="text-amber-500">/@d.Cashouts</span>}</td>
                                                            <td class="py-2 font-medium @(d.Profit >= 0 ? "text-emerald-400" : "text-red-400")">@d.Profit.ToString("F2")</td>
                                                            <td class="py-2 @(d.CumulativeRoi >= 0 ? "text-emerald-400" : "text-red-400")">@d.CumulativeRoi.ToString("F1")%</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex-1 flex items-center justify-center text-slate-600">No data found.</div>
                                    }
                                </TwCard>
                            </div>
                        </div>
                    }
                    else
                    {
                        <TwAlert Severity="info">Click "Refresh Charts" to load detailed analytics.</TwAlert>
                    }
                </div>
            </details>
        </div>
    </div>
</TwContainer>

<!-- Import Modal using Tailwind Overlay -->
@if (_importPreviewOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" @onclick="@(() => _importPreviewOpen = false)"></div>
        
        <!-- Modal Content -->
        <div class="relative w-full max-w-4xl bg-slate-900 border border-slate-700 rounded-xl shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
            <div class="p-6 border-b border-slate-800 flex justify-between items-center bg-slate-900">
                <h3 class="text-xl font-bold text-white">Review Import</h3>
                <button @onclick="@(() => _importPreviewOpen = false)" class="text-slate-400 hover:text-white">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            
            <div class="p-6 overflow-y-auto bg-slate-950/50">
                <TwAlert Severity="info" Class="mb-4">Review mapped data. @_previewBets.Count bets found.</TwAlert>
                <div class="border border-slate-800 rounded-lg overflow-hidden">
                    <table class="w-full text-xs text-left text-slate-300">
                        <thead class="bg-slate-900 text-slate-400 uppercase font-medium">
                            <tr>
                                <th class="px-4 py-2">Date</th>
                                <th class="px-4 py-2">Description</th>
                                <th class="px-4 py-2">Sport</th>
                                <th class="px-4 py-2">Stake</th>
                                <th class="px-4 py-2">Odds</th>
                                <th class="px-4 py-2">Result</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800">
                            @foreach(var bet in _previewBets)
                            {
                                <tr class="bg-slate-900/40">
                                    <td class="px-4 py-2">@bet.Date</td>
                                    <td class="px-4 py-2">@bet.Description</td>
                                    <td class="px-4 py-2">@bet.Sport</td>
                                    <td class="px-4 py-2">$@bet.Stake</td>
                                    <td class="px-4 py-2">@FormatOdds(bet.Odds)</td>
                                    <td class="px-4 py-2">@bet.Outcome</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div class="p-6 border-t border-slate-800 bg-slate-900 flex justify-end gap-3">
                <TwButton Variant="outline" OnClick="@(() => _importPreviewOpen = false)">Cancel</TwButton>
                <TwButton Variant="primary" OnClick="ConfirmImport">Confirm & Import</TwButton>
            </div>
        </div>
    </div>
}

<!-- Edit Modal -->
@if (_editDialogOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" @onclick="@(() => _editDialogOpen = false)"></div>
        
        <div class="relative w-full max-w-lg bg-slate-900 border border-slate-700 rounded-xl shadow-2xl p-6">
            <h3 class="text-xl font-bold text-white mb-6">Edit Bet</h3>
            
            <div class="space-y-4">
                <TwInput @bind-Value="_editDescription" Label="Description" FullWidth="true" />
                <div class="grid grid-cols-2 gap-4">
                    <div class="relative w-full">
                        <label class="block text-xs text-slate-500 mb-1 font-medium">Stake</label>
                        <input type="number" @bind="_editStake" class="appearance-none bg-slate-800 text-sm text-slate-100 border border-slate-700 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-transparent transition-all placeholder-slate-500 w-full" />
                    </div>
                    <div class="relative w-full">
                        <label class="block text-xs text-slate-500 mb-1 font-medium">Odds</label>
