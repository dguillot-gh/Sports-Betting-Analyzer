        {
            "ml" => $"{team} ML",
            "spread" => $"{team} {(value > 0 ? "+" : "")}{value}",
            "total" => $"{team} {value}",
            _ => team
        };

        var metadata = type switch
        {
            "ml" => new { type = "ml", team = team },
            "spread" => (object)new { type = "spread", team = team, value = value },
            "total" => new { type = "total", side = team.ToLower(), value = value },
            _ => null
        };

        var leg = new Leg
        {
            Description = description,
            Odds = odds,
            GameId = game.GameId,
            GameName = $"{game.Away} @ {game.Home}",
