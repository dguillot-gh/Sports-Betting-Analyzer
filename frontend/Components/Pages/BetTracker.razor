@page "/bet-tracker"
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Bet Tracker</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudPaper Class="pa-4" Elevation="2" Style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <div>
                    <MudText Typo="Typo.h4" Style="color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" />
                        Bet Tracker
                    </MudText>
                </div>
                <MudStack Row="true" Spacing="3">
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">@_wins W</MudChip>
                    <MudChip T="string" Color="Color.Error" Size="Size.Small">@_losses L</MudChip>
                    <MudChip T="string" Color="@(_netProfit >= 0 ? Color.Success : Color.Error)" Size="Size.Small">
                        @(_netProfit >= 0 ? "+" : "")$@_netProfit.ToString("F2")
                    </MudChip>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudGrid>
            <!-- Left: Available Games -->
            <MudItem xs="12" md="5">
                <MudPaper Class="pa-4" Elevation="2" Style="max-height: 600px; overflow-y: auto;">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudText Typo="Typo.h6">Available Games</MudText>
                        <MudStack Row="true" Spacing="1">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="@(_sport == "nfl" ? Color.Primary : Color.Default)"
                                       OnClick="@(() => { _sport = "nfl"; _ = LoadGames(); })">NFL</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="@(_sport == "nba" ? Color.Primary : Color.Default)"
                                       OnClick="@(() => { _sport = "nba"; _ = LoadGames(); })">NBA</MudButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="LoadGames" />
                        </MudStack>
                    </MudStack>

                    @if (_loadingGames)
                    {
                        <MudProgressLinear Indeterminate="true" />
                    }
                    else if (_games.Any())
                    {
                        @foreach (var game in _games)
                        {
                            <MudCard Class="mb-2" Elevation="1">
                                <MudCardContent Class="pa-2">
                                    <MudText Typo="Typo.body2">@game.Away @@ @game.Home</MudText>
                                    <MudStack Row="true" Spacing="1" Class="mt-1 flex-wrap">
                                        @if (game.HomeML != 0)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                       OnClick="@(() => AddLeg($"{game.Home} ML", game.HomeML, game.GameId))">
                                                @game.Home.Split(' ').Last() @FormatOdds(game.HomeML)
                                            </MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                       OnClick="@(() => AddLeg($"{game.Away} ML", game.AwayML, game.GameId))">
                                                @game.Away.Split(' ').Last() @FormatOdds(game.AwayML)
                                            </MudButton>
                                        }
                                        @if (game.Total > 0)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Tertiary"
                                                       OnClick="@(() => AddLeg($"O {game.Total}", -110, game.GameId))">O @game.Total</MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Tertiary"
                                                       OnClick="@(() => AddLeg($"U {game.Total}", -110, game.GameId))">U @game.Total</MudButton>
                                        }
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        }
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            No games. Click "Analyze + Cache" on Live Odds first.
                        </MudAlert>
                    }
                </MudPaper>
            </MudItem>

            <!-- Right: Bet Slip + History -->
            <MudItem xs="12" md="7">
                <!-- Bet Slip -->
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.h6" Class="mb-2">
                        Bet Slip
                        @if (_legs.Any())
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-2">
                                @(_legs.Count == 1 ? "Single" : $"{_legs.Count}-Leg Parlay")
                            </MudChip>
                        }
                    </MudText>

                    @if (!_legs.Any())
                    {
                        <MudText Color="Color.Secondary" Typo="Typo.body2">Click a bet to add.</MudText>
                    }
                    else
                    {
                        @foreach (var leg in _legs)
                        {
                            <MudPaper Class="pa-2 mb-1" Style="background: rgba(0,0,0,0.05);">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.body2">@leg.Description (@FormatOdds(leg.Odds))</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _legs.Remove(leg))" />
                                </MudStack>
                            </MudPaper>
                        }

                        @if (_legs.Count > 1)
                        {
                            <MudText Typo="Typo.body2" Class="mt-2">
                                Parlay Odds: <strong style="color:#2196f3;">@FormatOdds(GetParlayOdds())</strong>
                            </MudText>
                        }

                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Class="mt-3">
                            <MudSelect T="string" @bind-Value="_sportsbook" Label="Book" Variant="Variant.Outlined" Dense="true" Style="width:140px;">
                                <MudSelectItem Value="@("fanduel")">FanDuel</MudSelectItem>
                                <MudSelectItem Value="@("draftkings")">DraftKings</MudSelectItem>
                                <MudSelectItem Value="@("betmgm")">BetMGM</MudSelectItem>
                            </MudSelect>
                            <MudTextField T="decimal" @bind-Value="_stake" Label="Stake" Variant="Variant.Outlined" Dense="true"
                                          Style="width:100px;" Adornment="Adornment.Start" AdornmentText="$" />
                            <div>
                                <MudText Typo="Typo.caption">Total Payout</MudText>
                                <MudText Typo="Typo.body1" Style="color:#4caf50;"><strong>$@CalcPayout().ToString("F2")</strong></MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">(+$@CalcWin().ToString("F2") profit)</MudText>
                            </div>
                        </MudStack>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Class="mt-2"
                                   OnClick="PlaceBet" Disabled="@(_stake <= 0)">Place Bet</MudButton>
                    }
                </MudPaper>

                <!-- Manual Add -->
                <MudExpansionPanels Class="mt-3">
                    <MudExpansionPanel Text="Manual Entry">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                                <MudTextField T="string" @bind-Value="_manualDesc" Label="Description" Dense="true" 
                                              Placeholder="Chiefs ML" Style="flex:2;" />
                                <MudTextField T="int" @bind-Value="_manualOdds" Label="Odds" Dense="true" Style="width:90px;" />
                            </MudStack>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                                <MudTextField T="string" @bind-Value="_manualGame" Label="Game (optional)" Dense="true" 
                                              Placeholder="Chiefs @ Bills" Style="flex:2;" />
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddManualLeg">
                                    <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-1" Size="Size.Small" /> Add to Slip
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>

                <!-- History -->
                <MudPaper Class="pa-4 mt-3" Elevation="2">
                    <MudText Typo="Typo.h6" Class="mb-2">Recent Bets</MudText>
                    @if (_bets.Any())
                    {
                        <MudSimpleTable Dense="true" Hover="true" Style="max-height:250px; overflow-y:auto;">
                            <thead>
                                <tr><th>Bet</th><th>Stake</th><th>Odds</th><th>Result</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var b in _bets.Take(10))
                                {
                                    <tr>
                                        <td>@b.Description</td>
                                        <td>$@b.Stake.ToString("F2")</td>
                                        <td>@FormatOdds(b.Odds)</td>
                                        <td>
                                            <MudButtonGroup Size="Size.Small">
                                                <MudButton Color="@(b.Outcome=="win"?Color.Success:Color.Default)" Variant="@(b.Outcome=="win"?Variant.Filled:Variant.Outlined)"
                                                           OnClick="@(()=>SetOutcome(b.Id, b.Outcome=="win"?"pending":"win"))">W</MudButton>
                                                <MudButton Color="@(b.Outcome=="loss"?Color.Error:Color.Default)" Variant="@(b.Outcome=="loss"?Variant.Filled:Variant.Outlined)"
                                                           OnClick="@(()=>SetOutcome(b.Id, b.Outcome=="loss"?"pending":"loss"))">L</MudButton>
                                                <MudButton Color="@(b.Outcome=="cashout"?Color.Warning:Color.Default)" Variant="@(b.Outcome=="cashout"?Variant.Filled:Variant.Outlined)"
                                                           OnClick="@(()=>CashOut(b))">C</MudButton>
                                            </MudButtonGroup>
                                        </td>
                                        <td>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info"
                                                           OnClick="@(() => OpenEditDialog(b))" Title="Edit bet" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                           OnClick="@(() => DeleteBet(b.Id))" Title="Delete bet" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                    else
                    {
                        <MudText Color="Color.Secondary">No bets yet.</MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Analytics Section -->
        <MudExpansionPanels Class="mt-4">
            <MudExpansionPanel Text="📊 Analytics" IsInitiallyExpanded="false">
                <MudStack Spacing="3">
                    <MudStack Row="true" Spacing="2" Class="mb-2">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="LoadChartData" Disabled="@_loadingCharts">
                            @if (_loadingCharts)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Refresh Charts
                        </MudButton>
                        <MudSelect T="int" @bind-Value="_chartDays" Label="Period" Dense="true" Variant="Variant.Outlined" Style="width:120px;">
                            <MudSelectItem Value="7">7 Days</MudSelectItem>
                            <MudSelectItem Value="30">30 Days</MudSelectItem>
                            <MudSelectItem Value="90">90 Days</MudSelectItem>
                        </MudSelect>
                    </MudStack>

                    @if (_chartData != null)
                    {
                        <MudGrid Spacing="3">
                            <!-- Summary Cards -->
                            <MudItem xs="12" md="3">
                                <MudPaper Class="pa-3" Elevation="2" Style="text-align:center;">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">ROI</MudText>
                                    <MudText Typo="Typo.h5" Color="@(_chartRoi >= 0 ? Color.Success : Color.Error)">
                                        @(_chartRoi >= 0 ? "+" : "")@_chartRoi.ToString("F1")%
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudPaper Class="pa-3" Elevation="2" Style="text-align:center;">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Profit</MudText>
                                    <MudText Typo="Typo.h5" Color="@(_chartProfit >= 0 ? Color.Success : Color.Error)">
                                        @(_chartProfit >= 0 ? "+" : "")$@_chartProfit.ToString("F2")
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudPaper Class="pa-3" Elevation="2" Style="text-align:center;">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Win Rate</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Info">
                                        @_chartWinRate.ToString("F1")%
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudPaper Class="pa-3" Elevation="2" Style="text-align:center;">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Bets</MudText>
                                    <MudText Typo="Typo.h5">@_chartTotalBets</MudText>
                                </MudPaper>
                            </MudItem>

                            <!-- Win/Loss/Cashout Distribution -->
                            <MudItem xs="12" md="4">
                                <MudPaper Class="pa-4" Elevation="2">
                                    <MudText Typo="Typo.h6" Class="mb-3">Outcome Distribution</MudText>
                                    <MudStack Spacing="2">
                                        @{
                                            var totalOutcomes = _outcomeWins + _outcomeLosses + _outcomeCashouts;
                                            var winPct = totalOutcomes > 0 ? (_outcomeWins * 100.0 / totalOutcomes) : 0;
                                            var lossPct = totalOutcomes > 0 ? (_outcomeLosses * 100.0 / totalOutcomes) : 0;
                                            var cashPct = totalOutcomes > 0 ? (_outcomeCashouts * 100.0 / totalOutcomes) : 0;
                                        }
                                        <div>
                                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2">Wins (@_outcomeWins)</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Success">@winPct.ToString("F1")%</MudText>
                                            </MudStack>
                                            <MudProgressLinear Color="Color.Success" Value="@winPct" />
                                        </div>
                                        <div>
                                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2">Losses (@_outcomeLosses)</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Error">@lossPct.ToString("F1")%</MudText>
                                            </MudStack>
                                            <MudProgressLinear Color="Color.Error" Value="@lossPct" />
                                        </div>
                                        <div>
                                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2">Cashouts (@_outcomeCashouts)</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Warning">@cashPct.ToString("F1")%</MudText>
                                            </MudStack>
                                            <MudProgressLinear Color="Color.Warning" Value="@cashPct" />
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <!-- Daily Profit Trend -->
                            <MudItem xs="12" md="8">
                                <MudPaper Class="pa-4" Elevation="2">
                                    <MudText Typo="Typo.h6" Class="mb-3">Daily Profit/ROI Trend</MudText>
                                    @if (_dailyData.Any())
                                    {
                                        <MudSimpleTable Dense="true" Hover="true" Style="max-height:200px; overflow-y:auto;">
                                            <thead>
                                                <tr><th>Date</th><th>Bets</th><th>W/L/C</th><th>Profit</th><th>Cum. ROI</th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var d in _dailyData.TakeLast(10).Reverse())
                                                {
                                                    <tr>
                                                        <td>@d.Date</td>
                                                        <td>@d.Bets</td>
                                                        <td style="color:green;">@d.Wins<span style="color:gray;">/</span><span style="color:red;">@d.Losses</span>@(d.Cashouts > 0 ? $"/{d.Cashouts}" : "")</td>
                                                        <td style="color:@(d.Profit >= 0 ? "green" : "red")">@(d.Profit >= 0 ? "+" : "")$@d.Profit.ToString("F2")</td>
                                                        <td style="color:@(d.CumulativeRoi >= 0 ? "green" : "red")">@(d.CumulativeRoi >= 0 ? "+" : "")@d.CumulativeRoi.ToString("F1")%</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </MudSimpleTable>
                                    }
                                    else
                                    {
                                        <MudText Color="Color.Secondary">No data yet. Place some bets first!</MudText>
                                    }
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">Click "Refresh Charts" to load analytics.</MudAlert>
                    }
                </MudStack>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudStack>
</MudContainer>

<!-- Edit Bet Dialog -->
<MudDialog @bind-Visible="_editDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Bet</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField T="string" @bind-Value="_editDescription" Label="Description" Variant="Variant.Outlined" />
            <MudStack Row="true" Spacing="2">
                <MudTextField T="decimal" @bind-Value="_editStake" Label="Stake" Variant="Variant.Outlined" 
                              Adornment="Adornment.Start" AdornmentText="$" />
                <MudTextField T="int" @bind-Value="_editOdds" Label="Odds" Variant="Variant.Outlined" />
            </MudStack>
            <MudSelect T="string" @bind-Value="_editSportsbook" Label="Sportsbook" Variant="Variant.Outlined">
                <MudSelectItem Value="@("fanduel")">FanDuel</MudSelectItem>
                <MudSelectItem Value="@("draftkings")">DraftKings</MudSelectItem>
                <MudSelectItem Value="@("betmgm")">BetMGM</MudSelectItem>
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _editDialogOpen = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveEdit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    // State
    private string _sport = "nfl";
    private bool _loadingGames = false;
    private List<Game> _games = new();
    private List<Leg> _legs = new();
    private string _sportsbook = "fanduel";
    private decimal _stake = 10;
    private string _manualDesc = "";
    private int _manualOdds = -110;
    private string _manualGame = "";  // Optional game name for tracking
    private List<Bet> _bets = new();
    private int _wins = 0, _losses = 0;
    private decimal _netProfit = 0;

    // Chart state
    private bool _loadingCharts = false;
    private int _chartDays = 30;
    private JsonElement? _chartData = null;
    private decimal _chartRoi = 0;
    private decimal _chartProfit = 0;
    private decimal _chartWinRate = 0;
    private int _chartTotalBets = 0;
    private int _outcomeWins = 0, _outcomeLosses = 0, _outcomeCashouts = 0;
    private List<DailyData> _dailyData = new();

    // Edit dialog state
    private bool _editDialogOpen = false;
    private int _editBetId = 0;
    private string _editDescription = "";
    private decimal _editStake = 10;
    private int _editOdds = -110;
    private string _editSportsbook = "fanduel";

    protected override async Task OnInitializedAsync()
    {
        await LoadGames();
        await LoadBets();
        await LoadStats();
    }

    private async Task LoadGames()
    {
        _loadingGames = true;
        _games.Clear();
        StateHasChanged();
        
        try
        {
            // Fetch LIVE odds directly from the odds endpoint
            var resp = await Http.GetAsync($"http://backend:8000/odds/{_sport}?sportsbook=fanduel");
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadAsStringAsync();
                var doc = JsonDocument.Parse(json);
                
                // The /odds endpoint returns games in different formats - parse flexibly
                if (doc.RootElement.TryGetProperty("games", out var gamesArr) || 
                    doc.RootElement.TryGetProperty("odds", out gamesArr))
                {
                    foreach (var g in gamesArr.EnumerateArray())
                    {
                        ParseAndAddGame(g);
                    }
                }
                else if (doc.RootElement.ValueKind == JsonValueKind.Object)
                {
                    // Format: {"TeamA:TeamB": {...odds...}}
                    foreach (var prop in doc.RootElement.EnumerateObject())
                    {
                        var teams = prop.Name.Split(':');
                        if (teams.Length == 2)
                        {
                            var home = teams[0].Trim();
                            var away = teams[1].Trim();
                            int homeML = 0, awayML = 0;
                            decimal total = 0;
                            
                            var odds = prop.Value;
                            if (odds.TryGetProperty(home, out var homeData) && 
                                homeData.TryGetProperty("money_line_odds", out var hm) && hm.ValueKind == JsonValueKind.Number)
                                homeML = hm.GetInt32();
                            if (odds.TryGetProperty(away, out var awayData) && 
                                awayData.TryGetProperty("money_line_odds", out var am) && am.ValueKind == JsonValueKind.Number)
                                awayML = am.GetInt32();
                            if (odds.TryGetProperty("under_over_odds", out var uo) && uo.ValueKind == JsonValueKind.Number)
                                total = uo.GetDecimal();
                            
                            _games.Add(new Game { GameId = $"{home}:{away}", Home = home, Away = away, HomeML = homeML, AwayML = awayML, Total = total });
                        }
                    }
                }
            }
            
            // If no live games, try cache as fallback
            if (_games.Count == 0)
            {
                var cacheResp = await Http.GetAsync($"http://backend:8000/cache/games/{_sport}?include_expired=true");
                if (cacheResp.IsSuccessStatusCode)
                {
                    var json = await cacheResp.Content.ReadAsStringAsync();
                    var doc = JsonDocument.Parse(json);
                    if (doc.RootElement.TryGetProperty("games", out var gamesArr))
                    {
                        foreach (var g in gamesArr.EnumerateArray())
                        {
                            ParseCachedGame(g);
                        }
                    }
                }
            }
            
            if (_games.Count == 0)
            {
                Snackbar.Add($"No {_sport.ToUpper()} games available right now.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading games: {ex.Message}", Severity.Error);
        }
        _loadingGames = false;
    }

    private void ParseAndAddGame(JsonElement g)
    {
        var home = g.TryGetProperty("home_team", out var h) ? h.GetString() ?? "" : "";
        var away = g.TryGetProperty("away_team", out var a) ? a.GetString() ?? "" : "";
        var gid = g.TryGetProperty("game_id", out var id) ? id.GetString() ?? $"{home}:{away}" : $"{home}:{away}";
        int homeML = 0, awayML = 0;
        decimal total = 0;
        
        // Check multiple possible formats
        if (g.TryGetProperty("odds_data", out var odds) && odds.ValueKind == JsonValueKind.Object)
        {
            if (odds.TryGetProperty("home_ml", out var hm) && hm.ValueKind == JsonValueKind.Number)
                homeML = hm.GetInt32();
            if (odds.TryGetProperty("away_ml", out var am) && am.ValueKind == JsonValueKind.Number)
                awayML = am.GetInt32();
            if (odds.TryGetProperty("total", out var t) && t.ValueKind == JsonValueKind.Number)
                total = t.GetDecimal();
        }
        
        if (!string.IsNullOrEmpty(home) && !string.IsNullOrEmpty(away))
        {
            _games.Add(new Game { GameId = gid, Home = home, Away = away, HomeML = homeML, AwayML = awayML, Total = total });
        }
    }

    private void ParseCachedGame(JsonElement g)
    {
        var home = g.TryGetProperty("home_team", out var h) ? h.GetString() ?? "" : "";
        var away = g.TryGetProperty("away_team", out var a) ? a.GetString() ?? "" : "";
        var gid = g.TryGetProperty("game_id", out var id) ? id.GetString() ?? "" : "";
        int homeML = 0, awayML = 0;
        decimal total = 0;
        
        if (g.TryGetProperty("odds_data", out var odds) && odds.ValueKind == JsonValueKind.Object)
        {
            if (odds.TryGetProperty("home_ml", out var hm) && hm.ValueKind == JsonValueKind.Number)
                homeML = hm.GetInt32();
            if (odds.TryGetProperty("away_ml", out var am) && am.ValueKind == JsonValueKind.Number)
                awayML = am.GetInt32();
            if (odds.TryGetProperty("total", out var t) && t.ValueKind == JsonValueKind.Number)
                total = t.GetDecimal();
        }
        
        if (!string.IsNullOrEmpty(home) && !string.IsNullOrEmpty(away))
        {
            _games.Add(new Game { GameId = gid, Home = home, Away = away, HomeML = homeML, AwayML = awayML, Total = total });
        }
    }

    private void AddLeg(string desc, int odds, string gameId)
    {
        _legs.Add(new Leg { Description = desc, Odds = odds, GameId = gameId });
        Snackbar.Add($"Added: {desc}", Severity.Success);
    }

    private void AddManualLeg()
    {
        if (string.IsNullOrWhiteSpace(_manualDesc)) return;
        
        // Create a game ID from the game name if provided
        var gameId = !string.IsNullOrWhiteSpace(_manualGame) ? $"manual:{_manualGame.Replace(" ", "_")}" : null;
        
        _legs.Add(new Leg { 
            Description = _manualDesc, 
            Odds = _manualOdds, 
            GameId = gameId 
        });
        
        var msg = $"Added: {_manualDesc}";
        if (!string.IsNullOrWhiteSpace(_manualGame)) msg += $" ({_manualGame})";
        Snackbar.Add(msg, Severity.Success);
        
        _manualDesc = "";
        _manualGame = "";
    }

    private int GetParlayOdds()
    {
        if (_legs.Count <= 1) return _legs.FirstOrDefault()?.Odds ?? 0;
        double dec = 1;
        foreach (var l in _legs)
            dec *= l.Odds > 0 ? (l.Odds / 100.0) + 1 : (100.0 / Math.Abs(l.Odds)) + 1;
        return dec >= 2 ? (int)((dec - 1) * 100) : (int)(-100 / (dec - 1));
    }

    private decimal CalcWin()
    {
        if (_stake <= 0 || !_legs.Any()) return 0;
        var odds = GetParlayOdds();
        return odds > 0 ? _stake * odds / 100 : _stake * 100 / Math.Abs(odds);
    }

    private decimal CalcPayout()
    {
        return _stake + CalcWin();
    }

    private async Task PlaceBet()
    {
        if (_stake <= 0 || !_legs.Any()) return;
        try
        {
            var req = new
            {
                sport = _sport,
                bet_type = _legs.Count > 1 ? "parlay" : "single",
                sportsbook = _sportsbook,
                stake = _stake,
                odds = GetParlayOdds(),
                description = _legs.Count > 1 ? $"{_legs.Count}-leg: {string.Join(", ", _legs.Select(l => l.Description))}" : _legs[0].Description,
                legs = _legs.Select(l => new { description = l.Description, odds = l.Odds, game_id = l.GameId }).ToList()
            };
            var resp = await Http.PostAsJsonAsync("http://backend:8000/bets", req);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add($"Bet placed! Payout: ${CalcPayout():F2}", Severity.Success);
                _legs.Clear();
                await LoadBets();
                await LoadStats();
            }
            else
            {
                var errorBody = await resp.Content.ReadAsStringAsync();
                Snackbar.Add($"API Error ({resp.StatusCode}): {errorBody}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadBets()
    {
        try
        {
            var resp = await Http.GetFromJsonAsync<JsonElement>("http://backend:8000/bets?limit=20");
            _bets.Clear();
            if (resp.TryGetProperty("bets", out var arr))
            {
                foreach (var b in arr.EnumerateArray())
                {
                    _bets.Add(new Bet
                    {
                        Id = b.GetProperty("id").GetInt32(),
                        Description = b.TryGetProperty("description", out var d) ? d.GetString() ?? "" : "",
                        Stake = b.TryGetProperty("stake", out var s) && s.ValueKind == JsonValueKind.Number ? s.GetDecimal() : 0,
                        Odds = b.TryGetProperty("odds", out var o) && o.ValueKind == JsonValueKind.Number ? o.GetInt32() : 0,
                        Outcome = b.TryGetProperty("outcome", out var oc) ? oc.GetString() ?? "pending" : "pending"
                    });
                }
            }
        }
        catch { }
    }

    private async Task LoadStats()
    {
        try
        {
            var resp = await Http.GetFromJsonAsync<JsonElement>("http://backend:8000/bets/stats/summary");
            _wins = resp.TryGetProperty("wins", out var w) ? w.GetInt32() : 0;
            _losses = resp.TryGetProperty("losses", out var l) ? l.GetInt32() : 0;
            _netProfit = resp.TryGetProperty("net_profit", out var p) && p.ValueKind == JsonValueKind.Number ? p.GetDecimal() : 0;
        }
        catch { }
    }

    private async Task SetOutcome(int id, string outcome)
    {
        await Http.PatchAsJsonAsync($"http://backend:8000/bets/{id}/outcome", new { outcome });
        await LoadBets();
        await LoadStats();
    }

    private async Task CashOut(Bet bet)
    {
        var param = new DialogParameters { { "BetId", bet.Id }, { "Stake", bet.Stake } };
        var dlg = await DialogService.ShowAsync<CashOutDialog>("Cash Out", param);
        var result = await dlg.Result;
        if (!result.Canceled && result.Data is decimal amt)
        {
            await Http.PatchAsJsonAsync($"http://backend:8000/bets/{bet.Id}/outcome", new { outcome = "cashout", cashout_amount = amt });
            await LoadBets();
            await LoadStats();
        }
    }

    private string FormatOdds(int odds) => odds > 0 ? $"+{odds}" : odds.ToString();

    private async Task DeleteBet(int betId)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Delete Bet",
            "Are you sure you want to delete this bet? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        
        if (confirm == true)
        {
            try
            {
                var resp = await Http.DeleteAsync($"http://backend:8000/bets/{betId}");
                if (resp.IsSuccessStatusCode)
                {
                    Snackbar.Add("Bet deleted", Severity.Success);
                    await LoadBets();
                    await LoadStats();
                }
                else
                {
                    Snackbar.Add("Failed to delete bet", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }

    private void OpenEditDialog(Bet bet)
    {
        _editBetId = bet.Id;
        _editDescription = bet.Description;
        _editStake = bet.Stake;
        _editOdds = bet.Odds;
        _editDialogOpen = true;
    }

    private async Task SaveEdit()
    {
        try
        {
            var req = new
            {
                stake = _editStake,
                odds = _editOdds,
                description = _editDescription,
                sportsbook = _editSportsbook
            };
            
            var resp = await Http.PutAsJsonAsync($"http://backend:8000/bets/{_editBetId}", req);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Bet updated!", Severity.Success);
                _editDialogOpen = false;
                await LoadBets();
                await LoadStats();
            }
            else
            {
                Snackbar.Add("Failed to update bet", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    // Simple models
    private record Game { public string GameId { get; init; } = ""; public string Home { get; init; } = ""; public string Away { get; init; } = ""; public int HomeML { get; init; } public int AwayML { get; init; } public decimal Total { get; init; } }
    private record Leg { public string Description { get; init; } = ""; public int Odds { get; init; } public string? GameId { get; init; } }
    private record Bet { public int Id { get; init; } public string Description { get; init; } = ""; public decimal Stake { get; init; } public int Odds { get; init; } public string Outcome { get; init; } = "pending"; }
    private record DailyData { public string Date { get; init; } = ""; public decimal Profit { get; init; } public int Bets { get; init; } public int Wins { get; init; } public int Losses { get; init; } public int Cashouts { get; init; } public decimal CumulativeRoi { get; init; } }

    private async Task LoadChartData()
    {
        _loadingCharts = true;
        StateHasChanged();

        try
        {
            var resp = await Http.GetFromJsonAsync<JsonElement>($"http://backend:8000/bets/stats/chart-data?days={_chartDays}");
            _chartData = resp;

            // Parse summary
            if (resp.TryGetProperty("summary", out var summary))
            {
                _chartRoi = summary.TryGetProperty("roi", out var roi) && roi.ValueKind == JsonValueKind.Number ? roi.GetDecimal() : 0;
                _chartProfit = summary.TryGetProperty("total_profit", out var profit) && profit.ValueKind == JsonValueKind.Number ? profit.GetDecimal() : 0;
                _chartTotalBets = summary.TryGetProperty("total_bets", out var bets) && bets.ValueKind == JsonValueKind.Number ? bets.GetInt32() : 0;
            }

            // Parse outcome distribution
            if (resp.TryGetProperty("outcome_distribution", out var outcomes))
            {
                _outcomeWins = outcomes.TryGetProperty("wins", out var w) && w.ValueKind == JsonValueKind.Number ? w.GetInt32() : 0;
                _outcomeLosses = outcomes.TryGetProperty("losses", out var l) && l.ValueKind == JsonValueKind.Number ? l.GetInt32() : 0;
                _outcomeCashouts = outcomes.TryGetProperty("cashouts", out var c) && c.ValueKind == JsonValueKind.Number ? c.GetInt32() : 0;
            }

            // Calculate win rate
            var totalDecided = _outcomeWins + _outcomeLosses;
            _chartWinRate = totalDecided > 0 ? (_outcomeWins * 100m / totalDecided) : 0;

            // Parse daily data
            _dailyData.Clear();
            if (resp.TryGetProperty("daily_data", out var daily))
            {
                foreach (var d in daily.EnumerateArray())
                {
                    _dailyData.Add(new DailyData
                    {
                        Date = d.TryGetProperty("date", out var dt) ? dt.GetString()?.Substring(5) ?? "" : "",
                        Profit = d.TryGetProperty("profit", out var p) && p.ValueKind == JsonValueKind.Number ? p.GetDecimal() : 0,
                        Bets = d.TryGetProperty("bets", out var b) && b.ValueKind == JsonValueKind.Number ? b.GetInt32() : 0,
                        Wins = d.TryGetProperty("wins", out var wi) && wi.ValueKind == JsonValueKind.Number ? wi.GetInt32() : 0,
                        Losses = d.TryGetProperty("losses", out var lo) && lo.ValueKind == JsonValueKind.Number ? lo.GetInt32() : 0,
                        Cashouts = d.TryGetProperty("cashouts", out var ca) && ca.ValueKind == JsonValueKind.Number ? ca.GetInt32() : 0,
                        CumulativeRoi = d.TryGetProperty("cumulative_roi", out var cr) && cr.ValueKind == JsonValueKind.Number ? cr.GetDecimal() : 0
                    });
                }
            }

            Snackbar.Add("Chart data loaded!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading charts: {ex.Message}", Severity.Warning);
        }

        _loadingCharts = false;
        StateHasChanged();
    }
