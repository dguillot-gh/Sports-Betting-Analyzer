@page "/nascar-dashboard"
@using System.Net.Http.Json
@using System.Timers
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IConfiguration Configuration
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>NASCAR Live Dashboard</PageTitle>

<div class="min-h-screen bg-slate-950 text-slate-100 p-4 md:p-8 font-sans">
    <TwContainer MaxWidth="extraLarge">
        <div class="flex flex-col gap-6">
            <!-- Header -->
            <TwCard Class="bg-gradient-to-r from-slate-900 to-black border-slate-800">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                    <div class="flex items-center gap-4">
                        <div class="p-3 bg-red-500/10 rounded-2xl backdrop-blur-sm border border-red-500/20">
                            <TwIcon Icon="speed" Class="w-10 h-10 text-red-500" />
                        </div>
                        <div>
                            <h1 class="text-3xl font-black text-white tracking-tight">LIVE RACE DASHBOARD</h1>
                            <p class="text-slate-400 font-medium">Real-time telemetry & timing</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="flex items-center gap-2 px-3 py-1.5 rounded-full border @(_isConnected ? "bg-emerald-500/10 border-emerald-500/20 text-emerald-400" : "bg-red-500/10 border-red-500/20 text-red-400")">
                            <TwIcon Icon="@(_isConnected ? "wifi" : "wifi_off")" Class="w-4 h-4" />
                            <span class="text-xs font-bold uppercase tracking-wider">@(_isConnected ? "LIVE" : "OFFLINE")</span>
                        </div>
                        
                        <div class="flex items-center gap-3 bg-slate-800/50 rounded-lg p-2 border border-slate-700/50">
                            <span class="text-sm font-medium text-slate-400">Auto-Refresh</span>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" @bind="_autoRefresh" class="sr-only peer">
                                <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-emerald-500/20 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                            </label>
                        </div>
                    </div>
                </div>
            </TwCard>

            <!-- Race Info Banner -->
            @if (_raceInfo != null && _raceInfo.Count > 0)
            {
                <TwCard Class="bg-slate-900/50 border-slate-800">
                    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
                        @foreach (var item in _raceInfo)
                        {
                            <div class="flex flex-col">
                                <span class="text-xs uppercase tracking-wider text-slate-500 font-semibold mb-1">@FormatLabel(item.Key)</span>
                                <span class="text-lg font-bold text-white">@item.Value</span>
                            </div>
                        }
                    </div>
                </TwCard>
            }

            <!-- Leaderboard -->
            <TwCard Class="overflow-hidden border-slate-800" NoPadding="true">
                <div class="p-4 border-b border-slate-800 bg-slate-900/30">
                     <TwInput @bind-Value="_searchString" 
                              Placeholder="Search Driver, #, or Sponsor..." 
                              Icon="search" 
                              Class="w-full md:max-w-md" />
                </div>
                
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left text-slate-300">
                        <thead class="text-xs text-slate-400 uppercase bg-slate-900/50 border-b border-slate-800">
                            <tr>
                                <th class="px-6 py-3 cursor-pointer hover:text-white" @onclick="@(() => SortBy("Position"))">Pos</th>
                                <th class="px-6 py-3 cursor-pointer hover:text-white" @onclick="@(() => SortBy("Number"))">#</th>
                                <th class="px-6 py-3 cursor-pointer hover:text-white" @onclick="@(() => SortBy("Driver"))">Driver</th>
                                <th class="px-6 py-3">Mfr</th>
                                <th class="px-6 py-3 cursor-pointer hover:text-white" @onclick="@(() => SortBy("Delta"))">Delta</th>
                                <th class="px-6 py-3">Last Lap</th>
                                <th class="px-6 py-3">Best Lap</th>
                                <th class="px-6 py-3">Avg Spd</th>
                                <th class="px-6 py-3">Laps Led</th>
                                <th class="px-6 py-3">Pit</th>
                                <th class="px-6 py-3">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800">
                            @foreach (var car in FilteredVehicles)
                            {
                                <tr class="hover:bg-slate-800/30 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center justify-center w-8 h-8 rounded font-bold @GetPosColor(car.Position)">
                                            @car.Position
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 font-bold text-white font-mono">@car.Number</td>
                                    <td class="px-6 py-4">
                                        <div class="flex flex-col">
                                            <span class="font-bold text-white">@car.Driver</span>
                                            <span class="text-xs text-slate-500">@car.Sponsor</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">@car.Manufacturer</td>
                                    <td class="px-6 py-4 font-mono text-amber-500">@car.Delta</td>
                                    <td class="px-6 py-4 font-mono">
                                        <div class="flex flex-col">
                                            <span>@car.LastLapTime</span>
                                            <span class="text-xs text-slate-500">@car.LastLapSpeed mph</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 font-mono text-emerald-400">@car.BestLapTime</td>
                                    <td class="px-6 py-4 font-mono">@car.AverageSpeed</td>
                                    <td class="px-6 py-4">
                                        @if(car.LapsLedCount > 0)
                                        {
                                            <span class="px-2 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-500 border border-amber-500/20">@car.LapsLedCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-600">-</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4">@car.PitStops</td>
                                    <td class="px-6 py-4">
                                         <span class="@(car.Status == "Running" ? "text-emerald-400" : "text-red-400") font-medium">@car.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </TwCard>
        </div>
    </TwContainer>
</div>

@code {
    private string _apiBaseUrl = "http://backend:8000";
    private Timer? _timer;
    private bool _autoRefresh = true;
    private bool _isConnected = false;
    private Dictionary<string, object> _raceInfo = new();
    private List<VehicleData> _vehicles = new ();
    private string _searchString = "";
    private string _sortBy = "Position";
    private bool _sortAsc = true;

    private IEnumerable<VehicleData> FilteredVehicles
    {
        get
        {
            var query = _vehicles.AsEnumerable();
            
            if (!string.IsNullOrWhiteSpace(_searchString))
            {
                query = query.Where(x => 
                    (x.Driver?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.Number?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.Sponsor?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return SortData(query);
        }
    }

    private void SortBy(string column)
    {
        if (_sortBy == column)
            _sortAsc = !_sortAsc;
        else
        {
            _sortBy = column;
            _sortAsc = true;
        }
    }

    private IEnumerable<VehicleData> SortData(IEnumerable<VehicleData> data)
    {
        return _sortBy switch
        {
            "Driver" => _sortAsc ? data.OrderBy(x => x.Driver) : data.OrderByDescending(x => x.Driver),
            "Number" => _sortAsc ? data.OrderBy(x => int.TryParse(x.Number, out int n) ? n : 999) : data.OrderByDescending(x => int.TryParse(x.Number, out int n) ? n : 999),
            "Delta" => _sortAsc ? data.OrderBy(x => x.Delta) : data.OrderByDescending(x => x.Delta),
            _ => _sortAsc ? data.OrderBy(x => x.Position) : data.OrderByDescending(x => x.Position)
        };
    }

    protected override async Task OnInitializedAsync()
    {
        _apiBaseUrl = Configuration["PythonApiUrl"] ?? "http://backend:8000";
        
        // Start polling
        _timer = new Timer(2000); // 2 seconds
        _timer.Elapsed += async (sender, e) => await PollData();
        _timer.AutoReset = true;
        _timer.Start();
        
        await PollData();
    }

    private async Task PollData()
    {
        if (!_autoRefresh) return;
        
        try
        {
            var data = await Http.GetFromJsonAsync<DashboardResponse>($"{_apiBaseUrl}/nascar-live/dashboard-data");
            if (data != null)
            {
                _raceInfo = data.RaceInfo ?? new();
                _vehicles = data.Vehicles ?? new();
                _isConnected = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            _isConnected = false;
            // Silent fail on polling error
        }
    }

    private string GetPosColor(int pos)
    {
        if (pos == 1) return "bg-amber-500/20 text-amber-500 border border-amber-500/30"; 
        if (pos <= 5) return "bg-emerald-500/20 text-emerald-500 border border-emerald-500/30";
        if (pos <= 10) return "bg-blue-500/20 text-blue-500 border border-blue-500/30";
        return "bg-slate-800 text-slate-400";
    }

    private string FormatLabel(string key)
    {
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo
            .ToTitleCase(key.Replace("_", " "));
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }

    public class DashboardResponse 
    {
        [System.Text.Json.Serialization.JsonPropertyName("race_info")]
        public Dictionary<string, object>? RaceInfo { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("vehicles")]
        public List<VehicleData>? Vehicles { get; set; }
    }

    public class VehicleData
    {
        public int Position { get; set; }
        public string? Number { get; set; }
        public string? Driver { get; set; }
        public string? Manufacturer { get; set; }
        public string? Sponsor { get; set; }
        public string? Delta { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("Last Lap Time")]
        public string? LastLapTime { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("Last Lap Speed")]
        public string? LastLapSpeed { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("Best Lap Time")]
        public string? BestLapTime { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("Best Lap Speed")]
        public string? BestLapSpeed { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("Average Speed")]
        public string? AverageSpeed { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("Laps Led Count")]
        public int LapsLedCount { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("Pit Stops")]
        public int PitStops { get; set; }
        
        public string? Status { get; set; }
    }
}


