@page "/nascar-dashboard"
@using MudBlazor
@using System.Net.Http.Json
@using System.Timers
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IConfiguration Configuration
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>NASCAR Live Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Spacing="3">
        @* Header *@
        <MudPaper Class="pa-4" Elevation="3" Style="background: linear-gradient(to right, #2c3e50, #000000); color: white;">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Large" Color="Color.Error" />
                    <div>
                        <MudText Typo="Typo.h4" Style="font-weight: bold;">LIVE RACE DASHBOARD</MudText>
                        <MudText Typo="Typo.caption" Style="color: #bbb;">Real-time telemetry & timing</MudText>
                    </div>
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                    <MudChip T="string" Color="@(_isConnected ? Color.Success : Color.Error)" Size="Size.Small" Icon="@(_isConnected ? Icons.Material.Filled.Wifi : Icons.Material.Filled.WifiOff)">
                        @(_isConnected ? "LIVE" : "OFFLINE")
                    </MudChip>
                    <MudSwitch @bind-Value="_autoRefresh" Color="Color.Success" Label="Auto-Refresh (2s)" />
                </MudStack>
            </MudStack>
        </MudPaper>

        @* Race Info Banner *@
        @if (_raceInfo != null && _raceInfo.Count > 0)
        {
            <MudPaper Class="pa-3" Elevation="2" Style="background-color: #1a1a1a;">
                <MudGrid Spacing="1">
                    @foreach (var item in _raceInfo)
                    {
                        <MudItem xs="6" sm="4" md="2">
                            <MudText Typo="Typo.caption" Style="color: #888;">@FormatLabel(item.Key)</MudText>
                            <MudText Typo="Typo.body2" Style="color: white; font-weight: bold;">@item.Value</MudText>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        }

        @* Leaderboard *@
        <MudTable Items="@_vehicles" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="calc(100vh - 250px)" 
                  SortLabel="Sort By" Filter="new Func<VehicleData,bool>(FilterFunc)">
            <ToolBarContent>
                <MudTextField @bind-Value="_searchString" Placeholder="Search Driver..." Adornment="Adornment.Start" 
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<VehicleData, object>(x => x.Position)">Pos</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<VehicleData, object>(x => x.Number)">#</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<VehicleData, object>(x => x.Driver)">Driver</MudTableSortLabel></MudTh>
                <MudTh>Mfr</MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<VehicleData, object>(x => x.Delta)">Delta</MudTableSortLabel></MudTh>
                <MudTh>Last Lap</MudTh>
                <MudTh>Best Lap</MudTh>
                <MudTh>Avg Spd</MudTh>
                <MudTh>Laps Led</MudTh>
                <MudTh>Pit</MudTh>
                <MudTh>Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Pos">
                    <MudChip T="string" Size="Size.Small" Color="@GetPosColor(context.Position)" Variant="Variant.Filled">@context.Position</MudChip>
                </MudTd>
                <MudTd DataLabel="#">
                    <MudText Typo="Typo.body2" Style="font-weight: bold;">@context.Number</MudText>
                </MudTd>
                <MudTd DataLabel="Driver">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body2" Style="font-weight: bold;">@context.Driver</MudText>
                        <MudText Typo="Typo.caption" Style="color: #666;">@context.Sponsor</MudText>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Mfr">@context.Manufacturer</MudTd>
                <MudTd DataLabel="Delta" Style="font-family: monospace; color: #ff9800;">@context.Delta</MudTd>
                <MudTd DataLabel="Last Lap" Style="font-family: monospace;">
                    @context.LastLapTime
                    <MudText Typo="Typo.caption" Class="d-block">@context.LastLapSpeed mph</MudText>
                </MudTd>
                <MudTd DataLabel="Best Lap" Style="font-family: monospace; color: #4caf50;">
                    @context.BestLapTime
                </MudTd>
                <MudTd DataLabel="Avg Spd" Style="font-family: monospace;">@context.AverageSpeed</MudTd>
                <MudTd DataLabel="Laps Led">
                    @if(context.LapsLedCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@context.LapsLedCount</MudChip>
                    }
                    else
                    {
                        @("-")
                    }
                </MudTd>
                <MudTd DataLabel="Pit">@context.PitStops</MudTd>
                <MudTd DataLabel="Status">
                     <MudText Color="@(context.Status == "Running" ? Color.Success : Color.Error)">@context.Status</MudText>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudStack>
</MudContainer>

@code {
    private string _apiBaseUrl = "http://backend:8000";
    private Timer? _timer;
    private bool _autoRefresh = true;
    private bool _isConnected = false;
    private Dictionary<string, object> _raceInfo = new();
    private List<VehicleData> _vehicles = new ();
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        _apiBaseUrl = Configuration["PythonApiUrl"] ?? "http://backend:8000";
        
        // Start polling
        _timer = new Timer(2000); // 2 seconds
        _timer.Elapsed += async (sender, e) => await PollData();
        _timer.AutoReset = true;
        _timer.Start();
        
        await PollData();
    }

    private async Task PollData()
    {
        if (!_autoRefresh) return;
        
        try
        {
            var data = await Http.GetFromJsonAsync<DashboardResponse>($"{_apiBaseUrl}/nascar-live/dashboard-data");
            if (data != null)
            {
                _raceInfo = data.RaceInfo ?? new();
                _vehicles = data.Vehicles ?? new();
                _isConnected = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            _isConnected = false;
            // Silent fail on polling error
        }
    }

    private bool FilterFunc(VehicleData element) =>
        string.IsNullOrWhiteSpace(_searchString) ||
        element.Driver?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true ||
        element.Number?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true ||
        element.Sponsor?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true;

    private Color GetPosColor(int pos)
    {
        if (pos == 1) return Color.Warning; // Gold
        if (pos <= 5) return Color.Success; // Green
        if (pos <= 10) return Color.Info;   // Blue
        return Color.Default;
    }

    private string FormatLabel(string key)
    {
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo
            .ToTitleCase(key.Replace("_", " "));
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }

    public class DashboardResponse 
    {
        [System.Text.Json.Serialization.JsonPropertyName("race_info")]
        public Dictionary<string, object>? RaceInfo { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("vehicles")]
        public List<VehicleData>? Vehicles { get; set; }
    }

    public class VehicleData
    {
        public int Position { get; set; }
        public string? Number { get; set; }
        public string? Driver { get; set; }
        public string? Manufacturer { get; set; }
        public string? Sponsor { get; set; }
        public string? Delta { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("Last Lap Time")]
        public string? LastLapTime { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("Last Lap Speed")]
        public string? LastLapSpeed { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("Best Lap Time")]
        public string? BestLapTime { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("Best Lap Speed")]
        public string? BestLapSpeed { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("Average Speed")]
        public string? AverageSpeed { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("Laps Led Count")]
        public int LapsLedCount { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("Pit Stops")]
        public int PitStops { get; set; }
        
        public string? Status { get; set; }
    }
}
