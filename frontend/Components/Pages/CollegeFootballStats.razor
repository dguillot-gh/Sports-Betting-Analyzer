@using SportsBettingAnalyzer.Components.Shared.Tailwind
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IConfiguration Configuration
@using System.Text.Json.Serialization
@rendermode InteractiveServer

<PageTitle>College Football Analytics</PageTitle>

<TwContainer MaxWidth="extraLarge" Class="mt-8">
    <!-- Header -->
    <div class="p-6 mb-8 rounded-xl shadow-lg bg-gradient-to-br from-[#1e3a5f] to-[#0d1b2a] text-white relative overflow-hidden border-l-4 border-amber-500">
        <div class="absolute inset-0 bg-white/5 bg-[radial-gradient(#ffffff15_1px,transparent_1px)] [background-size:16px_16px]"></div>
        <div class="relative z-10 flex flex-col md:flex-row justify-between items-center gap-6">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-white/10 rounded-lg backdrop-blur-sm border border-white/20">
                    <TwIcon Icon="M12 21a9 9 0 100-18 9 9 0 000 18z M12 3v18 M3 12h18 M16.5 16.5l-9-9 M16.5 7.5l-9 9" Class="w-8 h-8 text-white" />
                </div>
                <div>
                    <h1 class="text-3xl font-bold tracking-tight text-white">College Football Stats</h1>
                    <p class="text-slate-400 mt-1">@_currentSeason Season • Powered by CollegeFootballData.com</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-32">
                    <TwSelect TValue="int" Value="@_selectedYear" ValueChanged="OnYearChanged" Label="Season" FullWidth="true">
                        @foreach (var y in _availableYears)
                        {
                            <option value="@y">@y</option>
                        }
                    </TwSelect>
                </div>
                <TwButton Variant="secondary" 
                           OnClick="ImportData" 
                           IsLoading="@_isLoading" 
                           Disabled="@_isLoading"
                           StartIcon="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                           Class="bg-amber-500/20 hover:bg-amber-500/30 border-amber-500/30 text-amber-500 font-bold">
                    @(_isLoading ? "Importing..." : "Import Data")
                </TwButton>
            </div>
        </div>
    </div>

    <!-- Status Alert -->
    @if (!_apiAvailable)
    {
        <TwAlert Severity="warning" Class="mb-8">
            <div class="flex items-center gap-2">
                <span class="font-bold">CFB API Key Required:</span> 
                <span>Add CFBD_API_KEY to your .env file.</span>
                <a href="https://collegefootballdata.com/key" target="_blank" class="underline hover:text-amber-400 transition-colors">Get a free key here</a>
            </div>
        </TwAlert>
    }

    <!-- Stats Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
        <TwCard Class="p-6 bg-gradient-to-br from-[#667eea] to-[#764ba2] border-none shadow-xl">
            <div class="flex flex-col items-center text-center text-white">
                <div class="p-3 bg-white/10 rounded-full mb-4">
                    <TwIcon Icon="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" Class="w-8 h-8" />
                </div>
                <div class="text-4xl font-black mb-1">@_teams.Count</div>
                <div class="text-sm font-bold uppercase tracking-wider opacity-80">Teams Loaded</div>
            </div>
        </TwCard>
        
        <TwCard Class="p-6 bg-gradient-to-br from-[#11998e] to-[#38ef7d] border-none shadow-xl">
            <div class="flex flex-col items-center text-center text-white">
                <div class="p-3 bg-white/10 rounded-full mb-4">
                    <TwIcon Icon="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" Class="w-8 h-8" />
                </div>
                <div class="text-4xl font-black mb-1">@_games.Count</div>
                <div class="text-sm font-bold uppercase tracking-wider opacity-80">Games</div>
            </div>
        </TwCard>
        
        <TwCard Class="p-6 bg-gradient-to-br from-[#f093fb] to-[#f5576c] border-none shadow-xl">
            <div class="flex flex-col items-center text-center text-white">
                <div class="p-3 bg-white/10 rounded-full mb-4">
                    <TwIcon Icon="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" Class="w-8 h-8" />
                </div>
                <div class="text-4xl font-black mb-1">@_players.Count</div>
                <div class="text-sm font-bold uppercase tracking-wider opacity-80">Player Stats</div>
            </div>
        </TwCard>
    </div>

    <TwTabs>
        @* Teams Tab *@
        <TwTabPanel Title="Teams" Icon="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
            <div class="space-y-6 mt-6">
                <!-- Filters -->
                <div class="flex flex-wrap gap-4 items-end bg-slate-800/30 p-4 rounded-xl border border-slate-700/50">
                    <div class="flex-1 min-w-[200px]">
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Search Teams</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <TwIcon Icon="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" Class="h-4 w-4 text-slate-500" />
                            </div>
                            <input type="text" @bind-value="_teamSearch" @bind-value:event="oninput"
                                   class="block w-full pl-10 pr-3 py-2 border border-slate-700 rounded-lg bg-slate-900 text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all sm:text-sm" 
                                   placeholder="Type team name..." />
                        </div>
                    </div>
                    <div class="w-full sm:w-64">
                        <TwSelect TValue="string" @bind-Value="_conferenceFilter" Label="Conference" FullWidth="true">
                            <option value="">All Conferences</option>
                            @foreach (var conf in _conferences)
                            {
                                <option value="@conf">@conf</option>
                            }
                        </TwSelect>
                    </div>
                </div>
                
                <TwTable Items="@FilteredTeams" IsLoading="@_isLoading" Class="bg-slate-900/50">
                    <HeaderContent>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Team</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Conference</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Division</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider text-center">Colors</th>
                    </HeaderContent>
                    <RowTemplate>
                        <td class="px-4 py-3 whitespace-nowrap text-slate-300">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg flex items-center justify-center text-white font-bold text-xs shadow-sm"
                                     style="background: @(context.Color ?? "#334155")">
                                    @(context.School?[0])
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-sm font-bold text-slate-200">@context.School</span>
                                    <span class="text-[10px] text-slate-500 uppercase tracking-tighter">@context.Mascot</span>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap">
                            <TwChip Color="blue" Variant="solid" Size="sm">@context.Conference</TwChip>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-slate-400">@context.Division</td>
                        <td class="px-4 py-3 whitespace-nowrap">
                            <div class="flex justify-center gap-2">
                                <div class="w-6 h-6 rounded border border-white/10 shadow-sm" style="background: @(context.Color ?? "#333");"></div>
                                <div class="w-6 h-6 rounded border border-white/10 shadow-sm" style="background: @(context.AltColor ?? "#666");"></div>
                            </div>
                        </td>
                    </RowTemplate>
                </TwTable>
            </div>
        </TwTabPanel>

        <!-- Schedule Tab -->
        <TwTabPanel Title="Schedule" Icon="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
            <div class="space-y-6 mt-6">
                <!-- Filters -->
                <div class="flex flex-wrap gap-4 items-end bg-slate-800/30 p-4 rounded-xl border border-slate-700/50">
                    <div class="w-full sm:w-32">
                        <TwSelect TValue="int?" @bind-Value="_weekFilter" Label="Week" FullWidth="true">
                            <option value="">All Weeks</option>
                            @for (int w = 1; w <= 15; w++)
                            {
                                <option value="@((int?)w)">Week @w</option>
                            }
                        </TwSelect>
                    </div>
                    <div class="flex-1 min-w-[200px]">
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Search Team</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <TwIcon Icon="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" Class="h-4 w-4 text-slate-500" />
                            </div>
                            <input type="text" @bind-value="_gameTeamSearch" @bind-value:event="oninput"
                                   class="block w-full pl-10 pr-3 py-2 border border-slate-700 rounded-lg bg-slate-900 text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all sm:text-sm" 
                                   placeholder="Team name..." />
                        </div>
                    </div>
                </div>

                <TwTable Items="@FilteredGames" IsLoading="@_isLoading" Class="bg-slate-900/50">
                    <HeaderContent>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Week</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Game</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Score</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Venue</th>
                    </HeaderContent>
                    <RowTemplate>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-slate-400">@context.Week</td>
                        <td class="px-4 py-3 whitespace-nowrap">
                            <div class="flex flex-col gap-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-slate-500 text-[10px] font-bold w-6">HOME</span>
                                    <span class="text-sm font-semibold text-slate-200">@context.HomeTeam</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-slate-500 text-[10px] font-bold w-6">AWAY</span>
                                    <span class="text-sm font-semibold text-slate-200">@context.AwayTeam</span>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap">
                            @if (context.HomePoints.HasValue)
                            {
                                <div class="flex flex-col gap-1 font-mono text-sm leading-none">
                                    <div class="@(context.HomePoints > context.AwayPoints ? "text-emerald-400 font-bold" : "text-slate-400")">
                                        @context.HomePoints
                                    </div>
                                    <div class="@(context.AwayPoints > context.HomePoints ? "text-emerald-400 font-bold" : "text-slate-400")">
                                        @context.AwayPoints
                                    </div>
                                </div>
                            }
                            else
                            {
                                <TwChip Color="blue" Variant="solid" Size="sm">UPCOMING</TwChip>
                            }
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-slate-500 italic truncate max-w-[200px]">
                            @context.Venue
                        </td>
                    </RowTemplate>
                </TwTable>
            </div>
        </TwTabPanel>

        <!-- Player Stats Tab -->
        <TwTabPanel Title="Player Stats" Icon="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z">
            <div class="space-y-6 mt-6">
                <!-- Filters -->
                <div class="flex flex-wrap gap-4 items-end bg-slate-800/30 p-4 rounded-xl border border-slate-700/50">
                    <div class="flex-1 min-w-[200px]">
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Search Player</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <TwIcon Icon="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" Class="h-4 w-4 text-slate-500" />
                            </div>
                            <input type="text" @bind-value="_playerSearch" @bind-value:event="oninput"
                                   class="block w-full pl-10 pr-3 py-2 border border-slate-700 rounded-lg bg-slate-900 text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all sm:text-sm" 
                                   placeholder="Player name..." />
                        </div>
                    </div>
                    <div class="w-full sm:w-48">
                        <TwSelect TValue="string" @bind-Value="_positionFilter" Label="Position" FullWidth="true">
                            <option value="">All Positions</option>
                            <option value="QB">Quarterback</option>
                            <option value="RB">Running Back</option>
                            <option value="WR">Wide Receiver</option>
                            <option value="TE">Tight End</option>
                            <option value="LB">Linebacker</option>
                            <option value="DB">Defensive Back</option>
                        </TwSelect>
                    </div>
                </div>

                <TwTable Items="@FilteredPlayers" IsLoading="@_isLoading" Class="bg-slate-900/50">
                    <HeaderContent>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Player</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Team</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider text-center">Pos</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Stat</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-400 uppercase tracking-wider">Value</th>
                    </HeaderContent>
                    <RowTemplate>
                        <td class="px-4 py-3 whitespace-nowrap">
                            <div class="text-sm font-bold text-slate-200">@context.Player</div>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-sm text-slate-400">@context.Team</td>
                        <td class="px-4 py-3 whitespace-nowrap text-center">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-300 border border-slate-700">
                                @context.Position
                            </span>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap">
                            <div class="flex flex-col">
                                <span class="text-xs font-semibold text-slate-300">@context.StatType</span>
                                <span class="text-[10px] text-slate-500 uppercase">@context.Category</span>
                            </div>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-right font-mono text-blue-400 font-bold">
                            @context.Stat
                        </td>
                    </RowTemplate>
                </TwTable>
            </div>
        </TwTabPanel>
    </TwTabs>
</TwContainer>

@code {
    private string _apiBaseUrl = "http://backend:8000";
    private bool _apiAvailable = true;
    private bool _isLoading = false;
    private int _selectedYear;
    private int _currentSeason;
    private List<int> _availableYears = new(); // [NEW]

    // Data
    private List<TeamInfo> _teams = new();
    private List<GameInfo> _games = new();
    private List<PlayerStat> _players = new();
    private List<string> _conferences = new();
    
    // Filters
    private string _teamSearch = "";
    private string _conferenceFilter = "";
    private int? _weekFilter;
    private string _gameTeamSearch = "";
    private string _playerSearch = "";
    private string _positionFilter = "";
    
    protected override async Task OnInitializedAsync()
    {
        _apiBaseUrl = Configuration["PythonApiUrl"] ?? "http://backend:8000";
        _currentSeason = DateTime.Now.Month >= 8 ? DateTime.Now.Year : DateTime.Now.Year - 1;
        _selectedYear = _currentSeason;
        
        // Populate available years
        for (int y = _currentSeason; y >= 2015; y--)
        {
            _availableYears.Add(y);
        }

        await CheckApiStatus();
        await LoadData();
    }
    
    private async Task CheckApiStatus()
    {
        try
        {
            var status = await Http.GetFromJsonAsync<CfbStatus>($"{_apiBaseUrl}/cfb/status");
            _apiAvailable = status?.Available ?? false;
            // Only update current season if API is explicitly available and returns robust data
            if (status != null && status.CurrentSeason > 0) 
            {
               // _currentSeason = status.CurrentSeason; // Keep the local calc as safer default for now
            }
        }
        catch { _apiAvailable = false; }
    }
    
    private async Task OnYearChanged(int year)
    {
        _selectedYear = year;
        await LoadData();
    }
    
    private async Task LoadData()
    {
        _isLoading = true;
        StateHasChanged();
        
        try
        {
            // Load teams
            var teamsResp = await Http.GetFromJsonAsync<TeamsResponse>($"{_apiBaseUrl}/cfb/teams?year={_selectedYear}");
            if (teamsResp != null) _teams = teamsResp.Teams;
            
            // Extract conferences
            _conferences = _teams.Where(t => !string.IsNullOrEmpty(t.Conference))
                                 .Select(t => t.Conference!)
                                 .Distinct()
                                 .OrderBy(c => c)
                                 .ToList();
            
            // Load games
            var gamesResp = await Http.GetFromJsonAsync<GamesResponse>($"{_apiBaseUrl}/cfb/games?year={_selectedYear}");
            if (gamesResp != null) _games = gamesResp.Games;
            
            // Load player stats
            var playersResp = await Http.GetFromJsonAsync<PlayersResponse>($"{_apiBaseUrl}/cfb/stats/players?year={_selectedYear}&limit=500");
            if (playersResp != null) _players = playersResp.Players;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
        }
        
        _isLoading = false;
        StateHasChanged();
    }
    
    private async Task ImportData()
    {
        _isLoading = true;
        StateHasChanged();
        
        try
        {
            var result = await Http.PostAsync($"{_apiBaseUrl}/cfb/import?year={_selectedYear}&import_type=all", null);
            var response = await result.Content.ReadFromJsonAsync<ImportResponse>();
            
            if (response?.Success == true)
            {
                Snackbar.Add($"Imported {response.TeamsImported} teams, {response.GamesImported} games, {response.PlayersImported} player stats", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Import failed", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Import error: {ex.Message}", Severity.Error);
        }
        
        _isLoading = false;
    }
    
    // Filtered collections
    private IEnumerable<TeamInfo> FilteredTeams => _teams
        .Where(t => string.IsNullOrEmpty(_teamSearch) || t.School?.Contains(_teamSearch, StringComparison.OrdinalIgnoreCase) == true)
        .Where(t => string.IsNullOrEmpty(_conferenceFilter) || t.Conference == _conferenceFilter);
    
    private IEnumerable<GameInfo> FilteredGames => _games
        .Where(g => !_weekFilter.HasValue || g.Week == _weekFilter)
        .Where(g => string.IsNullOrEmpty(_gameTeamSearch) || 
                    g.HomeTeam?.Contains(_gameTeamSearch, StringComparison.OrdinalIgnoreCase) == true ||
                    g.AwayTeam?.Contains(_gameTeamSearch, StringComparison.OrdinalIgnoreCase) == true);
    
    private IEnumerable<PlayerStat> FilteredPlayers => _players
        .Where(p => string.IsNullOrEmpty(_playerSearch) || p.Player?.Contains(_playerSearch, StringComparison.OrdinalIgnoreCase) == true)
        .Where(p => string.IsNullOrEmpty(_positionFilter) || p.Position?.Contains(_positionFilter, StringComparison.OrdinalIgnoreCase) == true);
    


    // DTOs
    private class CfbStatus { public bool Available { get; set; } public int CurrentSeason { get; set; } }
    private class TeamsResponse { [JsonPropertyName("teams")] public List<TeamInfo> Teams { get; set; } = new(); }
    private class GamesResponse { [JsonPropertyName("games")] public List<GameInfo> Games { get; set; } = new(); }
    private class PlayersResponse { [JsonPropertyName("players")] public List<PlayerStat> Players { get; set; } = new(); }
    private class ImportResponse { 
        [JsonPropertyName("success")] public bool Success { get; set; } 
        [JsonPropertyName("message")] public string? Message { get; set; } 
        [JsonPropertyName("teams_imported")] public int TeamsImported { get; set; } 
        [JsonPropertyName("games_imported")] public int GamesImported { get; set; } 
        [JsonPropertyName("players_imported")] public int PlayersImported { get; set; } 
    }
    
    private class TeamInfo
    {
        [JsonPropertyName("id")] public int? Id { get; set; }
        [JsonPropertyName("school")] public string? School { get; set; }
        [JsonPropertyName("mascot")] public string? Mascot { get; set; }
        [JsonPropertyName("conference")] public string? Conference { get; set; }
        [JsonPropertyName("division")] public string? Division { get; set; }
        [JsonPropertyName("color")] public string? Color { get; set; }
        [JsonPropertyName("alt_color")] public string? AltColor { get; set; }
    }
    
    private class GameInfo
    {
        [JsonPropertyName("week")] public int? Week { get; set; }
        [JsonPropertyName("home_team")] public string? HomeTeam { get; set; }
        [JsonPropertyName("away_team")] public string? AwayTeam { get; set; }
        [JsonPropertyName("home_points")] public double? HomePoints { get; set; }
        [JsonPropertyName("away_points")] public double? AwayPoints { get; set; }
        [JsonPropertyName("venue")] public string? Venue { get; set; }
    }
    
    private class PlayerStat
    {
        [JsonPropertyName("player")] public string? Player { get; set; }
        [JsonPropertyName("team")] public string? Team { get; set; }
        [JsonPropertyName("position")] public string? Position { get; set; }
        [JsonPropertyName("category")] public string? Category { get; set; }
        [JsonPropertyName("stat_type")] public string? StatType { get; set; }
        [JsonPropertyName("stat")] public string? Stat { get; set; }
    }
}
