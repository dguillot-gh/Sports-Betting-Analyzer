@page "/nascar"
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject PythonMLServiceClient MLServiceClient

<PageTitle>NASCAR Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudPaper Class="pa-4" Elevation="2" Style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <div>
                    <MudText Typo="Typo.h4" Style="color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.Flag" Class="mr-2" />
                        NASCAR @DateTime.Now.Year
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.7);">
                        Race Predictions & Schedule
                    </MudText>
                </div>
                <MudStack Row="true" Spacing="2">
                    <MudSelect T="int" @bind-Value="_seriesId" @bind-Value:after="LoadSchedule"
                               Label="Series" Variant="Variant.Outlined" Dense="true" 
                               Style="width: 160px; background: white;">
                        <MudSelectItem Value="@(1)">Cup Series</MudSelectItem>
                        <MudSelectItem Value="@(2)">Xfinity Series</MudSelectItem>
                        <MudSelectItem Value="@(3)">Truck Series</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" 
                               OnClick="LoadSchedule" Disabled="@_loading"
                               StartIcon="@Icons.Material.Filled.Refresh">
                        @(_loading ? "Loading..." : "Refresh")
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <!-- Next Race Card -->
        @if (_nextRace != null)
        {
            <MudPaper Class="pa-4" Elevation="3" Style="background: linear-gradient(135deg, #ff6f00 0%, #ff8f00 100%);">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.overline" Style="color: rgba(255,255,255,0.8);">
                            🏁 NEXT RACE
                        </MudText>
                        <MudText Typo="Typo.h5" Style="color: white; font-weight: bold;">
                            @_nextRace.RaceName
                        </MudText>
                        <MudText Style="color: rgba(255,255,255,0.9);">
                            @_nextRace.TrackName • @_nextRace.ScheduledLaps Laps
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.8);">
                            @_nextRace.RaceDate.ToString("dddd, MMMM d @ h:mm tt")
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Large"
                               OnClick="@(() => OpenRaceDetail(_nextRace))"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        View Predictions
                    </MudButton>
                </MudStack>
            </MudPaper>
        }

        <!-- Schedule Table -->
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="mr-2" />
                    @DateTime.Now.Year @GetSeriesName() Schedule
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Click any race to view predictions
                </MudText>
            </MudStack>

            @if (_loading)
            {
                <MudProgressLinear Color="Color.Warning" Indeterminate="true" />
            }
            else if (_schedule.Any())
            {
                <MudSimpleTable Dense="true" Hover="true" Striped="true" Style="cursor: pointer;">
                    <thead>
                        <tr style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
                            <th style="color: white; width: 50px;">#</th>
                            <th style="color: white;">Race</th>
                            <th style="color: white;">Track</th>
                            <th style="color: white;">Date</th>
                            <th style="color: white; width: 80px;">Laps</th>
                            <th style="color: white; width: 100px;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var race in _schedule)
                        {
                            var isPast = race.RaceDate < DateTime.Now;
                            var isNext = race.RaceId == _nextRace?.RaceId;
                            <tr @onclick="@(() => OpenRaceDetail(race))" 
                                style="@(isNext ? "background: rgba(255, 152, 0, 0.15); border-left: 4px solid #ff9800;" : "")">
                                <td><strong>@race.RaceNumber</strong></td>
                                <td>
                                    <MudText Typo="Typo.body2">
                                        <strong>@race.RaceName</strong>
                                    </MudText>
                                </td>
                                <td>@race.TrackName</td>
                                <td>
                                    <MudText Typo="Typo.body2">@race.RaceDate.ToString("MMM d")</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@race.RaceDate.ToString("h:mm tt")</MudText>
                                </td>
                                <td>@race.ScheduledLaps</td>
                                <td>
                                    @if (isPast && (race.WinnerDriverId ?? 0) > 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                            Complete
                                        </MudChip>
                                    }
                                    else if (isPast)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                            Past
                                        </MudChip>
                                    }
                                    else if (isNext)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                                            Next
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                            Upcoming
                                        </MudChip>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
            else
            {
                <MudAlert Severity="Severity.Info">
                    No schedule data available. Click Refresh to load.
                </MudAlert>
            }
        </MudPaper>
    </MudStack>
</MudContainer>

<!-- Race Detail Dialog -->
<MudDialog @bind-Visible="_dialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true })">
    <TitleContent>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h6">@_selectedRace?.RaceName</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_selectedRace?.TrackName • @_selectedRace?.RaceDate.ToString("MMMM d, yyyy")
                </MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _dialogVisible = false)" />
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <!-- Race Info -->
            <MudStack Row="true" Spacing="3">
                <MudPaper Class="pa-3 flex-1" Style="background: #f5f5f5;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Laps</MudText>
                    <MudText Typo="Typo.h6">@_selectedRace?.ScheduledLaps</MudText>
                </MudPaper>
                <MudPaper Class="pa-3 flex-1" Style="background: #f5f5f5;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Track Type</MudText>
                    <MudText Typo="Typo.h6">@(_selectedRace?.RestrictorPlate == true ? "Superspeedway" : "Standard")</MudText>
                </MudPaper>
                <MudPaper Class="pa-3 flex-1" Style="background: #f5f5f5;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Series</MudText>
                    <MudText Typo="Typo.h6">@GetSeriesName()</MudText>
                </MudPaper>
            </MudStack>

            <!-- Predictions Section -->
            <MudPaper Class="pa-3" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1">
                        <MudIcon Icon="@Icons.Material.Filled.Analytics" Class="mr-1" Size="Size.Small" />
                        AI Predictions
                    </MudText>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                               OnClick="LoadPredictions" Disabled="@_loadingPredictions"
                               StartIcon="@Icons.Material.Filled.Refresh">
                        @(_loadingPredictions ? "Loading..." : "Refresh")
                    </MudButton>
                </MudStack>

                @if (_loadingPredictions)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                }
                else if (_predictions.Any())
                {
                    <MudSimpleTable Dense="true" Hover="true" Striped="true">
                        <thead>
                            <tr>
                                <th>Rank</th>
                                <th>#</th>
                                <th>Driver</th>
                                <th>Win Prob</th>
                                <th>Proj Finish</th>
                                <th>Market Odds</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pred in _predictions.Take(20))
                            {
                                <tr>
                                    <td>
                                        <MudChip T="string" Size="Size.Small" 
                                                 Color="@(pred.Rank <= 5 ? Color.Warning : Color.Default)"
                                                 Variant="Variant.Filled">
                                            #@pred.Rank
                                        </MudChip>
                                    </td>
                                    <td>@pred.CarNumber</td>
                                    <td><strong>@pred.DriverName</strong></td>
                                    <td>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudProgressLinear Color="Color.Success" 
                                                               Value="@(pred.WinProbability * 100)" 
                                                               Max="15" 
                                                               Style="width: 60px; height: 8px;" />
                                            <MudText Typo="Typo.body2">@((pred.WinProbability * 100).ToString("F1"))%</MudText>
                                        </MudStack>
                                    </td>
                                    <td>P@pred.ProjectedFinish.ToString("F1")</td>
                                    <td>
                                        @if (pred.MarketOdds != "N/A" && !string.IsNullOrEmpty(pred.MarketOdds))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                                @pred.MarketOdds
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">--</MudText>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Click Refresh to load AI predictions for this race.
                    </MudAlert>
                }
            </MudPaper>

            <!-- AI Insight -->
            <MudPaper Class="pa-3" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1">
                        <MudIcon Icon="@Icons.Material.Filled.Psychology" Class="mr-1" Size="Size.Small" />
                        AI Race Analysis
                    </MudText>
                    <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Secondary"
                               OnClick="GetAiInsight" Disabled="@_loadingInsight"
                               StartIcon="@Icons.Material.Filled.AutoAwesome">
                        @(_loadingInsight ? "Analyzing..." : "Get Insight")
                    </MudButton>
                </MudStack>

                @if (_aiInsight != null)
                {
                    <MudPaper Class="pa-3" Style="background: rgba(156, 39, 176, 0.05); border-left: 4px solid #9c27b0;">
                        <MudText Typo="Typo.body2" Class="mb-2">
                            "@_aiInsight.LlmInsight?.Rationale"
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            <strong>Key Factor:</strong> @_aiInsight.LlmInsight?.KeyFactor
                        </MudText>
                    </MudPaper>
                }
                else if (!_loadingInsight)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Click "Get Insight" for Gemini AI analysis of this race.
                    </MudText>
                }
            </MudPaper>
        </MudStack>
    </DialogContent>
</MudDialog>

@code {
    private int _seriesId = 1;
    private bool _loading = false;
    private bool _dialogVisible = false;
    private bool _loadingPredictions = false;
    private bool _loadingInsight = false;

    private List<RaceInfo> _schedule = new();
    private RaceInfo? _nextRace;
    private RaceInfo? _selectedRace;
    private List<PredictionInfo> _predictions = new();
    private AiAnalysisReport? _aiInsight;

    protected override async Task OnInitializedAsync()
    {
        await LoadSchedule();
    }

    private async Task LoadSchedule()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var year = DateTime.Now.Year;
            var response = await Http.GetAsync($"http://backend:8000/nascar/schedule/{year}?series={_seriesId}");
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _schedule = JsonSerializer.Deserialize<List<RaceInfo>>(json, 
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();

                // Find next race
                _nextRace = _schedule.FirstOrDefault(r => r.RaceDate > DateTime.Now);
            }
            else
            {
                // Fallback to NASCAR API directly
                await LoadScheduleFromNascar();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading schedule: {ex.Message}", Severity.Error);
            await LoadScheduleFromNascar();
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task LoadScheduleFromNascar()
    {
        try
        {
            var year = DateTime.Now.Year;
            var url = $"https://cf.nascar.com/cacher/{year}/race_list_basic.json";
            var response = await Http.GetAsync(url);
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var data = JsonSerializer.Deserialize<RaceListResponse>(json, 
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                _schedule = _seriesId switch
                {
                    1 => data?.Series1 ?? new(),
                    2 => data?.Series2 ?? new(),
                    3 => data?.Series3 ?? new(),
                    _ => new()
                };

                // Number the races
                for (int i = 0; i < _schedule.Count; i++)
                    _schedule[i].RaceNumber = i + 1;

                _nextRace = _schedule.FirstOrDefault(r => r.RaceDate > DateTime.Now);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load from NASCAR API: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnSeriesChanged(int newValue)
    {
        _seriesId = newValue;
        await LoadSchedule();
    }

    private void OpenRaceDetail(RaceInfo race)
    {
        _selectedRace = race;
        _predictions = new();
        _aiInsight = null;
        _dialogVisible = true;
    }

    private async Task LoadPredictions()
    {
        if (_selectedRace == null) return;

        _loadingPredictions = true;
        StateHasChanged();

        try
        {
            var response = await Http.GetAsync($"http://backend:8000/nascar/predictions/{_selectedRace.RaceId}");
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<PredictionResponse>(json,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                _predictions = result?.Predictions ?? new();
            }
            else
            {
                Snackbar.Add("Failed to load predictions", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }

        _loadingPredictions = false;
        StateHasChanged();
    }

    private async Task GetAiInsight()
    {
        if (_selectedRace == null) return;

        _loadingInsight = true;
        StateHasChanged();

        try
        {
            _aiInsight = await MLServiceClient.GetAiAnalysisAsync(
                "nascar", 
                _selectedRace.TrackName, 
                _selectedRace.RaceName);

            if (_aiInsight != null)
            {
                Snackbar.Add("AI analysis complete!", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"AI Error: {ex.Message}", Severity.Error);
        }

        _loadingInsight = false;
        StateHasChanged();
    }

    private string GetSeriesName() => _seriesId switch
    {
        1 => "Cup Series",
        2 => "Xfinity Series",
        3 => "Truck Series",
        _ => "Unknown"
    };

    // Data Models
    public class RaceListResponse
    {
        public List<RaceInfo> Series1 { get; set; } = new();
        public List<RaceInfo> Series2 { get; set; } = new();
        public List<RaceInfo> Series3 { get; set; } = new();
    }

    public class RaceInfo
    {
        public int RaceNumber { get; set; }
        public int? RaceId { get; set; }
        public int? SeriesId { get; set; }
        public string RaceName { get; set; } = "";
        public string TrackName { get; set; } = "";
        public DateTime RaceDate { get; set; }
        public int? ScheduledLaps { get; set; }
        public int? WinnerDriverId { get; set; }
        public bool? RestrictorPlate { get; set; }
    }

    public class PredictionResponse
    {
        public int RaceId { get; set; }
        public string TrackName { get; set; } = "";
        public List<PredictionInfo> Predictions { get; set; } = new();
    }

    public class PredictionInfo
    {
        public int Rank { get; set; }
        public string DriverName { get; set; } = "";
        public string CarNumber { get; set; } = "";
        public double WinProbability { get; set; }
        public double ProjectedFinish { get; set; }
        public string MarketOdds { get; set; } = "N/A";
        public string Confidence { get; set; } = "Low";
    }
}
