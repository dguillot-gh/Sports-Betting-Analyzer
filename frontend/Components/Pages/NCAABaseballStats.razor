@page "/ncaa-baseball/stats"
@rendermode InteractiveServer
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ILogger<NCAABaseballStats> Logger

<PageTitle>College Baseball Stats</PageTitle>

<TwContainer MaxWidth="extraLarge" Class="mt-8">
    <!-- Header -->
    <div class="p-6 mb-8 rounded-xl shadow-lg bg-gradient-to-br from-[#002d72] to-[#ce1141] text-white relative overflow-hidden">
        <div class="absolute inset-0 bg-white/5 bg-[radial-gradient(#ffffff15_1px,transparent_1px)] [background-size:16px_16px]"></div>
        <div class="relative z-10 flex flex-col md:flex-row justify-between items-center gap-6">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-white/10 rounded-lg backdrop-blur-sm border border-white/20">
                    <TwIcon Icon="M12 21a9 9 0 100-18 9 9 0 000 18z M12 3v18 M3 12h18 M16.5 16.5l-9-9 M16.5 7.5l-9 9" Class="w-8 h-8 text-white" />
                </div>
                <div>
                    <h1 class="text-3xl font-bold tracking-tight text-white">College Baseball Analytics</h1>
                    <p class="text-white/80 mt-1">NCAA Division I, II, III batting and pitching statistics</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <TwButton Variant="secondary" 
                           Href="/college-baseball-player-profiles"
                           StartIcon="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                           Class="bg-white/10 border-white/20 hover:bg-white/20 text-white font-bold">
                    Player Profiles
                </TwButton>
                <TwChip Color="amber" Variant="solid" Size="md" Class="font-bold">
                    DIVISION @_selectedDivision
                </TwChip>
            </div>
        </div>
    </div>
    
    <!-- Team Selection & Import -->
    <TwCard Class="p-6 mb-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
            <div>
                <TwSelect TValue="int" @bind-Value="_selectedDivision" Label="Division" FullWidth="true">
                    <option value="1">Division I</option>
                    <option value="2">Division II</option>
                    <option value="3">Division III</option>
                </TwSelect>
            </div>
            <div class="md:col-span-1">
                <div class="flex flex-col gap-1.5 text-left">
                    <label class="text-sm font-semibold text-slate-300">Search Teams</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <TwIcon Icon="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" Class="w-4 h-4 text-slate-500" />
                        </div>
                        <input type="text" 
                               value="@_searchString" 
                               @oninput="@(e => UpdateSearch(e.Value?.ToString() ?? ""))"
                               placeholder="Type to search teams..." 
                               class="w-full bg-slate-900 border border-slate-700 rounded-lg py-2.5 pl-10 pr-4 text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all placeholder:text-slate-600" />
                        
                        @if (!string.IsNullOrEmpty(_searchString) && _filteredTeams.Any())
                        {
                            <div class="absolute z-20 w-full mt-1 bg-slate-800 border border-slate-700 rounded-lg shadow-2xl max-h-60 overflow-y-auto">
                                @foreach (var team in _filteredTeams)
                                {
                                    <button @onclick="() => SelectTeamInternal(team)" class="w-full text-left px-4 py-2 hover:bg-slate-700 text-slate-200 transition-colors border-b border-slate-700/50 last:border-0">
                                        @team.TeamName
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div>
                <TwButton Variant="outline" 
                           OnClick="LoadTeams" 
                           IsLoading="@_isLoading" 
                           Disabled="@_isLoading" 
                           FullWidth="true"
                           Class="border-slate-700 text-slate-300 hover:bg-slate-800">
                    @(_teams.Any() ? "Refresh Teams" : "Load Teams")
                </TwButton>
            </div>
            <div>
                <TwToolTip Text="Imports all divisions (D1, D3, D2) with smart year detection">
                    <TwButton Variant="secondary" 
                               OnClick="ImportAllTeams" 
                               IsLoading="@_isImporting" 
                               Disabled="@_isImporting" 
                               FullWidth="true"
                               StartIcon="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                               Class="bg-amber-600/20 hover:bg-amber-600/30 border-amber-600/30 text-amber-500 font-bold">
                        Import All Teams
                    </TwButton>
                </TwToolTip>
            </div>
        </div>
        
        @if (!string.IsNullOrEmpty(_importStatus))
        {
            <TwAlert Severity="@(_importStatus.Contains("Error") ? "error" : "info")" Class="mt-4">
                @_importStatus
            </TwAlert>
        }
        
        @if (_noDataAvailable)
        {
            <TwAlert Severity="warning" Class="mt-4">
                <span class="font-bold">No team data found for D@_selectedDivision.</span> 
                Click "Import All Teams" to fetch all divisions automatically.
            </TwAlert>
        }
    </TwCard>
        
        <!-- Team Stats Section (shows after team is selected) -->
        @if (_selectedTeam != null)
        {
            <TwCard Class="p-4 mb-8">
                <div class="flex flex-wrap items-center gap-4">
                    <div class="flex items-center gap-2">
                        <TwIcon Icon="M12 21a9 9 0 100-18 9 9 0 000 18z M12 3v18 M3 12h18 M16.5 16.5l-9-9 M16.5 7.5l-9 9" Class="w-5 h-5 text-blue-500" />
                        <h2 class="text-xl font-bold text-white">@_selectedTeam.TeamName</h2>
                    </div>
                    <TwChip Color="secondary" Variant="solid" Size="sm">@_selectedTeam.Conference</TwChip>
                    <div class="flex-grow"></div>
                    <div class="flex items-center gap-3">
                        <div class="w-24 text-left">
                            <TwSelect TValue="int" @bind-Value="_selectedYear" Label="Season" FullWidth="true">
                                @for (int y = DateTime.Now.Year; y >= 2015; y--)
                                {
                                    <option value="@y">@y</option>
                                }
                            </TwSelect>
                        </div>
                        <TwButton Variant="secondary" 
                                   OnClick="LoadTeamStats" 
                                   IsLoading="@_isLoadingStats" 
                                   Disabled="@_isLoadingStats"
                                   Class="bg-blue-600/20 hover:bg-blue-600/30 border-blue-600/30 text-blue-400 font-bold">
                            Load @_selectedYear Stats
                        </TwButton>
                    </div>
                </div>
            </TwCard>
        }
        
        <!-- Stats Tabs -->
        @if (_battingStats.Any() || _pitchingStats.Any())
        {
            <TwTabs>
                <TwTabPanel Title="Batting" TabIcon="M12 21a9 9 0 100-18 9 9 0 000 18z">
                    @if (_battingStats.Any())
                    {
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-lg font-bold text-white">
                                @_selectedTeam?.TeamName Batting Statistics (@_selectedYear)
                            </h3>
                        </div>
                        
                        <TwTable Items="@_battingStats" IsLoading="@_isLoadingStats" Class="bg-slate-900/50">
                            <HeaderContent>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Player</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Pos</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">GP</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">AB</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">R</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">H</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">2B</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">3B</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">HR</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">RBI</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">AVG</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">OBP</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">SLG</th>
                            </HeaderContent>
                            <RowTemplate>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-xs font-bold text-white uppercase">
                                            @(string.IsNullOrEmpty(context.Name) ? "?" : context.Name[0].ToString())
                                        </div>
                                        <a href="/college-baseball-player-profiles?player=@Uri.EscapeDataString(context.Name)" 
                                           class="text-blue-400 hover:text-blue-300 font-medium transition-colors">
                                            @context.Name
                                        </a>
                                    </div>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.Position</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.GP</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.AB</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.R</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.H</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.Doubles</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.Triples</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.HR</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.RBI</td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <TwChip Color="@GetAvgColor(context.AVG).ToString().ToLower()" Variant="solid" Size="sm">
                                        @context.AVG.ToString("F3")
                                    </TwChip>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.OBP.ToString("F3")</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.SLG.ToString("F3")</td>
                            </RowTemplate>
                        </TwTable>
                    }
                    else
                    {
                        <TwAlert Severity="info">Select a team and click "Load Stats" to view batting statistics.</TwAlert>
                    }
                </TwTabPanel>
                
                <TwTabPanel Title="Pitching" TabIcon="M13 10V3L4 14h7v7l9-11h-7z">
                    @if (_pitchingStats.Any())
                    {
                        <div class="flex items-center justify-between mb-4 mt-6">
                            <h3 class="text-lg font-bold text-white">
                                @_selectedTeam?.TeamName Pitching Statistics (@_selectedYear)
                            </h3>
                        </div>
                        
                        <TwTable Items="@_pitchingStats" IsLoading="@_isLoadingStats" Class="bg-slate-900/50">
                            <HeaderContent>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Player</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">W</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">L</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">ERA</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">GP</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">GS</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">IP</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">H</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">R</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">ER</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">BB</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">SO</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">SV</th>
                            </HeaderContent>
                            <RowTemplate>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-purple-600 flex items-center justify-center text-xs font-bold text-white uppercase">
                                            @(string.IsNullOrEmpty(context.Name) ? "?" : context.Name[0].ToString())
                                        </div>
                                        <a href="/college-baseball-player-profiles?player=@Uri.EscapeDataString(context.Name)" 
                                           class="text-purple-400 hover:text-purple-300 font-medium transition-colors">
                                            @context.Name
                                        </a>
                                    </div>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.W</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.L</td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <TwChip Color="@GetEraColor(context.ERA).ToString().ToLower()" Variant="solid" Size="sm">
                                        @context.ERA.ToString("F2")
                                    </TwChip>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.GP</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.GS</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.IP.ToString("F1")</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.H</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.R</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.ER</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.BB</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.SO</td>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.SV</td>
                            </RowTemplate>
                        </TwTable>
                    }
                    else
                    {
                        <TwAlert Severity="info">Select a team and click "Load Stats" to view pitching statistics.</TwAlert>
                    }
                </TwTabPanel>

                <TwTabPanel Title="Schedule" TabIcon="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                    @if (_schedule.Any())
                    {
                        <div class="flex items-center justify-between mb-4 mt-6">
                            <h3 class="text-lg font-bold text-white">
                                @_selectedTeam?.TeamName Schedule (@_selectedYear)
                            </h3>
                        </div>
                        
                        <TwTable Items="@_schedule" IsLoading="@_isLoadingStats" Class="bg-slate-900/50">
                            <HeaderContent>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Date</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Opponent</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Result</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider">Score</th>
                            </HeaderContent>
                            <RowTemplate>
                                <td class="px-4 py-3 whitespace-nowrap text-slate-300">@context.Date</td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <div class="flex items-center gap-2">
                                        <span class="text-slate-500 text-xs font-bold w-6">
                                            @(context.IsHome ? "VS" : "AT")
                                        </span>
                                        <span class="text-slate-200">@context.Opponent</span>
                                    </div>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    @if (!string.IsNullOrEmpty(context.Result))
                                    {
                                        <TwChip Color="@(context.Result == "W" ? "emerald" : context.Result == "L" ? "rose" : "slate")" 
                                                Variant="solid" Size="sm">
                                            @context.Result
                                        </TwChip>
                                    }
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap font-mono text-slate-300">@context.Score</td>
                            </RowTemplate>
                        </TwTable>
                    }
                    else
                    {
                        <TwAlert Severity="info">Select a team and click "Load Stats" to view schedule.</TwAlert>
                    }
                </TwTabPanel>
            </TwTabs>
        }
        else if (!_isLoading && !_isLoadingStats)
        {
            <TwCard Class="p-12">
                <div class="flex flex-col items-center text-center">
                    <div class="p-4 bg-slate-800 rounded-full mb-6">
                        <TwIcon Icon="M12 21a9 9 0 100-18 9 9 0 000 18z M12 3v18 M3 12h18 M16.5 16.5l-9-9 M16.5 7.5l-9 9" 
                                Class="w-12 h-12 text-blue-500" />
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2">Select a division and team to view stats</h3>
                    <p class="text-slate-400 max-w-md">
                        Click "Load Teams" to fetch the team list, then select a team and click "Load Stats" to see detailed analytics.
                    </p>
                </div>
            </TwCard>
        }
        
        <!-- Team List -->
        @if (_teams.Any() && _selectedTeam == null)
        {
            <TwCard Class="p-6">
                <h3 class="text-lg font-bold text-white mb-6">Division @_selectedDivision Teams (@_teams.Count)</h3>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
                    @foreach (var team in _teams.Take(50))
                    {
                        <button @onclick="@(() => SelectTeam(team))" 
                                class="px-4 py-2.5 rounded-lg border border-slate-700 bg-slate-800/50 text-slate-200 text-sm font-medium hover:bg-slate-700 hover:border-blue-500 hover:text-white transition-all text-left truncate">
                            @team.TeamName
                        </button>
                    }
                </div>
                @if (_teams.Count > 50)
                {
                    <div class="mt-6 flex items-center gap-2 text-slate-500 text-sm italic">
                        <TwIcon Icon="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-4 h-4" />
                        Showing first 50 of @_teams.Count teams. Use the search to find specific teams.
                    </div>
                }
            </TwCard>
        }
</TwContainer>

@code {
    // State
    private int _selectedDivision = 1;
    private int _selectedYear = DateTime.Now.Month >= 3 ? DateTime.Now.Year : DateTime.Now.Year - 1; // Baseball season is spring
    private TeamInfo? _selectedTeam;
    private bool _isLoading = false;
    private bool _isLoadingStats = false;
    private bool _isImporting = false;
    private bool _noDataAvailable = false;
    private string _importStatus = "";
    private string _searchString = "";
    private List<TeamInfo> _filteredTeams = new();
    
    // Data
    private List<TeamInfo> _teams = new();
    private List<BattingPlayer> _battingStats = new();
    private List<PitchingPlayer> _pitchingStats = new();
    private List<GameInfo> _schedule = new();
    
    protected override async Task OnInitializedAsync()
    {
        await LoadTeams();
    }

    private void UpdateSearch(string query)
    {
        _searchString = query;
        if (string.IsNullOrWhiteSpace(query))
        {
            _filteredTeams.Clear();
        }
        else
        {
            _filteredTeams = _teams
                .Where(t => t.TeamName.Contains(query, StringComparison.OrdinalIgnoreCase))
                .Take(10)
                .ToList();
        }
    }

    private async Task SelectTeamInternal(TeamInfo team)
    {
        _searchString = "";
        _filteredTeams.Clear();
        SelectTeam(team);
        await Task.CompletedTask;
    }
    
    private async Task LoadTeams()
    {
        _isLoading = true;
        _noDataAvailable = false;
        StateHasChanged();
        
        try
        {
            var response = await Http.GetFromJsonAsync<TeamsResponse>($"http://backend:8000/baseball/ncaa/teams?division={_selectedDivision}");
            
            if (response?.Teams != null && response.Teams.Any())
            {
                _teams = response.Teams;
                Snackbar.Add($"Loaded {_teams.Count} D{_selectedDivision} teams", Severity.Success);
            }
            else
            {
                _teams = new();
                _noDataAvailable = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading teams");
            _noDataAvailable = true;
            Snackbar.Add($"Error loading teams: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
    
    private async Task ImportAllTeams()
    {
        _isImporting = true;
        _importStatus = "Starting one-click import for all divisions (D1, D3, D2)...";
        StateHasChanged();
        
        try
        {
            // One-click import: division=0 (all), year=0 (smart detection)
            var response = await Http.PostAsync(
                "http://backend:8000/baseball/ncaa/import", 
                null);
            
            if (response.IsSuccessStatusCode)
            {
                _importStatus = "One-click import started! Importing D1, D3, D2 with automatic year detection. Check status below.";
                Snackbar.Add("Import started for all divisions", Severity.Success);
                
                // Start polling for status
                _ = PollImportStatus();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _importStatus = $"Error starting import: {error}";
            }
        }
        catch (Exception ex)
        {
            _importStatus = $"Error: {ex.Message}";
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isImporting = false;
            StateHasChanged();
        }
    }
    
    private async Task PollImportStatus()
    {
        for (int i = 0; i < 60; i++) // Poll for up to 5 minutes
        {
            await Task.Delay(5000);
            
            try
            {
                var response = await Http.GetFromJsonAsync<ImportStatusResponse>(
                    "http://backend:8000/baseball/ncaa/status");
                
                if (response != null)
                {
                    _importStatus = $"{response.Status}: {response.Message} ({response.Progress}%)";
                    StateHasChanged();
                    
                    if (response.Status == "idle" || response.Progress >= 100)
                    {
                        _noDataAvailable = false;
                        await LoadTeams();
                        break;
                    }
                }
            }
            catch { /* Ignore polling errors */ }
        }
    }
    
    private class ImportStatusResponse
    {
        public string Status { get; set; } = "";
        public string Message { get; set; } = "";
        public int Progress { get; set; }
    }
    
    private async Task LoadTeamStats()
    {
        if (_selectedTeam == null) return;
        
        _isLoadingStats = true;
        StateHasChanged();
        
        try
        {
            // Load batting
            try
            {
                var battingResponse = await Http.GetFromJsonAsync<StatsResponse>($"http://backend:8000/baseball/ncaa/stats/{_selectedTeam.TeamId}?stat_type=batting&year={_selectedYear}");
                if (battingResponse?.Stats != null)
                {
                    _battingStats = battingResponse.Stats.Select(s => new BattingPlayer
                    {
                        Name = GetString(s, "name", GetString(s, "player_name", "Unknown")),
                        Position = GetString(s, "pos", "-"),
                        GP = GetInt(s, "g", GetInt(s, "GP")),
                        AB = GetInt(s, "ab", GetInt(s, "AB")),
                        R = GetInt(s, "r", GetInt(s, "R")),
                        H = GetInt(s, "h", GetInt(s, "H")),
                        Doubles = GetInt(s, "2b", GetInt(s, "2B")),
                        Triples = GetInt(s, "3b", GetInt(s, "3B")),
                        HR = GetInt(s, "hr", GetInt(s, "HR")),
                        RBI = GetInt(s, "rbi", GetInt(s, "RBI")),
                        AVG = GetDouble(s, "avg", GetDouble(s, "BA")),
                        OBP = GetDouble(s, "obp", GetDouble(s, "OBPct")),
                        SLG = GetDouble(s, "slg", GetDouble(s, "SlgPct"))
                    }).ToList();
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning("Error loading batting: {Error}", ex.Message);
            }
            
            // Load pitching
            try
            {
                var pitchingResponse = await Http.GetFromJsonAsync<StatsResponse>($"http://backend:8000/baseball/ncaa/stats/{_selectedTeam.TeamId}?stat_type=pitching&year={_selectedYear}");
                if (pitchingResponse?.Stats != null)
                {
                    _pitchingStats = pitchingResponse.Stats.Select(s => new PitchingPlayer
                    {
                        Name = GetString(s, "name", GetString(s, "player_name", "Unknown")),
                        W = GetInt(s, "W"),
                        L = GetInt(s, "L"),
                        ERA = GetDouble(s, "ERA"),
                        GP = GetInt(s, "App", GetInt(s, "GP")),
                        GS = GetInt(s, "GS"),
                        IP = GetDouble(s, "IP"),
                        H = GetInt(s, "H"),
                        R = GetInt(s, "R"),
                        ER = GetInt(s, "ER"),
                        BB = GetInt(s, "BB"),
                        SO = GetInt(s, "SO"),
                        SV = GetInt(s, "SV")
                    }).ToList();
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning("Error loading pitching: {Error}", ex.Message);
            }

            // Load schedule
            try
            {
                var scheduleResponse = await Http.GetFromJsonAsync<ScheduleResponse>($"http://backend:8000/baseball/ncaa/schedule/{_selectedTeam.TeamId}?year={_selectedYear}");
                if (scheduleResponse?.Games != null)
                {
                    _schedule = scheduleResponse.Games.Select(g => new GameInfo
                    {
                        Date = GetString(g, "date", ""),
                        Opponent = GetString(g, "opponent", ""),
                        IsHome = GetString(g, "home_away", "").ToLower() == "home",
                        Result = GetString(g, "result", ""),
                        Score = GetString(g, "score", "")
                    }).ToList();
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning("Error loading schedule: {Error}", ex.Message);
            }
            
            Snackbar.Add($"Loaded stats for {_selectedTeam.TeamName}", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading team stats");
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingStats = false;
        }
    }
    
    private void SelectTeam(TeamInfo team)
    {
        _selectedTeam = team;
        StateHasChanged();
    }
    
    private async Task<IEnumerable<TeamInfo>> SearchTeams(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return _teams.Take(20);
        
        return _teams.Where(t => t.TeamName.Contains(value, StringComparison.OrdinalIgnoreCase)).Take(20);
    }
    
    // Helper methods
    private string GetString(Dictionary<string, object> dict, string key, string fallback = "")
    {
        // Try exact match
        if (dict.TryGetValue(key, out var val) && val != null)
            return val.ToString() ?? fallback;
            
        // Try case-insensitive match
        var keyMatch = dict.Keys.FirstOrDefault(k => k.Equals(key, StringComparison.OrdinalIgnoreCase));
        if (keyMatch != null && dict.TryGetValue(keyMatch, out var val2) && val2 != null)
             return val2.ToString() ?? fallback;

        return fallback;
    }
    
    private int GetInt(Dictionary<string, object> dict, string key, int fallback = 0)
    {
        object? val = null;
        if (dict.TryGetValue(key, out var v)) val = v;
        else 
        {
             var keyMatch = dict.Keys.FirstOrDefault(k => k.Equals(key, StringComparison.OrdinalIgnoreCase));
             if (keyMatch != null) dict.TryGetValue(keyMatch, out val);
        }

        if (val != null)
        {
            if (val is System.Text.Json.JsonElement je && je.ValueKind == System.Text.Json.JsonValueKind.Number && je.TryGetInt32(out var i)) return i;
            if (val is int iVal) return iVal;
            if (val is long lVal) return (int)lVal;
            if (int.TryParse(val.ToString(), out var parsed)) return parsed;
        }
        return fallback;
    }
    
    private double GetDouble(Dictionary<string, object> dict, string key, double fallback = 0)
    {
        object? val = null;
        if (dict.TryGetValue(key, out var v)) val = v;
        else 
        {
             var keyMatch = dict.Keys.FirstOrDefault(k => k.Equals(key, StringComparison.OrdinalIgnoreCase));
             if (keyMatch != null) dict.TryGetValue(keyMatch, out val);
        }

        if (val != null)
        {
            if (val is System.Text.Json.JsonElement je && je.ValueKind == System.Text.Json.JsonValueKind.Number && je.TryGetDouble(out var d)) return d;
            if (val is double dVal) return dVal;
            if (double.TryParse(val.ToString(), out var parsed)) return parsed;
        }
        return fallback;
    }
    
    private string GetAvgColor(double avg)
    {
        if (avg >= 0.300) return "emerald";
        if (avg >= 0.250) return "blue";
        if (avg >= 0.200) return "amber";
        return "red";
    }
    
    private string GetEraColor(double era)
    {
        if (era <= 2.50) return "emerald";
        if (era <= 3.50) return "blue";
        if (era <= 4.50) return "amber";
        return "red";
    }
    
