@page "/baseball-stats"
@page "/college-baseball"
@rendermode InteractiveServer
@using MudBlazor
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ILogger<BaseballStats> Logger

<PageTitle>College Baseball Stats</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudPaper Class="pa-4 mb-4" Elevation="1" Style="background: linear-gradient(135deg, #002d72 0%, #ce1141 100%);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.SportsBaseball" Size="Size.Large" Style="color: white;" Class="mr-3" />
                    <div>
                        <MudText Typo="Typo.h5" Style="color: white;">College Baseball Analytics</MudText>
                        <MudText Typo="Typo.subtitle2" Style="color: rgba(255,255,255,0.8);">NCAA Division I, II, III batting and pitching statistics</MudText>
                    </div>
                </MudStack>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.PersonSearch"
                               Href="/college-baseball-player-profiles">
                        Player Profiles
                    </MudButton>
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">D@_selectedDivision</MudChip>
                </MudStack>
            </MudStack>
        </MudPaper>
        
        <!-- Team Selection -->
        <MudPaper Class="pa-4" Elevation="2">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="2">
                    <MudSelect T="int" @bind-Value="_selectedDivision" Label="Division" 
                               Variant="Variant.Outlined" Dense="true">
                        <MudSelectItem Value="1">Division I</MudSelectItem>
                        <MudSelectItem Value="2">Division II</MudSelectItem>
                        <MudSelectItem Value="3">Division III</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="TeamInfo" @bind-Value="_selectedTeam" Label="Search Teams" 
                                     SearchFunc="@SearchTeams" ToStringFunc="@(t => t?.TeamName ?? "")"
                                     Variant="Variant.Outlined" Dense="true"
                                     AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary"
                                     Placeholder="Type to search teams..." />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadTeams"
                               Disabled="@_isLoading" FullWidth="true" Size="Size.Medium">
                        @if (_isLoading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                        @(_teams.Any() ? "Refresh Teams" : "Load Teams")
                    </MudButton>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="ImportDataFromR"
                               Disabled="@_isImporting" FullWidth="true" Size="Size.Medium">
                        @if (_isImporting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                        Import from NCAA
                    </MudButton>
                </MudItem>
            </MudGrid>
            
            @if (!string.IsNullOrEmpty(_importStatus))
            {
                <MudAlert Severity="@(_importStatus.Contains("Error") ? Severity.Error : Severity.Info)" 
                          Class="mt-3" Dense="true">@_importStatus</MudAlert>
            }
            
            @if (_noDataAvailable)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3">
                    <strong>No team data found for D@_selectedDivision.</strong> 
                    Click "Import from NCAA" to fetch teams. This requires R and baseballr to be installed.
                </MudAlert>
            }
        </MudPaper>
        
        <!-- Team Stats Section (shows after team is selected) -->
        @if (_selectedTeam != null)
        {
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.SportsBaseball" Color="Color.Info" />
                    <MudText Typo="Typo.h6">@_selectedTeam.TeamName</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@_selectedTeam.Conference</MudChip>
                    <MudSpacer />
                    <MudSelect T="int" @bind-Value="_selectedYear" Label="Season Year" 
                               Variant="Variant.Outlined" Dense="true" Style="width: 120px;">
                        @for (int y = DateTime.Now.Year; y >= 2015; y--)
                        {
                            <MudSelectItem Value="@y">@y</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="LoadTeamStats"
                               Disabled="@_isLoadingStats" Size="Size.Medium">
                        @if (_isLoadingStats) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                        Load @_selectedYear Stats
                    </MudButton>
                </MudStack>
            </MudPaper>
        }
        
        <!-- Stats Tabs -->
        @if (_battingStats.Any() || _pitchingStats.Any())
        {
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
                <!-- Batting Stats Tab -->
                <MudTabPanel Text="Batting" Icon="@Icons.Material.Filled.Sports">
                    @if (_battingStats.Any())
                    {
                        <MudText Typo="Typo.h6" Class="mb-3">
                            @_selectedTeam?.TeamName Batting Statistics (@_selectedYear)
                        </MudText>
                        <MudTable Items="@_battingStats" Dense="true" Hover="true" Striped="true" 
                                  FixedHeader="true" Height="500px">
                            <HeaderContent>
                                <MudTh><MudTableSortLabel SortBy="new Func<BattingPlayer, object>(x => x.Name)">Player</MudTableSortLabel></MudTh>
                                <MudTh>Pos</MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<BattingPlayer, object>(x => x.GP)">GP</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<BattingPlayer, object>(x => x.AB)">AB</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<BattingPlayer, object>(x => x.R)">R</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<BattingPlayer, object>(x => x.H)">H</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<BattingPlayer, object>(x => x.Doubles)">2B</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<BattingPlayer, object>(x => x.Triples)">3B</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<BattingPlayer, object>(x => x.HR)">HR</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<BattingPlayer, object>(x => x.RBI)">RBI</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<BattingPlayer, object>(x => x.AVG)">AVG</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<BattingPlayer, object>(x => x.OBP)">OBP</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<BattingPlayer, object>(x => x.SLG)">SLG</MudTableSortLabel></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Player">
                                    <div class="d-flex align-center">
                                        <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-2">@(string.IsNullOrEmpty(context.Name) ? "?" : context.Name[0].ToString())</MudAvatar>
                                        <MudLink Href="@($"/college-baseball-player-profiles?player={Uri.EscapeDataString(context.Name)}")" 
                                                 Underline="Underline.Hover" Color="Color.Primary">
                                            @context.Name
                                        </MudLink>
                                    </div>
                                </MudTd>
                                <MudTd DataLabel="Pos">@context.Position</MudTd>
                                <MudTd DataLabel="GP">@context.GP</MudTd>
                                <MudTd DataLabel="AB">@context.AB</MudTd>
                                <MudTd DataLabel="R">@context.R</MudTd>
                                <MudTd DataLabel="H">@context.H</MudTd>
                                <MudTd DataLabel="2B">@context.Doubles</MudTd>
                                <MudTd DataLabel="3B">@context.Triples</MudTd>
                                <MudTd DataLabel="HR">@context.HR</MudTd>
                                <MudTd DataLabel="RBI">@context.RBI</MudTd>
                                <MudTd DataLabel="AVG">
                                    <MudChip T="string" Size="Size.Small" Color="@GetAvgColor(context.AVG)">@context.AVG.ToString("F3")</MudChip>
                                </MudTd>
                                <MudTd DataLabel="OBP">@context.OBP.ToString("F3")</MudTd>
                                <MudTd DataLabel="SLG">@context.SLG.ToString("F3")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">Select a team and click "Load Stats" to view batting statistics.</MudAlert>
                    }
                </MudTabPanel>
                
                <!-- Pitching Stats Tab -->
                <MudTabPanel Text="Pitching" Icon="@Icons.Material.Filled.Speed">
                    @if (_pitchingStats.Any())
                    {
                        <MudText Typo="Typo.h6" Class="mb-3">
                            @_selectedTeam?.TeamName Pitching Statistics (@_selectedYear)
                        </MudText>
                        <MudTable Items="@_pitchingStats" Dense="true" Hover="true" Striped="true"
                                  FixedHeader="true" Height="500px">
                            <HeaderContent>
                                <MudTh><MudTableSortLabel SortBy="new Func<PitchingPlayer, object>(x => x.Name)">Player</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<PitchingPlayer, object>(x => x.W)">W</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<PitchingPlayer, object>(x => x.L)">L</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="new Func<PitchingPlayer, object>(x => x.ERA)">ERA</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<PitchingPlayer, object>(x => x.GP)">GP</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<PitchingPlayer, object>(x => x.GS)">GS</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<PitchingPlayer, object>(x => x.IP)">IP</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<PitchingPlayer, object>(x => x.H)">H</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<PitchingPlayer, object>(x => x.R)">R</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<PitchingPlayer, object>(x => x.ER)">ER</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<PitchingPlayer, object>(x => x.BB)">BB</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<PitchingPlayer, object>(x => x.SO)">SO</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<PitchingPlayer, object>(x => x.SV)">SV</MudTableSortLabel></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Player">
                                    <div class="d-flex align-center">
                                        <MudAvatar Color="Color.Secondary" Size="Size.Small" Class="mr-2">@(string.IsNullOrEmpty(context.Name) ? "?" : context.Name[0].ToString())</MudAvatar>
                                        <MudLink Href="@($"/college-baseball-player-profiles?player={Uri.EscapeDataString(context.Name)}")" 
                                                 Underline="Underline.Hover" Color="Color.Secondary">
                                            @context.Name
                                        </MudLink>
                                    </div>
                                </MudTd>
                                <MudTd DataLabel="W">@context.W</MudTd>
                                <MudTd DataLabel="L">@context.L</MudTd>
                                <MudTd DataLabel="ERA">
                                    <MudChip T="string" Size="Size.Small" Color="@GetEraColor(context.ERA)">@context.ERA.ToString("F2")</MudChip>
                                </MudTd>
                                <MudTd DataLabel="GP">@context.GP</MudTd>
                                <MudTd DataLabel="GS">@context.GS</MudTd>
                                <MudTd DataLabel="IP">@context.IP.ToString("F1")</MudTd>
                                <MudTd DataLabel="H">@context.H</MudTd>
                                <MudTd DataLabel="R">@context.R</MudTd>
                                <MudTd DataLabel="ER">@context.ER</MudTd>
                                <MudTd DataLabel="BB">@context.BB</MudTd>
                                <MudTd DataLabel="SO">@context.SO</MudTd>
                                <MudTd DataLabel="SV">@context.SV</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">Select a team and click "Load Stats" to view pitching statistics.</MudAlert>
                    }
                </MudTabPanel>
                
                <!-- Schedule Tab -->
                <MudTabPanel Text="Schedule" Icon="@Icons.Material.Filled.CalendarMonth">
                    @if (_schedule.Any())
                    {
                        <MudText Typo="Typo.h6" Class="mb-3">
                            @_selectedTeam?.TeamName Schedule (@_selectedYear)
                        </MudText>
                        <MudTable Items="@_schedule" Dense="true" Hover="true" Striped="true"
                                  FixedHeader="true" Height="500px">
                            <HeaderContent>
                                <MudTh>Date</MudTh>
                                <MudTh>Opponent</MudTh>
                                <MudTh>Result</MudTh>
                                <MudTh>Score</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Date">@context.Date</MudTd>
                                <MudTd DataLabel="Opponent">
                                    @if (context.IsHome)
                                    {
                                        <span>vs @context.Opponent</span>
                                    }
                                    else
                                    {
                                        <span>@@ @context.Opponent</span>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Result">
                                    @if (!string.IsNullOrEmpty(context.Result))
                                    {
                                        <MudChip T="string" Size="Size.Small" 
                                                 Color="@(context.Result == "W" ? Color.Success : context.Result == "L" ? Color.Error : Color.Default)">
                                            @context.Result
                                        </MudChip>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Score">@context.Score</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">Select a team and click "Load Stats" to view schedule.</MudAlert>
                    }
                </MudTabPanel>
            </MudTabs>
        }
        else if (!_isLoading && !_isLoadingStats)
        {
            <MudPaper Class="pa-6" Elevation="2">
                <div class="d-flex flex-column align-center">
                    <MudIcon Icon="@Icons.Material.Filled.SportsBaseball" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary">Select a division and team to view stats</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                        Click "Load Teams" to fetch the team list, then select a team and click "Load Stats"
                    </MudText>
                </div>
            </MudPaper>
        }
        
        <!-- Team List -->
        @if (_teams.Any() && _selectedTeam == null)
        {
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">Division @_selectedDivision Teams (@_teams.Count)</MudText>
                <MudGrid Spacing="2">
                    @foreach (var team in _teams.Take(50))
                    {
                        <MudItem xs="6" sm="4" md="3" lg="2">
                            <MudButton Variant="Variant.Outlined" Color="Color.Info" FullWidth="true"
                                       OnClick="@(() => SelectTeam(team))">
                                @team.TeamName
                            </MudButton>
                        </MudItem>
                    }
                </MudGrid>
                @if (_teams.Count > 50)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                        Showing first 50 of @_teams.Count teams. Use the search to find specific teams.
                    </MudText>
                }
            </MudPaper>
        }
    </MudStack>
</MudContainer>

@code {
    // State
    private int _selectedDivision = 1;
    private int _selectedYear = DateTime.Now.Month >= 3 ? DateTime.Now.Year : DateTime.Now.Year - 1; // Baseball season is spring
    private TeamInfo? _selectedTeam;
    private bool _isLoading = false;
    private bool _isLoadingStats = false;
    private bool _isImporting = false;
    private bool _noDataAvailable = false;
    private string _importStatus = "";
    
    // Data
    private List<TeamInfo> _teams = new();
    private List<BattingPlayer> _battingStats = new();
    private List<PitchingPlayer> _pitchingStats = new();
    private List<GameInfo> _schedule = new();
    
    protected override async Task OnInitializedAsync()
    {
        await LoadTeams();
    }
    
    private async Task LoadTeams()
    {
        _isLoading = true;
        _noDataAvailable = false;
        StateHasChanged();
        
        try
        {
            var response = await Http.GetFromJsonAsync<TeamsResponse>($"http://backend:8000/baseball/ncaa/teams?division={_selectedDivision}");
            
            if (response?.Teams != null && response.Teams.Any())
            {
                _teams = response.Teams;
                Snackbar.Add($"Loaded {_teams.Count} D{_selectedDivision} teams", Severity.Success);
            }
            else
            {
                _teams = new();
                _noDataAvailable = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading teams");
            _noDataAvailable = true;
            Snackbar.Add($"Error loading teams: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
    
    private async Task ImportDataFromR()
    {
        _isImporting = true;
        _importStatus = $"Starting import for D{_selectedDivision}...";
        StateHasChanged();
        
        try
        {
            var response = await Http.PostAsync(
                $"http://backend:8000/baseball/ncaa/import?division={_selectedDivision}", 
                null);
            
            if (response.IsSuccessStatusCode)
            {
                _importStatus = "Import started! This runs in the background. Check status below, then click 'Load Teams' when ready.";
                Snackbar.Add("Import started in background", Severity.Success);
                
                // Start polling for status
                _ = PollImportStatus();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _importStatus = $"Error starting import: {error}";
            }
        }
        catch (Exception ex)
        {
            _importStatus = $"Error: {ex.Message}";
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isImporting = false;
            StateHasChanged();
        }
    }
    
    private async Task PollImportStatus()
    {
        for (int i = 0; i < 60; i++) // Poll for up to 5 minutes
        {
            await Task.Delay(5000);
            
            try
            {
                var response = await Http.GetFromJsonAsync<ImportStatusResponse>(
                    "http://backend:8000/baseball/ncaa/status");
                
                if (response != null)
                {
                    _importStatus = $"{response.Status}: {response.Message} ({response.Progress}%)";
                    StateHasChanged();
                    
                    if (response.Status == "idle" || response.Progress >= 100)
                    {
                        _noDataAvailable = false;
                        await LoadTeams();
                        break;
                    }
                }
            }
            catch { /* Ignore polling errors */ }
        }
    }
    
    private class ImportStatusResponse
    {
        public string Status { get; set; } = "";
        public string Message { get; set; } = "";
        public int Progress { get; set; }
    }
    
    private async Task LoadTeamStats()
    {
        if (_selectedTeam == null) return;
        
        _isLoadingStats = true;
        StateHasChanged();
        
        try
        {
            // Load batting
            try
            {
                var battingResponse = await Http.GetFromJsonAsync<StatsResponse>($"http://backend:8000/baseball/ncaa/stats/{_selectedTeam.TeamId}?stat_type=batting&year={_selectedYear}");
                if (battingResponse?.Stats != null)
                {
                    _battingStats = battingResponse.Stats.Select(s => new BattingPlayer
                    {
                        Name = GetString(s, "player_name", s.GetValueOrDefault("Name")?.ToString() ?? "Unknown"),
                        Position = GetString(s, "Pos", ""),
                        GP = GetInt(s, "GP"),
                        AB = GetInt(s, "AB"),
                        R = GetInt(s, "R"),
                        H = GetInt(s, "H"),
                        Doubles = GetInt(s, "2B"),
                        Triples = GetInt(s, "3B"),
                        HR = GetInt(s, "HR"),
                        RBI = GetInt(s, "RBI"),
                        AVG = GetDouble(s, "BA", GetDouble(s, "AVG")),
                        OBP = GetDouble(s, "OBPct", GetDouble(s, "OBP")),
                        SLG = GetDouble(s, "SlgPct", GetDouble(s, "SLG"))
                    }).ToList();
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning("Error loading batting: {Error}", ex.Message);
            }
            
            // Load pitching
            try
            {
                var pitchingResponse = await Http.GetFromJsonAsync<StatsResponse>($"http://backend:8000/baseball/ncaa/stats/{_selectedTeam.TeamId}?stat_type=pitching&year={_selectedYear}");
                if (pitchingResponse?.Stats != null)
                {
                    _pitchingStats = pitchingResponse.Stats.Select(s => new PitchingPlayer
                    {
                        Name = GetString(s, "player_name", s.GetValueOrDefault("Name")?.ToString() ?? "Unknown"),
                        W = GetInt(s, "W"),
                        L = GetInt(s, "L"),
                        ERA = GetDouble(s, "ERA"),
                        GP = GetInt(s, "App", GetInt(s, "GP")),
                        GS = GetInt(s, "GS"),
                        IP = GetDouble(s, "IP"),
                        H = GetInt(s, "H"),
                        R = GetInt(s, "R"),
                        ER = GetInt(s, "ER"),
                        BB = GetInt(s, "BB"),
                        SO = GetInt(s, "SO"),
                        SV = GetInt(s, "SV")
                    }).ToList();
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning("Error loading pitching: {Error}", ex.Message);
            }
            
            // Load schedule
            try
            {
                var scheduleResponse = await Http.GetFromJsonAsync<ScheduleResponse>($"http://backend:8000/baseball/ncaa/schedule/{_selectedTeam.TeamId}?year={_selectedYear}");
                if (scheduleResponse?.Games != null)
                {
                    _schedule = scheduleResponse.Games.Select(g => new GameInfo
                    {
                        Date = GetString(g, "date", ""),
                        Opponent = GetString(g, "opponent", ""),
                        IsHome = GetString(g, "home_away", "").ToLower() == "home",
                        Result = GetString(g, "result", ""),
                        Score = GetString(g, "score", "")
                    }).ToList();
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning("Error loading schedule: {Error}", ex.Message);
            }
            
            Snackbar.Add($"Loaded stats for {_selectedTeam.TeamName}", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading team stats");
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingStats = false;
        }
    }
    
    private void SelectTeam(TeamInfo team)
    {
        _selectedTeam = team;
        StateHasChanged();
    }
    
    private async Task<IEnumerable<TeamInfo>> SearchTeams(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return _teams.Take(20);
        
        return _teams.Where(t => t.TeamName.Contains(value, StringComparison.OrdinalIgnoreCase)).Take(20);
    }
    
    // Helper methods
    private string GetString(Dictionary<string, object> dict, string key, string fallback = "")
    {
        if (dict.TryGetValue(key, out var val) && val != null)
            return val.ToString() ?? fallback;
        return fallback;
    }
    
    private int GetInt(Dictionary<string, object> dict, string key, int fallback = 0)
    {
        if (dict.TryGetValue(key, out var val) && val != null)
        {
            if (val is JsonElement je && je.TryGetInt32(out var i)) return i;
            if (int.TryParse(val.ToString(), out var parsed)) return parsed;
        }
        return fallback;
    }
    
    private double GetDouble(Dictionary<string, object> dict, string key, double fallback = 0)
    {
        if (dict.TryGetValue(key, out var val) && val != null)
        {
            if (val is JsonElement je && je.TryGetDouble(out var d)) return d;
            if (double.TryParse(val.ToString(), out var parsed)) return parsed;
        }
        return fallback;
    }
    
    private Color GetAvgColor(double avg)
    {
        if (avg >= 0.300) return Color.Success;
        if (avg >= 0.250) return Color.Info;
        if (avg >= 0.200) return Color.Warning;
        return Color.Error;
    }
    
    private Color GetEraColor(double era)
    {
        if (era <= 2.50) return Color.Success;
        if (era <= 3.50) return Color.Info;
        if (era <= 4.50) return Color.Warning;
        return Color.Error;
    }
    
