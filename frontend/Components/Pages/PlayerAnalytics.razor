@page "/players"
@page "/players/{Sport}"
@rendermode InteractiveServer
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@using SportsBettingAnalyzer.Components.Shared.PlayerAnalytics
@using SportsBettingAnalyzer.Components.Pages
@inject NavigationManager Navigation

<PageTitle>Player Analytics - @_selectedSport.ToUpper()</PageTitle>

<div class="min-h-screen bg-slate-950 text-slate-100 p-4 md:p-8 font-sans">
    <TwContainer MaxWidth="7xl">
        
        <!-- Header -->
        <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
            <div class="flex items-center gap-3">
                <div class="bg-gradient-to-br from-indigo-500 to-purple-600 p-3 rounded-xl shadow-lg shadow-indigo-900/20">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-3xl font-bold tracking-tight">Player Analytics</h1>
                    <p class="text-slate-400 text-sm">Comprehensive player statistics, profiles, and performance trends</p>
                </div>
            </div>

            <!-- Sport Selector -->
            <div class="flex bg-slate-900/50 p-1 rounded-lg border border-slate-800">
                <button class="@GetSportButtonClass("nfl")" @onclick="@(() => SelectSport("nfl"))">
                    NFL
                </button>
                <button class="@GetSportButtonClass("nba")" @onclick="@(() => SelectSport("nba"))">
                    NBA
                </button>
            </div>
        </header>

        <!-- Main Content -->
        <TwTabs Items="@_tabs" @bind-ActiveTab="_activeTab" />

        <div class="mt-6">
            @if (_activeTab == 0) // Stats Explorer
            {
                <PlayerStatsExplorer Sport="@_selectedSport" OnPlayerSelected="HandlePlayerSelected" />
            }
            else if (_activeTab == 1) // Profiles
            {
                <PlayerProfileViewer Sport="@_selectedSport" InitialPlayer="@_selectedPlayer" />
            }
            else if (_activeTab == 2) // Hit Rates
            {
                <PlayerHitRates Sport="@_selectedSport" OnPlayerSelected="HandlePlayerSelected" />
            }
            else if (_activeTab == 3) // Trends
            {
                <!-- Reusing the existing page as a component. 
                     We verified it has [Parameter] public string Sport. -->
                <PlayerTrends Sport="@_selectedSport" />
            }
        </div>

    </TwContainer>
</div>

@code {
    [Parameter] public string? Sport { get; set; }

    private string _selectedSport = "nfl";
    private int _activeTab = 0;
    private string? _selectedPlayer;
    
    private readonly string[] _tabs = new[] { "Stats Explorer", "Profiles", "Hit Rates", "Trends" };

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Sport) && (Sport.ToLower() == "nba" || Sport.ToLower() == "nfl"))
        {
            _selectedSport = Sport.ToLower();
        }
    }

    protected override void OnParametersSet()
    {
         if (!string.IsNullOrEmpty(Sport) && (Sport.ToLower() == "nba" || Sport.ToLower() == "nfl"))
        {
            _selectedSport = Sport.ToLower();
            StateHasChanged();
        }
    }

    private void SelectSport(string sport)
    {
        _selectedSport = sport;
        // Update URL without reload
        Navigation.NavigateTo($"/players/{sport}", false);
    }

    private string GetSportButtonClass(string sport)
    {
        var baseClass = "px-4 py-1.5 rounded-md text-sm font-medium transition-colors";
        if (_selectedSport == sport)
        {
            return baseClass + $" bg-{GetSportColor(sport)}-600 text-white shadow-lg";
        }
        return baseClass + " text-slate-400 hover:text-white hover:bg-slate-800";
    }

    private string GetSportColor(string sport) => sport == "nfl" ? "blue" : "orange";

    private void HandlePlayerSelected(string playerName)
    {
        _selectedPlayer = playerName;
        _activeTab = 1; // Switch to Profiles tab
        StateHasChanged();
    }
}
