@page "/"
@using MudBlazor
@using SportsBettingAnalyzer.Models
@using SportsBettingAnalyzer.Services
@inject BetAnalysisService BetAnalysisService
@inject DataCollectionService DataCollectionService
@inject PythonMLServiceClient MLServiceClient
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Dashboard - Sports Betting Analyzer</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    @* Welcome & Header *@
    <MudGrid Class="mb-6">
        <MudItem xs="12" md="8">
            <MudText Typo="Typo.h3" GutterBottom="true">👋 Welcome Back</MudText>
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                Your AI-powered command center for smart sports betting.
            </MudText>
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-end justify-md-end">
            <MudChip T="string" Icon="@Icons.Material.Filled.CheckCircle" Color="@(_isBackendHealthy ? Color.Success : Color.Error)">
                System: @(_isBackendHealthy ? "Online" : "Connecting...")
            </MudChip>
            <ApiQuotaTracker />
        </MudItem>
    </MudGrid>

    @* Summary Stats Cards *@
    <MudGrid Class="mb-8">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="4" Class="pa-4 mud-theme-primary dashboard-card">
                <MudText Typo="Typo.subtitle2">Total Profit</MudText>
                <MudText Typo="Typo.h4">@_netProfit.ToString("C2")</MudText>
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Inherit" Class="card-icon" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="4" Class="pa-4 mud-theme-success dashboard-card">
                <MudText Typo="Typo.subtitle2">Win Rate</MudText>
                <MudText Typo="Typo.h4">@_winRate.ToString("P1")</MudText>
                <MudText Typo="Typo.caption">Across @_totalBetsWithResults bets</MudText>
                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Inherit" Class="card-icon" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="4" Class="pa-4 mud-theme-info dashboard-card">
                <MudText Typo="Typo.subtitle2">Active Picks</MudText>
                <MudText Typo="Typo.h4">@_activePicksCount</MudText>
                <MudText Typo="Typo.caption">NBA & NFL Models</MudText>
                <MudIcon Icon="@Icons.Material.Filled.SportsBasketball" Color="Color.Inherit" Class="card-icon" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="4" Class="pa-4 mud-theme-dark dashboard-card">
                <MudText Typo="Typo.subtitle2">Confidence Avg</MudText>
                <MudText Typo="Typo.h4">@_avgConfidence.ToString("F1")%</MudText>
                <MudIcon Icon="@Icons.Material.Filled.Psychology" Color="Color.Inherit" Class="card-icon" />
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        @* Left Column: Top Picks & Dashboard Info *@
        <MudItem xs="12" md="8">
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Surface">
                <MudTabPanel Text="Today's Top Value" Icon="@Icons.Material.Filled.BrightnessHigh">
                    @if (_isPicksLoading)
                    {
                        <div class="d-flex flex-column align-center justify-center pa-12">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-4" />
                            <MudText>Scanning markets for EV+ opportunities...</MudText>
                        </div>
                    }
                    else if (_topPicks.Any())
                    {
                        <MudGrid>
                            @foreach (var pick in _topPicks)
                            {
                                <MudItem xs="12" sm="6">
                                    <MudCard Elevation="2" Class="h-100">
                                        <MudCardHeader>
                                            <CardHeaderContent>
                                                <MudText Typo="Typo.caption">@pick.Sport - @pick.GameTime</MudText>
                                                <MudText Typo="Typo.h6">@pick.AwayTeam @@ @pick.HomeTeam</MudText>
                                            </CardHeaderContent>
                                            <CardHeaderActions>
                                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">@pick.ValueScore.ToString("F1") Value</MudChip>
                                            </CardHeaderActions>
                                        </MudCardHeader>
                                        <MudCardContent>
                                            <MudText Typo="Typo.body1">Recommendation: <strong>@pick.Winner</strong></MudText>
                                            <MudText Typo="Typo.body2">Win Prob: @pick.Probability.ToString("P1") | Edge: @pick.Edge.ToString("P1")</MudText>
                                        </MudCardContent>
                                        <MudCardActions>
                                            <MudButton Variant="Variant.Text" Color="Color.Primary" href="@(pick.Sport == "NBA" ? "/live-nba-odds" : "/live-nfl-odds")">View Details</MudButton>
                                        </MudCardActions>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">No high-value bets found yet. Check back closer to game time!</MudAlert>
                    }
                </MudTabPanel>
                
                <MudTabPanel Text="Recent Activity" Icon="@Icons.Material.Filled.Timeline">
                    <MudTable Items="@_recentBets" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                        <HeaderContent>
                            <MudTh>Date</MudTh>
                            <MudTh>Game/Player</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Wager</MudTh>
                            <MudTh>Result</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Date">@context.AnalyzedAt.ToString("MM/dd")</MudTd>
                            <MudTd DataLabel="Game">@(string.IsNullOrEmpty(context.PlayerName) ? $"{context.Team2} @@ {context.Team1}" : context.PlayerName)</MudTd>
                            <MudTd DataLabel="Type">@context.BetType</MudTd>
                            <MudTd DataLabel="Wager">$@context.WagerAmount.ToString("F0")</MudTd>
                            <MudTd DataLabel="Result">
                                @if (context.Won == true) { <MudChip T="string" Color="Color.Success" Size="Size.Small">WON</MudChip> }
                                else if (context.Won == false) { <MudChip T="string" Color="Color.Error" Size="Size.Small">LOST</MudChip> }
                                else { <MudChip T="string" Color="Color.Default" Size="Size.Small">PENDING</MudChip> }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudTabPanel>
            </MudTabs>

            <MudPaper Elevation="2" Class="pa-6 mt-6">
                <MudText Typo="Typo.h6" GutterBottom="true">📡 Data Source Status</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="4">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Color="Color.Warning" Class="mr-2" />
                            <div>
                                <MudText Typo="Typo.body2">NASCAR Cup</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Success">Active • Updated 5m ago</MudText>
                            </div>
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.SportsBasketball" Color="Color.Primary" Class="mr-2" />
                            <div>
                                <MudText Typo="Typo.body2">NBA Live Odds</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Success">Active • Updated 1m ago</MudText>
                            </div>
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.SportsFootball" Color="Color.Info" Class="mr-2" />
                            <div>
                                <MudText Typo="Typo.body2">NFL Nex Gen</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Success">Synced • 2025 Regular</MudText>
                            </div>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Elevation="2" Class="pa-6 mt-6">
                <MudText Typo="Typo.h6" GutterBottom="true" Class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Color="Color.Warning" Class="mr-2" /> AI Advisor Insights
                </MudText>
                @if (_latestInsight != null)
                {
                    <MudCard Elevation="0" Outlined="true" Class="mt-2 pa-4">
                        <MudText Typo="Typo.subtitle1"><strong>@_latestInsight.Matchup</strong></MudText>
                        <MudText Typo="Typo.body2" Class="mt-1 italic">"@(_latestInsight.LlmInsight?.Rationale)"</MudText>
                        <div class="d-flex align-center mt-2">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                Confidence: @(_latestInsight.LlmInsight?.Confidence)%
                            </MudChip>
                            <MudText Typo="Typo.caption" Class="ml-2">Key: @(_latestInsight.LlmInsight?.KeyFactor)</MudText>
                        </div>
                    </MudCard>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Get a deep AI analysis for today's top-rated value pick.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="@AnalyzeHomeTopPick" 
                               Disabled="@(_isPicksLoading || _isAiProcessing || !_topPicks.Any())">
                        @if (_isAiProcessing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Consulting Gemini...</span>
                        }
                        else
                        {
                            <span>Analyze Today's Top Pick</span>
                        }
                    </MudButton>
                }
            </MudPaper>

            <MudPaper Elevation="2" Class="pa-6 mt-6">
                <MudText Typo="Typo.h6" GutterBottom="true" Class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.AutoGraph" Color="Color.Secondary" Class="mr-2" /> Model Intelligence
                </MudText>
                @if (_isModelsLoading)
                {
                    <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="my-4" />
                }
                else if (_modelSummary.Any())
                {
                    <MudTable Items="@_modelSummary" Dense="true" Hover="true" Elevation="0" Class="mt-2">
                        <HeaderContent>
                            <MudTh>Sport/Model</MudTh>
                            <MudTh>Task</MudTh>
                            <MudTh>Acc %</MudTh>
                            <MudTh>Status</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudText Typo="Typo.body2"><strong>@context.Sport.ToUpper()</strong> - @context.Series</MudText>
                            </MudTd>
                            <MudTd>@context.Task</MudTd>
                            <MudTd>
                                <MudText Color="@(context.Accuracy > 0.6 ? Color.Success : Color.Info)">
                                    @((context.Accuracy * 100).ToString("F1"))%
                                </MudText>
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="@(context.Accuracy > 0.55 ? Color.Success : Color.Default)" Variant="Variant.Text">OPTIMIZED</MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No trained models found yet.</MudText>
                }
            </MudPaper>
        </MudItem>

        @* Right Column: Bet Slip Analyzer *@
        <MudItem xs="12" md="4">
            <MudPaper Elevation="4" Class="pa-6 border-t-4 border-t-primary">
                <MudText Typo="Typo.h5" GutterBottom="true" Class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Scanner" Class="mr-2" /> Bet Slip Analyzer
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-4">
                    Upload your slip to get a mathematical breakdown before you lock it in.
                </MudText>

                <InputFile OnChange="OnFileSelected" accept="image/*" class="d-none" id="fileInput" />
                <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary" 
                           FullWidth="true" StartIcon="@Icons.Material.Filled.CloudUpload" 
                           for="fileInput" Class="mb-4 py-3">
                    Analyze My Slip
                </MudButton>

                @if (_selectedFile != null)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" OnClose="OnFileRemoved">
                        @_selectedFile.Name
                    </MudAlert>
                }

                @if (_isProcessing)
                {
                    <MudStack AlignItems="AlignItems.Center">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        <MudText Typo="Typo.body2">Extracting data via OCR...</MudText>
                    </MudStack>
                }

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@_errorMessage</MudAlert>
                }

                @if (_currentAnalysis != null)
                {
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">LAST ANALYSIS</MudText>
                    <MudText Typo="Typo.h6">@_currentAnalysis.BetSlip.BetType @@ @(_currentAnalysis.BetSlip.Odds > 0 ? "+" : "")@_currentAnalysis.BetSlip.Odds</MudText>
                    <MudText Typo="Typo.body2" Color="@(_currentAnalysis.ExpectedValue >= 0 ? Color.Success : Color.Error)">
                        EV: $@_currentAnalysis.ExpectedValue.ToString("F2")
                    </MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" 
                               Class="mt-2" OnClick="@(() => _showAnalysisModal = true)">
                        View Full Report
                    </MudButton>
                }
            </MudPaper>

            <MudPaper Elevation="4" Class="pa-6 mt-6 mud-theme-dark overflow-hidden relative">
                <MudText Typo="Typo.h6">New to the App?</MudText>
                <MudText Typo="Typo.body2" Class="mb-4">Check out our guide on how to bet like a pro.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" href="/betting-101" FullWidth="true">
                    Betting 101 Guide
                </MudButton>
                <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Large" 
                         Class="absolute bottom-n4 right-n4 opacity-20" Style="font-size: 100px;" />
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@* Analysis Modal *@
<MudDialog @bind-IsVisible="_showAnalysisModal" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h5">Bet Analysis Detail</MudText>
    </TitleContent>
    <DialogContent>
        @if (_currentAnalysis != null)
        {
            @* (Re-using some logic from the old Home.razor here for the modal content) *@
            <MudAlert Severity="@(_currentAnalysis.Recommendation == "GoodBet" ? Severity.Success : _currentAnalysis.Recommendation == "BadBet" ? Severity.Error : Severity.Warning)" Class="mb-4">
                 Recommendation: @_currentAnalysis.Recommendation (@_currentAnalysis.ConfidenceScore.ToString("F0")% Confidence)
            </MudAlert>
            <MudGrid>
                <MudItem xs="6"><MudText Typo="Typo.body2"><strong>Implied Prob:</strong> @_currentAnalysis.ImpliedProbability.ToString("P1")</MudText></MudItem>
                <MudItem xs="6"><MudText Typo="Typo.body2"><strong>Value Score:</strong> @_currentAnalysis.ValueScore.ToString("F2")</MudText></MudItem>
            </MudGrid>
            <MudText Typo="Typo.body2" Class="mt-4" Style="white-space: pre-line">@_currentAnalysis.AnalysisDetails</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAnalysis">Save to History</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@(() => _showAnalysisModal = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .dashboard-card { position: relative; overflow: hidden; min-height: 120px; display: flex; flex-direction: column; justify-content: center; }
    .card-icon { position: absolute; right: -10px; bottom: -10px; font-size: 80px; opacity: 0.2; transform: rotate(-15deg); }
    .border-t-4 { border-top: 4px solid !important; }
    .border-t-primary { border-top-color: var(--mud-palette-primary) !important; }
    .relative { position: relative; }
    .absolute { position: absolute; }
    .bottom-n4 { bottom: -1rem; }
    .right-n4 { right: -1rem; }
    .opacity-20 { opacity: 0.2; }
</style>

@code {
    private bool _isBackendHealthy = false;
    private decimal _netProfit = 0;
    private double _winRate = 0;
    private int _totalBetsWithResults = 0;
    private int _activePicksCount = 0;
    private double _avgConfidence = 0;

    private List<HistoricalBet> _recentBets = new();
    private List<TopPick> _topPicks = new();
    private bool _isPicksLoading = true;
    private bool _showAnalysisModal = false;

    // Analyzer state
    private BetAnalysis? _currentAnalysis;
    private bool _isProcessing = false;
    private string _errorMessage = string.Empty;
    private IBrowserFile? _selectedFile;
    private List<DashboardModelSummary> _modelSummary = new();
    private bool _isModelsLoading = true;
    private AiAnalysisReport? _latestInsight;
    private bool _isAiProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAnalytics();
        await LoadTopPicks();
        await LoadModelSummary();
        _isBackendHealthy = await MLServiceClient.IsHealthyAsync();
    }

    private async Task AnalyzeHomeTopPick()
    {
        if (!_topPicks.Any()) return;
        
        _isAiProcessing = true;
        StateHasChanged();
        
        try
        {
            var pick = _topPicks.First();
            _latestInsight = await MLServiceClient.GetAiAnalysisAsync(pick.Sport.ToLower(), pick.HomeTeam, pick.AwayTeam);
        }
        catch (Exception) { }
        finally
        {
            _isAiProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadModelSummary()
    {
        _isModelsLoading = true;
        try
        {
            _modelSummary = await MLServiceClient.GetModelSummaryAsync();
        }
        catch (Exception) { }
        finally { _isModelsLoading = false; }
    }

    private async Task LoadAnalytics()
    {
        try
        {
            var analytics = await DataCollectionService.GetAnalyticsAsync();
            if (analytics.ContainsKey("NetProfit")) _netProfit = (decimal)analytics["NetProfit"];
            if (analytics.ContainsKey("WinRate")) _winRate = (double)analytics["WinRate"];
            if (analytics.ContainsKey("BetsWithResults")) _totalBetsWithResults = (int)analytics["BetsWithResults"];
            if (analytics.ContainsKey("GoodBetCount")) _avgConfidence = 0; // TBD

            _recentBets = await DataCollectionService.GetHistoricalBetsAsync(10);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed to load analytics data", Severity.Warning);
        }
    }

    private async Task LoadTopPicks()
    {
        _isPicksLoading = true;
        try
        {
            // In a real app, we'd fetch these from a dedicated 'Best Bets' endpoint.
            // For now, we'll simulate a few high-value opportunities.
            _topPicks = new List<TopPick>
            {
                new() { Sport = "NBA", HomeTeam = "Lakers", AwayTeam = "Bucks", GameTime = "7:30 PM", Probability = 0.582, Winner = "Lakers ML", ValueScore = 8.4, Edge = 0.045 },
                new() { Sport = "NFL", HomeTeam = "Chiefs", AwayTeam = "Bills", GameTime = "Sun 4:25 PM", Probability = 0.541, Winner = "Chiefs -2.5", ValueScore = 6.2, Edge = 0.031 }
            };
            _activePicksCount = 12; // Example
        }
        catch (Exception) { }
        finally { _isPicksLoading = false; }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _selectedFile = file;
        _errorMessage = string.Empty;
        _currentAnalysis = null;

        try
        {
            _isProcessing = true;
            StateHasChanged();

            using var stream = file.OpenReadStream(maxAllowedSize: 10485760);
            _currentAnalysis = await BetAnalysisService.AnalyzeBetSlipImageAsync(stream);
            _showAnalysisModal = true;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error processing: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private void OnFileRemoved()
    {
        _selectedFile = null;
        _currentAnalysis = null;
    }

    private async Task SaveAnalysis()
    {
        if (_currentAnalysis == null) return;
        try
        {
            await DataCollectionService.SaveBetAnalysisAsync(_currentAnalysis);
            Snackbar.Add("Saved to history!", Severity.Success);
            _showAnalysisModal = false;
            await LoadAnalytics(); // Refresh
        }
        catch (Exception ex)
        {
            Snackbar.Add("Save failed", Severity.Error);
        }
    }

    public class TopPick
    {
        public string Sport { get; set; } = "";
        public string HomeTeam { get; set; } = "";
        public string AwayTeam { get; set; } = "";
        public string GameTime { get; set; } = "";
        public double Probability { get; set; }
        public string Winner { get; set; } = "";
        public double ValueScore { get; set; }
        public double Edge { get; set; }
    }
}
