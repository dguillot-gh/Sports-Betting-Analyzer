@page "/odds"
@page "/ncaab"
@using SportsBettingAnalyzer.Services
@using SportsBettingAnalyzer.Models
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@inject OddsService OddsService
@inject BallDontLieService StatsService
@inject PythonMLServiceClient PythonMLService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject FileExportService FileExportService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<TwContainer>
    <div class="px-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white tracking-tight">Live Betting Odds</h1>
            <p class="text-slate-400 mt-1">Real-time odds and trend analysis across major sportsbooks.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            @if (OddsService.LastQuotaUsage.RequestsRemaining > 0 || OddsService.LastQuotaUsage.RequestsUsed > 0)
            {
                <TwChip Icon="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" 
                        Color="blue" Variant="outline">
                    Odds API: @OddsService.LastQuotaUsage.RequestsUsed / @OddsService.LastQuotaUsage.RequestsRemaining
                </TwChip>
            }
            <TwButton Variant="outline" Size="sm" OnClick="ExportOdds" Disabled="@(!_events.Any())">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                Export CSV
            </TwButton>
            <TwButton Variant="secondary" Size="sm" Href="/daily-analysis">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                View Daily Cache
            </TwButton>
        </div>
    </div>

    <TwTabs HeaderClass="px-4">
        <TwTabPanel Title="Live Odds">
            <IconContent>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
            </IconContent>
            <ChildContent>
                <div class="px-4">
                    <TwGrid Columns="1" ColumnsMd="2" Class="mb-6 items-end">
                    <TwSelect TValue="string" Label="Select Sport" Value="@_selectedSportKey" ValueChanged="OnSportChanged" FullWidth="true">
                        @foreach (var sport in _filteredSports)
                        {
                            <option value="@sport.Key">@sport.Title</option>
                        }
                    </TwSelect>
                    <div class="flex gap-3">
                        <TwButton Variant="primary" OnClick="LoadOdds" IsLoading="@_isLoading" Disabled="@(string.IsNullOrEmpty(_selectedSportKey) || _isLoading)" FullWidth="true">
                            Refresh Odds
                        </TwButton>

                        @if (_selectedSportKey == "basketball_ncaab")
                        {
                            <TwButton Variant="secondary" OnClick="TrainNcaabModel" IsLoading="@_isTraining" Disabled="@(_isLoading || _isTraining)" FullWidth="true">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86 1.417l-1.873 1.56a2 2 0 01-1.076.443L6.5 18M3.5 14l1-1.5M13 13l3-1M5 10c2.133 0 4.267.533 6 1.5M15 10c-2.133 0-4.267.533-6 1.5"></path></svg>
                                Train Model (v2)
                            </TwButton>
                        }
                    </div>
                </TwGrid>

                @if (_events.Any())
                {
                    var validEvents = _events.Where(e => !string.IsNullOrEmpty(e.HomeTeam) && !string.IsNullOrEmpty(e.AwayTeam)).ToList();
                    
                    @if (validEvents.Any())
                    {
                        <TwCard NoPadding="true" Class="overflow-hidden">
                            <TwTable TItem="object">
                                <TwTh Class="w-10">
                                    <input type="checkbox" 
                                           @onchange="ToggleSelectAll"
                                           checked="@(_selectedGameIds.Count == validEvents.Count && validEvents.Count > 0)"
                                           class="w-4 h-4 rounded border-slate-600 bg-slate-800 text-emerald-500 focus:ring-emerald-500" />
                                </TwTh>
                                <TwTh>Time</TwTh>
                                <TwTh>Matchup</TwTh>
                                <TwTh>DraftKings</TwTh>
                                <TwTh>FanDuel</TwTh>
                                <TwTh>ESPN BPI</TwTh>
                                <TwTh Class="text-right">Analysis</TwTh>
                                @foreach (var context in validEvents)
                                {
                                    <TwTr Class="@(_selectedGameIds.Contains(GetGameId(context)) ? "bg-emerald-900/20" : "")">
                                        <TwTd>
                                            <input type="checkbox" 
                                                   checked="@_selectedGameIds.Contains(GetGameId(context))"
                                                   @onchange="@(() => ToggleGameSelection(GetGameId(context), context))"
                                                   class="w-4 h-4 rounded border-slate-600 bg-slate-800 text-emerald-500 focus:ring-emerald-500" />
                                        </TwTd>
                                        <TwTd><span class="text-slate-400">@context.CommenceTime.ToLocalTime().ToString("MM/dd HH:mm")</span></TwTd>
                                        <TwTd>
                                            <div class="flex flex-col">
                                                <span class="font-bold text-white">@context.AwayTeam</span>
                                                <span class="text-[10px] text-slate-500 uppercase tracking-widest my-0.5">at</span>
                                                <span class="font-bold text-white">@context.HomeTeam</span>
                                            </div>
                                        </TwTd>
                                        <TwTd>
                                            <div class="text-xs space-y-1">
                                                @GetBookmakerOdds(context, "DraftKings")
                                            </div>
                                        </TwTd>
                                        <TwTd>
                                            <div class="text-xs space-y-1">
                                                @GetBookmakerOdds(context, "FanDuel")
                                            </div>
                                        </TwTd>
                                        <TwTd>
                                            @{
                                                var bpi = MatchEspnGame(context);
                                            }
                                            @if (bpi != null)
                                            {
                                                <div class="flex flex-col gap-1 max-w-[100px]">
                                                    @if (bpi.HomeWinProb > bpi.AwayWinProb)
                                                    {
                                                        <TwChip Color="emerald" Variant="outline" Size="sm">H: @((bpi.HomeWinProb*100).ToString("F0"))%</TwChip>
                                                    }
                                                    else
                                                    {
                                                        <TwChip Color="emerald" Variant="outline" Size="sm">A: @((bpi.AwayWinProb*100).ToString("F0"))%</TwChip>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-slate-600">-</span>
                                            }
                                        </TwTd>
                                        <TwTd Class="text-right">
                                            <TwButton Variant="secondary" Size="sm" OnClick="@(() => OpenAnalysis(context))">
                                                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                                                Analyze
                                            </TwButton>
                                        </TwTd>
                                    </TwTr>
                                }
                            </TwTable>
                        </TwCard>
                    }
                    else
                    {
                        <TwAlert Severity="info" Class="mt-4">
                            This sport only has futures/outright markets available. Try selecting a different sport with upcoming games.
                        </TwAlert>
                    }
                }
                else if (!string.IsNullOrEmpty(_selectedSportKey) && !_isLoading)
                {
                    <TwAlert Severity="info" Class="mt-4">
                        No active events found for this sport.
                    </TwAlert>
                }
                </div>
            </ChildContent>
        </TwTabPanel>

        <TwTabPanel Title="Hit Rates (NCAAB)" Disabled="@(!_selectedSportKey.Contains("ncaab"))">
             <IconContent>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
            </IconContent>
            <ChildContent>
                <div class="px-4">
                <TwCard Class="mb-6">
                    <TwGrid Columns="1" ColumnsMd="12" Class="items-end gap-4">
                        <div class="md:col-span-4">
                            <TwAutocomplete Items="@_teamList" Label="Team" @bind-Value="_trendTeam" Placeholder="Search team..." FullWidth="true" />
                        </div>
                        <div class="md:col-span-2">
                            <TwSelect TValue="string" Label="Metric" @bind-Value="_trendMetric" FullWidth="true">
                                <option value="total">Total (O/U)</option>
                                <option value="team_score">Team Score</option>
                                <option value="margin">Margin (Spread)</option>
                            </TwSelect>
                        </div>
                        <div class="md:col-span-2">
                            <TwNumericField @bind-Value="_trendLine" Label="Target Line" Step="0.5" FullWidth="true" />
                        </div>
                        <div class="md:col-span-2">
                             <TwSlider @bind-Value="_trendLastN" Min="5" Max="50" Step="1">Last @_trendLastN Games</TwSlider>
                        </div>
                        <div class="md:col-span-2">
                            <TwButton Variant="primary" OnClick="CalculateTrend" IsLoading="@_isTrendLoading" Disabled="@(string.IsNullOrEmpty(_trendTeam) || _isTrendLoading)" FullWidth="true">
                                Check Trend
                            </TwButton>
                        </div>
                    </TwGrid>
                </TwCard>

                @if (_hitRateResult != null)
                {
                    <TwCard HoverEffect="false" Class="mb-6">
                        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-4 gap-4">
                            <div>
                                <h3 class="text-xl font-bold text-white">@_hitRateResult.Team Trends</h3>
                                <p class="text-sm text-slate-400 mt-1">
                                    Analysis: Over last @_hitRateResult.GamesAnalyzed games, @_hitRateResult.Team went <b>@(_trendMetric == "total" ? "OVER" : "OVER")</b> @_hitRateResult.Line <b>@_hitRateResult.Hits</b> times.
                                </p>
                            </div>
                            <TwChip Color="@(_hitRateResult.HitRate > 0.55 ? "emerald" : "slate")" Size="lg">
                                Hit Rate: @_hitRateResult.Hits / @_hitRateResult.GamesAnalyzed (@(_hitRateResult.HitRate.ToString("P0")))
                            </TwChip>
                        </div>
                        
                        <div class="text-sm text-blue-400 bg-blue-500/5 p-3 rounded-lg border border-blue-500/10 mb-4 inline-block">
                            Avg Value: <strong>@_hitRateResult.AvgValue</strong>
                        </div>

                        <TwTable TItem="object">
                            <TwTh>Date</TwTh>
                            <TwTh>Opponent</TwTh>
                            <TwTh>Score</TwTh>
                            <TwTh>Value</TwTh>
                            <TwTh Class="text-right">Result</TwTh>
                            @foreach (var game in _hitRateResult.GameLog)
                            {
                                <TwTr>
                                    <TwTd><span class="text-slate-400">@game.Date</span></TwTd>
                                    <TwTd><span class="text-white font-medium">@game.Opponent</span></TwTd>
                                    <TwTd>@game.Score</TwTd>
                                    <TwTd>@game.Value</TwTd>
                                    <TwTd Class="text-right">
                                        @if (game.IsHit)
                                        {
                                            <svg class="w-5 h-5 text-emerald-500 ml-auto" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                                        }
                                        else
                                        {
                                            <svg class="w-5 h-5 text-red-500 ml-auto" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg>
                                        }
                                    </TwTd>
                                </TwTr>
                            }
                        </TwTable>
                    </TwCard>
                }
                
                <h6 class="text-lg font-bold text-white mt-8 mb-4">Model Management</h6>
                <div class="flex flex-wrap items-center gap-4">
                    <TwButton Variant="primary" OnClick="TrainNcaabModel" IsLoading="@_isTraining" Disabled="@_isTraining">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86 1.417l-1.873 1.56a2 2 0 01-1.076.443L6.5 18M3.5 14l1-1.5M13 13l3-1M5 10c2.133 0 4.267.533 6 1.5M15 10c-2.133 0-4.267.533-6 1.5"></path></svg>
                        Train XGBoost Model
                    </TwButton>
                    
                    @if(_trainingMessage != null)
                    {
                        <span class="text-blue-400 text-sm">@_trainingMessage</span>
                    }
                    
                    <TwButton Variant="outline" OnClick="RunBacktest" IsLoading="@_isBacktesting" Disabled="@_isBacktesting">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        Run Backtest (2023-24)
                    </TwButton>
                </div>
                
                @if(_backtestReport != null)
                {
                    <TwGrid Columns="2" ColumnsMd="4" Class="mt-6">
                        <TwStatCard Label="ROI" Value="@($"{_backtestReport.RoiPercent}%")" Color="@(_backtestReport.RoiPercent > 0 ? "emerald" : "red")" />
                        <TwStatCard Label="Units Won" Value="@(_backtestReport.UnitsWon.ToString("F1"))" Color="@(_backtestReport.UnitsWon > 0 ? "emerald" : "red")" />
                        <TwStatCard Label="Hit Rate" Value="@($"{_backtestReport.HitRate}%")" Color="blue" />
                        <TwStatCard Label="Bets" Value="@(_backtestReport.BetsPlaced.ToString())" Color="slate" />
                    </TwGrid>
                }
                </div>
            </ChildContent>
        </TwTabPanel>

        <TwTabPanel Title="ESPN Predictions">
            <IconContent>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </IconContent>
            <ChildContent>
                <div class="px-4">
                <TwGrid Columns="1" ColumnsMd="2" Class="mb-6 items-end gap-4">
                    <TwSelect TValue="string" Label="League" @bind-Value="_espnSport" FullWidth="true">
                        <option value="ncaab">NCAAB</option>
                        <option value="nba">NBA</option>
                        <option value="nfl">NFL</option>
                    </TwSelect>
                    <div class="flex items-center gap-4">
                        <TwButton Variant="primary" OnClick="LoadEspnPredictions" IsLoading="@_isEspnLoading" Disabled="@_isEspnLoading" FullWidth="true">
                            Load Predictions
                        </TwButton>
                        @if (_espnResponse != null)
                        {
                            <span class="text-xs text-slate-500">Source: @_espnResponse.Source</span>
                        }
                    </div>
                </TwGrid>

                @if (_espnResponse?.Games != null && _espnResponse.Games.Any())
                {
                    <TwCard NoPadding="true" Class="overflow-hidden">
                        <TwTable TItem="object">
                            <TwTh>Time</TwTh>
                            <TwTh>Away Team</TwTh>
                            <TwTh>Home Team</TwTh>
                            <TwTh>Win Probability</TwTh>
                            <TwTh>Spread/Total</TwTh>
                            @foreach (var game in _espnResponse.Games)
                            {
                                <TwTr>
                                    <TwTd>
                                        <div class="flex flex-col">
                                            <span class="text-slate-400">@DateTime.Parse(game.GameTime).ToLocalTime().ToString("MM/dd HH:mm")</span>
                                            <span class="text-[10px] text-slate-600">@game.EventId</span>
                                        </div>
                                    </TwTd>
                                    <TwTd>
                                        <div class="flex flex-col">
                                            <div class="flex items-center">
                                                <span class="font-bold text-white">@game.AwayTeam</span>
                                                @if(game.AwayRank is object && game.AwayRank.ToString() != "99" && game.AwayRank.ToString() != "999") 
                                                { <span class="ml-1.5 text-blue-400 text-[10px] font-bold">#@game.AwayRank</span> }
                                            </div>
                                            <span class="text-xs text-slate-500">@game.AwayScore</span>
                                        </div>
                                    </TwTd>
                                    <TwTd>
                                         <div class="flex flex-col">
                                            <div class="flex items-center">
                                                <span class="font-bold text-white">@game.HomeTeam</span>
                                                @if(game.HomeRank is object && game.HomeRank.ToString() != "99" && game.HomeRank.ToString() != "999") 
                                                { <span class="ml-1.5 text-blue-400 text-[10px] font-bold">#@game.HomeRank</span> }
                                            </div>
                                            <span class="text-xs text-slate-500">@game.HomeScore</span>
                                        </div>
                                    </TwTd>
                                    <TwTd>
                                        <div class="flex flex-col gap-2 min-w-[120px]">
                                            <TwProgressBar Value="@((int)(game.AwayWinProb * 100))" Color="@(game.AwayWinProb > game.HomeWinProb ? "emerald" : "slate")" Size="sm" Label="@($"Away: {game.AwayWinProb:P1}")" />
                                            <TwProgressBar Value="@((int)(game.HomeWinProb * 100))" Color="@(game.HomeWinProb > game.AwayWinProb ? "emerald" : "slate")" Size="sm" Label="@($"Home: {game.HomeWinProb:P1}")" />
                                        </div>
                                    </TwTd>
                                    <TwTd>
                                        <div class="text-xs space-y-0.5">
                                            <div class="text-slate-300">Spread: <span class="font-medium text-white">@game.Spread</span></div>
                                            <div class="text-slate-300">Total: <span class="font-medium text-white">@game.OverUnder</span></div>
                                        </div>
                                    </TwTd>
                                </TwTr>
                            }
                        </TwTable>
                    </TwCard>
                }
                </div>
            </ChildContent>
        </TwTabPanel>
    </TwTabs>

    <!-- Floating Paper Trading Action Bar -->
    @if (_showPaperTradingBar)
    {
        <div class="fixed bottom-6 left-1/2 transform -translate-x-1/2 z-50">
            <div class="bg-gradient-to-r from-slate-900 to-slate-800 border border-emerald-500/50 rounded-2xl shadow-2xl shadow-emerald-500/20 px-6 py-4 flex items-center gap-6">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-emerald-500/20 rounded-lg">
                        <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="text-white font-semibold">@_selectedGameIds.Count game@(_selectedGameIds.Count != 1 ? "s" : "") selected</div>
                        <div class="text-xs text-slate-400">Ready to add to paper trading</div>
                    </div>
                </div>
                
                <div class="flex gap-3">
                    <button @onclick="AddSelectedToPaperTrading" 
                            class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-lg transition-colors flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                        Add to Deck
                    </button>
                    <button @onclick="ClearSelection" 
                            class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white font-medium rounded-lg transition-colors">
                        Clear
                    </button>
                </div>
            </div>
        </div>
    }

</TwContainer>

@code {
    private List<SportInfo> _sports = new();
    private List<SportInfo> _filteredSports = new();
    private List<OddsEvent> _events = new();
    private string _selectedSportKey = "";
    private bool _isLoading = false;

    // Major US sports to filter by
    private readonly HashSet<string> _majorSports = new() 
    { 
        "americanfootball_nfl", 
        "basketball_nba", 
        "baseball_mlb", 
        "icehockey_nhl", 
        "motorsports_nascar_cup",
        "basketball_ncaab" 
    };

    // Trend Tab State
    private string _trendTeam = "";
    private string _trendMetric = "total";
    private double _trendLine = 145.5;
    private int _trendLastN = 10;
    private bool _isTrendLoading = false;
    private HitRateResult? _hitRateResult;
    private List<string> _teamList = new();

    // Paper Trading Selection State
    private HashSet<string> _selectedGameIds = new();
    private bool _showPaperTradingBar => _selectedGameIds.Count > 0;

    // ESPN Tab State
    private string _espnSport = "ncaab";
    private bool _isEspnLoading = false;
    private EspnResponse? _espnResponse;

    // Training State
    private bool _isTraining = false;
    private string? _trainingMessage;


    private async Task TrainNcaabModel()
    {
        _isTraining = true;
        _trainingMessage = "Training started in background...";
        try
        {
            await PythonMLService.TrainNcaabModelAsync();
            Snackbar.Add("Training started! The model will be updated shortly.", Severity.Success);
            _trainingMessage = "Training triggered successfully.";
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Training failed: {ex.Message}", Severity.Error);
            _trainingMessage = "Training failed.";
        }
        finally
        {
            _isTraining = false;
        }
    }

    // Backtest State
    private bool _isBacktesting = false;
    private BacktestReport? _backtestReport;

    private async Task RunBacktest()
    {
        _isBacktesting = true;
        _backtestReport = null;
        try
        {
            _backtestReport = await PythonMLService.BacktestNcaabAsync();
            if (_backtestReport != null)
            {
                Snackbar.Add($"Backtest Complete! ROI: {_backtestReport.RoiPercent}%", Severity.Success);
            }
            else
            {
                 Snackbar.Add("Backtest failed or returned no data.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Backtest Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isBacktesting = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _sports = await OddsService.GetSportsAsync();
            
            // Filter
            _filteredSports = _sports
                .Where(s => s.Active && (_majorSports.Contains(s.Key) || s.Group == "American Football" || s.Group == "Basketball" || s.Group == "Baseball"))
                .ToList();
            
            // Default Logic
            SportInfo? defaultSport = null;
            
            if (NavigationManager.Uri.Contains("/ncaab"))
            {
                 defaultSport = _filteredSports.FirstOrDefault(s => s.Key == "basketball_ncaab");
            }
            
            if (defaultSport == null)
            {
                defaultSport = _filteredSports.FirstOrDefault(s => s.Key == "americanfootball_nfl") 
                                ?? _filteredSports.FirstOrDefault(s => s.Key == "basketball_nba")
                                ?? _filteredSports.FirstOrDefault();
            }
                            
            if (defaultSport != null)
            {
                _selectedSportKey = defaultSport.Key;
                await OnSportChanged(_selectedSportKey);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading sports: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnSportChanged(string sportKey)
    {
        _selectedSportKey = sportKey;
        
        // Auto-switch ESPN tab too
        if (sportKey.Contains("ncaab")) _espnSport = "ncaab";
        else if (sportKey.Contains("nba")) _espnSport = "nba";
        else if (sportKey.Contains("nfl")) _espnSport = "nfl";
        
        // Load data in parallel
        await Task.WhenAll(LoadOdds(), LoadEspnPredictions());

        // Low priority: load teams
        if (sportKey.Contains("ncaab"))
        {
            _ = LoadNcaabTeams();
        }
    }

    private async Task LoadOdds()
    {
        if (string.IsNullOrEmpty(_selectedSportKey)) return;

        _isLoading = true;
        try
        {
            _events = await OddsService.GetOddsAsync(_selectedSportKey);
            Snackbar.Add($"Loaded {_events.Count} events", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading odds: {ex.Message}", Severity.Error);
            Console.WriteLine($"Error: {ex}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadNcaabTeams()
    {
        try 
        {
            var teams = await PythonMLService.GetTeamsAsync("ncaab"); 
            _teamList = teams.Select(t => t.ContainsKey("team_name") ? t["team_name"].ToString() : 
                                          t.ContainsKey("team") ? t["team"].ToString() : 
                                          t.ContainsKey("school") ? t["school"].ToString() : "Unknown").Where(x => x != null).ToList()!;
            
            _teamList = _teamList.Distinct().OrderBy(x => x).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading NCAAB teams: {ex}");
        }
    }
    
    private async Task<IEnumerable<string>> SearchTeams(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return _teamList;
        return _teamList.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task CalculateTrend()
    {
        if (string.IsNullOrEmpty(_trendTeam)) return;
        
        _isTrendLoading = true;
        try
        {
            _hitRateResult = await PythonMLService.GetNcaabHitRatesAsync(_trendTeam, _trendMetric, _trendLine, _trendLastN);
            if (_hitRateResult == null)
            {
                 Snackbar.Add("No data found for this team/trend.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error calculating trend: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isTrendLoading = false;
        }
    }

    private async Task LoadEspnPredictions()
    {
        _isEspnLoading = true;
        try
        {
            _espnResponse = await PythonMLService.GetEspnPredictionsAsync(_espnSport);
            if (_espnResponse == null || !_espnResponse.Games.Any())
            {
                Snackbar.Add("No ESPN predictions found.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading ESPN predictions: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isEspnLoading = false;
        }
    }

    private void OpenAnalysis(OddsEvent ev)
    {
        var espnGame = MatchEspnGame(ev);
        var parameters = new DialogParameters 
        { 
            { "Event", ev },
            { "Sport", _selectedSportKey },
            { "EspnData", espnGame } // Pass matched data 
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        DialogService.Show<GameAnalysis>("Game Analysis", parameters, options);
    }


    private EspnGame? MatchEspnGame(OddsEvent ev)
    {
        if (_espnResponse?.Games == null) return null;
        
        // Simple fuzzy match on names
        // Normalize: remove generic terms (University, State, Team) if needed, but for now strict-ish logic
        
        return _espnResponse.Games.FirstOrDefault(g => 
            // Try Exact match first
            (g.HomeTeam.Equals(ev.HomeTeam, StringComparison.OrdinalIgnoreCase) || g.HomeTeam.Contains(ev.HomeTeam) || ev.HomeTeam.Contains(g.HomeTeam)) &&
            (g.AwayTeam.Equals(ev.AwayTeam, StringComparison.OrdinalIgnoreCase) || g.AwayTeam.Contains(ev.AwayTeam) || ev.AwayTeam.Contains(g.AwayTeam))
        );
    }

    private async Task ExportOdds()
    {
        if (!_events.Any()) return;

        var exportData = _events.Select(e => new 
        {
            Time = e.CommenceTime.ToLocalTime().ToString("g"),
            Matchup = $"{e.AwayTeam} vs {e.HomeTeam}",
            DK_ML_Home = GetOddsValue(e, "DraftKings", "h2h", e.HomeTeam),
            DK_ML_Away = GetOddsValue(e, "DraftKings", "h2h", e.AwayTeam),
            DK_Spread = GetSpreadValue(e, "DraftKings", e.HomeTeam),
            DK_Total = GetTotalValue(e, "DraftKings"),
            FD_ML_Home = GetOddsValue(e, "FanDuel", "h2h", e.HomeTeam),
            FD_ML_Away = GetOddsValue(e, "FanDuel", "h2h", e.AwayTeam),
            FD_Spread = GetSpreadValue(e, "FanDuel", e.HomeTeam),
            FD_Total = GetTotalValue(e, "FanDuel")
        }).ToList();

        await FileExportService.ExportToCsv(exportData, $"odds_{_selectedSportKey}_{DateTime.Now:yyyyMMdd}.csv");
        Snackbar.Add("Odds exported successfully", Severity.Success);
    }

    private string GetOddsValue(OddsEvent ev, string bookmaker, string marketKey, string outcomeName)
    {
        var book = ev.Bookmakers.FirstOrDefault(b => b.Title.Contains(bookmaker, StringComparison.OrdinalIgnoreCase));
        var market = book?.Markets.FirstOrDefault(m => m.Key == marketKey);
        var outcome = market?.Outcomes.FirstOrDefault(o => o.Name == outcomeName);
        return FormatPrice(outcome?.Price);
    }

    private string GetSpreadValue(OddsEvent ev, string bookmaker, string teamName)
    {
        var book = ev.Bookmakers.FirstOrDefault(b => b.Title.Contains(bookmaker, StringComparison.OrdinalIgnoreCase));
        var market = book?.Markets.FirstOrDefault(m => m.Key == "spreads");
        var outcome = market?.Outcomes.FirstOrDefault(o => o.Name == teamName);
        if (outcome == null) return "-";
        return $"{FormatPoint(outcome.Point)} ({FormatPrice(outcome.Price)})";
    }

    private string GetTotalValue(OddsEvent ev, string bookmaker)
    {
        var book = ev.Bookmakers.FirstOrDefault(b => b.Title.Contains(bookmaker, StringComparison.OrdinalIgnoreCase));
        var market = book?.Markets.FirstOrDefault(m => m.Key == "totals");
        var outcome = market?.Outcomes.FirstOrDefault(o => o.Name == "Over");
        if (outcome == null) return "-";
        return $"O {outcome.Point} ({FormatPrice(outcome.Price)})";
    }

    private RenderFragment GetBookmakerOdds(OddsEvent ev, string bookmakerName) => builder =>
    {
        var book = ev.Bookmakers.FirstOrDefault(b => b.Title.Contains(bookmakerName, StringComparison.OrdinalIgnoreCase));
        if (book == null)
        {
            builder.AddContent(0, "-");
            return;
        }

        // Moneyline (h2h)
        var h2h = book.Markets.FirstOrDefault(m => m.Key == "h2h");
        if (h2h != null)
        {
            var away = h2h.Outcomes.FirstOrDefault(o => o.Name == ev.AwayTeam);
            var home = h2h.Outcomes.FirstOrDefault(o => o.Name == ev.HomeTeam);
            
            builder.OpenElement(1, "div");
            builder.AddAttribute(2, "class", "flex justify-between mb-1");
            builder.AddContent(3, $"ML: {FormatPrice(away?.Price)} / {FormatPrice(home?.Price)}");
            builder.CloseElement();
        }

        // Spread
        var spread = book.Markets.FirstOrDefault(m => m.Key == "spreads");
        if (spread != null)
        {
            var away = spread.Outcomes.FirstOrDefault(o => o.Name == ev.AwayTeam);
            var home = spread.Outcomes.FirstOrDefault(o => o.Name == ev.HomeTeam);
            
            if (away != null && home != null)
            {
                builder.OpenElement(4, "div");
                builder.AddAttribute(5, "class", "flex justify-between mb-1");
                builder.AddContent(6, $"Spr: {FormatPoint(away.Point)} ({FormatPrice(away.Price)})");
                builder.CloseElement();
            }
        }

        // Total
        var total = book.Markets.FirstOrDefault(m => m.Key == "totals");
        if (total != null)
        {
            var over = total.Outcomes.FirstOrDefault(o => o.Name == "Over");
            
            if (over != null)
            {
                builder.OpenElement(7, "div");
                builder.AddAttribute(8, "class", "flex justify-between");
                builder.AddContent(9, $"Tot: {over.Point} ({FormatPrice(over.Price)})");
                builder.CloseElement();
            }
        }
    };

    private string FormatPrice(double? price)
    {
        if (!price.HasValue) return "-";
        return price > 0 ? $"+{price}" : price.ToString();
    }

    private string FormatPoint(double? point)
    {
        if (!point.HasValue) return "";
        return point > 0 ? $"+{point}" : point.ToString();
    }

    // Paper Trading Selection Functions
    private Dictionary<string, OddsEvent> _selectedEventsData = new();

    private void ToggleGameSelection(string gameId, OddsEvent eventData)
    {
        if (_selectedGameIds.Contains(gameId))
        {
            _selectedGameIds.Remove(gameId);
            _selectedEventsData.Remove(gameId);
        }
        else
        {
            _selectedGameIds.Add(gameId);
            _selectedEventsData[gameId] = eventData;
        }
        StateHasChanged();
    }

    private string GetGameId(OddsEvent evt) => $"{evt.AwayTeam}:{evt.HomeTeam}";

    private void ToggleSelectAll()
    {
        var validEvents = _events.Where(e => !string.IsNullOrEmpty(e.HomeTeam) && !string.IsNullOrEmpty(e.AwayTeam)).ToList();
        
        if (_selectedGameIds.Count == validEvents.Count)
        {
            _selectedGameIds.Clear();
            _selectedEventsData.Clear();
        }
        else
        {
            foreach (var evt in validEvents)
            {
                var gameId = $"{evt.AwayTeam}:{evt.HomeTeam}";
                _selectedGameIds.Add(gameId);
                _selectedEventsData[gameId] = evt;
            }
        }
        StateHasChanged();
    }

    private void ClearSelection()
    {
        _selectedGameIds.Clear();
        _selectedEventsData.Clear();
        StateHasChanged();
    }

    private void AddSelectedToPaperTrading()
    {
        // Store selection in session and navigate to bet tracker with query param
        var gamesParam = string.Join(",", _selectedGameIds);
        NavigationManager.NavigateTo($"/bet-tracker?games={Uri.EscapeDataString(gamesParam)}&sport={_selectedSportKey}");
        
        Snackbar.Add($"Opening Paper Trading with {_selectedGameIds.Count} games...", Severity.Success);
        ClearSelection();
    }
