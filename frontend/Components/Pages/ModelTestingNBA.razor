                        // Parse (Experimental)
                        if (game.TryGetProperty("experimental_prediction", out var ep) && ep.ValueKind == JsonValueKind.Object)
                        {
                            gp.ExperimentalModel = new ModelResult
                            {
                                HomeWinProb = ep.TryGetProperty("home_win_probability", out var ehp) && ehp.ValueKind == JsonValueKind.Number ? ehp.GetDouble() : null,
                                PredictedWinner = (ep.TryGetProperty("home_win_probability", out var p) && p.GetDouble() > 0.5) ? gp.HomeTeam : gp.AwayTeam,
