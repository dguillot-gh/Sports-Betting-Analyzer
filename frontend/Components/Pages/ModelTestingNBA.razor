@page "/model-testing-nba"
@page "/live-nba-odds"
@using System.Text.Json
@using SportsBettingAnalyzer.Services
@using SportsBettingAnalyzer.Models
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ILogger<ModelTestingNBA> Logger
@inject PythonMLServiceClient MLServiceClient
@rendermode InteractiveServer

<PageTitle>NBA Model Testing</PageTitle>

<TwContainer MaxWidth="extraLarge" Class="mt-8 px-4 pb-12">
    <!-- Loading Overlay -->
    <TwLoadingOverlay 
        IsVisible="@_isLoading"
        Title="Crunching NBA Data..."
        Color="amber"
        CurrentStatusMessage="@_analysisStatus"
        ShowProgress="false" />

    @* Header Section *@
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white flex items-center gap-3">
                <TwIcon Icon="M12 2a10 10 0 1010 10A10 10 0 0012 2zm0 18a8 8 0 118-8 8 8 0 01-8 8z" Class="w-8 h-8 text-amber-500" />
                NBA Model Testing
            </h1>
            <p class="text-slate-400 mt-1">Using kyleskom/NBA-ML-Sports-Betting pre-trained model (68.9% accuracy)</p>
        </div>

        <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
            <div class="w-full sm:w-40">
                <TwSelect TValue="string" @bind-Value="_selectedSportsbook" Class="w-full">
                    <option value="fanduel">FanDuel</option>
                    <option value="draftkings">DraftKings</option>
                    <option value="betmgm">BetMGM</option>
                </TwSelect>
            </div>
            
            <TwButton Variant="primary" OnClick="@RunAnalysis" IsLoading="_isLoading" Disabled="@_isLoading">
                @if (!_isLoading) { <TwIcon Icon="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" Class="w-4 h-4 mr-2" /> }
                @(_isLoading ? "Analyzing..." : "Analyze Games")
            </TwButton>

            <TwButton Variant="secondary" OnClick="@SaveAllToCache" IsLoading="_isSavingAll" Disabled="@(!_games.Any() || _isSavingAll)">
                @if (!_isSavingAll) { <TwIcon Icon="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" Class="w-4 h-4 mr-2" /> }
                Snapshot Results
            </TwButton>

            <TwLink Href="/daily-analysis" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-slate-700 transition-all text-sm font-medium">
                <TwIcon Icon="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-4 h-4 text-slate-500" />
                History
            </TwLink>
        </div>
    </div>

    @* Strategy Chips *@
    <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-4 mb-8 flex flex-wrap items-center gap-4">
        <div class="flex items-center gap-2 group cursor-help" title="The Holy Grail: Strong Signal (Agree) & Positive EV (Green)">
            <TwChip Color="blue" Size="sm" Class="flex items-center gap-1.5 font-bold">
                <TwIcon Icon="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" Class="w-3.5 h-3.5" />
                EV = Edge
            </TwChip>
            <span class="text-[11px] text-slate-500 group-hover:text-slate-300 transition-colors hidden sm:block">Value detection (Hover for Guide)</span>
        </div>
        <div class="flex items-center gap-2 group cursor-help">
            <TwChip Color="purple" Size="sm" Class="flex items-center gap-1.5 font-bold">
                <TwIcon Icon="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.407 2.663 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.407-2.663-1M12 16v1m-7-4a4 4 0 118 0 4 4 0 01-8 0z" Class="w-3.5 h-3.5" />
                Kelly = Size
            </TwChip>
            <span class="text-[11px] text-slate-500 group-hover:text-slate-300 transition-colors hidden sm:block">Position sizing</span>
        </div>
        <div class="flex items-center gap-2 group cursor-help">
            <TwChip Color="emerald" Size="sm" Class="flex items-center gap-1.5 font-bold">
                <TwIcon Icon="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-3.5 h-3.5" />
                Agree = Strong
            </TwChip>
            <span class="text-[11px] text-slate-500 group-hover:text-slate-300 transition-colors hidden sm:block">Model consensus</span>
        </div>

        <div class="ml-auto flex items-center gap-2 text-[10px] text-slate-500 italic">
            <TwIcon Icon="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-3 h-3" />
            Hover results for metric details
        </div>
    </div>

    @if (_error != null)
    {
        <div class="mb-8">
            <TwAlert Severity="error">@_error</TwAlert>
        </div>
    }

    <ApiQuotaTracker />

    <TwTabs>
        <TwTabPanel Title="Games" TabIcon="@Icons.Material.Filled.SportsBasketball">
                @if (_games.Any())
                {
                    <div class="flex items-center gap-2 text-slate-400 text-sm mb-6 px-2">
                        <TwIcon Icon="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-4 h-4" />
                        <span>@_games.Count game(s) found • @_date • Stats from NBA API</span>
                    </div>
                    
                    <TwGrid Columns="1" md="2" lg="3" Gap="6">
                        @foreach (var game in _games)
                        {
                            <TwCard Class="p-0 overflow-hidden bg-slate-900 border-slate-800 shadow-xl group hover:border-blue-500/30 transition-all">
                                @* Card Header *@
                                <div class="bg-slate-900/50 p-5 border-b border-slate-800">
                                    <div class="flex items-center justify-between text-white font-bold">
                                        <span class="text-lg">@game.AwayTeam</span>
                                        <span class="text-[10px] text-slate-500 font-normal uppercase tracking-widest px-2 py-0.5 bg-slate-800 rounded">vs</span>
                                        <span class="text-lg">@game.HomeTeam</span>
                                    </div>
                                </div>

                                <div class="p-5 space-y-6">
                                    @* Odds Row *@
                                    <div class="flex justify-between gap-3">
                                        <div class="flex-1 bg-slate-800/50 rounded-lg p-2 text-center border border-slate-800 group-hover:bg-slate-800 transition-colors">
                                            <p class="text-[10px] text-slate-500 uppercase font-semibold mb-1">Away ML</p>
                                            <p class="font-mono text-white">@FormatOdds(game.AwayMoneyline)</p>
                                        </div>
                                        <div class="flex-1 bg-slate-800/50 rounded-lg p-2 text-center border border-slate-800 group-hover:bg-slate-800 transition-colors">
                                            <p class="text-[10px] text-slate-500 uppercase font-semibold mb-1">Home ML</p>
                                            <p class="font-mono text-white">@FormatOdds(game.HomeMoneyline)</p>
                                        </div>
                                    </div>

                                    @* Model Comparison *@
                                    <div class="space-y-3">
                                        <div class="grid grid-cols-4 text-[10px] text-slate-500 uppercase font-bold tracking-wider mb-1 px-1">
                                            <div class="col-span-1">Metric</div>
                                            <div class="text-center">Simple</div>
                                            <div class="text-center">XGB</div>
                                            <div class="text-center">CBS</div>
                                        </div>
                                        
                                        @* Win Prob Row *@
                                        <div class="grid grid-cols-4 items-center bg-slate-950/30 rounded-xl p-2.5 border border-slate-800/50">
                                            <div class="text-[11px] text-slate-300 font-medium">Win %</div>
                                            <div class="text-center text-emerald-400 font-bold text-xs">@(((game.SimpleModel?.HomeWinProb ?? 0) * 100).ToString("F1"))%</div>
                                            <div class="text-center text-blue-400 font-bold text-xs">
                                                @if (game.XgbModel?.Error == null) { @(((game.XgbModel?.HomeWinProb ?? 0) * 100).ToString("F1"))<span>%</span> }
                                                else { <span class="text-[8px] text-amber-500 uppercase tracking-tighter">Train Req</span> }
                                            </div>
                                            <div class="text-center text-slate-600 text-[10px]">
                                                —
                                            </div>
                                        </div>

                                        @* Pick Row *@
                                        @{
                                            var cbsPick = _expertPicks.FirstOrDefault(p => 
                                                p.HomeTeam.Contains(game.HomeTeam) || game.HomeTeam.Contains(p.HomeTeam));
                                        }
                                        <div class="grid grid-cols-4 items-center bg-slate-950/30 rounded-xl p-2.5 border border-slate-800/50">
                                            <div class="text-[11px] text-slate-300 font-medium text-xs">Pick</div>
                                            <div class="text-center text-emerald-500/80 font-semibold text-[10px] truncate">@((game.SimpleModel?.PredictedWinner ?? "—").Split(' ').Last())</div>
                                            <div class="text-center text-blue-500/80 font-semibold text-[10px] truncate">@((game.XgbModel?.PredictedWinner ?? "—").Split(' ').Last())</div>
                                            <div class="text-center text-amber-500/80 font-semibold text-[9px] truncate">
                                                @(cbsPick?.SpreadPickTeam != null ? $"{cbsPick.SpreadPickTeam} {cbsPick.SpreadValue?.ToString("+#.0;-#.0")}" : "—")
                                            </div>
                                        </div>

                                        @* EV Row *@
                                        <div class="grid grid-cols-4 items-center bg-slate-950/30 rounded-xl p-2.5 border border-slate-800/50">
                                            <div class="text-[11px] text-slate-300 font-medium">EV Home</div>
                                            <div class="text-center font-mono text-[11px] @(game.SimpleModel?.EvHome > 0 ? "text-emerald-400" : "text-red-400")">
                                                @(game.SimpleModel?.EvHome?.ToString("+0.00;-0.00") ?? "—")
                                            </div>
                                            <div class="text-center font-mono text-[11px] @(game.XgbModel?.EvHome > 0 ? "text-emerald-400" : "text-red-400")">
                                                @(game.XgbModel?.EvHome?.ToString("+0.00;-0.00") ?? "—")
                                            </div>
                                            <div class="text-center text-slate-600">—</div>
                                        </div>

                                        @* Kelly Row *@
                                        <div class="grid grid-cols-4 items-center bg-slate-950/30 rounded-xl p-2.5 border border-slate-800/50">
                                            <div class="text-[11px] text-slate-300 font-medium">Kelly %</div>
                                            <div class="text-center font-mono text-[11px] text-slate-300">@(game.SimpleModel?.KellyHome?.ToString("F1") ?? "—")%</div>
                                            <div class="text-center font-mono text-[11px] text-slate-300">@(game.XgbModel?.KellyHome?.ToString("F1") ?? "—")%</div>
                                            <div class="text-center text-slate-600">—</div>
                                        </div>

                                        @* O/U Row *@
                                        <div class="grid grid-cols-4 items-center bg-slate-950/30 rounded-xl p-2.5 border border-slate-800/50">
                                            <div class="text-[11px] text-slate-300 font-medium">O/U Line</div>
                                            <div class="text-center text-slate-600">—</div>
                                            <div class="text-center">
                                                @if (game.XgbModel?.OverUnder != null){
                                                    <TwChip Color="@(game.XgbModel.OverUnder.Pick == "OVER" ? "blue" : "purple")" Size="sm" Class="text-[9px] px-1 py-0">
                                                        @game.XgbModel.OverUnder.Pick @game.XgbModel.OverUnder.TotalLine
                                                    </TwChip>
                                                }
                                            </div>
                                            <div class="text-center">
                                                @if (cbsPick?.TotalPick != null) {
                                                    <span class="text-[9px] font-bold @(cbsPick.TotalPick == "Over" ? "text-emerald-400" : "text-amber-400")">
                                                        @(cbsPick.TotalPick.Substring(0,1)) @cbsPick.TotalValue?.ToString("F1")
                                                    </span>
                                                } else {
                                                    <span class="text-slate-600">—</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                    @* Agreement Badge *@
                                    @{
                                        var simpleWinner = game.SimpleModel?.PredictedWinner;
                                        var xgbWinner = game.XgbModel?.PredictedWinner;
                                        var modelsAgree = simpleWinner == xgbWinner && simpleWinner != null;
                                    }
                                    <div class="flex justify-center pt-2">
                                        @if (modelsAgree)
                                        {
                                            <TwChip Color="emerald" Size="sm" Class="w-full flex justify-center gap-2 py-1.5 shadow-lg shadow-emerald-900/10">
                                                <TwIcon Icon="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-4 h-4" />
                                                <span class="uppercase font-black tracking-tighter">Strong Signal: @simpleWinner</span>
                                            </TwChip>
                                        }
                                        else if (xgbWinner != null)
                                        {
                                            <TwChip Color="amber" Size="sm" Class="w-full flex justify-center gap-2 py-1.5">
                                                <TwIcon Icon="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" Class="w-4 h-4" />
                                                <span class="uppercase font-black tracking-tighter">Models Disagree</span>
                                            </TwChip>
                                        }
                                    </div>
                                </TwCard>
                        }
                    </TwGrid>
                }
                else if (!_isLoading)
                {
                    <div class="p-12 text-center bg-slate-900/50 border border-dashed border-slate-800 rounded-3xl">
                        <TwIcon Icon="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" Class="w-16 h-16 text-slate-700 mx-auto mb-4" />
                        <h3 class="text-xl font-bold text-slate-300 mb-2">Ready for Analysis</h3>
                        <p class="text-slate-500 max-w-sm mx-auto mb-8">Click "Analyze Games" to fetch today's NBA games and run predictions across all models.</p>
                        <TwButton Variant="primary" OnClick="@RunAnalysis">Start Analysis</TwButton>
                    </div>
                }
            </TwTabPanel>

            @* AI Predictions Tab *@
            <TwTabPanel Title="AI Predictions" TabIcon="@Icons.Material.Filled.Psychology">
                <div class="space-y-6">
                    <div class="bg-blue-600/10 border border-blue-600/20 rounded-xl p-4 flex items-center gap-3">
                        <TwIcon Icon="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-5 h-5 text-blue-400" />
                        <p class="text-sm text-blue-100">
                            <span class="font-bold">5 AI Engines:</span> Baseline, Linear (Ridge), Tree (XGBoost), MLP (Neural Net), Ensemble (Best)
                        </p>
                    </div>
                    
                    @if (_games.Any())
                    {
                        <div class="flex justify-start px-2">
                            <TwButton Variant="primary" OnClick="@LoadAllAiPredictions" IsLoading="_loadingAi" Disabled="@_loadingAi">
                                Load AI Predictions for All Games
                            </TwButton>
                        </div>
                        
                        <TwGrid Columns="1" md="2" Gap="6">
                            @foreach (var game in _games)
                            {
                                <TwCard Class="p-0 overflow-hidden bg-slate-900 border-slate-800 shadow-xl">
                                    @* AI Card Header *@
                                    <div class="bg-gradient-to-r from-indigo-900 to-blue-900 px-6 py-4 flex items-center justify-between">
                                        <h4 class="text-white font-bold tracking-tight">@game.AwayTeam @@ @game.HomeTeam</h4>
                                        @if (game.AiPredictions != null)
                                        {
                                            <TwChip Color="emerald" Size="sm" Class="font-bold text-[10px] uppercase">Ready</TwChip>
                                        }
                                    </div>

                                    <div class="p-6">
                                        @if (game.AiPredictions == null)
                                        {
                                            <div class="py-8 text-center bg-slate-950/30 rounded-2xl border border-slate-800">
                                                <TwButton Variant="secondary" OnClick="@(() => LoadAiPredictions(game))" IsLoading="_loadingAi">
                                                    Analyze with AI
                                                </TwButton>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="space-y-4">
                                                <div class="overflow-x-auto rounded-xl border border-slate-800">
                                                    <table class="w-full text-sm text-left">
                                                        <thead class="bg-slate-800/50 text-[10px] uppercase text-slate-500 font-bold">
                                                            <tr>
                                                                <th class="px-4 py-3">Engine</th>
                                                                <th class="px-4 py-3 text-center">Win %</th>
                                                                <th class="px-4 py-3 text-center">Margin</th>
                                                                <th class="px-4 py-3 text-right">Pick</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody class="divide-y divide-slate-800">
                                                            @foreach (var engine in new[] { "Baseline", "Linear", "Tree", "MLP", "Ensemble" })
                                                            {
                                                                var pred = GetAiEnginePrediction(game.AiPredictions, engine);
                                                                <tr class="@(engine == "Ensemble" ? "bg-blue-600/5 font-bold" : "") hover:bg-slate-800/30 transition-colors">
                                                                    <td class="px-4 py-3 flex items-center gap-2">
                                                                        @engine
                                                                        @if (engine == "Ensemble") { <span class="text-[8px] bg-blue-600 px-1.5 py-0.5 rounded text-white italic">Best</span> }
                                                                    </td>
                                                                    <td class="px-4 py-3 text-center @(pred.HomeWinProb > 0.5 ? "text-emerald-400" : "text-red-400")">
                                                                        @((pred.HomeWinProb * 100).ToString("F1"))%
                                                                    </td>
                                                                    <td class="px-4 py-3 text-center @(pred.Margin > 0 ? "text-emerald-400" : "text-red-400")">
                                                                        @pred.Margin.ToString("+0.0;-0.0")
                                                                    </td>
                                                                    <td class="px-4 py-3 text-right text-slate-200">
                                                                        @(pred.HomeWinProb > 0.5 ? game.HomeTeam : game.AwayTeam)
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                
                                                <div class="pt-2">
                                                    @if (game.GeminiAnalysis == null)
                                                    {
                                                        <TwButton Variant="primary" Class="w-full bg-indigo-600 hover:bg-indigo-500" OnClick="@(() => GetGeminiAnalysis(game))" IsLoading="game.IsGeneratingAi">
                                                            <TwIcon Icon="M13 10V3L4 14h7v7l9-11h-7z" Class="w-4 h-4 mr-2" />
                                                            Get AI Rationale
                                                        </TwButton>
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-2xl border border-slate-700 overflow-hidden shadow-2xl shadow-indigo-900/10">
                                                            @* Rationale Header *@
                                                            <div class="bg-indigo-950/80 px-4 py-3 flex items-center justify-between border-b border-indigo-900/50">
                                                                <div class="flex items-center gap-2">
                                                                    <TwIcon Icon="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.364-6.364l.707.707M6.636 10.07l.2.2m5.071 8.01a5 5 0 01-6.105-6.105c.133-.395.133-.822 0-1.217C5.07 9.123 5.483 8 7 8h10c1.517 0 1.93 1.123 1.105 2.848a5 5 0 01-6.105 6.105z" Class="w-5 h-5 text-indigo-400" />
                                                                    <span class="text-sm font-bold text-white">AI Insight: @game.GeminiAnalysis.LlmInsight?.Winner</span>
                                                                </div>
                                                                <TwChip Color="purple" Size="sm" Class="font-black text-[10px]">@(game.GeminiAnalysis.LlmInsight?.Confidence)% Confidence</TwChip>
                                                            </div>
                                                            
                                                            @* Rationale Content *@
                                                            <div class="p-5 bg-slate-900/80 text-sm leading-relaxed text-slate-300">
                                                                <div class="mb-4 flex gap-3 p-3 bg-amber-500/5 border border-amber-500/10 rounded-xl">
                                                                    <TwIcon Icon="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-5 h-5 text-amber-400 shrink-0" />
                                                                    <p class="text-[12px] italic"><span class="font-bold text-amber-400">Key Factor:</span> @game.GeminiAnalysis.LlmInsight?.KeyFactor</p>
                                                                </div>
                                                                
                                                                <div class="prose prose-invert prose-sm max-w-none">
                                                                    @((MarkupString)(game.GeminiAnalysis.LlmInsight?.Rationale ?? ""))
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </TwCard>
                            }
                        </TwGrid>
                    }
                    else
                    {
                        <div class="p-12 text-center bg-slate-900/50 border border-dashed border-slate-800 rounded-3xl">
                            <TwIcon Icon="M13 10V3L4 14h7v7l9-11h-7z" Class="w-16 h-16 text-slate-700 mx-auto mb-4" />
                            <h3 class="text-xl font-bold text-slate-300 mb-2">NBA Games Required</h3>
                            <p class="text-slate-500 max-w-sm mx-auto">Load games from the "Games" tab first, then switch here for detailed AI predictions and rationale.</p>
                        </div>
                    }
                </div>
            </TwTabPanel>
            
            @* ESPN BPI Tab *@
            <TwTabPanel Title="ESPN BPI" TabIcon="@Icons.Material.Filled.Analytics">
                <div class="space-y-6">
                    <div class="bg-gradient-to-r from-blue-700 to-blue-800 rounded-2xl p-6 shadow-xl shadow-blue-900/10 flex flex-col md:flex-row justify-between items-center gap-4">
                        <div>
                            <h3 class="text-xl font-bold text-white flex items-center gap-3">
                                <TwIcon Icon="M12 2a10 10 0 1010 10A10 10 0 0012 2zm0 18a8 8 0 118-8 8 8 0 01-8 8z" Class="w-6 h-6" />
                                ESPN BPI Predictions
                            </h3>
                            <p class="text-blue-100/70 text-sm mt-1">Basketball Power Index • External "Second Opinion"</p>
                        </div>
                        <TwButton Variant="primary" Class="bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold" OnClick="LoadEspnData" IsLoading="_espnLoading" Disabled="@_espnLoading">
                            @(_espnLoading ? "Loading..." : "Load ESPN Data")
                        </TwButton>
                    </div>

                    @if (_espnError != null)
                    {
                        <TwAlert Severity="error">@_espnError</TwAlert>
                    }

                    @if (_espnLoading)
                    {
                        <TwProgressBar Value="100" IsIndeterminate="true" Color="blue" />
                    }
                    else if (_espnGames.Any())
                    {
                        <TwGrid Columns="1" md="2" lg="3" Gap="6">
                            @foreach (var game in _espnGames)
                            {
                                <TwCard Class="p-5 bg-slate-900 border-slate-800 hover:border-blue-500/30 transition-all">
                                    <div class="flex items-center justify-between mb-4">
                                        <div class="flex flex-col">
                                            <span class="text-white font-bold text-sm">@game.AwayTeam</span>
                                            <span class="text-[10px] text-slate-500">@game.AwayRecord</span>
                                        </div>
                                        <span class="text-[10px] text-slate-600 font-bold px-2">@@</span>
                                        <div class="flex flex-col text-right">
                                            <span class="text-white font-bold text-sm">@game.HomeTeam</span>
