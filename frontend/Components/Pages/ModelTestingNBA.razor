    // AI Engine Predictions
    private async Task LoadAiPredictions(GamePrediction game)
    {
        _loadingAi = true;
        StateHasChanged();
        
        try
        {
            var homePpg = game.HomeStats?.GetValueOrDefault("ppg") ?? game.HomeStats?.GetValueOrDefault("PTS") ?? 110;
            var awayPpg = game.AwayStats?.GetValueOrDefault("ppg") ?? game.AwayStats?.GetValueOrDefault("PTS") ?? 108;
            var homeFg = game.HomeStats?.GetValueOrDefault("fg_pct") ?? game.HomeStats?.GetValueOrDefault("FG_PCT") ?? 0.47;
            var awayFg = game.AwayStats?.GetValueOrDefault("fg_pct") ?? game.AwayStats?.GetValueOrDefault("FG_PCT") ?? 0.46;
            var homeOppPpg = game.HomeStats?.GetValueOrDefault("opp_ppg") ?? 112;
            var awayOppPpg = game.AwayStats?.GetValueOrDefault("opp_ppg") ?? 112;
            var homeWinPct = game.HomeStats?.GetValueOrDefault("win_pct") ?? game.HomeStats?.GetValueOrDefault("W_PCT") ?? 0.5;
            var awayWinPct = game.AwayStats?.GetValueOrDefault("win_pct") ?? game.AwayStats?.GetValueOrDefault("W_PCT") ?? 0.5;
            
            // Call NBA_AI integration endpoint (uses cloned repo from https://github.com/NBA-Betting/NBA_AI)
            var url = $"http://backend:8000/nba/ai/integration/predictions?home_team={Uri.EscapeDataString(game.HomeTeam)}&away_team={Uri.EscapeDataString(game.AwayTeam)}&home_ppg={homePpg}&away_ppg={awayPpg}&home_opp_ppg={homeOppPpg}&away_opp_ppg={awayOppPpg}&home_fg_pct={homeFg}&away_fg_pct={awayFg}&home_win_pct={homeWinPct}&away_win_pct={awayWinPct}";
            var response = await Http.GetAsync(url);
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                game.AiPredictions = JsonDocument.Parse(json).RootElement;
                Snackbar.Add($"AI predictions loaded for {game.HomeTeam} vs {game.AwayTeam}", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to load AI predictions", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        
        _loadingAi = false;
        StateHasChanged();
    }

    private record AiEnginePredResult(double HomeWinProb, double Margin);

    private AiEnginePredResult GetAiEnginePrediction(JsonElement? aiPredictions, string engine)
    {
        if (aiPredictions == null) return new AiEnginePredResult(0.5, 0);
        
        try
        {
            if (aiPredictions.Value.TryGetProperty("predictions", out var preds) &&
                preds.TryGetProperty(engine, out var enginePred))
            {
                var prob = enginePred.TryGetProperty("home_win_prob", out var p) ? p.GetDouble() : 0.5;
                var margin = enginePred.TryGetProperty("margin", out var m) ? m.GetDouble() : 0;
                return new AiEnginePredResult(prob, margin);
            }
        }
        catch { }
        
        return new AiEnginePredResult(0.5, 0);
    }

    private async Task LoadAllAiPredictions()
    {
        _loadingAi = true;
        StateHasChanged();
        
        foreach (var game in _games)
        {
            if (game.AiPredictions == null)
            {
                await LoadAiPredictions(game);
                await Task.Delay(100); // Small delay to avoid overwhelming the backend
            }
        }
        
        _loadingAi = false;
        Snackbar.Add($"AI predictions loaded for all {_games.Count} games!", Severity.Success);
        StateHasChanged();
    }

    private async Task GetGeminiAnalysis(GamePrediction game)
    {
        game.IsGeneratingAi = true;
        StateHasChanged();
        
        try
        {
            // Prepare stats for Gemini
            var homeStats = JsonSerializer.Serialize(game.HomeStats);
            var awayStats = JsonSerializer.Serialize(game.AwayStats);
            
            var result = await MLServiceClient.GetAiAnalysisAsync("nba", game.HomeTeam, game.AwayTeam, homeStats, awayStats);
            if (result != null)
            {
                game.GeminiAnalysis = result;
                Snackbar.Add($"Gemini analysis complete for {game.HomeTeam}", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gemini Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            game.IsGeneratingAi = false;
            StateHasChanged();
        }
    }

    // ESPN BPI Methods
    private async Task LoadEspnData()
    {
        _espnLoading = true;
        _espnError = null;
        _espnGames.Clear();
        StateHasChanged();

        try
        {
            var resp = await Http.GetAsync("http://backend:8000/espn/nba");
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadAsStringAsync();
                var doc = JsonDocument.Parse(json);
                
                if (doc.RootElement.TryGetProperty("games", out var gamesArray))
                {
                    foreach (var game in gamesArray.EnumerateArray())
                    {
                        _espnGames.Add(new EspnGame
                        {
                            EventId = game.GetProperty("event_id").GetString() ?? "",
                            HomeTeam = game.GetProperty("home_team").GetString() ?? "",
                            AwayTeam = game.GetProperty("away_team").GetString() ?? "",
                            HomeAbbrev = game.GetProperty("home_abbrev").GetString() ?? "",
                            AwayAbbrev = game.GetProperty("away_abbrev").GetString() ?? "",
                            HomeRecord = game.GetProperty("home_record").GetString() ?? "",
                            AwayRecord = game.GetProperty("away_record").GetString() ?? "",
                            Status = game.GetProperty("status").GetString() ?? "",
                            HomeWinProb = game.GetProperty("home_win_prob").GetDouble(),
                            AwayWinProb = game.GetProperty("away_win_prob").GetDouble(),
                            TotalOverProb = game.GetProperty("total_over_prob").GetDouble(),
                            SpreadCoverHomeProb = game.GetProperty("spread_cover_home_prob").GetDouble(),
                            HasBpi = game.GetProperty("has_bpi").GetBoolean()
                        });
                    }
                }

                if (_espnGames.Count == 0)
                {
                    _espnError = "No NBA games found in ESPN data.";
                }
                else
                {
                    Snackbar.Add($"Loaded ESPN BPI for {_espnGames.Count} games", Severity.Success);
                }
            }
            else
            {
                _espnError = $"Failed to load ESPN data: {resp.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _espnError = $"Error: {ex.Message}";
        }

        _espnLoading = false;
        StateHasChanged();
    }

    private string GetTailwindEspnStatusColor(string status)
    {
        if (status.Contains("Final")) return "emerald";
        if (status.Contains("progress") || status.Contains("Half") || status.Contains("Q")) return "amber";
        return "blue";
    }

    private record EspnGame
    {
        public string EventId { get; init; } = "";
        public string HomeTeam { get; init; } = "";
        public string AwayTeam { get; init; } = "";
        public string HomeAbbrev { get; init; } = "";
        public string AwayAbbrev { get; init; } = "";
        public string HomeRecord { get; init; } = "";
        public string AwayRecord { get; init; } = "";
        public string Status { get; init; } = "";
        public double HomeWinProb { get; init; }
        public double AwayWinProb { get; init; }
        public double TotalOverProb { get; init; }
        public double SpreadCoverHomeProb { get; init; }
        public bool HasBpi { get; init; }
    };
    private string FormatOdds(int? odds) => odds switch
    {
        null => "-",
        > 0 => $"+{odds}",
        _ => odds.ToString() ?? "-"
    };

    private async Task SaveAllToCache()
    {
        if (!_games.Any()) return;

        _isSavingAll = true;
        StateHasChanged();
        
        int successCount = 0;

        try
        {
            // Save in parallel for speed
            var tasks = _games.Select(async game => 
            {
                var analysisData = new Dictionary<string, object>
                {
                    ["consensus_winner"] = game.XgbModel?.PredictedWinner ?? game.SimpleModel?.PredictedWinner ?? game.HomeTeam,
                    ["win_prob"] = game.XgbModel?.HomeWinProb ?? game.SimpleModel?.HomeWinProb ?? 0.5,
                    ["simple_prob"] = game.SimpleModel?.HomeWinProb ?? 0,
                    ["xgb_prob"] = game.XgbModel?.HomeWinProb ?? 0,
                    ["ev_home"] = game.XgbModel?.EvHome ?? 0,
                    ["kelly_home"] = game.XgbModel?.KellyHome ?? 0
                };
                
                if (game.GeminiAnalysis?.LlmInsight != null)
                {
                    analysisData["ai_rationale"] = game.GeminiAnalysis.LlmInsight.Rationale;
                    analysisData["ai_key_factor"] = game.GeminiAnalysis.LlmInsight.KeyFactor;
                    analysisData["ai_confidence"] = game.GeminiAnalysis.LlmInsight.Confidence;
                    analysisData["ai_winner"] = game.GeminiAnalysis.LlmInsight.Winner;
                }

                if (await MLServiceClient.SaveAnalysisAsync("nba", game.HomeTeam, game.AwayTeam, analysisData))
                {
                    System.Threading.Interlocked.Increment(ref successCount);
                }
            });

            await Task.WhenAll(tasks);
            
            if (successCount == _games.Count)
                Snackbar.Add($"All {successCount} games saved to daily cache!", Severity.Success);
            else
                Snackbar.Add($"Saved {successCount}/{_games.Count} games to cache.", Severity.Warning);

        }
        catch (Exception ex)
        {
             Snackbar.Add($"Error saving snapshot: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSavingAll = false;
            StateHasChanged();
        }
    }
}

