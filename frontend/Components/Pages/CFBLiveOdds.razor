@page "/cfb-live-odds"
@using System.Text.Json
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ILogger<CFBLiveOdds> Logger
@inject PythonMLServiceClient MLServiceClient
@rendermode InteractiveServer

<PageTitle>CFB Live Odds</PageTitle>

<TwContainer>
    <!-- Loading Overlay for Analysis -->
    <TwLoadingOverlay 
        IsVisible="@_isLoading"
        Title="Analyzing Matches..."
        Color="blue"
        CurrentStatusMessage="@_analysisStatus"
        ShowProgress="false" />

    <div class="flex flex-col gap-6">
        <!-- Header & Loading Status -->
        <TwCard Class="p-1 relative overflow-hidden">
            <div class="p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                <div>
                    <h1 class="text-3xl font-bold text-white flex items-center gap-3">
                        <svg class="w-8 h-8 text-blue-500" fill="currentColor" viewBox="0 0 24 24"><path d="M5.14,2C4.33,2,3.65,2.5,3.31,3.23L1.13,7.96C1.04,8.19,1,8.43,1,8.68V11c0,0.55,0.45,1,1,1h1c0,3.31,2.69,6,6,6c0.55,0,1,0.45,1,1v1h2v-1c0-0.55,0.45-1,1-1c3.31,0,6-2.69,6-6h1c0.55,0,1-0.45,1-1V8.68c0-0.25-0.04-0.49-0.13-0.72l-2.18-4.73C17.35,2.5,16.67,2,15.86,2H5.14z M17,11h-1v-1h1V11z M5,11H4v-1h1V11z M12,14c-1.66,0-3-1.34-3-3s1.34-3,3-3s3,1.34,3,3S13.66,14,12,14z"></path></svg>
                        CFB Live Odds
                        @if (_isLoading)
                        {
                            <span class="text-xs font-normal text-blue-400 animate-pulse ml-2 flex items-center gap-1">
                                <span class="block w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                                Fetching live odds...
                            </span>
                        }
                    </h1>
                    <p class="text-slate-400 mt-1">College Football predictions with value detection.</p>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <TwSelect TValue="string" @bind-Value="_selectedSportsbook" Label="Sportsbook" Class="w-40">
                        <option value="fanduel">FanDuel</option>
                        <option value="draftkings">DraftKings</option>
                        <option value="betmgm">BetMGM</option>
                    </TwSelect>
                    <TwButton Variant="primary" StartIcon="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" 
                              OnClick="@RunAnalysis" IsLoading="@_isLoading" Disabled="@_isLoading">
                        Analyze Games
                    </TwButton>
                </div>
            </div>
        </TwCard>

        @if (_error != null)
        {
            <TwAlert Severity="error">@_error</TwAlert>
        }

        <TwApiQuotaTracker />

        @if (_games.Any())
        {
            <div class="bg-slate-900/50 border border-slate-800 rounded-xl px-4 py-3 flex justify-between items-center">
                <span class="text-slate-300">
                    <strong class="text-white">@_games.Count</strong> games found · 
                    <strong class="text-blue-400">@_valueBets</strong> value bets detected
                </span>
                <TwChip Color="blue" Variant="outline" Size="sm">@_source</TwChip>
            </div>
        }

        @if (_games.Any())
        {
            <TwGrid Columns="1" ColumnsMd="2" ColumnsLg="3" Gap="6">
                @foreach (var game in _games)
                {
                    <TwCard NoPadding="true" Class="flex flex-col h-full border-t-4" Style="@(game.HasValue ? "border-t-blue-500" : "border-t-slate-800")">
                        <div class="p-5 border-b border-slate-800 bg-slate-900/40">
                            <div class="flex justify-between items-start mb-1">
                                <div class="flex flex-col">
                                    <span class="text-lg font-bold text-white">@game.AwayTeam</span>
                                    <span class="text-[10px] text-slate-500 uppercase tracking-widest my-0.5">at</span>
                                    <span class="text-lg font-bold text-white">@game.HomeTeam</span>
                                </div>
                                @if (game.HasValue)
                                {
                                    <TwChip Color="emerald" Size="xs">VALUE</TwChip>
                                }
                            </div>
                        </div>

                        <div class="p-5 flex-1 space-y-4">
                            <!-- Odds Table -->
                            <div class="rounded-lg border border-slate-800 overflow-hidden text-xs">
                                    <TwTable TItem="object">
                                    <TwTr>
                                        <TwTd Class="bg-slate-900/20 font-medium text-slate-400">Moneyline</TwTd>
                                        <TwTd Class="text-right">@FormatOdds(game.HomeMoneyline) / @FormatOdds(game.AwayMoneyline)</TwTd>
                                    </TwTr>
                                    @if (game.Spread.HasValue)
                                    {
                                        <TwTr>
                                            <TwTd Class="bg-slate-900/20 font-medium text-slate-400">Spread</TwTd>
                                            <TwTd Class="text-right">@game.Spread.Value.ToString("+0.0;-0.0")</TwTd>
                                        </TwTr>
                                    }
                                    @if (game.OverUnder.HasValue)
                                    {
                                        <TwTr>
                                            <TwTd Class="bg-slate-900/20 font-medium text-slate-400">O/U</TwTd>
                                            <TwTd Class="text-right">@game.OverUnder.Value</TwTd>
                                        </TwTr>
                                    }
                                </TwTable>
                            </div>

                            <!-- Predictions -->
                            <div class="space-y-3">
                                <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Model Predictions</h4>
                                <div class="rounded-lg border border-slate-800 overflow-hidden text-xs">
                                    <TwTable TItem="object">
                                        <TwTr Class="bg-slate-900/40">
                                            <TwTh Class="text-[10px] py-1">Model</TwTh>
                                            <TwTh Class="text-[10px] py-1">Winner</TwTh>
                                            <TwTh Class="text-[10px] py-1 text-right">Total</TwTh>
                                        </TwTr>
                                        <TwTr>
                                            <TwTd>Simple Stats</TwTd>
                                            <TwTd>
                                                @if (game.Prediction != null)
                                                {
                                                    <span class="font-bold @(game.Prediction.HomeWinProbability > 0.5 ? "text-emerald-500" : "text-red-500")">
                                                        @(game.Prediction.HomeWinProbability > 0.5 ? "Home" : "Away")
                                                    </span>
                                                    <span class="text-slate-500 text-[10px]"> @(game.Prediction.HomeWinProbability.ToString("P0"))</span>
                                                }
                                                else { <span>-</span> }
                                            </TwTd>
                                            <TwTd Class="text-right font-medium">@(game.Prediction?.PredictedTotal.ToString("F1") ?? "-")</TwTd>
                                        </TwTr>
                                        <TwTr>
                                            <TwTd>XGBoost (ML)</TwTd>
                                            <TwTd colspan="2" Class="text-center italic text-slate-500 py-1">Coming Soon</TwTd>
                                        </TwTr>
                                    </TwTable>
                                </div>
                            </div>

                            <!-- AI Analysis -->
                            <div>
                                @if (game.GeminiAnalysis == null)
                                {
                                    <TwButton Variant="outline" Size="sm" Class="w-full"
                                              StartIcon="M13 10V3L4 14h7v7l9-11h-7z"
                                              OnClick="@(() => GetGeminiAnalysis(game))" IsLoading="@game.IsAnalyzing" Disabled="@game.IsAnalyzing">
                                        AI Rationale
                                    </TwButton>
                                }
                                else
                                {
                                    <div class="mt-2 p-3 rounded-lg bg-blue-500/5 border border-blue-500/10 space-y-2">
                                        <div class="flex items-center gap-2 text-blue-400">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
                                            <span class="text-xs font-bold uppercase tracking-wider">AI Rationale</span>
                                        </div>
                                        <div class="text-xs text-slate-400 leading-relaxed">
                                            @((MarkupString)(game.GeminiAnalysis.LlmInsight?.Rationale ?? ""))
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </TwCard>
                }
            </TwGrid>
        }
        else if (!_isLoading)
        {
            <TwAlert Severity="info">
                No College Football games found for today. Click "Analyze Games" to fetch live odds.
            </TwAlert>
        }
    </div>
</TwContainer>

@code {
    private bool _isLoading = false;
    private string? _error = null;
    private string _selectedSportsbook = "fanduel";
    private List<GameData> _games = new();
    private int _valueBets = 0;
    private string _source = "";
    private string _analysisStatus = "🏈 Studying the playbook...";

    private async Task RunAnalysis()
    {
        _isLoading = true;
        _error = null;
        _games.Clear();
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync(
                $"http://backend:8000/odds/cfb/analyze-all?sportsbook={_selectedSportsbook}", 
                null);
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var doc = JsonDocument.Parse(json);
                var root = doc.RootElement;

                if (root.TryGetProperty("error", out var err))
                {
                    _error = err.GetString();
                }
                else
                {
                    _source = root.TryGetProperty("source", out var src) ? src.GetString() ?? "" : "";
                    _valueBets = root.TryGetProperty("value_bets_found", out var vb) ? vb.GetInt32() : 0;

                    if (root.TryGetProperty("games", out var gamesArr))
                    {
                        foreach (var g in gamesArr.EnumerateArray())
                        {
                            _games.Add(ParseGame(g));
                        }
                    }
                }
            }
            else
            {
                _error = $"API Error: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
            Logger.LogError(ex, "Error fetching CFB odds");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private GameData ParseGame(JsonElement g)
    {
        var game = new GameData
        {
            HomeTeam = g.TryGetProperty("home_team", out var h) ? h.GetString() ?? "" : "",
            AwayTeam = g.TryGetProperty("away_team", out var a) ? a.GetString() ?? "" : "",
            HasValue = g.TryGetProperty("has_value", out var hv) && hv.GetBoolean(),
        };

        if (g.TryGetProperty("home_moneyline", out var hml) && hml.ValueKind == JsonValueKind.Number)
            game.HomeMoneyline = (int)Math.Round(hml.GetDouble());
        if (g.TryGetProperty("away_moneyline", out var aml) && aml.ValueKind == JsonValueKind.Number)
            game.AwayMoneyline = (int)Math.Round(aml.GetDouble());
        if (g.TryGetProperty("spread", out var sp) && sp.ValueKind == JsonValueKind.Number)
            game.Spread = sp.GetDecimal();
        if (g.TryGetProperty("over_under", out var ou) && ou.ValueKind == JsonValueKind.Number)
            game.OverUnder = ou.GetDecimal();

        if (g.TryGetProperty("simple_model", out var pred) && pred.ValueKind == JsonValueKind.Object)
        {
            game.Prediction = new PredictionData
            {
                PredictedWinner = pred.TryGetProperty("predicted_winner", out var pw) ? pw.GetString() ?? "" : "",
                HomeWinProbability = pred.TryGetProperty("home_win_probability", out var hwp) ? hwp.GetDouble() : 0.5,
                PredictedTotal = pred.TryGetProperty("predicted_total", out var pt) ? pt.GetDouble() : 0,
                Confidence = pred.TryGetProperty("confidence", out var c) ? c.GetDouble() : 0.5,
                OuPick = pred.TryGetProperty("ou_pick", out var oup) ? oup.GetString() ?? "" : "",
            };
        }

        return game;
    }

    private string FormatOdds(int? odds) => odds switch
    {
        null => "-",
        > 0 => $"+{odds}",
        _ => odds.ToString() ?? "-"
    };

    private class GameData
    {
        public string HomeTeam { get; set; } = "";
        public string AwayTeam { get; set; } = "";
        public int? HomeMoneyline { get; set; }
        public int? AwayMoneyline { get; set; }
        public decimal? Spread { get; set; }
        public decimal? OverUnder { get; set; }
        public bool HasValue { get; set; }
        public PredictionData? Prediction { get; set; }
        public AiAnalysisReport? GeminiAnalysis { get; set; }
        public bool IsAnalyzing { get; set; }
    }

    private class PredictionData
    {
        public string PredictedWinner { get; set; } = "";
        public double HomeWinProbability { get; set; }
        public double PredictedTotal { get; set; }
        public double Confidence { get; set; }
        public string OuPick { get; set; } = "";
    }

    private async Task GetGeminiAnalysis(GameData game)
    {
        game.IsAnalyzing = true;
        StateHasChanged();

        try
        {
            var result = await MLServiceClient.GetAiAnalysisAsync("cfb", game.HomeTeam, game.AwayTeam);
            if (result != null)
            {
                game.GeminiAnalysis = result;
                Snackbar.Add($"Gemini insight loaded for {game.HomeTeam}", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gemini Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            game.IsAnalyzing = false;
            StateHasChanged();
        }
    }
}
