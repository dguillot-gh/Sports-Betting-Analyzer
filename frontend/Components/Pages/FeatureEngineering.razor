@page "/feature-engineering"
@using SportsBettingAnalyzer.Services
@using System.Text.Json
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@inject PythonMLServiceClient MLService
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<PageTitle>Feature Engineering</PageTitle>

<TwContainer MaxWidth="extraLarge" Class="mt-8">
    <div class="space-y-6">
        <!-- Header -->
        <TwCard Class="p-6">
             <div class="flex items-center gap-4">
                <div class="p-3 bg-cyan-500/10 rounded-xl">
                    <TwIcon Name="auto_fix_high" Class="w-8 h-8 text-cyan-500" />
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-slate-100">Feature Engineering Pipeline</h1>
                    <p class="text-slate-400">Manage and enhance your data with advanced predictive features</p>
                </div>
            </div>
        </TwCard>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
            <!-- Control Panel -->
            <div class="md:col-span-4 space-y-6">
                <!-- Actions -->
                <TwCard Class="p-6 h-full">
                    <h3 class="font-bold text-slate-100 mb-2">Actions</h3>
                    <p class="text-sm text-slate-400 mb-6">Run the enhancement pipeline to calculate new features (e.g., career stats, rolling averages) for all NASCAR series.</p>
                    
                    @if (_isEnhancing)
                    {
                         <div class="bg-blue-500/10 border border-blue-500/30 p-4 rounded-xl text-center">
                            <TwProgressBar Indeterminate="true" Color="blue" Height="h-1" Class="mb-3" />
                            <p class="text-blue-400 text-sm font-medium">Processing data...</p>
                        </div>
                    }
                    else
                    {
                        <TwButton Variant="solid" Color="cyan" FullWidth="true" OnClick="RunEnhancement">
                            <div class="flex items-center justify-center gap-2 py-1">
                                <TwIcon Name="auto_fix_high" />
                                <span>Run Feature Enhancement</span>
                            </div>
                        </TwButton>
                    }
                    
                    @if (!string.IsNullOrEmpty(_lastRunMessage))
                    {
                        <div class="mt-4">
                            <TwAlert Severity="@(_lastRunSuccess ? "success" : "error")">
                                @_lastRunMessage
                            </TwAlert>
                             @if (_lastRunSuccess && _enhancedSeries.Any())
                            {
                                <div class="mt-2 space-y-1">
                                    @foreach (var seriesName in _enhancedSeries)
                                    {
                                        <div class="flex items-center gap-2 text-sm text-emerald-400">
                                            <TwIcon Name="check_circle" Class="w-4 h-4" />
                                            <span class="font-bold uppercase">@seriesName Enhanced</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </TwCard>
                
                <!-- Info -->
                <TwCard Class="p-6">
                     <h3 class="font-bold text-slate-100 mb-4">Pipeline Info</h3>
                     <div class="space-y-4">
                         <div class="flex items-center gap-3 text-slate-400">
                             <TwIcon Name="source" Class="text-slate-500" />
                             <span class="text-sm">Input: Raw .rda files (data/nascar/raw)</span>
                         </div>
                         <div class="flex items-center gap-3 text-slate-400">
                             <TwIcon Name="output" Class="text-slate-500" />
                             <span class="text-sm">Output: Enhanced .csv files (data/nascar)</span>
                         </div>
                          <div class="flex items-center gap-3 text-slate-400">
                             <TwIcon Name="functions" Class="text-slate-500" />
                             <span class="text-sm">Features: 27+ New Contextual Features</span>
                         </div>
                          <div class="flex items-center gap-3 text-slate-400">
                             <TwIcon Name="filter_alt" Class="text-slate-500" />
                             <span class="text-sm">Filter: Modern Era (2012-2025)</span>
                         </div>
                     </div>
                </TwCard>
            </div>
            
            <!-- Data Preview -->
             <div class="md:col-span-8">
                 <TwCard Class="p-6 h-full">
                     <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                         <h3 class="font-bold text-slate-100">Data Preview</h3>
                         
                         <div class="flex gap-2 flex-col md:flex-row">
                             <div class="w-full md:w-32">
                                <TwSelect TValue="int?" Value="@_selectedSeason" ValueChanged="OnSeasonChanged" Label="Season" FullWidth="true">
                                    <option value="">All</option>
                                    @for (int year = DateTime.Now.Year + 1; year >= 2012; year--)
                                    {
                                        <option value="@year">@year</option>
                                    }
                                </TwSelect>
                             </div>
                             <div class="w-full md:w-40">
                                 <TwSelect TValue="string" Value="@_selectedTrackType" ValueChanged="OnTrackTypeChanged" Label="Track Type" FullWidth="true">
                                     <option value="">All Types</option>
                                     @foreach (var type in _trackTypes)
                                     {
                                         <option value="@type">@type</option>
                                     }
                                 </TwSelect>
                             </div>
                              <div class="relative w-full md:w-48">
                                <label class="block text-xs text-slate-500 mb-1 font-medium">Driver</label>
                                <input type="text" @bind="_driverFilter" @bind:event="oninput" @onkeyup="@(async (e) => { if (e.Key == "Enter") await OnDriverFilterChanged(_driverFilter); })" placeholder="Search..." class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-cyan-500" />
                            </div>
                         </div>
                     </div>
                     
                     <TwTabs DefaultTab="0">
                         <TwTabPanel Title="Cup Series" OnClick="@(() => LoadData("cup"))">
                             <div class="pt-4">
                                <TwTable TItem="Dictionary<string, object>" Items="@_cupData" IsLoading="@_isLoadingData">
                                    <HeaderContent>
                                        @foreach (var col in _displayColumns) { <TwTh>@col</TwTh> }
                                    </HeaderContent>
                                    <RowTemplate Context="row">
                                         @foreach (var col in _displayColumns) { <TwTd>@row.GetValueOrDefault(col, "")</TwTd> }
                                    </RowTemplate>
                                </TwTable>
                                <!-- Simple pagination/limit indicator -->
                                <div class="flex justify-between items-center mt-4 text-xs text-slate-500 border-t border-slate-800 pt-4">
                                    <span>Showing top 100 rows. Total: @_totalRows</span>
                                </div>
                             </div>
                         </TwTabPanel>
                         
                         <TwTabPanel Title="Xfinity Series" OnClick="@(() => LoadData("xfinity"))">
                             <div class="pt-4">
                                  <TwTable TItem="Dictionary<string, object>" Items="@_cupData" IsLoading="@_isLoadingData">
                                    <HeaderContent>
                                        @foreach (var col in _displayColumns) { <TwTh>@col</TwTh> }
                                    </HeaderContent>
                                    <RowTemplate Context="row">
                                         @foreach (var col in _displayColumns) { <TwTd>@row.GetValueOrDefault(col, "")</TwTd> }
                                    </RowTemplate>
                                </TwTable>
                                 <div class="flex justify-between items-center mt-4 text-xs text-slate-500 border-t border-slate-800 pt-4">
                                    <span>Showing top 100 rows. Total: @_totalRows</span>
                                </div>
                             </div>
                         </TwTabPanel>
                         
                         <TwTabPanel Title="Truck Series" OnClick="@(() => LoadData("truck"))">
                             <div class="pt-4">
                                  <TwTable TItem="Dictionary<string, object>" Items="@_cupData" IsLoading="@_isLoadingData">
                                    <HeaderContent>
                                        @foreach (var col in _displayColumns) { <TwTh>@col</TwTh> }
                                    </HeaderContent>
                                    <RowTemplate Context="row">
                                         @foreach (var col in _displayColumns) { <TwTd>@row.GetValueOrDefault(col, "")</TwTd> }
                                    </RowTemplate>
                                </TwTable>
                                 <div class="flex justify-between items-center mt-4 text-xs text-slate-500 border-t border-slate-800 pt-4">
                                    <span>Showing top 100 rows. Total: @_totalRows</span>
                                </div>
                             </div>
                         </TwTabPanel>
                     </TwTabs>
                 </TwCard>
             </div>
        </div>
    </div>
</TwContainer>

@code {
    private bool _isEnhancing = false;
    private bool _lastRunSuccess = false;
    private string _lastRunMessage = "";
    private List<string> _enhancedSeries = new();

    private bool _isLoadingData = false;
    private List<Dictionary<string, object>> _cupData = new();
    private List<string> _displayColumns = new();
    private int _totalRows = 0;
    private string _currentSeries = "cup";
    private int? _selectedSeason = null;
    private string? _selectedTrackType = null;
    private string? _driverFilter = null;
    
    private readonly List<string> _trackTypes = new() { "Short Track", "Speedway", "Superspeedway", "Road Course", "Dirt" };

    protected override async Task OnInitializedAsync()
    {
        await LoadData("cup");
    }

    private async Task OnSeasonChanged(int? season)
    {
        _selectedSeason = season;
        await LoadData(_currentSeries);
    }

    private async Task OnTrackTypeChanged(string? trackType)
    {
        _selectedTrackType = trackType;
        if (string.IsNullOrEmpty(trackType)) _selectedTrackType = null;
        await LoadData(_currentSeries);
    }

    private async Task OnDriverFilterChanged(string? driver)
    {
        _driverFilter = driver;
        await LoadData(_currentSeries);
    }

    private async Task RunEnhancement()
    {
        _isEnhancing = true;
        _lastRunMessage = "";
        _enhancedSeries = new();
        StateHasChanged();

        try
        {
            var result = await MLService.EnhanceDataAsync("nascar");
            
            if (result.Success)
            {
                _lastRunSuccess = true;
                _lastRunMessage = result.Message ?? "Enhancement completed successfully!";
                _enhancedSeries = result.SeriesEnhanced ?? new List<string>();
                Snackbar.Add("Data Enhancement Successful", Severity.Success);
                await LoadData(_currentSeries);
            }
            else
            {
                _lastRunSuccess = false;
                _lastRunMessage = result.Message ?? "Enhancement failed.";
                Snackbar.Add("Data Enhancement Failed", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _lastRunSuccess = false;
             _lastRunMessage = $"Error: {ex.Message}";
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isEnhancing = false;
            StateHasChanged();
        }
    }

    private async Task LoadData(string series)
    {
        _currentSeries = series;
        _isLoadingData = true;
        StateHasChanged(); // Force update

        try
        {
            var data = await MLService.GetDataAsync(
                "nascar", 
                limit: 100, 
                series: series, 
                seasonMin: _selectedSeason, 
                seasonMax: _selectedSeason, 
                trackType: _selectedTrackType, 
                driver: _driverFilter
            ); 
            
            if (data != null && data.Rows.Count > 0)
            {
                _cupData = data.Rows;
                _totalRows = data.TotalRows;
                
                var allCols = data.Columns;
                var priorityCols = new[] { "year", "race_num", "driver", "finishing_position", "start", "track", "career_wins", "avg_finish_last_5" };
                
                _displayColumns = priorityCols.Where(c => allCols.Contains(c)).ToList();
                foreach(var col in allCols.Take(5))
                {
                    if (!_displayColumns.Contains(col)) _displayColumns.Add(col);
                }
            }
            else
            {
                _cupData = new();
                _totalRows = 0;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _isLoadingData = false;
             StateHasChanged();
        }
    }
}
