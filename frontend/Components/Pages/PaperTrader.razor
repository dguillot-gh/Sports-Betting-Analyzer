@page "/paper-trading"
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using SportsBettingAnalyzer.Services
@using SportsBettingAnalyzer.Models
@using SportsBettingAnalyzer.Components.Shared.Tailwind

<PageTitle>Paper Trading</PageTitle>

<TwContainer MaxWidth="extraLarge" Class="pa-4 mt-8">
    <div class="space-y-6">
        <!-- Header -->
        <div class="p-6 rounded-xl shadow-lg bg-gradient-to-br from-indigo-900 to-slate-900 text-white border border-indigo-500/30">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                <div>
                    <h1 class="text-3xl font-bold flex items-center gap-3">
                        <svg class="w-8 h-8 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                        Paper Trading
                    </h1>
                    <p class="text-indigo-300 text-sm mt-1">Mock trades and CLV performance tracking.</p>
                </div>
                <div class="flex items-center gap-3">
                    <TwChip Color="indigo" Size="sm" Variant="solid">Paper Account</TwChip>
                    <TwChip Color="@(_netProfit >= 0 ? "emerald" : "red")" Size="lg" Variant="outline" Class="font-bold">
                        @(_netProfit >= 0 ? "+" : "")$@_netProfit.ToString("F2")
                    </TwChip>
                </div>
            </div>
        </div>

        <!-- Stats Overview -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <TwStatCard Label="ROI" Value="@($"{(_roi >= 0 ? "+" : "")}{_roi:F1}%")" Color="@(_roi >= 0 ? "emerald" : "red")" />
            <TwStatCard Label="Avg CLV Edge" Value="@($"{(_avgClv >= 0 ? "+" : "")}{_avgClv:F1}%")" Color="@(_avgClv >= 0 ? "indigo" : "amber")" />
            <TwStatCard Label="Win Rate" Value="@($"{_winRate:F1}%")" Color="blue" />
            <TwStatCard Label="Total Mock Bets" Value="@_totalBets.ToString()" Color="slate" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
            <!-- Mock Bet Slip (Simplified for Paper Trading) -->
            <div class="md:col-span-12">
                <TwCard>
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-lg font-bold text-white flex items-center gap-2">
                             Quick Mock Entry
                        </h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
                        <div class="md:col-span-3">
                            <TwInput @bind-Value="_entryDesc" Label="Description" Placeholder="Ex: Lakers ML" FullWidth="true" />
                        </div>
                        <div class="md:col-span-2">
                            <div class="relative w-full">
                                <label class="block text-xs text-slate-500 mb-1 font-medium">Odds</label>
                                <input type="number" @bind="_entryOdds" class="appearance-none bg-slate-800 text-sm text-slate-100 border border-slate-700 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-transparent transition-all placeholder-slate-500 w-full" />
                            </div>
                        </div>
                        <div class="md:col-span-2">
                            <div class="relative w-full">
                                <label class="block text-xs text-slate-500 mb-1 font-medium">Stake</label>
                                <div class="relative">
                                    <div class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-500">$</div>
                                    <input type="number" @bind="_entryStake" class="appearance-none bg-slate-800 text-sm text-slate-100 border border-slate-700 rounded-xl px-4 py-2.5 pl-7 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-transparent transition-all placeholder-slate-500 w-full" />
                                </div>
                            </div>
                        </div>
                        <div class="md:col-span-3">
                             <TwSelect TValue="string" @bind-Value="_entrySport" Label="Sport" FullWidth="true">
                                <option value="nba">NBA</option>
                                <option value="nfl">NFL</option>
                                <option value="nhl">NHL</option>
                                <option value="nascar">NASCAR</option>
                            </TwSelect>
                        </div>
                        <div class="md:col-span-2">
                             <TwButton Variant="primary" FullWidth="true" OnClick="PlaceMockBet" Disabled="@(string.IsNullOrWhiteSpace(_entryDesc) || _entryStake <= 0)" Class="py-3 bg-indigo-600 hover:bg-indigo-700">
                                Place Mock
                            </TwButton>
                        </div>
                    </div>
                </TwCard>
            </div>

            <!-- Paper Trade History -->
            <div class="md:col-span-12">
                <TwCard>
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-lg font-bold text-white">Paper Trade History</h2>
                        <div class="flex gap-2">
                            <TwButton Size="sm" Variant="outline" OnClick="LoadMockBets" StartIcon="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15">Refresh</TwButton>
                        </div>
                    </div>

                    @if (_loading)
                    {
                        <TwProgressBar Indeterminate="true" Color="indigo" />
                    }
                    else if (_bets.Any())
                    {
                        <div class="overflow-x-auto rounded-lg border border-slate-800">
                            <table class="w-full text-sm text-left text-slate-300">
                                <thead class="text-xs text-slate-400 uppercase bg-slate-900">
                                    <tr>
                                        <th class="px-4 py-3">Date</th>
                                        <th class="px-4 py-3">Selection</th>
                                        <th class="px-4 py-3">Stake</th>
                                        <th class="px-4 py-3">Odds</th>
                                        <th class="px-4 py-3">CLV Edge</th>
                                        <th class="px-4 py-3">Result</th>
                                        <th class="px-4 py-3 text-right">Profit</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-800 bg-slate-900/30">
                                    @foreach (var b in _bets)
                                    {
                                        <tr class="hover:bg-slate-800/50 transition-colors">
                                            <td class="px-4 py-3 text-xs text-slate-500">
                                                @DateTime.Parse(b.CreatedAt).ToString("MM/dd HH:mm")
                                            </td>
                                            <td class="px-4 py-3">
                                                <div class="font-medium text-white">@b.Description</div>
                                                <div class="text-xs text-slate-500">@b.Sport.ToUpper() @(b.GameName ?? "")</div>
                                            </td>
                                            <td class="px-4 py-3">$@b.Stake.ToString("F2")</td>
                                            <td class="px-4 py-3">@FormatOdds(b.Odds)</td>
                                            <td class="px-4 py-3">
                                                @if (b.ClvPercent.HasValue)
                                                {
                                                    <span class="flex items-center gap-1 @(b.ClvPercent >= 0 ? "text-indigo-400" : "text-amber-500")">
                                                        @(b.ClvPercent >= 0 ? "+" : "")@b.ClvPercent.Value.ToString("F1")%
                                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                                                    </span>
                                                }
                                                else if (b.Outcome == "pending")
                                                {
                                                    <span class="text-slate-600 text-xs italic">Pending Close</span>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-600">-</span>
                                                }
                                            </td>
                                            <td class="px-4 py-3">
                                                @if (b.Outcome == "pending")
                                                {
                                                    <TwChip Color="slate" Size="xs" Variant="outline">Pending</TwChip>
                                                }
                                                else
                                                {
                                                    <TwChip Color="@(b.Outcome == "win" ? "emerald" : "red")" Size="xs" Variant="solid">
                                                        @b.Outcome.ToUpper()
                                                    </TwChip>
                                                }
                                            </td>
                                            <td class="px-4 py-3 text-right font-bold @(b.Profit >= 0 ? "text-emerald-400" : "text-red-400")">
                                                @if (b.Outcome != "pending")
                                                {
                                                    @((b.Profit >= 0 ? "+" : "") + "$" + b.Profit.Value.ToString("F2"))
                                                }
                                                else
                                                {
                                                    <span class="text-slate-600 font-normal">--</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-12 bg-slate-900/50 rounded-lg border-2 border-dashed border-slate-800">
                             <p class="text-slate-500 italic">No paper trades recorded yet.</p>
                             <TwButton Variant="link" OnClick="@(() => _entryDesc = "Example NBA Bet")">Create your first mock trade</TwButton>
                        </div>
                    }
                </TwCard>
            </div>
        </div>
    </div>
</TwContainer>

@code {
    private bool _loading = false;
    private List<PaperBet> _bets = new();
    
    // Quick entry state
    private string _entryDesc = "";
    private int _entryOdds = -110;
    private decimal _entryStake = 100;
    private string _entrySport = "nba";
    
    // Stats
    private decimal _netProfit = 0;
    private decimal _roi = 0;
    private decimal _avgClv = 0;
    private decimal _winRate = 0;
    private int _totalBets = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadMockBets();
        await LoadStats();
    }

    private async Task LoadMockBets()
    {
        _loading = true;
        try
        {
            // Filter by is_mock=true
            var content = await Http.GetStringAsync("http://backend:8000/bets?is_mock=true&limit=100");
            using var doc = JsonDocument.Parse(content);
            if (doc.RootElement.TryGetProperty("bets", out var arr))
            {
                _bets.Clear();
                foreach (var b in arr.EnumerateArray())
                {
                    _bets.Add(new PaperBet
                    {
                        Id = b.GetProperty("id").GetInt32(),
                        CreatedAt = b.GetProperty("created_at").GetString() ?? "",
                        Description = b.GetProperty("description").GetString() ?? "",
                        Stake = b.GetProperty("stake").GetDecimal(),
                        Odds = b.GetProperty("odds").GetInt32(),
                        Outcome = b.GetProperty("outcome").GetString() ?? "pending",
                        GameName = b.TryGetProperty("game_name", out var gn) ? gn.GetString() : null,
                        Sport = b.GetProperty("sport").GetString() ?? "unknown",
                        Profit = b.TryGetProperty("profit", out var p) && p.ValueKind != JsonValueKind.Null ? p.GetDecimal() : null,
                        ClvPercent = b.TryGetProperty("clv_percent", out var clv) && clv.ValueKind != JsonValueKind.Null ? (double)clv.GetDecimal() : null
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading mock bets: {ex.Message}", Severity.Error);
        }
        _loading = false;
    }

    private async Task LoadStats()
    {
        try
        {
            var resp = await Http.GetFromJsonAsync<JsonElement>("http://backend:8000/bets/stats/summary?is_mock=true");
            _totalBets = resp.TryGetProperty("total_bets", out var total) ? total.GetInt32() : 0;
            var wins = resp.TryGetProperty("wins", out var w) ? w.GetInt32() : 0;
            var losses = resp.TryGetProperty("losses", out var l) ? l.GetInt32() : 0;
            _netProfit = resp.TryGetProperty("net_profit", out var p) && p.ValueKind == JsonValueKind.Number ? p.GetDecimal() : 0;
            
            var totalDecided = wins + losses;
            _winRate = totalDecided > 0 ? (wins * 100m / totalDecided) : 0;
            
            var totalStake = resp.TryGetProperty("total_stake", out var ts) && ts.ValueKind == JsonValueKind.Number ? ts.GetDecimal() : 0;
            _roi = totalStake > 0 ? (_netProfit * 100m / totalStake) : 0;

            // Average CLV calculation from loaded bets
            var clvBets = _bets.Where(b => b.ClvPercent.HasValue).ToList();
            _avgClv = clvBets.Any() ? (decimal)clvBets.Average(b => b.ClvPercent.Value) : 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stats: {ex.Message}");
        }
    }

    private async Task PlaceMockBet()
    {
        try
        {
            var req = new
            {
                sport = _entrySport,
                bet_type = "single",
                sportsbook = "paper",
                stake = _entryStake,
                odds = _entryOdds,
                description = _entryDesc,
                is_mock = true,
                source = "manual"
            };
            
            var resp = await Http.PostAsJsonAsync("http://backend:8000/bets", req);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Mock trade placed!", Severity.Success);
                _entryDesc = "";
                await LoadMockBets();
                await LoadStats();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private string FormatOdds(int odds) => odds > 0 ? $"+{odds}" : odds.ToString();

    public class PaperBet
    {
        public int Id { get; set; }
        public string CreatedAt { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Stake { get; set; }
        public int Odds { get; set; }
        public string Outcome { get; set; } = "pending";
        public string? GameName { get; set; }
        public string Sport { get; set; } = "";
        public decimal? Profit { get; set; }
        public double? ClvPercent { get; set; }
    }
}
