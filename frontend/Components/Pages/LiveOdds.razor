@page "/live-odds-old"
@* DEPRECATED: Routes moved to ModelTestingNBA.razor - use /live-nba-odds *@
@rendermode InteractiveServer
@using MudBlazor
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Live NBA Odds - Sports Betting Analyzer</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="mb-4">
        <MudTabPanel Text="Live Analysis" Icon="@Icons.Material.Filled.Analytics">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex align-center justify-space-between flex-wrap" style="gap: 16px;">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.SportsBasketball" Size="Size.Large" Color="Color.Primary" Class="mr-3" />
                    <div>
                        <MudText Typo="Typo.h5">Live NBA Odds & Predictions</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Real-time odds with model analysis</MudText>
                    </div>
                </div>
                
                <div class="d-flex align-center" style="gap: 12px;">
                    <MudSelect T="string" @bind-Value="_selectedSportsbook" Label="Sportsbook" Dense="true"
                               Variant="Variant.Outlined" Style="min-width: 160px;">
                        @foreach (var book in _sportsbooks)
                        {
                            <MudSelectItem Value="@book">@FormatBookName(book)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="RefreshOdds" 
                               Disabled="_isLoading" StartIcon="@Icons.Material.Filled.Refresh">
                        Refresh
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="RunAnalysis" 
                               Disabled="_isLoading || !_games.Any()" StartIcon="@Icons.Material.Filled.Analytics">
                        @if (_isAnalyzing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Run Analysis
                    </MudButton>
                    <MudTooltip Text="Train XGBoost ML model using TimeSeriesSplit cross-validation (5-fold). Prevents 'data leaking' by only training on past games. Simple model uses expert rules, XGBoost learns patterns from historical data.">
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="TrainModel"
                                   Disabled="_isTraining" StartIcon="@Icons.Material.Filled.ModelTraining">
                            @if (_isTraining)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Train XGB
                        </MudButton>
                    </MudTooltip>
                </div>
            </div>
        </MudPaper>

        @if (_isLoading || _isAnalyzing)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }

        <!-- Value Bets Summary -->
        @if (_analyzedGames.Any(g => g.HasValue))
        {
            <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.Whatshot">
                <strong>@_analyzedGames.Count(g => g.HasValue) Value Bet(s) Found!</strong>
                @foreach (var game in _analyzedGames.Where(g => g.HasValue))
                {
                    <MudText Typo="Typo.body2">
                        @game.AwayTeam @@ @game.HomeTeam: @string.Join(", ", game.ValueBets)
                    </MudText>
                }
            </MudAlert>
        }

        @if (_analyzedGames.Any())
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                @_analyzedGames.Count games analyzed for @DateTime.Today.ToString("MMM dd, yyyy") via @FormatBookName(_selectedSportsbook)
            </MudText>
            
            <MudGrid>
                @foreach (var game in _analyzedGames)
                {
                    <MudItem xs="12" md="6">
                        <MudCard Elevation="3" Style="@(game.HasValue ? "border-left: 4px solid #4caf50;" : "")">
                            <MudCardHeader Style="padding-bottom: 8px;">
                                <CardHeaderContent>
                                    <div class="d-flex justify-space-between align-center">
                                        <div class="text-center" style="flex: 1;">
                                            <MudText Typo="Typo.h6">@game.AwayTeam</MudText>
                                            <MudText Typo="Typo.caption">@(game.AwayWinProbability.HasValue ? $"{(game.AwayWinProbability.Value * 100):F0}%" : "")</MudText>
                                        </div>
                                        <div class="mx-2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">@@</MudText>
                                        </div>
                                        <div class="text-center" style="flex: 1;">
                                            <MudText Typo="Typo.h6">@game.HomeTeam</MudText>
                                            <MudText Typo="Typo.caption">@(game.HomeWinProbability.HasValue ? $"{(game.HomeWinProbability.Value * 100):F0}%" : "")</MudText>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(game.PredictedWinner))
                                    {
                                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mt-2">
                                            Pick: @game.PredictedWinner (@game.ConfidenceLevel)
                                        </MudChip>
                                    }
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Style="padding-top: 0;">
                                <MudDivider Class="mb-3" />
                                <MudGrid Spacing="2">
                                    <!-- Moneyline -->
                                    <MudItem xs="4">
                                        <MudText Typo="Typo.overline" Color="Color.Secondary">MONEYLINE</MudText>
                                        <div class="d-flex flex-column">
                                            <MudText Typo="Typo.body2">@game.AwayTeam: @FormatOdds(game.AwayMoneyline)</MudText>
                                            <MudText Typo="Typo.body2">@game.HomeTeam: @FormatOdds(game.HomeMoneyline)</MudText>
                                        </div>
                                        @if (game.MlValue)
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small">
                                                @game.MlPick +@(game.HomeMlEdge)%
                                            </MudChip>
                                        }
                                    </MudItem>
                                    
                                    <!-- Spread -->
                                    <MudItem xs="4">
                                        <MudText Typo="Typo.overline" Color="Color.Secondary">SPREAD</MudText>
                                        <MudText Typo="Typo.body1">@(game.Spread.HasValue ? FormatSpread(game.Spread.Value) : "N/A")</MudText>
                                        @if (game.SpreadValue)
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small">
                                                @game.SpreadPick @(game.SpreadEdge > 0 ? "+" : "")@game.SpreadEdge
                                            </MudChip>
                                        }
                                        else if (!string.IsNullOrEmpty(game.SpreadPick))
                                        {
                                            <MudText Typo="Typo.caption">Pick: @game.SpreadPick</MudText>
                                        }
                                    </MudItem>
                                    
                                    <!-- O/U -->
                                    <MudItem xs="4">
                                        <MudText Typo="Typo.overline" Color="Color.Secondary">O/U TOTAL</MudText>
                                        <MudText Typo="Typo.body1">@(game.OverUnder.HasValue ? game.OverUnder.Value.ToString() : "N/A")</MudText>
                                        @if (game.OuValue)
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small">
                                                @game.OuPick @(game.OuEdge > 0 ? "+" : "")@game.OuEdge
                                            </MudChip>
                                        }
                                        else if (!string.IsNullOrEmpty(game.OuPick))
                                        {
                                            <MudText Typo="Typo.caption">Pick: @game.OuPick</MudText>
                                        }
                                    </MudItem>
                                </MudGrid>
                                
                                <!-- Model Prediction Details -->
                                @if (game.PredictedTotal.HasValue)
                                {
                                    <MudDivider Class="my-2" />
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.caption">
                                            Pred Total: <strong>@game.PredictedTotal</strong>
                                        </MudText>
                                        <MudText Typo="Typo.caption">
                                            Pred Margin: <strong>@(game.PredictedMargin > 0 ? "+" : "")@game.PredictedMargin</strong>
                                        </MudText>
                                    </div>
                                }
                                
                                <!-- Side-by-Side Model Comparison -->
                                @if (game.XgbModel != null)
                                {
                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">MODEL COMPARISON</MudText>
                                    <MudSimpleTable Dense="true" Hover="true" Style="background: transparent;">
                                        <thead>
                                            <tr>
                                                <th></th>
                                                <th>Simple</th>
                                                <th>XGBoost</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td><MudText Typo="Typo.caption">Home Win%</MudText></td>
                                                <td><strong>@(((game.HomeWinProbability ?? 0) * 100).ToString("F0"))%</strong></td>
                                                <td>
                                                    @if (game.XgbModel.HomeWinProb.HasValue)
                                                    {
                                                        <strong style="color: #2196f3;">@((game.XgbModel.HomeWinProb.Value * 100).ToString("F0"))%</strong>
                                                    }
                                                    else
                                                    {
                                                        <span style="color: gray;">N/A</span>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <td><MudText Typo="Typo.caption">Pick</MudText></td>
                                                <td>@game.PredictedWinner</td>
                                                <td style="color: #2196f3;">@(game.XgbModel.PredictedWinner ?? "N/A")</td>
                                            </tr>
                                        </tbody>
                                    </MudSimpleTable>
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
        else if (_games.Any() && !_isAnalyzing)
        {
            <!-- Show basic odds before analysis -->
            <MudAlert Severity="Severity.Info" Class="mb-3">
                Click <strong>Run Analysis</strong> to get predictions and value bet recommendations!
            </MudAlert>
            <MudGrid>
                @foreach (var game in _games)
                {
                    <MudItem xs="12" md="6" lg="4">
                        <MudCard Elevation="2">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <div class="d-flex justify-space-between align-center">
                                        <MudText Typo="Typo.h6">@game.AwayTeam</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@@</MudText>
                                        <MudText Typo="Typo.h6">@game.HomeTeam</MudText>
                                    </div>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudGrid>
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.overline" Color="Color.Secondary">MONEYLINE</MudText>
                                        <div class="d-flex justify-space-between">
                                            <MudChip T="string" Color="@GetOddsColor(game.AwayMoneyline)" Size="Size.Small">
                                                @game.AwayTeam: @FormatOdds(game.AwayMoneyline)
                                            </MudChip>
                                            <MudChip T="string" Color="@GetOddsColor(game.HomeMoneyline)" Size="Size.Small">
                                                @game.HomeTeam: @FormatOdds(game.HomeMoneyline)
                                            </MudChip>
                                        </div>
                                    </MudItem>
                                    @if (game.Spread.HasValue)
                                    {
                                        <MudItem xs="6">
                                            <MudText Typo="Typo.overline" Color="Color.Secondary">SPREAD</MudText>
                                            <MudText Typo="Typo.body1">@FormatSpread(game.Spread.Value)</MudText>
                                        </MudItem>
                                    }
                                    @if (game.OverUnder.HasValue)
                                    {
                                        <MudItem xs="6">
                                            <MudText Typo="Typo.overline" Color="Color.Secondary">O/U</MudText>
                                            <MudText Typo="Typo.body1">@game.OverUnder.Value</MudText>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
        else if (!_isLoading)
        {
            <MudAlert Severity="Severity.Info">
                No NBA games scheduled for today. Check back later!
            </MudAlert>
        }

        <!-- Kelly Calculator -->
        <MudExpansionPanels>
            <MudExpansionPanel Text="Kelly Criterion Calculator" Icon="@Icons.Material.Filled.Calculate">
                <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
                    <strong>How to use:</strong> The Kelly Criterion calculates optimal bet sizing based on your edge vs the market.
                    <ol class="mt-2 mb-0" style="padding-left: 20px;">
                        <li><strong>Win Probability</strong> - Your estimated chance the bet wins (0.55 = 55%)</li>
                        <li><strong>American Odds</strong> - The sportsbook line (e.g., -110 for favorites, +150 for underdogs)</li>
                        <li><strong>Bankroll</strong> - Your total betting budget</li>
                    </ol>
                    <MudText Typo="Typo.caption" Class="mt-2">
                        💡 Tip: After running analysis above, use the model's predicted win probability from a game card.
                    </MudText>
                </MudAlert>
                <MudGrid>
                    <MudItem xs="12" md="3">
                        <MudTooltip Text="Your model's predicted probability (0-1). Example: 0.60 = 60% chance">
                            <MudNumericField @bind-Value="_kellyWinProb" Label="Win Probability" 
                                            Min="0" Max="1" Step="0.01" Format="P0"
                                            HelperText="0.55 = 55%"
                                            Variant="Variant.Outlined" />
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTooltip Text="Sportsbook odds. Negative = favorite (-110), Positive = underdog (+150)">
                            <MudNumericField @bind-Value="_kellyOdds" Label="American Odds"
                                            HelperText="-110 or +150"
                                            Variant="Variant.Outlined" />
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTooltip Text="Your total betting budget">
                            <MudNumericField @bind-Value="_kellyBankroll" Label="Bankroll"
                                            Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                                            HelperText="Total budget"
                                            Variant="Variant.Outlined" />
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="12" md="3" Class="d-flex align-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="CalculateKelly">
                            Calculate
                        </MudButton>
                    </MudItem>
                </MudGrid>
                
                @if (_kellyResult != null)
                {
                    <MudPaper Class="pa-4 mt-3" Elevation="1" Style="background: var(--mud-palette-background-default);">
                        <MudGrid>
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.overline" Color="Color.Secondary">IMPLIED PROB</MudText>
                                <MudText Typo="Typo.h6">@(_kellyResult.ImpliedProbability)%</MudText>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.overline" Color="Color.Secondary">MODEL EDGE</MudText>
                                <MudText Typo="Typo.h6" Color="@(_kellyResult.ModelEdge > 0 ? Color.Success : Color.Error)">
                                    @(_kellyResult.ModelEdge > 0 ? "+" : "")@(_kellyResult.ModelEdge)%
                                </MudText>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.overline" Color="Color.Secondary">RECOMMENDED BET</MudText>
                                <MudText Typo="Typo.h6" Color="Color.Primary">$@(_kellyResult.RecommendedBet)</MudText>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.overline" Color="Color.Secondary">% OF BANKROLL</MudText>
                                <MudText Typo="Typo.h6">@(_kellyResult.BetPercentage)%</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                }
            </MudExpansionPanel>
            
            <!-- Hot/Cold Players Edge Section -->
            <MudExpansionPanel Text="🔥 Hot & Cold Players" Icon="@Icons.Material.Filled.TrendingUp">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                    Players performing above/below their season average
                </MudText>
                
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadEdgeData" 
                           Disabled="_isLoadingEdge" Class="mb-3">
                    @if (_isLoadingEdge)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Load Hot/Cold Players
                </MudButton>
                
                @if (_edgeData != null)
                {
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudPaper Class="pa-3" Elevation="1" Style="border-left: 3px solid #4caf50;">
                                <MudText Typo="Typo.subtitle2">🔥 Hot Players</MudText>
                                @foreach (var player in _edgeData.HotPlayers.Take(5))
                                {
                                    <div class="d-flex justify-space-between align-center py-1">
                                        <MudText Typo="Typo.body2"><strong>@player.Player</strong> (@player.Team)</MudText>
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small">+@player.EdgeScore</MudChip>
                                    </div>
                                }
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudPaper Class="pa-3" Elevation="1" Style="border-left: 3px solid #f44336;">
                                <MudText Typo="Typo.subtitle2">❄️ Cold Players</MudText>
                                @foreach (var player in _edgeData.ColdPlayers.Take(5))
                                {
                                    <div class="d-flex justify-space-between align-center py-1">
                                        <MudText Typo="Typo.body2"><strong>@player.Player</strong> (@player.Team)</MudText>
                                        <MudChip T="string" Color="Color.Error" Size="Size.Small">@player.EdgeScore</MudChip>
                                    </div>
                                }
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                }
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudStack>
        </MudTabPanel>
        
        <!-- History Tab -->
        <MudTabPanel Text="Today's History" Icon="@Icons.Material.Filled.History" BadgeData="@_analysisHistory.Count" BadgeColor="Color.Primary">
            <MudPaper Class="pa-4" Elevation="2">
                <div class="d-flex justify-space-between align-center mb-3">
                    <MudText Typo="Typo.h6">Analysis History - @DateTime.Today.ToString("MMM dd, yyyy")</MudText>
                    <div class="d-flex" style="gap: 8px;">
                        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Success" OnClick="SyncGameResults" 
                                   Disabled="@(_isSyncingResults || !_analysisHistory.Any(h => string.IsNullOrEmpty(h.Result)))" 
                                   StartIcon="@Icons.Material.Filled.Sync">
                            @if (_isSyncingResults) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                            Sync Results
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="RefreshClosingLines" 
                                   Disabled="@_isRefreshingLines" StartIcon="@Icons.Material.Filled.Update">
                            @if (_isRefreshingLines) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                            Update Lines
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ClearHistory" 
                                   Disabled="@(!_analysisHistory.Any())" StartIcon="@Icons.Material.Filled.Delete">
                            Clear
                        </MudButton>
                    </div>
                </div>
                
                @if (_analysisHistory.Any())
                {
                    <MudSimpleTable Dense="true" Hover="true" Style="font-size: 0.85rem;">
                        <thead>
                            <tr style="background: var(--mud-palette-surface);">
                                <th>Time</th>
                                <th>Matchup</th>
                                <th>Pick</th>
                                <th>Win%</th>
                                <th>O/U (Open→Close)</th>
                                <th>Spread</th>
                                <th>Value?</th>
                                <th>Stake</th>
                                <th>Result</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in _analysisHistory.OrderByDescending(e => e.AnalyzedAt))
                            {
                                <tr>
                                    <td>@entry.AnalyzedAt.ToString("HH:mm")</td>
                                    <td><strong>@entry.AwayTeam</strong> @@ <strong>@entry.HomeTeam</strong></td>
                                    <td><MudChip T="string" Color="Color.Primary" Size="Size.Small">@entry.Pick</MudChip></td>
                                    <td>@entry.WinProbability%</td>
                                    <td>
                                        @if (entry.OpeningOU.HasValue && entry.ClosingOU.HasValue && entry.OpeningOU != entry.ClosingOU)
                                        {
                                            var movement = entry.ClosingOU.Value - entry.OpeningOU.Value;
                                            var color = movement > 0 ? "green" : "red";
                                            <span>@entry.OpeningOU → <span style="color: @color; font-weight: bold;">@entry.ClosingOU</span></span>
                                        }
                                        else
                                        {
                                            <span>@entry.OuPick</span>
                                        }
                                    </td>
                                    <td>@entry.SpreadPick</td>
                                    <td>
                                        @if (entry.HasValue)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                        }
                                    </td>
                                    <td>
                                        <MudNumericField T="double" @bind-Value="entry.Stake" 
                                                         Variant="Variant.Text" Margin="Margin.Dense"
                                                         Style="width: 70px;" Min="0" Step="10" />
                                    </td>
                                    <td>
                                        <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined">
                                            <MudButton Color="@(entry.Result == "W" ? Color.Success : Color.Default)" 
                                                       OnClick="@(() => MarkResult(entry, "W"))">W</MudButton>
                                            <MudButton Color="@(entry.Result == "L" ? Color.Error : Color.Default)" 
                                                       OnClick="@(() => MarkResult(entry, "L"))">L</MudButton>
                                            <MudButton Color="@(entry.Result == "P" ? Color.Warning : Color.Default)" 
                                                       OnClick="@(() => MarkResult(entry, "P"))">P</MudButton>
                                        </MudButtonGroup>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    
                    <MudPaper Class="pa-3 mt-3" Elevation="1" Style="background: var(--mud-palette-background-grey);">
                        <MudGrid Spacing="2">
                            <MudItem xs="6" md="2">
                                <MudText Typo="Typo.overline" Color="Color.Secondary">ANALYZED</MudText>
                                <MudText Typo="Typo.h6">@_analysisHistory.Count</MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText Typo="Typo.overline" Color="Color.Secondary">VALUE BETS</MudText>
                                <MudText Typo="Typo.h6">@_analysisHistory.Count(h => h.HasValue)</MudText>
                            </MudItem>
                            <MudItem xs="4" md="2">
                                <MudText Typo="Typo.overline" Color="Color.Secondary">RECORD</MudText>
                                <MudText Typo="Typo.h6" Color="@GetRecordColor()">@GetWins()-@GetLosses()-@GetPushes()</MudText>
                            </MudItem>
                            <MudItem xs="4" md="2">
                                <MudText Typo="Typo.overline" Color="Color.Secondary">WIN RATE</MudText>
                                <MudText Typo="Typo.h6">@GetWinRate()</MudText>
                            </MudItem>
                            <MudItem xs="4" md="2">
                                <MudText Typo="Typo.overline" Color="Color.Secondary">STAKED</MudText>
                                <MudText Typo="Typo.h6">$@GetTotalStaked().ToString("F0")</MudText>
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudText Typo="Typo.overline" Color="Color.Secondary">ROI</MudText>
                                <MudText Typo="Typo.h6" Color="@GetRoiColor()">@GetRoiDisplay()</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                }
                else
                {
                    <MudAlert Severity="Severity.Info">No analyses yet today. Run analysis on the Live Analysis tab!</MudAlert>
                }
            </MudPaper>
        </MudTabPanel>
        
        <!-- Compare Books Tab (NEW) -->
        <MudTabPanel Text="Compare Books" Icon="@Icons.Material.Filled.CompareArrows">
            <MudPaper Class="pa-4" Elevation="2">
                <div class="d-flex justify-space-between align-center mb-4">
                    <div>
                        <MudText Typo="Typo.h6">FanDuel vs DraftKings</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Find the best line for maximum value</MudText>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadOddsComparison" 
                               Disabled="@_isLoadingComparison" StartIcon="@Icons.Material.Filled.Refresh">
                        @if (_isLoadingComparison) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                        Load Comparison
                    </MudButton>
                </div>
                
                @if (_comparisonGames.Any())
                {
                    <MudSimpleTable Dense="true" Hover="true" Striped="true">
                        <thead>
                            <tr style="background: var(--mud-palette-surface);">
                                <th>Game</th>
                                <th colspan="2" style="text-align: center; background: #1976D2; color: white;">FanDuel</th>
                                <th colspan="2" style="text-align: center; background: #388E3C; color: white;">DraftKings</th>
                                <th>Best Line</th>
                            </tr>
                            <tr>
                                <th></th>
                                <th>Home ML</th>
                                <th>Away ML</th>
                                <th>Home ML</th>
                                <th>Away ML</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var game in _comparisonGames)
                            {
                                <tr>
                                    <td><strong>@game.Game</strong></td>
                                    <td style="@(game.BestHomeML == "fanduel" ? "background: #E3F2FD; font-weight: bold;" : "")">
                                        @FormatOdds(game.FanDuelHomeML)
                                    </td>
                                    <td style="@(game.BestAwayML == "fanduel" ? "background: #E3F2FD; font-weight: bold;" : "")">
                                        @FormatOdds(game.FanDuelAwayML)
                                    </td>
                                    <td style="@(game.BestHomeML == "draftkings" ? "background: #E8F5E9; font-weight: bold;" : "")">
                                        @FormatOdds(game.DraftKingsHomeML)
                                    </td>
                                    <td style="@(game.BestAwayML == "draftkings" ? "background: #E8F5E9; font-weight: bold;" : "")">
                                        @FormatOdds(game.DraftKingsAwayML)
                                    </td>
                                    <td>
                                        @if (game.BestHomeML != "same" || game.BestAwayML != "same")
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                                ★ @(game.BestHomeML == "fanduel" || game.BestAwayML == "fanduel" ? "FD" : "DK") better
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Same</MudText>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    
                    <MudAlert Severity="Severity.Info" Class="mt-4">
                        <strong>Tip:</strong> Highlighted cells show the better odds. Always bet at the book with the best line!
                    </MudAlert>
                }
                else if (!_isLoadingComparison)
                {
                    <MudAlert Severity="Severity.Normal">
                        Click "Load Comparison" to see FanDuel vs DraftKings odds side-by-side.
                    </MudAlert>
                }
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private int _activeTab = 0;
    private bool _isLoading = false;
    private bool _isAnalyzing = false;
    private bool _isTraining = false;
    private string _errorMessage = "";
    private string _selectedSportsbook = "fanduel";
    private List<string> _sportsbooks = new() { "fanduel", "draftkings", "betmgm", "pointsbet", "caesars" };
    private List<GameOdds> _games = new();
    private List<AnalyzedGame> _analyzedGames = new();
    
    // History tracking
    private List<AnalysisHistoryEntry> _analysisHistory = new();
    
    // Kelly Calculator
    private double _kellyWinProb = 0.55;
    private int _kellyOdds = -110;
    private double _kellyBankroll = 1000;
    private KellyResult? _kellyResult;
    
    // Edge Predictions
    private bool _isLoadingEdge = false;
    private EdgeResponse? _edgeData;

    protected override async Task OnInitializedAsync()
    {
        await RefreshOdds();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadHistoryFromStorage();
            StateHasChanged();
        }
    }
    
    private async Task LoadHistoryFromStorage()
    {
        try
        {
            var saved = await JS.InvokeAsync<string>("localStorage.getItem", "nba_analysis_history");
            var savedDate = await JS.InvokeAsync<string>("localStorage.getItem", "nba_analysis_date");
            
            // Auto-clear if it's a new day
            var today = DateTime.Today.ToString("yyyy-MM-dd");
            if (savedDate != today)
            {
                // New day - clear old data
                await JS.InvokeVoidAsync("localStorage.removeItem", "nba_analysis_history");
                await JS.InvokeVoidAsync("localStorage.setItem", "nba_analysis_date", today);
                return;
            }
            
            if (!string.IsNullOrEmpty(saved))
            {
                var loaded = JsonSerializer.Deserialize<List<AnalysisHistoryEntry>>(saved);
                if (loaded != null)
                {
                    _analysisHistory = loaded;
                }
            }
        }
        catch (Exception ex)
        {
            // Fail silently - localStorage not critical
            Snackbar.Add($"Could not load history: {ex.Message}", Severity.Warning);
        }
    }
    
    private async Task SaveHistoryToStorage()
    {
        try
        {
            var json = JsonSerializer.Serialize(_analysisHistory);
            await JS.InvokeVoidAsync("localStorage.setItem", "nba_analysis_history", json);
            await JS.InvokeVoidAsync("localStorage.setItem", "nba_analysis_date", DateTime.Today.ToString("yyyy-MM-dd"));
        }
        catch
        {
            // Fail silently
        }
    }

    private async Task RefreshOdds()
    {
        _isLoading = true;
        _errorMessage = "";
        _analyzedGames = new();
        StateHasChanged();
        
        try
        {
            var response = await Http.GetFromJsonAsync<OddsResponse>(
                $"http://backend:8000/odds/nba?sportsbook={_selectedSportsbook}");
            
            if (response?.Error != null)
            {
                _errorMessage = response.Error;
                _games = new();
            }
            else if (response?.Games != null)
            {
                _games = response.Games;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to fetch odds: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunAnalysis()
    {
        _isAnalyzing = true;
        StateHasChanged();
        
        try
        {
            var response = await Http.PostAsync(
                $"http://backend:8000/odds/nba/analyze-all?sportsbook={_selectedSportsbook}", null);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AnalysisResponse>();
                if (result?.Games != null)
                {
                    _analyzedGames = result.Games;
                    
                    // Log to history
                    foreach (var game in _analyzedGames)
                    {
                        _analysisHistory.Add(new AnalysisHistoryEntry
                        {
                            AnalyzedAt = DateTime.Now,
                            HomeTeam = game.HomeTeam,
                            AwayTeam = game.AwayTeam,
                            Pick = game.PredictedWinner ?? "N/A",
                            WinProbability = ((game.HomeWinProbability ?? 0) * 100).ToString("F0"),
                            SpreadPick = game.SpreadPick ?? "N/A",
                            OuPick = game.OuPick ?? "N/A",
                            HasValue = game.HasValue
                        });
                    }
                    
                    // Save to localStorage
                    await SaveHistoryToStorage();
                    
                    var valueBets = _analyzedGames.Count(g => g.HasValue);
                    Snackbar.Add($"Analysis complete! {valueBets} value bet(s) found.", 
                        valueBets > 0 ? Severity.Success : Severity.Info);
                }
            }
            else
            {
                Snackbar.Add("Analysis failed", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isAnalyzing = false;
        }
    }

    private async Task TrainModel()
    {
        _isTraining = true;
        StateHasChanged();
        
        try
        {
            var response = await Http.PostAsync("http://backend:8000/odds/nba/train?epochs=500", null);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<TrainingResult>();
                if (result != null)
                {
                    Snackbar.Add($"XGBoost trained! ML Accuracy: {result.MlAccuracy}%, O/U MAE: {result.OuMae} pts", Severity.Success);
                }
            }
            else
            {
                Snackbar.Add("Training failed", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Training error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isTraining = false;
        }
    }

    private async Task CalculateKelly()
    {
        try
        {
            var url = $"http://backend:8000/odds/nba/calculate-kelly?win_probability={_kellyWinProb}&american_odds={_kellyOdds}&bankroll={_kellyBankroll}";
            _kellyResult = await Http.GetFromJsonAsync<KellyResult>(url);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadEdgeData()
    {
        _isLoadingEdge = true;
        StateHasChanged();
        
        try
        {
            var url = $"http://backend:8000/edge/nba/players?season={DateTime.Now.Year}&limit=50";
            _edgeData = await Http.GetFromJsonAsync<EdgeResponse>(url);
            if (_edgeData != null)
            {
                Snackbar.Add($"Loaded {_edgeData.TotalAnalyzed} players", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Edge data error: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _isLoadingEdge = false;
        }
    }

    private string FormatBookName(string book) => book switch
    {
        "fanduel" => "FanDuel",
        "draftkings" => "DraftKings",
        "betmgm" => "BetMGM",
        "pointsbet" => "PointsBet",
        "caesars" => "Caesars",
        "wynn" => "Wynn",
        "bet_rivers_ny" => "BetRivers NY",
        _ => book
    };

    private string FormatOdds(int? odds)
    {
        if (!odds.HasValue) return "N/A";
        return odds.Value > 0 ? $"+{odds.Value}" : odds.Value.ToString();
    }

    private string FormatSpread(double spread)
    {
        return spread > 0 ? $"+{spread}" : spread.ToString();
    }

    private Color GetOddsColor(int? odds)
    {
        if (!odds.HasValue) return Color.Default;
        return odds.Value < 0 ? Color.Warning : Color.Success;
    }

    // Models
    public class OddsResponse
    {
        [System.Text.Json.Serialization.JsonPropertyName("date")] public string? Date { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("sportsbook")] public string? Sportsbook { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("games")] public List<GameOdds> Games { get; set; } = new();
        [System.Text.Json.Serialization.JsonPropertyName("error")] public string? Error { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("message")] public string? Message { get; set; }
    }
    
    public class GameOdds
    {
        [System.Text.Json.Serialization.JsonPropertyName("home_team")] public string HomeTeam { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("away_team")] public string AwayTeam { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("home_moneyline")] public int? HomeMoneyline { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("away_moneyline")] public int? AwayMoneyline { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("spread")] public double? Spread { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("over_under")] public double? OverUnder { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("status")] public string Status { get; set; } = "scheduled";
    }
    
    public class AnalysisResponse
    {
        [System.Text.Json.Serialization.JsonPropertyName("games")] public List<AnalyzedGame> Games { get; set; } = new();
        [System.Text.Json.Serialization.JsonPropertyName("value_bets_found")] public int ValueBetsFound { get; set; }
    }
    
    public class AnalyzedGame
    {
        [System.Text.Json.Serialization.JsonPropertyName("home_team")] public string HomeTeam { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("away_team")] public string AwayTeam { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("home_moneyline")] public int? HomeMoneyline { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("away_moneyline")] public int? AwayMoneyline { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("spread")] public double? Spread { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("over_under")] public double? OverUnder { get; set; }
        
        // Predictions
        [System.Text.Json.Serialization.JsonPropertyName("predicted_winner")] public string? PredictedWinner { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("home_win_probability")] public double? HomeWinProbability { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("away_win_probability")] public double? AwayWinProbability { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("predicted_margin")] public double? PredictedMargin { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("predicted_total")] public double? PredictedTotal { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("confidence_level")] public string? ConfidenceLevel { get; set; }
        
        // Value indicators
        [System.Text.Json.Serialization.JsonPropertyName("ml_pick")] public string? MlPick { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("ml_value")] public bool MlValue { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("home_ml_edge")] public double? HomeMlEdge { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("spread_pick")] public string? SpreadPick { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("spread_value")] public bool SpreadValue { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("spread_edge")] public double? SpreadEdge { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("ou_pick")] public string? OuPick { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("ou_value")] public bool OuValue { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("ou_edge")] public double? OuEdge { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("has_value")] public bool HasValue { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("value_bets")] public List<string> ValueBets { get; set; } = new();
        
        // XGBoost model comparison
        [System.Text.Json.Serialization.JsonPropertyName("xgboost_model")] public XgbModelData? XgbModel { get; set; }
    }
    
    public class XgbModelData
    {
        [System.Text.Json.Serialization.JsonPropertyName("model")] public string? Model { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("home_win_probability")] public double? HomeWinProb { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("away_win_probability")] public double? AwayWinProb { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("predicted_winner")] public string? PredictedWinner { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("predicted_total")] public double? PredictedTotal { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("ml_pick")] public string? MlPick { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("ml_value")] public bool? MlValue { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("home_ml_edge")] public double? HomeMlEdge { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("error")] public string? Error { get; set; }
    }
    
    public class KellyResult
    {
        [System.Text.Json.Serialization.JsonPropertyName("implied_probability")] public double ImpliedProbability { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("model_edge")] public double ModelEdge { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("recommended_bet")] public double RecommendedBet { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("bet_percentage")] public double BetPercentage { get; set; }
    }
    
    public class TrainingResult
    {
        [System.Text.Json.Serialization.JsonPropertyName("ml_accuracy")] public double MlAccuracy { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("ou_mae")] public double OuMae { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("samples_trained")] public int SamplesTrained { get; set; }
    }
    
    public class EdgeResponse
    {
        [System.Text.Json.Serialization.JsonPropertyName("total_analyzed")] public int TotalAnalyzed { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("hot_players")] public List<PlayerEdge> HotPlayers { get; set; } = new();
        [System.Text.Json.Serialization.JsonPropertyName("cold_players")] public List<PlayerEdge> ColdPlayers { get; set; } = new();
    }

    public class PlayerEdge
    {
        [System.Text.Json.Serialization.JsonPropertyName("player")] public string Player { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("team")] public string Team { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("edge_score")] public double EdgeScore { get; set; }
    }
    
    public class AnalysisHistoryEntry
    {
        public DateTime AnalyzedAt { get; set; }
        public string HomeTeam { get; set; } = "";
        public string AwayTeam { get; set; } = "";
        public string Pick { get; set; } = "";
        public string WinProbability { get; set; } = "";
        public string SpreadPick { get; set; } = "";
        public string OuPick { get; set; } = "";
        public bool HasValue { get; set; }
        public double Stake { get; set; } = 0;
        public string Result { get; set; } = ""; // W, L, P (Push)
        
        // Opening/Closing line tracking (NEW)
        public double? OpeningSpread { get; set; }
        public double? ClosingSpread { get; set; }
        public double? OpeningOU { get; set; }
        public double? ClosingOU { get; set; }
        public int? OpeningHomeML { get; set; }
        public int? ClosingHomeML { get; set; }
        public int? OpeningAwayML { get; set; }
        public int? ClosingAwayML { get; set; }
        
        // For result syncing
        public string? GameId { get; set; }
        public DateTime? GameTime { get; set; }
        public int? FinalHomeScore { get; set; }
        public int? FinalAwayScore { get; set; }
        public bool ResultSynced { get; set; } = false;
    }
    
    private async Task MarkResult(AnalysisHistoryEntry entry, string result)
    {
        entry.Result = entry.Result == result ? "" : result; // Toggle
        var emoji = result == "W" ? "✅" : result == "L" ? "❌" : "➡️";
        Snackbar.Add($"{emoji} {entry.Pick} marked as {result}", Severity.Info);
        await SaveHistoryToStorage();
    }
    
    private async Task ClearHistory()
    {
        _analysisHistory.Clear();
        await JS.InvokeVoidAsync("localStorage.removeItem", "nba_analysis_history");
        Snackbar.Add("History cleared", Severity.Info);
    }
    
    // ROI Tracking helper methods
    private int GetWins() => _analysisHistory.Count(h => h.Result == "W");
    private int GetLosses() => _analysisHistory.Count(h => h.Result == "L");
    private int GetPushes() => _analysisHistory.Count(h => h.Result == "P");
    private double GetTotalStaked() => _analysisHistory.Where(h => h.Stake > 0 && !string.IsNullOrEmpty(h.Result)).Sum(h => h.Stake);
    
    private string GetWinRate()
    {
        var wins = GetWins();
        var losses = GetLosses();
        return (wins + losses) > 0 ? $"{(wins * 100.0 / (wins + losses)):F0}%" : "--";
    }
    
    private double GetRoi()
    {
        var totalStaked = GetTotalStaked();
        var totalWon = _analysisHistory.Where(h => h.Result == "W" && h.Stake > 0).Sum(h => h.Stake * 0.91);
        var losses = GetLosses();
        return totalStaked > 0 ? ((totalWon - losses * 100) / totalStaked * 100) : 0;
    }
    
    private string GetRoiDisplay()
    {
        var roi = GetRoi();
        return $"{(roi > 0 ? "+" : "")}{roi:F1}%";
    }
    
    private Color GetRecordColor()
    {
        var wins = GetWins();
        var losses = GetLosses();
        return wins > losses ? Color.Success : wins < losses ? Color.Error : Color.Default;
    }
    
    private Color GetRoiColor()
    {
        var roi = GetRoi();
        return roi > 0 ? Color.Success : roi < 0 ? Color.Error : Color.Default;
    }
    
    // ===== Compare Books Tab =====
    private bool _isLoadingComparison = false;
    private List<OddsComparisonGame> _comparisonGames = new();
    
    private async Task LoadOddsComparison()
    {
        _isLoadingComparison = true;
        _comparisonGames.Clear();
        StateHasChanged();
        
        try
        {
            var response = await Http.GetAsync("http://backend:8000/odds/nba/compare/fd-dk");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var data = JsonSerializer.Deserialize<JsonElement>(json);
                
                if (data.TryGetProperty("games", out var games))
                {
                    foreach (var game in games.EnumerateArray())
                    {
                        var compGame = new OddsComparisonGame
                        {
                            Game = game.GetProperty("game").GetString() ?? "",
                            HomeTeam = game.TryGetProperty("home_team", out var ht) ? ht.GetString() ?? "" : "",
                            AwayTeam = game.TryGetProperty("away_team", out var at) ? at.GetString() ?? "" : "",
                        };
                        
                        if (game.TryGetProperty("fanduel", out var fd))
                        {
                            compGame.FanDuelHomeML = fd.TryGetProperty("home_ml", out var fhm) && fhm.ValueKind == JsonValueKind.Number ? fhm.GetInt32() : (int?)null;
                            compGame.FanDuelAwayML = fd.TryGetProperty("away_ml", out var fam) && fam.ValueKind == JsonValueKind.Number ? fam.GetInt32() : (int?)null;
                        }
                        
                        if (game.TryGetProperty("draftkings", out var dk))
                        {
                            compGame.DraftKingsHomeML = dk.TryGetProperty("home_ml", out var dhm) && dhm.ValueKind == JsonValueKind.Number ? dhm.GetInt32() : (int?)null;
                            compGame.DraftKingsAwayML = dk.TryGetProperty("away_ml", out var dam) && dam.ValueKind == JsonValueKind.Number ? dam.GetInt32() : (int?)null;
                        }
                        
                        if (game.TryGetProperty("best", out var best))
                        {
                            compGame.BestHomeML = best.TryGetProperty("home_ml", out var bhm) ? bhm.GetString() ?? "same" : "same";
                            compGame.BestAwayML = best.TryGetProperty("away_ml", out var bam) ? bam.GetString() ?? "same" : "same";
                        }
                        
                        _comparisonGames.Add(compGame);
                    }
                }
                
                Snackbar.Add($"Loaded {_comparisonGames.Count} games for comparison", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to load comparison", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingComparison = false;
        }
    }
    private class OddsComparisonGame
    {
        public string Game { get; set; } = "";
        public string HomeTeam { get; set; } = "";
        public string AwayTeam { get; set; } = "";
        public int? FanDuelHomeML { get; set; }
        public int? FanDuelAwayML { get; set; }
        public int? DraftKingsHomeML { get; set; }
        public int? DraftKingsAwayML { get; set; }
        public string BestHomeML { get; set; } = "same";
        public string BestAwayML { get; set; } = "same";
    }
    
    // ===== Result Syncing =====
    private bool _isSyncingResults = false;
    private bool _isRefreshingLines = false;
    
    private async Task SyncGameResults()
    {
        _isSyncingResults = true;
        StateHasChanged();
        
        try
        {
            // Get games that need results synced (no result yet)
            var pendingGames = _analysisHistory.Where(h => string.IsNullOrEmpty(h.Result)).ToList();
            
            if (!pendingGames.Any())
            {
                Snackbar.Add("No games need syncing", Severity.Info);
                return;
            }
            
            // Fetch today's completed games from the API
            var response = await Http.GetAsync("http://backend:8000/results/nba/today");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var data = JsonSerializer.Deserialize<JsonElement>(json);
                
                int synced = 0;
                if (data.TryGetProperty("games", out var games))
                {
                    foreach (var game in games.EnumerateArray())
                    {
                        var homeTeam = game.TryGetProperty("home_team", out var ht) ? ht.GetString() : "";
                        var awayTeam = game.TryGetProperty("away_team", out var at) ? at.GetString() : "";
                        var homeScore = game.TryGetProperty("home_score", out var hs) && hs.ValueKind == JsonValueKind.Number ? hs.GetInt32() : (int?)null;
                        var awayScore = game.TryGetProperty("away_score", out var @as) && @as.ValueKind == JsonValueKind.Number ? @as.GetInt32() : (int?)null;
                        var status = game.TryGetProperty("status", out var st) ? st.GetString() : "";
                        
                        if (status?.ToLower() != "final") continue;
                        if (!homeScore.HasValue || !awayScore.HasValue) continue;
                        
                        // Find matching entry in history
                        var entry = pendingGames.FirstOrDefault(h => 
                            h.HomeTeam.Contains(homeTeam ?? "", StringComparison.OrdinalIgnoreCase) ||
                            h.AwayTeam.Contains(awayTeam ?? "", StringComparison.OrdinalIgnoreCase) ||
                            (homeTeam ?? "").Contains(h.HomeTeam, StringComparison.OrdinalIgnoreCase));
                        
                        if (entry != null)
                        {
                            entry.FinalHomeScore = homeScore;
                            entry.FinalAwayScore = awayScore;
                            entry.ResultSynced = true;
                            
                            // Auto-determine result based on pick and scores
                            var totalPoints = homeScore.Value + awayScore.Value;
                            var homeWon = homeScore > awayScore;
                            
                            // Try to determine result based on pick type
                            if (entry.Pick.Contains(entry.HomeTeam))
                                entry.Result = homeWon ? "W" : "L";
                            else if (entry.Pick.Contains(entry.AwayTeam))
                                entry.Result = !homeWon ? "W" : "L";
                            
                            synced++;
                        }
                    }
                }
                
                if (synced > 0)
                {
                    await SaveHistoryToStorage();
                    Snackbar.Add($"✅ Synced {synced} game result(s)", Severity.Success);
                }
                else
                {
                    Snackbar.Add("No matching games found in results", Severity.Info);
                }
            }
            else
            {
                // Fallback: Fetch from odds endpoint
                Snackbar.Add("Results endpoint not available yet. Mark results manually.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Sync error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSyncingResults = false;
        }
    }
    
    private async Task RefreshClosingLines()
    {
        _isRefreshingLines = true;
        StateHasChanged();
        
        try
        {
            // Fetch current odds to update closing lines
            var response = await Http.GetAsync($"http://backend:8000/odds/nba?sportsbook={_selectedSportsbook}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var data = JsonSerializer.Deserialize<JsonElement>(json);
                
                int updated = 0;
                if (data.TryGetProperty("games", out var games))
                {
                    foreach (var game in games.EnumerateArray())
                    {
                        var homeTeam = game.TryGetProperty("home_team", out var ht) ? ht.GetString() : "";
                        var awayTeam = game.TryGetProperty("away_team", out var at) ? at.GetString() : "";
                        var currentOU = game.TryGetProperty("over_under", out var ou) && ou.ValueKind == JsonValueKind.Number ? ou.GetDouble() : (double?)null;
                        var currentSpread = game.TryGetProperty("spread", out var sp) && sp.ValueKind == JsonValueKind.Number ? sp.GetDouble() : (double?)null;
                        var currentHomeML = game.TryGetProperty("home_moneyline", out var hm) && hm.ValueKind == JsonValueKind.Number ? hm.GetInt32() : (int?)null;
                        var currentAwayML = game.TryGetProperty("away_moneyline", out var am) && am.ValueKind == JsonValueKind.Number ? am.GetInt32() : (int?)null;
                        
                        // Find matching entry in history
                        var entry = _analysisHistory.FirstOrDefault(h =>
                            h.HomeTeam.Contains(homeTeam ?? "", StringComparison.OrdinalIgnoreCase) ||
                            (homeTeam ?? "").Contains(h.HomeTeam, StringComparison.OrdinalIgnoreCase));
                        
                        if (entry != null)
                        {
                            // Set opening lines if not set yet
                            if (!entry.OpeningOU.HasValue && currentOU.HasValue)
                            {
                                entry.OpeningOU = currentOU;
                            }
                            
                            // Always update closing lines
                            entry.ClosingOU = currentOU;
                            entry.ClosingSpread = currentSpread;
                            entry.ClosingHomeML = currentHomeML;
                            entry.ClosingAwayML = currentAwayML;
                            updated++;
                        }
                    }
                }
                
                if (updated > 0)
                {
                    await SaveHistoryToStorage();
                    Snackbar.Add($"📈 Updated lines for {updated} game(s)", Severity.Success);
                }
                else
                {
                    Snackbar.Add("No matching games to update", Severity.Info);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating lines: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isRefreshingLines = false;
        }
    }
