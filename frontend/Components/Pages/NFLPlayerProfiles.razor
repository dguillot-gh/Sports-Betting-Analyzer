@page "/nfl-player-profiles"
@rendermode InteractiveServer
@using MudBlazor
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>NFL Player Profiles</PageTitle>

<div class="min-h-screen bg-slate-950 text-slate-100 p-4 md:p-8 font-sans">
    <TwContainer MaxWidth="6xl">
        
        <!-- Header Section -->
        <header class="mb-8">
            <div class="flex items-center gap-3 mb-2">
                <div class="bg-purple-600 p-3 rounded-xl shadow-lg shadow-purple-900/20">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-3xl font-bold tracking-tight">NFL Player Profiles</h1>
                    <p class="text-slate-400 text-sm">View detailed player statistics and history</p>
                </div>
            </div>
        </header>

        <TwGrid Cols="1" ColsMd="3" Gap="6">
            <!-- Search Panel -->
            <div class="md:col-span-1">
                <TwCard Title="Find Player" Color="purple">
                    <div class="space-y-4">
                        <TwInput Label="Player Name" @bind-Value="_selectedPlayer"
                                 Placeholder="Type player name..."
                                 ShowSearchIcon="true" />
                        
                        <TwButton Variant="primary" FullWidth="true" OnClick="LoadProfile" 
                                  IsLoading="_isLoading" Disabled="@(string.IsNullOrEmpty(_selectedPlayer) || _isLoading)">
                            Load Profile
                        </TwButton>
                    </div>
                </TwCard>

                <TwAlert Severity="info" Class="mt-4">
                    Search for NFL players to view their season stats and recent game history.
                </TwAlert>
            </div>

            <!-- Profile Display -->
            <div class="md:col-span-2">
                @if (_profile != null)
                {
                    <!-- Player Header Card -->
                    <div class="bg-gradient-to-br from-slate-800 via-purple-900/30 to-slate-800 rounded-2xl p-6 mb-6 border border-slate-700">
                        <div class="flex items-center gap-4">
                            <TwAvatar Size="xl" Alt="@_profile.Name" Color="purple" />
                            <div class="flex-1">
                                <h2 class="text-2xl font-bold text-white">@_profile.Name</h2>
                                <p class="text-slate-400">
                                    @(_profile.Metadata?.GetValueOrDefault("position")?.ToString() ?? "NFL") • 
                                    @(_profile.Metadata?.GetValueOrDefault("team")?.ToString() ?? "")
                                </p>
                            </div>
                            <TwChip Color="amber" Size="lg">NFL</TwChip>
                        </div>
                    </div>

                    <!-- Tabs -->
                    <div class="mb-6">
                        <TwTabs Tabs="_tabs" @bind-ActiveTabId="_activeTabId" />
                    </div>

                    @if (_activeTabId == "stats")
                    {
                        <!-- Stats by Season -->
                        @if (_profile.Stats != null && _profile.Stats.Any())
                        {
                            <TwCard Title="Season Statistics" Color="emerald">
                                <div class="space-y-6 max-h-[600px] overflow-y-auto">
                                    @foreach (var seasonStats in _profile.Stats.OrderByDescending(s => s.Key))
                                    {
                                        <div>
                                            <h4 class="text-sm font-semibold text-purple-400 mb-3 sticky top-0 bg-slate-900/90 py-1 backdrop-blur-sm z-10">
                                                @seasonStats.Key Season
                                            </h4>
                                            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
                                                @foreach (var stat in seasonStats.Value.Where(s => ShouldShowStat(s.Key)).Take(12))
                                                {
                                                    var statValue = stat.Value?.ToString() ?? "0";
                                                    <TwStatCard Value="@statValue" Label="@FormatStatName(stat.Key)" Color="blue" />
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </TwCard>
                        }
                        else
                        {
                            <TwAlert Severity="info">No season stats available for this player.</TwAlert>
                        }
                    }
                    else if (_activeTabId == "games")
                    {
                        <!-- Recent Games -->
                        @if (_profile.RecentGames != null && _profile.RecentGames.Any())
                        {
                            <TwCard Title="Game Log" Color="blue">
                                <HeaderContent>
                                    <div class="flex items-center justify-between w-full">
                                        <span class="font-bold text-white">Recent Games</span>
                                        <TwLink Href="@($"/nfl/scores?player={Uri.EscapeDataString(_profile.Name ?? "")}")">
                                            View All Results →
                                        </TwLink>
                                    </div>
                                </HeaderContent>
                                <ChildContent>
                                    <div class="overflow-x-auto">
                                        <TwTable TItem="object">
                                            <HeaderContent>
                                                <TwTh>Date/Season</TwTh>
                                                <TwTh>Team</TwTh>
                                                <TwTh>Opp</TwTh>
                                                <TwTh Class="text-right">Pass Yds</TwTh>
                                                <TwTh Class="text-right">Rush Yds</TwTh>
                                                <TwTh Class="text-right">Rec Yds</TwTh>
                                                <TwTh Class="text-right">TDs</TwTh>
                                            </HeaderContent>
                                            <ChildContent>
                                                @foreach (var game in _profile.RecentGames.Take(10))
                                                {
                                                    var passTd = GetIntValue(game, "pass_td");
                                                    var rushTd = GetIntValue(game, "rush_td");
                                                    var recTd = GetIntValue(game, "rec_td");
                                                    var totalTd = passTd + rushTd + recTd;
                                                    <TwTr>
                                                        <TwTd>
                                                            <span class="text-xs text-slate-400 block">@GetGameDate(game)</span>
                                                        </TwTd>
                                                        <TwTd>@(game.GetValueOrDefault("team")?.ToString() ?? "-")</TwTd>
                                                        <TwTd>@(game.GetValueOrDefault("opponent")?.ToString() ?? "-")</TwTd>
                                                        <TwTd Class="text-right font-bold text-white">@FormatNumber(GetIntValue(game, "pass_yds"))</TwTd>
                                                        <TwTd Class="text-right font-bold text-white">@FormatNumber(GetIntValue(game, "rush_yds"))</TwTd>
                                                        <TwTd Class="text-right font-bold text-white">@FormatNumber(GetIntValue(game, "rec_yds"))</TwTd>
                                                        <TwTd Class="text-right">
                                                            @if (totalTd > 0)
                                                            {
                                                                <TwChip Size="sm" Color="emerald">@totalTd</TwChip>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-slate-600">-</span>
                                                            }
                                                        </TwTd>
                                                    </TwTr>
                                                }
                                            </ChildContent>
                                        </TwTable>
                                    </div>
                                </ChildContent>
                            </TwCard>
                        }
                        else
                        {
                            <TwAlert Severity="info">
                                No recent games found.
                                <div class="mt-2">
                                    <TwLink Href="@($"/nfl/scores?player={Uri.EscapeDataString(_profile.Name ?? "")}")">
                                        Search in Game Results
                                    </TwLink>
                                </div>
                            </TwAlert>
                        }
                    }
                }
                else if (_isLoading)
                {
                    <TwCard Color="slate" Hoverable="false">
                        <div class="flex flex-col items-center justify-center py-16">
                            <TwProgressBar IsIndeterminate="true" Color="purple" Class="w-48 mb-4" />
                            <p class="text-slate-400">Loading profile...</p>
                        </div>
                    </TwCard>
                }
                else if (_notFound)
                {
                    <TwAlert Severity="warning">
                        Player "@_selectedPlayer" not found. Try searching for a different name.
                    </TwAlert>
                }
                else
                {
                    <TwCard Color="slate" Hoverable="false">
                        <div class="flex flex-col items-center justify-center py-16">
                            <div class="w-16 h-16 bg-slate-800 rounded-full flex items-center justify-center mb-4">
                                <svg class="w-8 h-8 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </div>
                            <h3 class="text-lg font-semibold text-slate-400">Search for a player</h3>
                            <p class="text-slate-500 text-sm">Type a player name to view their profile</p>
                        </div>
                    </TwCard>
                }
            </div>
        </TwGrid>
    </TwContainer>
</div>

@code {
    private string _selectedPlayer = "";
    private bool _isLoading = false;
    private bool _notFound = false;
    private string _activeTabId = "stats";
    
    private List<TabItem> _tabs = new()
    {
        new TabItem { Id = "stats", Label = "Season Stats" },
        new TabItem { Id = "games", Label = "Recent Games" }
    };
    
    private PlayerProfile? _profile;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        
        var playerParam = query["player"];
        
        if (!string.IsNullOrEmpty(playerParam))
        {
            _selectedPlayer = playerParam;
            await LoadProfile();
        }
    }

    private async Task LoadProfile()
    {
        if (string.IsNullOrEmpty(_selectedPlayer)) return;
        
        _isLoading = true;
        _notFound = false;
        _profile = null;
        StateHasChanged();

        
        try
        {
            var url = $"http://backend:8000/db/profiles/nfl/{Uri.EscapeDataString(_selectedPlayer)}";
            Console.WriteLine($"Loading profile from: {url}");
            _profile = await Http.GetFromJsonAsync<PlayerProfile>(url);
            
            if (_profile?.NotFound == true)
            {
                Console.WriteLine($"Profile not found for: {_selectedPlayer}");
                _notFound = true;
                _profile = null;
            }
            else
            {
                Console.WriteLine($"Loaded profile: {_profile?.Name}, Stats: {_profile?.Stats?.Count ?? 0}, Games: {_profile?.RecentGames?.Count ?? 0}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadProfile error: {ex}");
            _notFound = true;
            _profile = null;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private bool ShouldShowStat(string key)
    {
        var skipKeys = new[] { "player_id", "player_name", "position", "team", "season", "gsis_id" };
        return !skipKeys.Contains(key.ToLower());
    }
    
    private string GetGameDate(Dictionary<string, object> game)
    {
        if (game.TryGetValue("game_date", out var dateObj)) return dateObj?.ToString() ?? "";
        if (game.TryGetValue("season", out var seasonObj)) return seasonObj?.ToString() ?? "";
        return "";
    }

    private string FormatStatName(string key) => key.ToLower() switch
    {
        "pass_yds" => "Pass Yards",
        "pass_td" => "Pass TDs",
        "pass_att" => "Pass Att",
        "pass_cmp" => "Completions",
        "pass_int" => "INTs",
        "rush_yds" => "Rush Yards",
        "rush_td" => "Rush TDs",
        "rush_att" => "Rush Att",
        "rec" => "Receptions",
        "rec_yds" => "Rec Yards",
        "rec_td" => "Rec TDs",
        "targets" => "Targets",
        "games" => "Games",
        "fantasy_pts" => "Fantasy Pts",
        "fantasy_pts_ppr" => "Fantasy PPR",
        _ => key.Replace("_", " ").ToUpperInvariant()
    };

    private int GetIntValue(Dictionary<string, object>? dict, string key)
    {
        if (dict == null) return 0;
        if (dict.TryGetValue(key, out var value))
        {
            if (value == null) return 0;
            if (value is int i) return i;
            if (value is long l) return (int)l;
            if (value is double d) return (int)d;
            if (value is System.Text.Json.JsonElement je)
            {
                if (je.ValueKind == System.Text.Json.JsonValueKind.Number)
                    return je.TryGetInt32(out var num) ? num : 0;
            }
            if (int.TryParse(value.ToString(), out var parsed)) return parsed;
        }
        return 0;
    }

    private string FormatNumber(int value) => value > 0 ? value.ToString("N0") : "-";

    // Response models
    private class PlayerProfile
    {
        [System.Text.Json.Serialization.JsonPropertyName("id")]
        public int Id { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("name")]
        public string Name { get; set; } = "";
        
        [System.Text.Json.Serialization.JsonPropertyName("type")]
        public string Type { get; set; } = "";
        
        [System.Text.Json.Serialization.JsonPropertyName("series")]
        public string? Series { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("metadata")]
        public Dictionary<string, object>? Metadata { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("stats")]
        public Dictionary<string, Dictionary<string, object>>? Stats { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("recent_games")]
        public List<Dictionary<string, object>>? RecentGames { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("not_found")]
        public bool? NotFound { get; set; }
    }
}
