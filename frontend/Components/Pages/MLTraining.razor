@page "/ml-training"
@rendermode InteractiveServer
@using System.Text.Json
@using SportsBettingAnalyzer.Services
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@inject PythonMLServiceClient MLClient
@inject ILogger<MLTraining> Logger
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>ML Model Training</PageTitle>

<TwContainer MaxWidth="extraLarge" Class="mt-8">
    <div class="space-y-6">
        <!-- Header -->
        <TwCard Class="p-6">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-purple-500/10 rounded-xl">
                    <TwIcon Icon="model_training" Class="w-8 h-8 text-purple-500" />
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-slate-100">ML Model Training</h1>
                    <p class="text-slate-400">Train machine learning models using professional sports datasets</p>
                </div>
            </div>
        </TwCard>

        @if (!_isPythonServiceAvailable)
        {
            <TwAlert Severity="error">
                Python ML Service is not available. Please ensure the service is running at @_pythonServiceUrl
            </TwAlert>
        }

        <TwTabs @bind-ActiveTab="_activeTab">
            <!-- Dataset Explorer Tab -->
            <TwTabPanel Title="Dataset Explorer" Icon="@Icons.Material.Filled.Storage">
                <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 pt-6">
                    <!-- Filters -->
                    <div class="lg:col-span-1">
                        <TwCard Class="p-4 h-full">
                            <h3 class="font-bold text-slate-100 mb-4">Configuration</h3>
                            <div class="space-y-4">
                                <TwSelect TValue="string" Value="@_selectedSport" ValueChanged="SelectSport" Label="Sport" FullWidth="true">
                                    @foreach (var sport in _availableSports)
                                    {
                                        <option value="@sport">@sport.ToUpper()</option>
                                    }
                                </TwSelect>

                                @if (_selectedSport == "nascar")
                                {
                                    <TwSelect TValue="int?" @bind-Value="_selectedSeason" Label="Season" FullWidth="true">
                                        <option value="">All Seasons</option>
                                        @foreach (var item in _featureValues.GetValueOrDefault("year", new List<object>()))
                                        {
                                           var val = ConvertToInt(item);
                                           <option value="@val">@val</option>
                                        }
                                    </TwSelect>

                                    <TwSelect TValue="string" @bind-Value="_selectedTrackType" Label="Track Type" FullWidth="true">
                                        <option value="">All Types</option>
                                        @foreach (var item in _featureValues.GetValueOrDefault("track_type", new List<object>()))
                                        {
                                            <option value="@item">@item</option>
                                        }
                                    </TwSelect>
                                     
                                    <!-- Driver search could be an autocomplete, using select for simplicity now -->
                                     <TwSelect TValue="string" @bind-Value="_selectedDriver" Label="Driver" FullWidth="true">
                                        <option value="">All Drivers</option>
                                         @foreach (var item in _featureValues.GetValueOrDefault("driver", new List<object>()))
                                        {
                                            <option value="@item">@item</option>
                                        }
                                    </TwSelect>
                                }
                                
                                <TwButton Variant="solid" OnClick="OnFilterChanged" FullWidth="true" Class="mt-2">
                                    Apply Filters
                                </TwButton>
                            </div>
                        </TwCard>
                    </div>

                    <!-- Data Table -->
                    <div class="lg:col-span-3">
                        <TwCard Class="p-4 h-full">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="font-bold text-slate-100">Data View</h3>
                                @if (_dataSchema != null)
                                {
                                    <TwChip Color="blue" Size="sm" Variant="outline">Total Rows: @_dataSchema.TotalRows</TwChip>
                                }
                            </div>
                            
                            <TwTable TItem="Dictionary<string, object>" Items="@_tableItems" IsLoading="@_isLoadingData">
                                <HeaderContent>
                                    @if (_dataSchema?.Columns != null)
                                    {
                                        @foreach (var col in _dataSchema.Columns.Take(8)) // Limit columns for display
                                        {
                                            <TwTh>@col</TwTh>
                                        }
                                    }
                                </HeaderContent>
                                <RowTemplate Context="row">
                                    @if (_dataSchema?.Columns != null)
                                    {
                                        @foreach (var col in _dataSchema.Columns.Take(8))
                                        {
                                            <TwTd>@row.GetValueOrDefault(col, "")</TwTd>
                                        }
                                    }
                                </RowTemplate>
                            </TwTable>
                            
                            <!-- Pagination Controls -->
                            <div class="flex items-center justify-between mt-4 border-t border-slate-700 pt-4">
                                <TwButton OnClick="PrevPage" Disabled="@(_currentPage == 0)" Variant="outline" Size="sm">Previous</TwButton>
                                <span class="text-slate-400 text-sm">Page @(_currentPage + 1)</span>
                                <TwButton OnClick="NextPage" Disabled="@((_currentPage + 1) * _pageSize >= (_dataSchema?.TotalRows ?? 0))" Variant="outline" Size="sm">Next</TwButton>
                            </div>
                        </TwCard>
                    </div>
                </div>
            </TwTabPanel>

            <!-- Train Model Tab -->
            <TwTabPanel Title="Train Model" Icon="@Icons.Material.Filled.School">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 pt-6">
                    <!-- Configuration -->
                    <TwCard Class="p-4">
                        <h3 class="font-bold text-slate-100 mb-4">Training Configuration</h3>
                        <div class="space-y-4">
                            <TwSelect TValue="string" @bind-Value="_trainingSport" Label="Sport" FullWidth="true">
                                @foreach (var sport in _availableSports)
                                {
                                    <option value="@sport">@sport.ToUpper()</option>
                                }
                            </TwSelect>

                            @if (_trainingSport == "nascar")
                            {
                                <TwSelect TValue="string" @bind-Value="_nascarSeries" Label="Series" FullWidth="true">
                                    @foreach (var series in _nascarSeriesList)
                                    {
                                        <option value="@series">@series</option>
                                    }
                                </TwSelect>
                            }

                            <TwSelect TValue="string" @bind-Value="_trainingTask" Label="Task Type" FullWidth="true">
                                <option value="classification">Classification (Win/Loss)</option>
                                <option value="regression">Regression (Score Prediction)</option>
                            </TwSelect>

                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs text-slate-500 mb-1 font-medium">Train Start Season</label>
                                    <input type="number" @bind="_trainStartSeason" class="appearance-none bg-slate-800 text-sm text-slate-100 border border-slate-700 rounded-xl px-4 py-2.5 w-full focus:outline-none focus:ring-2 focus:ring-blue-500/50" placeholder="Optional" />
                                </div>
                                <div>
                                    <label class="block text-xs text-slate-500 mb-1 font-medium">Test Start Season</label>
                                    <input type="number" @bind="_testStartSeason" class="appearance-none bg-slate-800 text-sm text-slate-100 border border-slate-700 rounded-xl px-4 py-2.5 w-full focus:outline-none focus:ring-2 focus:ring-blue-500/50" placeholder="Optional" />
                                </div>
                            </div>

                            <TwSelect TValue="string" @bind-Value="_selectedModelType" Label="Model Algorithm" FullWidth="true">
                                <option value="rf">Random Forest (Baseline)</option>
                                <option value="xgboost">XGBoost (Gradient Boosting)</option>
                            </TwSelect>

                            <!-- Advanced Options Toggle -->
                            <div class="border border-slate-700 rounded-xl p-4 bg-slate-900/50">
                                <div class="flex items-center justify-between cursor-pointer" @onclick="() => _showAdvanced = !_showAdvanced">
                                    <span class="text-sm font-bold text-slate-300">Advanced Options</span>
                                    <svg class="w-4 h-4 text-slate-500 transform transition-transform @(_showAdvanced ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                </div>
                                @if (_showAdvanced)
                                {
                                    <div class="mt-4 space-y-4">
                                        <div>
                                            <div class="flex justify-between mb-1">
                                                <label class="text-xs text-slate-500">Trees (n_estimators)</label>
                                                <span class="text-xs text-slate-300">@_nEstimators</span>
                                            </div>
                                            <input type="range" min="10" max="500" step="10" @bind="_nEstimators" @bind:event="oninput" class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-blue-500" />
                                        </div>
                                        
                                        <div>
                                            <label class="block text-xs text-slate-500 mb-1">Max Depth</label>
                                            <input type="number" @bind="_maxDepth" class="appearance-none bg-slate-800 text-sm text-slate-100 border border-slate-700 rounded-xl px-4 py-2 w-full" placeholder="No Limit" />
                                        </div>

                                        @if (_trainingTask == "classification")
                                        {
                                            <TwSelect TValue="string" @bind-Value="_classWeight" Label="Class Weight" FullWidth="true">
                                                <option value="None">None (Equal weights)</option>
                                                <option value="balanced">Balanced</option>
                                                <option value="balanced_subsample">Balanced Subsample</option>
                                            </TwSelect>
                                        }
                                    </div>
                                }
                            </div>

                            <TwButton Variant="solid" Color="emerald" FullWidth="true" OnClick="StartTraining" Disabled="@(_isTraining || !_isPythonServiceAvailable)">
                                @if (_isTraining) { <span>Training...</span> } else { <span>Start Training</span> }
                            </TwButton>
                        </div>
                    </TwCard>
                    
                    <!-- Training Results -->
                    @if (_trainingResult != null)
                    {
                        <TwCard Class="p-4 bg-slate-900 border-emerald-500/30 border">
                             <div class="flex items-center gap-2 mb-4 text-emerald-400">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                <h3 class="font-bold">Training Complete</h3>
                             </div>
                             
                             <div class="space-y-4">
                                 <div class="grid grid-cols-2 gap-4 text-sm">
                                     <div>
                                         <span class="text-slate-500 block">Sport</span>
                                         <span class="text-slate-200 font-medium">@_trainingSport.ToUpper()</span>
                                     </div>
                                     <div>
                                         <span class="text-slate-500 block">Task</span>
                                         <span class="text-slate-200 font-medium">@_trainingTask</span>
                                     </div>
                                 </div>
                                 
                                 <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 font-mono text-xs text-slate-400 break-all">
                                     @_trainingResult.ModelPath
                                 </div>
                                 
                                <h4 class="font-bold text-slate-300 text-sm mt-4">Metrics</h4>
                                <TwTable TItem="KeyValuePair<string, object>" Items="@GetMetricsList(_trainingResult.Metrics)">
                                    <RowTemplate Context="m">
                                        <TwTd><span class="font-medium text-slate-300">@m.Key</span></TwTd>
                                        <TwTd class="text-right text-emerald-400 font-mono">@FormatMetricValue(m.Value)</TwTd>
                                    </RowTemplate>
                                </TwTable>
                             </div>
                        </TwCard>
                    }
                    else if (!_isTraining)
                    {
                        <div class="flex flex-col items-center justify-center p-12 text-slate-600 border-2 border-dashed border-slate-800 rounded-xl h-full">
                            <TwIcon Icon="model_training" Class="w-12 h-12 mb-4 opacity-50" />
                            <p>Configure and start training to see results</p>
                        </div>
                    }
                </div>
            </TwTabPanel>

            <!-- Model Management Tab -->
             <TwTabPanel Title="Model Management" Icon="@Icons.Material.Filled.Settings">
                 <div class="pt-6">
                     <TwCard Class="p-4">
                         <div class="flex justify-between items-center mb-4">
                             <h3 class="font-bold text-slate-100">Trained Models</h3>
                             <TwButton Variant="outline" Size="sm" OnClick="LoadModels">Refresh</TwButton>
                         </div>
                         
                         <TwTable TItem="ModelInfo" Items="@_trainedModels" IsLoading="@_isLoadingModels">
                             <HeaderContent>
                                 <TwTh>Sport</TwTh>
                                 <TwTh>Series</TwTh>
                                 <TwTh>Task</TwTh>
                                 <TwTh>Last Updated</TwTh>
                                 <TwTh>Actions</TwTh>
                             </HeaderContent>
                             <RowTemplate Context="model">
                                 <TwTd>@model.Sport.ToUpper()</TwTd>
                                 <TwTd>@model.Series</TwTd>
                                 <TwTd>@model.Task</TwTd>
                                 <TwTd>@DateTimeOffset.FromUnixTimeSeconds((long)model.LastUpdated).ToLocalTime().ToString("g")</TwTd>
                                 <TwTd>
                                     <div class="flex gap-2">
                                         <TwButton Variant="solid" Color="red" Size="xs" OnClick="@(() => DeleteModel(model))">Delete</TwButton>
                                         <TwButton Variant="outline" Size="xs" Href="@($"/model-insights?sport={model.Sport}&series={model.Series}&task={model.Task}")">Insights</TwButton>
                                     </div>
                                 </TwTd>
                             </RowTemplate>
                         </TwTable>
                     </TwCard>
                 </div>
             </TwTabPanel>
        </TwTabs>
    </div>
</TwContainer>

<!-- Training Progress Modal -->
<TwDialog @bind-IsOpen="_showTrainingDialog" Title="Training Progress" MaxWidth="lg">
    <div class="space-y-4">
        <TwProgressBar Value="100" Indeterminate="@(_trainingStatus == "running")" Color="@(_trainingStatus == "failed" ? "red" : "blue")" Height="h-2" />
        
        <div class="flex items-center justify-between text-sm">
             <span class="text-slate-400">Status:</span>
             <span class="@(_trainingStatus == "completed" ? "text-emerald-400" : "text-blue-400") font-bold uppercase">@(_trainingStatus ?? "Initializing...")</span>
        </div>

        <div class="bg-slate-950 rounded-lg p-3 h-64 overflow-y-auto font-mono text-xs space-y-1 scrollbar-thin scrollbar-thumb-slate-700">
            @foreach (var line in _trainingProgress)
            {
                <div class="@(line.Contains("Error") ? "text-red-400" : "text-emerald-500/80")">@line</div>
            }
            @if (!_trainingProgress.Any())
            {
                <div class="text-slate-600 italic">Waiting for logs...</div>
            }
        </div>

        @if (_trainingStatus == "completed" || _trainingStatus == "failed")
        {
            <div class="flex justify-end pt-4">
                <TwButton OnClick="CloseTrainingDialog" Variant="solid" Color="slate">Close</TwButton>
            </div>
        }
    </div>
</TwDialog>

@code {
    private int _activeTab = 0;
    private string _pythonServiceUrl = "http://localhost:8000";
    private bool _isPythonServiceAvailable = false;
    
    // Dataset Explorer
    private List<string> _availableSports = new();
    private string _selectedSport = "";
    private DataSchema _dataSchema;
    private bool _isLoadingData = false;
    private List<Dictionary<string, object>> _tableItems = new();
    private int _currentPage = 0;
    private int _pageSize = 10;
    
    // Filters
    private int? _selectedSeason;
    private string? _selectedTrackType;
    private string? _selectedDriver;
    private Dictionary<string, List<object>> _featureValues = new();

    // Training state
    private string _trainingSport = "nfl";
    private string _trainingTask = "classification";
    private string _selectedModelType = "rf";
    private string _nascarSeries = "cup";
    private List<string> _nascarSeriesList = new() { "cup", "truck", "xfinity" };
    private int? _testStartSeason;
    private int? _trainStartSeason;
    private bool _isTraining = false;
    private TrainResponse _trainingResult;
    private bool _showAdvanced = false;

    // Hyperparams
    private int _nEstimators = 200;
    private int? _maxDepth;
    private string _classWeight = "balanced";

    // Model Management
    private List<ModelInfo> _trainedModels = new();
    private bool _isLoadingModels = false;

    // Dialog
    private bool _showTrainingDialog = false;
    private string? _trainingStatus;
    private List<string> _trainingProgress = new();

    private int ConvertToInt(object item) {
        if (item is JsonElement element) return element.GetInt32();
        return Convert.ToInt32(item);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isPythonServiceAvailable = await MLClient.IsHealthyAsync();
            _availableSports = await MLClient.GetAvailableSportsAsync();
            
            if (_isPythonServiceAvailable)
                Snackbar.Add("Python ML Service connected", Severity.Success);
            else
                Snackbar.Add("Python ML Service unavailable", Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing");
        }
    }

    private async Task SelectSport(string sport)
    {
        _selectedSport = sport;
        _selectedSeason = null;
        _selectedTrackType = null;
        _selectedDriver = null;
        _currentPage = 0;
        
        try 
        {
            var series = sport == "nascar" ? "cup" : null;
            _featureValues = await MLClient.GetFeatureValuesAsync(sport, series);
        }
        catch { /* Ignore */ }

        await LoadData();
    }
    
    private List<KeyValuePair<string, object>> GetMetricsList(JsonElement metrics)
    {
         var list = new List<KeyValuePair<string, object>>();
         if (metrics.ValueKind == JsonValueKind.Object)
         {
             foreach (var prop in metrics.EnumerateObject())
             {
                 list.Add(new KeyValuePair<string, object>(prop.Name, prop.Value));
             }
         }
         return list;
    }

    private async Task LoadData()
    {
        if (string.IsNullOrEmpty(_selectedSport)) return;
        
        _isLoadingData = true;
        StateHasChanged(); // Force UI update
        
        try
        {
            var series = _selectedSport == "nascar" ? "cup" : null;
            
            var data = await MLClient.GetDataAsync(
                _selectedSport, 
                limit: _pageSize, 
                skip: _currentPage * _pageSize,
                seasonMin: _selectedSeason,
                seasonMax: _selectedSeason,
                series: series,
                driver: _selectedDriver,
                trackType: _selectedTrackType
            );
            
            _dataSchema = data;
            _tableItems = data.Rows;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingData = false;
             StateHasChanged();
        }
    }
    
    private async Task PrevPage()
    {
        if (_currentPage > 0)
        {
            _currentPage--;
            await LoadData();
        }
    }

    private async Task NextPage()
    {
        if (((_currentPage + 1) * _pageSize) < (_dataSchema?.TotalRows ?? 0))
        {
            _currentPage++;
            await LoadData();
        }
    }

    private async Task OnFilterChanged()
    {
        _currentPage = 0;
        await LoadData();
    }

    private async Task StartTraining()
    {
        _isTraining = true;
        _showTrainingDialog = true;
        _trainingStatus = "running";
        _trainingProgress.Clear();
        _trainingProgress.Add($"Starting {_trainingSport} training...");
        
        try
        {
             var hyperparams = new Dictionary<string, object>
            {
                { "model_type", _selectedModelType },
                { "n_estimators", _nEstimators }
            };

            if (_maxDepth.HasValue) hyperparams.Add("max_depth", _maxDepth.Value);
            if (_trainingTask == "classification") hyperparams.Add("class_weight", _classWeight);

            _trainingResult = await MLClient.TrainAsync(
                sport: _trainingSport,
                task: _trainingTask,
                testStartSeason: _testStartSeason,
                trainStartSeason: _trainStartSeason,
                series: _trainingSport == "nascar" ? _nascarSeries : null,
                hyperparameters: hyperparams
            );
            
            _trainingStatus = "completed";
            _trainingProgress.Add("Training completed successfully!");
            _trainingProgress.Add($"Model saved: {_trainingResult.ModelPath}");
        }
        catch (Exception ex)
        {
            _trainingStatus = "failed";
            _trainingProgress.Add($"Error: {ex.Message}");
        }
        finally
        {
            _isTraining = false;
        }
    }

    private void CloseTrainingDialog() => _showTrainingDialog = false;

    private string FormatMetricValue(object value)
    {
        if (value is JsonElement el)
        {
             if (el.ValueKind == JsonValueKind.Number && el.TryGetDouble(out var d)) return d.ToString("F4");
             return el.ToString();
        }
        return value?.ToString() ?? "N/A";
    }

    private async Task LoadModels()
    {
        _isLoadingModels = true;
        try
        {
            var allModels = new List<ModelInfo>();
            foreach (var sport in _availableSports)
            {
                allModels.AddRange(await MLClient.GetModelsAsync(sport));
            }
            _trainedModels = allModels.OrderByDescending(m => m.LastUpdated).ToList();
        }
        finally { _isLoadingModels = false; }
    }

    private async Task DeleteModel(ModelInfo model)
    {
         // Simple confirmation using JS runtime or just delete for now (Dialog replacement is complex without custom verify modal)
         // For now, we will just delete to keep it simple, or we could add a "Confirm" boolean state.
         // Let's implement a simple "Double Click" or just direct delete for this migration to save time on a Confirm Modal.
         // Or better, use the JS confirm.
         
         try 
         {
             await MLClient.DeleteModelAsync(model.Sport, model.Series, model.Task);
             Snackbar.Add("Model deleted", Severity.Success);
             await LoadModels();
         }
         catch (Exception ex)
         {
             Snackbar.Add($"Error: {ex.Message}", Severity.Error);
         }
    }
}
