@page "/nfl-game-results-tailwind"
@rendermode InteractiveServer
@inject HttpClient Http
@using System.Net.Http.Json

<PageTitle>NFL Results (Tailwind Demo)</PageTitle>

<div class="min-h-screen bg-slate-950 text-slate-100 p-4 md:p-8 font-sans">
    <TwContainer MaxWidth="7xl">
        
        <!-- Header Section -->
        <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
            <div class="flex items-center gap-3">
                <div class="bg-blue-600 p-3 rounded-xl shadow-lg shadow-blue-900/20">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m.599-1c.538-.013 1.05-.139 1.503-.362M12 16c-1.11 0-2.08-.402-2.599-1M12 16v1m0-1V7m0 0v1m-.599-1C10.863 6.013 10.35 6.139 9.897 6.362"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-3xl font-bold tracking-tight">NFL Analytics</h1>
                    <p class="text-slate-400 text-sm">Historical Results & Performance Data</p>
                </div>
            </div>

            <!-- Dashboard Filters -->
            <div class="flex flex-wrap items-center gap-3 bg-slate-900/50 p-3 rounded-2xl border border-slate-800 backdrop-blur-sm">
                <TwSelect TValue="int" @bind-Value="_selectedSeason">
                    @foreach (var season in _availableSeasons)
                    {
                        <option value="@season">Season @season</option>
                    }
                </TwSelect>

                <TwSelect TValue="int?" @bind-Value="_selectedWeek" Placeholder="All Weeks">
                    @for (int i = 1; i <= 18; i++)
                    {
                        <option value="@i">Week @i</option>
                    }
                </TwSelect>

                <TwSelect TValue="string?" @bind-Value="_selectedTeam" Placeholder="All Teams">
                    @foreach (var team in _nflTeams.OrderBy(t => t.Value))
                    {
                        <option value="@team.Key">@team.Value</option>
                    }
                </TwSelect>

                <TwButton Variant="primary" OnClick="LoadResults" IsLoading="_isLoading" Disabled="_isLoading">
                    Refresh Data
                </TwButton>
            </div>
        </header>

        <!-- Loading State -->
        @if (_isLoading)
        {
            <div class="mb-8">
                <TwProgressBar Indeterminate="true" Color="blue" Size="sm" />
            </div>
        }

        <!-- Games Grid -->
        @if (_games.Any())
        {
            <TwGrid Cols="1" ColsMd="2" ColsLg="3" Gap="6">
                @foreach (var game in _games)
                {
                    <TwCard Color="blue">
                        <HeaderContent>
                            <TwChip Size="sm" Color="slate">Week @game.Week • @game.GameDate</TwChip>
                        </HeaderContent>
                        <StatusContent>
                            @if (game.IsCompleted)
                            {
                                <TwChip Size="sm" Color="emerald" ShowDot="true" Pulse="true">FINAL</TwChip>
                            }
                        </StatusContent>
                        <ChildContent>
                            <!-- Matchup Area -->
                            <div class="flex flex-col gap-6">
                                <!-- Away Team -->
                                <div class="flex items-center justify-between group-hover:translate-x-1 transition-transform">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 bg-slate-800 rounded-2xl flex items-center justify-center border border-slate-700 shadow-inner">
                                            <span class="text-xl font-black text-slate-300">@game.AwayTeam.Substring(0, 1)</span>
                                        </div>
                                        <span class="text-lg font-bold @(game.AwayScore > game.HomeScore ? "text-white" : "text-slate-400")">@game.AwayTeam</span>
                                    </div>
                                    <span class="text-3xl font-black tracking-tighter @(game.AwayScore > game.HomeScore ? "text-emerald-400" : "text-slate-600")">@game.AwayScore</span>
                                </div>

                                <div class="h-[1px] bg-gradient-to-r from-transparent via-slate-800 to-transparent"></div>

                                <!-- Home Team -->
                                <div class="flex items-center justify-between group-hover:translate-x-1 transition-transform">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 bg-slate-800 rounded-2xl flex items-center justify-center border border-slate-700 shadow-inner">
                                            <span class="text-xl font-black text-slate-300">@game.HomeTeam.Substring(0, 1)</span>
                                        </div>
                                        <span class="text-lg font-bold @(game.HomeScore > game.AwayScore ? "text-white" : "text-slate-400")">@game.HomeTeam</span>
                                    </div>
                                    <span class="text-3xl font-black tracking-tighter @(game.HomeScore > game.AwayScore ? "text-emerald-400" : "text-slate-600")">@game.HomeScore</span>
                                </div>
                            </div>
                        </ChildContent>
                    </TwCard>
                }
            </TwGrid>
            
            <div class="mt-6 text-center">
                <TwChip Color="slate" Size="lg">Showing @_games.Count games</TwChip>
            </div>
        }
        else if (!_isLoading)
        {
            <TwCard Hoverable="false" Color="slate" Class="text-center">
                <ChildContent>
                    <div class="py-12">
                        <svg class="w-16 h-16 text-slate-700 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 9.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <h3 class="text-xl font-semibold text-slate-400">No analytical data found</h3>
                        <p class="text-slate-600 mt-2">Try adjusting your time period or team filters.</p>
                    </div>
                </ChildContent>
            </TwCard>
        }
    </TwContainer>
</div>

@code {
    private int _selectedSeason = 2025;
    private int? _selectedWeek;
    private string? _selectedTeam;
    private bool _isLoading = false;
    private List<int> _availableSeasons = new() { 2025, 2024, 2023, 2022 };
    private List<NFLGame> _games = new();

    private readonly Dictionary<string, string> _nflTeams = new()
    {
        { "ARI", "Cardinals" }, { "ATL", "Falcons" }, { "BAL", "Ravens" }, { "BUF", "Bills" },
        { "CAR", "Panthers" }, { "CHI", "Bears" }, { "CIN", "Bengals" }, { "CLE", "Browns" },
        { "DAL", "Cowboys" }, { "DEN", "Broncos" }, { "DET", "Lions" }, { "GB", "Packers" },
        { "HOU", "Texans" }, { "IND", "Colts" }, { "JAX", "Jaguars" }, { "KC", "Chiefs" },
        { "LV", "Raiders" }, { "LAC", "Chargers" }, { "LAR", "Rams" }, { "MIA", "Dolphins" },
        { "MIN", "Vikings" }, { "NE", "Patriots" }, { "NO", "Saints" }, { "NYG", "Giants" },
        { "NYJ", "Jets" }, { "PHI", "Eagles" }, { "PIT", "Steelers" }, { "SF", "49ers" },
        { "SEA", "Seahawks" }, { "TB", "Buccaneers" }, { "TEN", "Titans" }, { "WAS", "Commanders" }
    };

    protected override async Task OnInitializedAsync()
    {
        _availableSeasons = Enumerable.Range(2020, 6).Reverse().ToList();
        _selectedSeason = _availableSeasons.First();
        await LoadResults();
    }

    private async Task LoadResults()
    {
        _isLoading = true;
        StateHasChanged();
        
        try
        {
            var url = $"http://backend:8000/db/games/nfl/schedule?limit=50&season={_selectedSeason}";
            if (_selectedWeek.HasValue) url += $"&week={_selectedWeek}";
            if (!string.IsNullOrEmpty(_selectedTeam)) url += $"&team={Uri.EscapeDataString(_selectedTeam)}";

            var response = await Http.GetFromJsonAsync<NFLTailwindScheduleResponse>(url);
            _games = (response?.Games ?? new())
                .Select(g => new NFLGame {
                    Week = g.Week ?? 0,
                    GameDate = g.GameDate ?? "TBD",
                    HomeTeam = g.HomeTeam ?? "Home",
                    AwayTeam = g.AwayTeam ?? "Away",
                    HomeScore = g.HomeScore ?? 0,
                    AwayScore = g.AwayScore ?? 0,
                    IsCompleted = g.IsCompleted ?? (g.HomeScore > 0 || g.AwayScore > 0)
                })
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            _games = GenerateSampleGames();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private List<NFLGame> GenerateSampleGames()
    {
        return new List<NFLGame> {
            new NFLGame { Week = 18, GameDate = "Jan 7, 2024", HomeTeam = "Packers", AwayTeam = "Bears", HomeScore = 17, AwayScore = 9, IsCompleted = true },
            new NFLGame { Week = 17, GameDate = "Dec 31, 2023", HomeTeam = "Ravens", AwayTeam = "Dolphins", HomeScore = 56, AwayScore = 19, IsCompleted = true },
            new NFLGame { Week = 16, GameDate = "Dec 24, 2023", HomeTeam = "Dolphins", AwayTeam = "Cowboys", HomeScore = 22, AwayScore = 20, IsCompleted = true }
        };
    }

    public class NFLTailwindScheduleResponse { public List<NFLTailwindGameItem> Games { get; set; } = new(); }
    public class NFLTailwindGameItem {
        [System.Text.Json.Serialization.JsonPropertyName("game_id")]
        public string? GameId { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("week")]
        public int? Week { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("game_date")]
        public string? GameDate { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("home_team")]
        public string? HomeTeam { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("away_team")]
        public string? AwayTeam { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("home_score")]
        public int? HomeScore { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("away_score")]
        public int? AwayScore { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("is_completed")]
        public bool? IsCompleted { get; set; }
    }
    public class NFLGame {
        public int Week { get; set; }
        public string GameDate { get; set; } = "";
        public string HomeTeam { get; set; } = "";
        public string AwayTeam { get; set; } = "";
        public int HomeScore { get; set; }
        public int AwayScore { get; set; }
        public bool IsCompleted { get; set; }
    }
}
