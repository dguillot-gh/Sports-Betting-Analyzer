@page "/model-playground"
@using System.Text.Json
@using System.Text
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Model Playground - Sports Betting Analyzer</PageTitle>

<!-- Loading Dialog Overlay -->
@if (_showLoadingDialog)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-sm">
        <div class="bg-slate-900 border border-slate-700 p-8 rounded-2xl max-w-md w-full text-center shadow-2xl">
            <div class="w-12 h-12 border-4 border-blue-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
            <h3 class="text-xl font-bold text-white mb-2">@_loadingTitle</h3>
            <p class="text-slate-400 mb-2">@_loadingMessage</p>
            @if (!string.IsNullOrEmpty(_loadingDetail))
            {
                <p class="text-xs text-blue-400 font-mono mb-4">@_loadingDetail</p>
            }
            <TwProgressBar Indeterminate="true" Color="blue" Height="h-1" />
        </div>
    </div>
}

<TwContainer MaxWidth="extraLarge" Class="mt-8">
    <div class="space-y-6">
        <!-- Header -->
        <TwCard Class="p-6">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-indigo-500/10 rounded-xl">
                    <TwIcon Icon="science" Class="w-8 h-8 text-indigo-500" />
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-slate-100">Model Playground</h1>
                    <p class="text-slate-400">Train and compare predictions from Simple, Kyle, and Apex models</p>
                </div>
            </div>
        </TwCard>

        <TwTabs DefaultTab="0">
            <!-- Training Tab -->
            <TwTabPanel Title="Training" TabIcon="@Icons.Material.Filled.ModelTraining">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-6">
                    <!-- Training Config -->
                    <TwCard Class="p-6 h-full">
                        <div class="flex items-center gap-2 mb-6">
                            <TwIcon Icon="fitness_center" Class="text-blue-500" />
                            <h3 class="font-bold text-slate-100">Train Apex Model</h3>
                        </div>

                        <div class="space-y-6">
                            <TwSelect TValue="string" @bind-Value="_trainSport" Label="Sport" FullWidth="true">
                                <option value="all">All (NBA + NFL)</option>
                                <option value="nba">NBA Only</option>
                                <option value="nfl">NFL Only</option>
                            </TwSelect>

                            <div>
                                <div class="flex justify-between mb-2">
                                    <label class="text-sm text-slate-400">Epochs</label>
                                    <span class="text-sm font-bold text-slate-200">@_epochs</span>
                                </div>
                                <input type="range" min="100" max="1000" step="100" @bind="_epochs" @bind:event="oninput" 
                                       class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-blue-500" />
                            </div>

                            <TwButton Variant="solid" Color="blue" OnClick="TrainApex" Disabled="@_isTraining" FullWidth="true" Class="h-12">
                                @if (_isTraining) { <span>Training...</span> } else { <span class="flex items-center gap-2"><TwIcon Icon="play_arrow" /> Train Model</span> }
                            </TwButton>

                            @if (_trainingResult != null)
                            {
                                <TwAlert Severity="success">
                                    <div class="max-h-40 overflow-y-auto text-xs font-mono">
                                        <pre>@JsonSerializer.Serialize(_trainingResult, new JsonSerializerOptions { WriteIndented = true })</pre>
                                    </div>
                                </TwAlert>
                            }
                        </div>
                    </TwCard>

                    <!-- Model Status -->
                    <TwCard Class="p-6 h-full">
                         <div class="flex items-center justify-between mb-6">
                            <div class="flex items-center gap-2">
                                <TwIcon Icon="model_training" Class="w-12 h-12 mb-4 opacity-50" />
                                <h3 class="font-bold text-slate-100">Model Status</h3>
                            </div>
                            <TwButton Variant="outline" Size="sm" OnClick="LoadModelStatus">Refresh</TwButton>
                        </div>

                        @if (_modelStatus != null)
                        {
                            <div class="overflow-hidden rounded-xl border border-slate-700">
                                <table class="w-full text-sm text-left text-slate-300">
                                    <thead class="bg-slate-800 text-slate-400 uppercase text-xs">
                                        <tr>
                                            <th class="px-4 py-3">Model</th>
                                            <th class="px-4 py-3">Available</th>
                                            <th class="px-4 py-3">Features</th>
                                            <th class="px-4 py-3">Accuracy</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-700 bg-slate-900/50">
                                        <tr>
                                            <td class="px-4 py-3 font-medium text-slate-200">Simple</td>
                                            <td class="px-4 py-3"><TwIcon Icon="check_circle" Class="text-emerald-500 w-5 h-5" /></td>
                                            <td class="px-4 py-3">10</td>
                                            <td class="px-4 py-3">~55%</td>
                                        </tr>
                                        <tr>
                                            <td class="px-4 py-3 font-medium text-slate-200">Kyle</td>
                                            <td class="px-4 py-3"><TwIcon Icon="check_circle" Class="text-emerald-500 w-5 h-5" /></td>
                                            <td class="px-4 py-3">106</td>
                                            <td class="px-4 py-3">68.9%</td>
                                        </tr>
                                        <tr>
                                            <td class="px-4 py-3 font-medium text-slate-200">Apex (NBA)</td>
                                            <td class="px-4 py-3">
                                                @if (GetStatusBool("nba_available")) { <TwIcon Icon="check_circle" Class="text-emerald-500 w-5 h-5" /> }
                                                else { <TwIcon Icon="cancel" Class="text-red-500 w-5 h-5" /> }
                                            </td>
                                            <td class="px-4 py-3">@GetStatusValue("nba_features", "0")</td>
                                            <td class="px-4 py-3">@GetTrainingAccuracy("nba")%</td>
                                        </tr>
                                         <tr>
                                            <td class="px-4 py-3 font-medium text-slate-200">Apex (NFL)</td>
                                            <td class="px-4 py-3">
                                                @if (GetStatusBool("nfl_available")) { <TwIcon Icon="check_circle" Class="text-emerald-500 w-5 h-5" /> }
                                                else { <TwIcon Icon="cancel" Class="text-red-500 w-5 h-5" /> }
                                            </td>
                                            <td class="px-4 py-3">@GetStatusValue("nfl_features", "0")</td>
                                            <td class="px-4 py-3">@GetTrainingAccuracy("nfl")%</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        }
                    </TwCard>
                </div>
            </TwTabPanel>

            <!-- NBA Comparison Tab -->
            <TwTabPanel Title="NBA Comparison" TabIcon="@Icons.Material.Filled.SportsBasketball">
                <div class="pt-6 space-y-6">
                    <TwCard Class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <!-- Custom Autocomplete for Home Team -->
                            <div class="relative">
                                <label class="block text-xs text-slate-500 mb-1 font-medium">Home Team</label>
                                <input type="text" @bind="_nbaHomeTeam" placeholder="Search..." class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2 text-slate-200 focus:outline-none focus:border-blue-500" />
                            </div>
                             <div class="relative">
                                <label class="block text-xs text-slate-500 mb-1 font-medium">Away Team</label>
                                <input type="text" @bind="_nbaAwayTeam" placeholder="Search..." class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2 text-slate-200 focus:outline-none focus:border-blue-500" />
                            </div>
                             <div>
                                <label class="block text-xs text-slate-500 mb-1 font-medium">O/U Line</label>
                                <input type="number" @bind="_nbaTotalLine" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2 text-slate-200 focus:outline-none focus:border-blue-500" />
                            </div>
                        </div>

                        <TwButton Variant="solid" Color="blue" OnClick="CompareNba" Disabled="@_isComparing" Class="mt-6" FullWidth="true">
                            @if (_isComparing) { <span>Comparing...</span> } else { <span>Compare All Models</span> }
                        </TwButton>
                    </TwCard>

                    @if (_nbaComparison != null)
                    {
                        <div>
                            <h3 class="font-bold text-slate-100 mb-4">Results</h3>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                @foreach (var model in GetModels())
                                {
                                    <TwCard Class="p-6 border-t-4 border-t-blue-500">
                                         <h4 class="font-bold text-lg text-slate-100 mb-4 uppercase">@model</h4>
                                         @{
                                             var modelData = GetModelResult(model);
                                             if (modelData != null)
                                             {
                                                 if (modelData.Value.TryGetProperty("error", out var error))
                                                 {
                                                     <p class="text-red-400 text-sm">@error.GetString()</p>
                                                 }
                                                 else
                                                 {
                                                     <div class="space-y-2">
                                                         <div class="flex justify-between">
                                                             <span class="text-slate-400">Winner</span>
                                                             <span class="font-bold text-emerald-400">@GetJsonValue(modelData.Value, "predicted_winner")</span>
                                                         </div>
                                                          <div class="flex justify-between">
                                                             <span class="text-slate-400">Confidence</span>
                                                             <span class="font-bold text-slate-200">@GetJsonValue(modelData.Value, "confidence")%</span>
                                                         </div>
                                                         <div class="h-px bg-slate-700 my-2"></div>
                                                          <div class="flex justify-between text-sm">
                                                             <span class="text-slate-500">Home Win %</span>
                                                             <span class="text-slate-300">@(GetJsonDouble(modelData.Value, "home_win_probability") * 100)%</span>
                                                         </div>
                                                          <div class="flex justify-between text-sm">
                                                             <span class="text-slate-500">Away Win %</span>
                                                             <span class="text-slate-300">@(GetJsonDouble(modelData.Value, "away_win_probability") * 100)%</span>
                                                         </div>
                                                     </div>
                                                 }
                                             }
                                         }
                                    </TwCard>
                                }
                            </div>
                        </div>
                    }
                </div>
            </TwTabPanel>

            <!-- NFL Comparison Tab -->
             <TwTabPanel Title="NFL Comparison" TabIcon="@Icons.Material.Filled.SportsFootball">
                <div class="pt-6 space-y-6">
                    <TwCard Class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                             <div class="relative">
                                <label class="block text-xs text-slate-500 mb-1 font-medium">Home Team</label>
                                <input type="text" @bind="_nflHomeTeam" placeholder="KC..." class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2 text-slate-200 focus:outline-none focus:border-blue-500" />
                            </div>
                             <div class="relative">
                                <label class="block text-xs text-slate-500 mb-1 font-medium">Away Team</label>
                                <input type="text" @bind="_nflAwayTeam" placeholder="PHI..." class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2 text-slate-200 focus:outline-none focus:border-blue-500" />
                            </div>
                             <div>
                                <label class="block text-xs text-slate-500 mb-1 font-medium">O/U Line</label>
                                <input type="number" @bind="_nflTotalLine" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2 text-slate-200 focus:outline-none focus:border-blue-500" />
                            </div>
                        </div>

                        <TwButton Variant="solid" Color="blue" OnClick="CompareNfl" Disabled="@_isComparing" Class="mt-6" FullWidth="true">
                            @if (_isComparing) { <span>Comparing...</span> } else { <span>Compare Models</span> }
                        </TwButton>

                        <TwAlert Severity="info" Class="mt-4">
                            Note: Kyle model is NBA-only. NFL comparison shows Simple and Apex models.
                        </TwAlert>
                    </TwCard>

                    @if (_nflComparison != null)
                    {
                        <div>
                            <h3 class="font-bold text-slate-100 mb-4">Results</h3>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                @foreach (var model in GetModels())
                                {
                                    <TwCard Class="p-6 border-t-4 border-t-emerald-500">
                                         <h4 class="font-bold text-lg text-slate-100 mb-4 uppercase">@model</h4>
                                         @{
                                             var modelData = GetNflModelResult(model);
                                             if (modelData != null)
                                             {
                                                 if (modelData.Value.TryGetProperty("error", out var error))
                                                 {
                                                     <p class="text-red-400 text-sm">@error.GetString()</p>
                                                 }
                                                 else
                                                 {
                                                      <div class="space-y-2">
                                                         <div class="flex justify-between">
                                                             <span class="text-slate-400">Winner</span>
                                                             <span class="font-bold text-emerald-400">@GetJsonValue(modelData.Value, "predicted_winner")</span>
                                                         </div>
                                                          <div class="flex justify-between">
                                                             <span class="text-slate-400">Confidence</span>
                                                             <span class="font-bold text-slate-200">@GetJsonValue(modelData.Value, "confidence")%</span>
                                                         </div>
                                                         <div class="h-px bg-slate-700 my-2"></div>
                                                          <div class="flex justify-between text-sm">
                                                             <span class="text-slate-500">Home Win %</span>
                                                             <span class="text-slate-300">@(GetJsonDouble(modelData.Value, "home_win_probability") * 100)%</span>
                                                         </div>
                                                          <div class="flex justify-between text-sm">
                                                             <span class="text-slate-500">Away Win %</span>
                                                             <span class="text-slate-300">@(GetJsonDouble(modelData.Value, "away_win_probability") * 100)%</span>
                                                         </div>
                                                     </div>
                                                 }
                                             }
                                         }
                                    </TwCard>
                                }
                            </div>
                        </div>
                    }
                </div>
            </TwTabPanel>

            <!-- Verification Tab -->
            <TwTabPanel Title="Verification" TabIcon="@Icons.Material.Filled.VerifiedUser">
                <div class="pt-6 space-y-6">
                    <TwCard Class="p-6">
                         <h3 class="font-bold text-slate-100 mb-2">Backtest on Historical Games</h3>
                         <p class="text-slate-400 text-sm mb-6">Test all models on past games where we know the outcome. This gives concrete proof of which model is more accurate.</p>

                         <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                             <TwSelect TValue="string" @bind-Value="_backtestSport" Label="Sport" FullWidth="true">
                                <option value="nfl">NFL</option>
                                <option value="nba">NBA</option>
                             </TwSelect>
                             <div>
                                 <label class="block text-xs text-slate-500 mb-1 font-medium">Test Year</label>
                                 <input type="number" @bind="_backtestYear" min="2020" max="2025" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2 text-slate-200 focus:outline-none focus:border-blue-500" />
                             </div>
                              <div>
                                <div class="flex justify-between mb-2">
                                    <label class="text-sm text-slate-400">Sample Size</label>
                                    <span class="text-sm font-bold text-slate-200">@_backtestSampleSize</span>
                                </div>
                                <input type="range" min="10" max="100" step="10" @bind="_backtestSampleSize" @bind:event="oninput" 
                                       class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-emerald-500" />
                            </div>
                         </div>

                         <TwButton Variant="solid" Color="emerald" OnClick="RunBacktest" Disabled="@_isBacktesting" Class="mt-6" FullWidth="true">
                            @if (_isBacktesting) { <span>Running Backtest...</span> } else { <span>Run Backtest</span> }
                        </TwButton>
                    </TwCard>
                    
                    @if (_backtestResult != null)
                    {
                        <TwCard Class="p-6">
                            <div class="flex items-center gap-2 mb-4 text-emerald-400">
                                <TwIcon Icon="analytics" />
                                <h3 class="font-bold">Results: @GetBacktestValue("games_tested") Games Tested</h3>
                            </div>
                            
                            @if (HasBacktestNote())
                            {
                                <div class="bg-blue-500/10 border border-blue-500/30 p-4 rounded-xl text-blue-300 text-sm mb-6">
                                    @GetBacktestValue("note")
                                </div>
                            }
                            
                            <table class="w-full text-sm text-left text-slate-300 mb-6">
                                <thead class="bg-emerald-900/40 text-emerald-200 uppercase text-xs">
                                    <tr>
                                        <th class="px-4 py-3 rounded-l-lg">Model</th>
                                        <th class="px-4 py-3">Correct</th>
                                        <th class="px-4 py-3">Total</th>
                                        <th class="px-4 py-3">Accuracy</th>
                                        <th class="px-4 py-3 rounded-r-lg">Result</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-800">
                                    @foreach (var model in GetModels())
                                    {
                                        var modelStats = GetBacktestModelStats(model);
                                        var accuracy = GetBacktestAccuracy(model);
                                        var isBest = accuracy > 0 && accuracy >= GetBestAccuracy();
                                        <tr class="@(isBest ? "bg-emerald-500/10" : "")">
                                            <td class="px-4 py-3 font-bold text-slate-200 uppercase">@model</td>
                                            <td class="px-4 py-3">@GetModelStatValue(modelStats, "correct")</td>
                                            <td class="px-4 py-3">@GetModelStatValue(modelStats, "total")</td>
                                            <td class="px-4 py-3 font-bold @(accuracy >= 60 ? "text-emerald-400" : (accuracy >= 50 ? "text-amber-400" : "text-red-400"))">
                                                @accuracy%
                                            </td>
                                            <td class="px-4 py-3">
                                                 @if (isBest && accuracy > 0)
                                                 {
                                                     <TwChip Color="emerald" Size="xs">BEST</TwChip>
                                                 }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            
                             <div class="border border-slate-700 rounded-xl overflow-hidden bg-slate-900/50">
                                <div class="p-4 cursor-pointer flex justify-between items-center hover:bg-slate-800/50" @onclick="() => _showGameLog = !_showGameLog">
                                    <span class="font-bold text-slate-300">View Game-by-Game Results</span>
                                    <svg class="w-5 h-5 text-slate-500 transform transition-transform @(_showGameLog ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                </div>
                                @if (_showGameLog)
                                {
                                    <div class="max-h-80 overflow-y-auto border-t border-slate-700">
                                        <table class="w-full text-xs text-left text-slate-300">
                                            <thead class="bg-slate-800 sticky top-0">
                                                <tr>
                                                    <th class="px-4 py-2">Game</th>
                                                    <th class="px-4 py-2">Actual Winner</th>
                                                    <th class="px-4 py-2">Simple</th>
                                                    <th class="px-4 py-2">Kyle</th>
                                                    <th class="px-4 py-2">Apex</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-800">
                                                @foreach (var game in GetGameResults())
                                                {
                                                    <tr class="hover:bg-slate-800/30">
                                                        <td class="px-4 py-2">@GetGameTeams(game)</td>
                                                        <td class="px-4 py-2 font-bold text-slate-200">@GetGameValue(game, "actual_winner")</td>
                                                        <td class="px-4 py-2">@RenderPrediction(game, "simple")</td>
                                                        <td class="px-4 py-2">@RenderPrediction(game, "kyle")</td>
                                                        <td class="px-4 py-2">@RenderPrediction(game, "apex")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                             </div>
                        </TwCard>
                    }
                </div>
            </TwTabPanel>
        </TwTabs>
    </div>
</TwContainer>

@code {
    // Training state
    private string _trainSport = "all";
    private int _epochs = 500;
    private bool _isTraining = false;
    private JsonElement? _trainingResult;
    private JsonElement? _modelStatus;
    
    // Loading dialog state
    private bool _showLoadingDialog = false;
    private string _loadingTitle = "";
    private string _loadingMessage = "";
    private string _loadingDetail = "";
    
    // NBA comparison state (No autocomplete logic needed now, using simple inputs)
    private string _nbaHomeTeam = "Boston Celtics";
    private string _nbaAwayTeam = "Los Angeles Lakers";
    private double _nbaTotalLine = 225.0;
    private bool _isComparing = false;
    private JsonElement? _nbaComparison;
    
    // NFL comparison state
    private string _nflHomeTeam = "KC";
    private string _nflAwayTeam = "PHI";
    private double _nflTotalLine = 45.0;
    private JsonElement? _nflComparison;
    
    // Backtest state
    private string _backtestSport = "nfl";
    private int _backtestYear = 2024;
    private int _backtestSampleSize = 50;
    private bool _isBacktesting = false;
    private JsonElement? _backtestResult;
    private bool _showGameLog = false;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadModelStatus();
    }
    
    private void ShowLoading(string title, string message, string detail)
    {
        _loadingTitle = title;
        _loadingMessage = message;
        _loadingDetail = detail;
        _showLoadingDialog = true;
        StateHasChanged();
    }
    
    private void HideLoading()
    {
        _showLoadingDialog = false;
        StateHasChanged();
    }
    
    private void UpdateLoadingDetail(string detail)
    {
        _loadingDetail = detail;
        StateHasChanged();
    }
    
    private async Task TrainApex()
    {
        _isTraining = true;
        ShowLoading("Training Apex Model", $"Training {_trainSport.ToUpper()} model with {_epochs} epochs...", "Loading training data and initializing XGBoost...");
        
        try
        {
            UpdateLoadingDetail("Running cross-validation (5-fold TimeSeriesSplit)...");
            var response = await Http.PostAsync($"http://backend:8000/apex/train?sport={_trainSport}&epochs={_epochs}", null);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _trainingResult = JsonSerializer.Deserialize<JsonElement>(json);
                 Snackbar.Add("Training complete!", Severity.Success);
                 await LoadModelStatus();
            }
            else { Snackbar.Add("Training failed", Severity.Error); }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _isTraining = false; HideLoading(); }
    }
    
    private async Task LoadModelStatus()
    {
        try
        {
            var response = await Http.GetAsync("http://backend:8000/apex/status");
            if (response.IsSuccessStatusCode)
            {
                _modelStatus = JsonSerializer.Deserialize<JsonElement>(await response.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error loading status: {ex.Message}", Severity.Warning); }
        StateHasChanged();
    }
    
    private async Task CompareNba()
    {
        _isComparing = true;
        StateHasChanged();
        try
        {
            var url = $"http://backend:8000/apex/compare/nba?home_team={Uri.EscapeDataString(_nbaHomeTeam)}&away_team={Uri.EscapeDataString(_nbaAwayTeam)}&total_line={_nbaTotalLine}";
            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                _nbaComparison = JsonSerializer.Deserialize<JsonElement>(await response.Content.ReadAsStringAsync());
                Snackbar.Add("Comparison complete!", Severity.Success);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _isComparing = false; StateHasChanged(); }
    }
    
    private async Task CompareNfl()
    {
         _isComparing = true;
        StateHasChanged();
        try
        {
            var url = $"http://backend:8000/apex/compare/nfl?home_team={Uri.EscapeDataString(_nflHomeTeam)}&away_team={Uri.EscapeDataString(_nflAwayTeam)}&total_line={_nflTotalLine}";
            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                _nflComparison = JsonSerializer.Deserialize<JsonElement>(await response.Content.ReadAsStringAsync());
                Snackbar.Add("Comparison complete!", Severity.Success);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _isComparing = false; StateHasChanged(); }
    }
    
