@page "/nhl-live-odds"
@using System.Text.Json
@using SportsBettingAnalyzer.Services
@using SportsBettingAnalyzer.Models
@using SportsBettingAnalyzer.Shared.Services
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ILogger<NHLLiveOdds> Logger
@inject PythonMLServiceClient MLServiceClient
@rendermode InteractiveServer

<TwContainer>
    <!-- Loading Overlay for NHL Analysis -->
    <TwLoadingOverlay 
        IsVisible="@_isLoading"
        Title="Analyzing NHL Games..."
        Color="purple"
        CurrentStatusMessage="@_analysisStatus"
        ShowProgress="false" />
    <div class="px-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white tracking-tight">NHL Live Betting Odds</h1>
            <p class="text-slate-400 mt-1">AI-powered NHL predictions using rolling team statistics and xG data.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
             <TwSelect TValue="string" @bind-Value="_selectedSportsbook" Label="Book" Class="w-32">
                <option value="fanduel">FanDuel</option>
                <option value="draftkings">DraftKings</option>
                <option value="betmgm">BetMGM</option>
            </TwSelect>
            <TwButton Variant="primary" OnClick="RunAnalysis" IsLoading="@_isLoading" Disabled="@_isLoading">
                <TwIcon Icon="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" Class="w-4 h-4 mr-2" />
                Analyze Games
            </TwButton>
        </div>
    </div>

    <!-- XGBoost Model Performance Card -->
    <div class="mb-8 p-6 rounded-2xl bg-gradient-to-br from-purple-900/30 to-blue-900/30 border border-purple-500/30 shadow-2xl">
        <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
                <div class="p-3 bg-purple-500/20 rounded-xl">
                    <TwIcon Icon="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" Class="w-6 h-6 text-purple-400" />
                </div>
                <div>
                    <h3 class="text-lg font-bold text-white">XGBoost Model Performance</h3>
                    <p class="text-xs text-slate-400">5-Fold Walk-Forward Validation • 2,000 Training Samples</p>
                </div>
            </div>
            <TwChip Color="purple" Size="sm" Variant="solid">BACKTESTED</TwChip>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <!-- Win Rate -->
            <div class="p-4 rounded-xl bg-slate-900/50 border border-slate-700/50">
                <div class="flex items-center gap-2 mb-2">
                    <TwIcon Icon="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-4 h-4 text-emerald-400" />
                    <span class="text-xs text-slate-500 font-medium uppercase">Win Rate</span>
                </div>
                <div class="text-2xl font-bold text-emerald-400">58.0%</div>
                <div class="text-xs text-slate-500 mt-1">58W-42L (100 bets)</div>
            </div>

            <!-- ROI -->
            <div class="p-4 rounded-xl bg-slate-900/50 border border-slate-700/50">
                <div class="flex items-center gap-2 mb-2">
                    <TwIcon Icon="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" Class="w-4 h-4 text-blue-400" />
                    <span class="text-xs text-slate-500 font-medium uppercase">ROI</span>
                </div>
                <div class="text-2xl font-bold text-blue-400">+4.9%</div>
                <div class="text-xs text-slate-500 mt-1">$487.50 profit</div>
            </div>

            <!-- Accuracy -->
            <div class="p-4 rounded-xl bg-slate-900/50 border border-slate-700/50">
                <div class="flex items-center gap-2 mb-2">
                    <TwIcon Icon="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" Class="w-4 h-4 text-amber-400" />
                    <span class="text-xs text-slate-500 font-medium uppercase">ML Accuracy</span>
                </div>
                <div class="text-2xl font-bold text-amber-400">57.8%</div>
                <div class="text-xs text-slate-500 mt-1">±2.3% std dev</div>
            </div>

            <!-- Sharpe Ratio -->
            <div class="p-4 rounded-xl bg-slate-900/50 border border-slate-700/50">
                <div class="flex items-center gap-2 mb-2">
                    <TwIcon Icon="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" Class="w-4 h-4 text-purple-400" />
                    <span class="text-xs text-slate-500 font-medium uppercase">Sharpe</span>
                </div>
                <div class="text-2xl font-bold text-purple-400">1.18</div>
                <div class="text-xs text-slate-500 mt-1">Risk-adjusted</div>
            </div>
        </div>

        <div class="mt-4 p-3 rounded-lg bg-slate-900/30 border border-slate-700/30">
            <div class="flex items-start gap-2">
                <TwIcon Icon="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-4 h-4 text-blue-400 mt-0.5 flex-shrink-0" />
                <p class="text-xs text-slate-400">
                    <span class="font-semibold text-slate-300">Model Details:</span> 24 engineered features (xG, Corsi, Fenwick, Special Teams, Rest/B2B). 
                    Trained with 5-fold walk-forward validation to prevent data leakage. Min edge threshold: 5%. 
                    O/U MAE: 0.92 goals. Max drawdown: $312.
                </p>
            </div>
        </div>
    </div>

    <!-- Quick Reference Chips -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8 p-4 rounded-2xl bg-slate-900 border border-slate-800 shadow-xl">
        <div class="flex items-center gap-3">
            <div class="p-2 bg-blue-500/10 rounded-lg"><TwIcon Icon="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" Class="w-5 h-5 text-blue-400" /></div>
            <div>
                <p class="text-xs text-slate-500 font-medium uppercase tracking-wider">EV Logic</p>
                <p class="text-sm text-white">Edge = Opportunity</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
             <div class="p-2 bg-emerald-500/10 rounded-lg"><TwIcon Icon="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-5 h-5 text-emerald-400" /></div>
            <div>
                <p class="text-xs text-slate-500 font-medium uppercase tracking-wider">Kelly %</p>
                <p class="text-sm text-white">Optimal Bet Sizing</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
             <div class="p-2 bg-amber-500/10 rounded-lg"><TwIcon Icon="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-5 h-5 text-amber-400" /></div>
            <div>
                <p class="text-xs text-slate-500 font-medium uppercase tracking-wider">Agreement</p>
                <p class="text-sm text-white">Model Confidence</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
             <div class="p-2 bg-slate-500/10 rounded-lg"><TwIcon Icon="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" Class="w-5 h-5 text-slate-400" /></div>
            <div>
                <p class="text-xs text-slate-500 font-medium uppercase tracking-wider">Rolling Stats</p>
                <p class="text-sm text-white">Latest Form Analysis</p>
            </div>
        </div>
    </div>

    @if (_error != null)
    {
        <TwAlert Severity="error" Class="mb-6">@_error</TwAlert>
    }

    <div class="px-4">
        @if (_games.Any())
        {
            <div class="flex items-center justify-between mb-6">
                <p class="text-sm text-slate-500 italic">
                    @_games.Count game(s) found • @_date • Data: MoneyPuck
                </p>
            </div>

            <TwGrid Columns="1" ColumnsMd="2" ColumnsLg="3" Gap="6">
            @foreach (var game in _games)
            {
                <TwCard NoPadding="true" Class="h-full border-t-4 border-t-blue-500 bg-slate-900 shadow-lg overflow-hidden">
                    <div class="p-5 border-b border-slate-800 bg-white/[0.02]">
                        <div class="flex justify-between items-center mb-4">
                            <div class="flex flex-col">
                                <span class="text-lg font-bold text-white">@game.AwayTeam</span>
                                <span class="text-[10px] text-slate-500 uppercase tracking-widest my-0.5">at</span>
                                <span class="text-lg font-bold text-white">@game.HomeTeam</span>
                            </div>
                        </div>
                        <div class="flex justify-between gap-2">
                            <TwChip Variant="outline" Size="sm">A: @FormatOdds(game.AwayMoneyline)</TwChip>
                            <TwChip Variant="outline" Size="sm">H: @FormatOdds(game.HomeMoneyline)</TwChip>
                        </div>
                    </div>
                    <div class="p-3">
                        <div class="overflow-x-auto">
                            <table class="w-full text-[11px] text-left">
                                <thead class="text-slate-500 border-b border-slate-800/50">
                                    <tr>
                                        <th class="font-normal py-2">Metric</th>
                                        <th class="text-center font-normal py-2">Simple</th>
                                        <th class="text-center font-normal py-2">XGB</th>
                                        <th class="text-center font-normal py-2">Edge</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-800/30">
                                    <tr class="hover:bg-white/[0.02] transition-colors">
                                        <td class="py-2"><span class="text-slate-400">Win Prob</span></td>
                                        <td class="text-center font-bold text-emerald-400">@(((game.SimpleModel?.HomeWinProb ?? 0) * 100).ToString("F1"))%</td>
                                        <td class="text-center text-slate-300">
                                            @FormatOdds(ProbToAmerican(game.SimpleModel?.HomeWinProb ?? 0.5))
                                        </td>
                                        <td class="text-center">
                                           <span class="@(game.SimpleModel?.EvHome > 0 ? "text-emerald-400" : "text-red-400")">
                                               @(game.SimpleModel?.EvHome?.ToString("+0.00;-0.00") ?? "—")
                                           </span>
                                        </td>
                                    </tr>
                                    <tr class="hover:bg-white/[0.02] transition-colors text-[10px]">
                                        <td class="py-2"><span class="text-slate-500">Spread / Tot</span></td>
                                        <td class="text-center text-blue-400 font-medium">@(game.SimpleModel?.PredictedSpread?.ToString("+0.0;-0.0"))</td>
                                        <td class="text-center text-amber-400 font-medium">O/U @(game.SimpleModel?.PredictedTotal?.ToString("F1"))</td>
                                        <td class="text-center text-slate-500">@(game.SimpleModel?.Confidence)</td>
                                    </tr>
                                    <tr class="hover:bg-white/[0.02] transition-colors">
                                        <td class="py-2"><span class="text-slate-400">Record (L10)</span></td>
                                        <td class="text-center text-slate-300">@(game.HomeStats?.L10Record ?? "0-0")</td>
                                        <td class="text-center text-slate-300">@(game.AwayStats?.L10Record ?? "0-0")</td>
                                        <td class="text-center">
                                            @if (game.HomeStats?.IsB2B == true || game.AwayStats?.IsB2B == true)
                                            {
                                                <TwChip Color="amber" Size="xs">B2B</TwChip>
                                            }
                                        </td>
                                    </tr>
                                    <tr class="hover:bg-white/[0.02] transition-colors">
                                        <td class="py-2"><span class="text-slate-400">Season Rec</span></td>
                                        <td class="text-center text-slate-400">@(game.HomeStats?.SeasonRecord ?? "0-0")</td>
                                        <td class="text-center text-slate-400">@(game.AwayStats?.SeasonRecord ?? "0-0")</td>
                                        <td class="text-center text-slate-500 font-mono">H @(game.HomeStats?.RestDays)d</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Mini Stats Row -->
                        <div class="mt-4 grid grid-cols-2 gap-2 p-2 rounded-lg bg-slate-800/30 border border-slate-700/50 text-[10px]">
                            <div class="flex flex-col gap-1">
                                <span class="text-slate-500 uppercase tracking-tighter">Home L10 xG</span>
                                <span class="text-white font-mono">@((game.HomeStats?.xG ?? 0).ToString("F2"))</span>
                            </div>
                            <div class="flex flex-col gap-1 text-right">
                                <span class="text-slate-500 uppercase tracking-tighter">Away L10 xG</span>
                                <span class="text-white font-mono">@((game.AwayStats?.xG ?? 0).ToString("F2"))</span>
                            </div>
                        </div>

                        @if (game.HasValue)
                        {
                            <div class="mt-3 flex justify-center">
                                <TwChip Color="emerald" Size="sm" Class="px-3 animate-pulse">✓ Edge Detected</TwChip>
                            </div>
                        }
                    </div>
                </TwCard>
            }
            </TwGrid>
        }
        else if (!_isLoading)
        {
            <div class="py-20 text-center bg-slate-900/50 rounded-2xl border border-dashed border-slate-800">
                <TwIcon Icon="M13 10V3L4 14h7v7l9-11h-7z" Class="w-12 h-12 text-slate-700 mx-auto mb-4" />
                <h3 class="text-xl font-bold text-white mb-2">No NHL Games Analyzed</h3>
                <p class="text-slate-400 mb-6 max-w-sm mx-auto">Click the <strong class="text-blue-400">Analyze Games</strong> button to fetch today's NHL schedule and run calculations.</p>
                <TwButton Variant="primary" OnClick="RunAnalysis" IsLoading="@_isLoading">Analyze Now</TwButton>
            </div>
        }
    </div>
</TwContainer>

@code {
    private bool _isLoading = false;
    private string? _error = null;
    private string _selectedSportsbook = "fanduel";
    private string _date = "";
    private List<NhlGamePrediction> _games = new();
    private string _analysisStatus = "🏒 Checking if the ice is ready...";

    private async Task RunAnalysis()
    {
        _isLoading = true;
        _error = null;
        _games.Clear();
        StateHasChanged();

        try
        {
            // Update to use the new NHL endpoint
            var response = await Http.PostAsync(
                PredictionApiRoutes.NhlAnalyzeAll(_selectedSportsbook),
                null
            );
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var data = JsonSerializer.Deserialize<JsonElement>(json);
                
                _date = data.TryGetProperty("date", out var d) ? d.GetString() ?? "" : "";
                
                if (data.TryGetProperty("games", out var games))
                {
                    foreach (var game in games.EnumerateArray())
                    {
                        var gp = new NhlGamePrediction
                        {
                            HomeTeam = game.TryGetProperty("home_team", out var ht) ? ht.GetString() ?? "" : "",
                            AwayTeam = game.TryGetProperty("away_team", out var at) ? at.GetString() ?? "" : "",
                            HomeMoneyline = game.TryGetProperty("home_moneyline", out var hm) && hm.ValueKind == JsonValueKind.Number ? hm.GetInt32() : null,
                            AwayMoneyline = game.TryGetProperty("away_moneyline", out var am) && am.ValueKind == JsonValueKind.Number ? am.GetInt32() : null,
                            HasValue = game.TryGetProperty("has_value", out var hv) && hv.GetBoolean(),
                            HomeStats = game.TryGetProperty("home_stats", out var hs) ? new NhlTeamMetrics { 
                                xG = hs.TryGetProperty("xgoals_for", out var hxg) ? hxg.GetDouble() : 0,
                                L10Record = hs.TryGetProperty("l10_record", out var hl10) ? hl10.GetString() : "0-0",
                                SeasonRecord = hs.TryGetProperty("season_record", out var hsr) ? hsr.GetString() : "0-0",
                                RestDays = hs.TryGetProperty("rest_days", out var hrd) ? hrd.GetInt32() : 0,
                                IsB2B = hs.TryGetProperty("is_b2b", out var hb2b) && hb2b.GetBoolean()
                            } : null,
                            AwayStats = game.TryGetProperty("away_stats", out var @as) ? new NhlTeamMetrics { 
                                xG = @as.TryGetProperty("xgoals_for", out var axg) ? axg.GetDouble() : 0,
                                L10Record = @as.TryGetProperty("l10_record", out var al10) ? al10.GetString() : "0-0",
                                SeasonRecord = @as.TryGetProperty("season_record", out var asr) ? asr.GetString() : "0-0",
                                RestDays = @as.TryGetProperty("rest_days", out var ard) ? ard.GetInt32() : 0,
                                IsB2B = @as.TryGetProperty("is_b2b", out var ab2b) && ab2b.GetBoolean()
                            } : null
                        };
                        
                        if (game.TryGetProperty("simple_model", out var sm))
                        {
                            gp.SimpleModel = new NhlModelResult
                            {
                                HomeWinProb = sm.TryGetProperty("home_win_probability", out var shp) && shp.ValueKind == JsonValueKind.Number ? shp.GetDouble() : null,
                                PredictedWinner = sm.TryGetProperty("predicted_winner", out var spw) ? spw.GetString() : null,
                                EvHome = sm.TryGetProperty("ev_home", out var seh) && seh.ValueKind == JsonValueKind.Number ? seh.GetDouble() : null,
                                KellyHome = sm.TryGetProperty("kelly_home", out var skh) && skh.ValueKind == JsonValueKind.Number ? skh.GetDouble() : null,
                                PredictedSpread = sm.TryGetProperty("predicted_spread", out var sps) && sps.ValueKind == JsonValueKind.Number ? sps.GetDouble() : null,
                                PredictedTotal = sm.TryGetProperty("predicted_total", out var spt) && spt.ValueKind == JsonValueKind.Number ? spt.GetDouble() : null,
                                Confidence = sm.TryGetProperty("confidence", out var sc) ? sc.GetString() : "Med"
                            };
                        }
                        
                        _games.Add(gp);
                    }
                }
                
                Snackbar.Add($"Analyzed {_games.Count} NHL games", Severity.Success);
            }
            else
            {
                _error = $"API Error: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogError(ex, "Error analyzing NHL games");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string FormatOdds(int? odds) => !odds.HasValue ? "N/A" : (odds.Value > 0 ? $"+{odds.Value}" : odds.Value.ToString());

    private int ProbToAmerican(double prob)
    {
        if (prob <= 0 || prob >= 1) return 0;
        if (prob >= 0.5) return (int)(-100 * prob / (1 - prob));
        return (int)(100 * (1 - prob) / prob);
    }

    private class NhlGamePrediction
    {
        public string HomeTeam { get; set; } = "";
        public string AwayTeam { get; set; } = "";
        public int? HomeMoneyline { get; set; }
        public int? AwayMoneyline { get; set; }
        public NhlModelResult? SimpleModel { get; set; }
        public NhlTeamMetrics? HomeStats { get; set; }
        public NhlTeamMetrics? AwayStats { get; set; }
        public bool HasValue { get; set; }
    }

    private class NhlModelResult
    {
        public double? HomeWinProb { get; set; }
        public string? PredictedWinner { get; set; }
        public double? EvHome { get; set; }
        public double? KellyHome { get; set; }
        public double? PredictedSpread { get; set; }
        public double? PredictedTotal { get; set; }
        public string? Confidence { get; set; }
    }

    private class NhlTeamMetrics
    {
        public double xG { get; set; }
        public string? L10Record { get; set; }
        public string? SeasonRecord { get; set; }
        public int RestDays { get; set; }
        public bool IsB2B { get; set; }
    }
}
