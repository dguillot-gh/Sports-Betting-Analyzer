@page "/admin/notification-test"
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@using SportsBettingAnalyzer.Services
@inject PythonMLServiceClient MLService
@rendermode InteractiveServer

<PageTitle>Notification Testing - Admin</PageTitle>

<TwContainer MaxWidth="large" Class="mt-8 px-4 pb-12">
    <div class="space-y-8">
        <!-- Header -->
        <div>
            <h1 class="text-3xl font-bold text-white">🧪 Notification Testing</h1>
            <p class="text-slate-400 mt-1">Fire test notifications to each channel individually to verify your setup.</p>
        </div>

        <!-- Channel Test Cards -->
        <TwGrid Columns="1" ColumnsMd="2" Gap="6">
            <!-- In-App + Push + Email (via insert_notification) -->
            <TwCard Class="p-6 bg-slate-900 border-slate-800">
                <div class="flex items-center gap-3 mb-4">
                    <div class="p-3 bg-emerald-500/10 rounded-xl">
                        <span class="text-2xl">🔔</span>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-white">In-App Notification</h3>
                        <p class="text-xs text-slate-500">Writes to DB + triggers Push + Email</p>
                    </div>
                </div>
                <p class="text-sm text-slate-400 mb-4">
                    Inserts a test notification into the database. This also fires Web Push, FCM, and Email 
                    through the standard broadcast pipeline.
                </p>
                <div class="flex items-center gap-3">
                    <button @onclick='() => TestChannel("in-app")' disabled="@_testing.ContainsKey("in-app")"
                            class="flex-1 px-4 py-3 bg-emerald-600 hover:bg-emerald-500 disabled:bg-slate-700 text-white rounded-xl font-semibold text-sm transition-colors">
                        @if (_testing.ContainsKey("in-app") && _testing["in-app"])
                        {
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span>🔔 Send In-App Test</span>
                        }
                    </button>
                </div>
                @if (_results.ContainsKey("in-app"))
                {
                    <div class="mt-3 p-3 rounded-lg text-xs font-mono @(_resultSuccess["in-app"] ? "bg-emerald-900/30 border border-emerald-700 text-emerald-300" : "bg-red-900/30 border border-red-700 text-red-300")">
                        @_results["in-app"]
                    </div>
                }
            </TwCard>

            <!-- Web Push Only -->
            <TwCard Class="p-6 bg-slate-900 border-slate-800">
                <div class="flex items-center gap-3 mb-4">
                    <div class="p-3 bg-blue-500/10 rounded-xl">
                        <span class="text-2xl">🌐</span>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-white">Web Push</h3>
                        <p class="text-xs text-slate-500">VAPID / Service Worker</p>
                    </div>
                </div>
                <p class="text-sm text-slate-400 mb-4">
                    Sends a Web Push notification directly to all browser subscribers via VAPID keys. 
                    Does not write to the notification DB.
                </p>
                <div class="flex items-center gap-3">
                    <button @onclick='() => TestChannel("web-push")' disabled="@(_testing.ContainsKey("web-push") && _testing["web-push"])"
                            class="flex-1 px-4 py-3 bg-blue-600 hover:bg-blue-500 disabled:bg-slate-700 text-white rounded-xl font-semibold text-sm transition-colors">
                        @if (_testing.ContainsKey("web-push") && _testing["web-push"])
                        {
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span>🌐 Send Web Push Test</span>
                        }
                    </button>
                </div>
                @if (_results.ContainsKey("web-push"))
                {
                    <div class="mt-3 p-3 rounded-lg text-xs font-mono @(_resultSuccess["web-push"] ? "bg-emerald-900/30 border border-emerald-700 text-emerald-300" : "bg-red-900/30 border border-red-700 text-red-300")">
                        @_results["web-push"]
                    </div>
                }
            </TwCard>

            <!-- FCM Push Only -->
            <TwCard Class="p-6 bg-slate-900 border-slate-800">
                <div class="flex items-center gap-3 mb-4">
                    <div class="p-3 bg-amber-500/10 rounded-xl">
                        <span class="text-2xl">📱</span>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-white">FCM Push</h3>
                        <p class="text-xs text-slate-500">Firebase Cloud Messaging</p>
                    </div>
                </div>
                <p class="text-sm text-slate-400 mb-4">
                    Sends an FCM notification directly to all registered Android devices via Firebase Admin SDK.
                    Does not write to the notification DB.
                </p>
                <div class="flex items-center gap-3">
                    <button @onclick='() => TestChannel("fcm")' disabled="@(_testing.ContainsKey("fcm") && _testing["fcm"])"
                            class="flex-1 px-4 py-3 bg-amber-600 hover:bg-amber-500 disabled:bg-slate-700 text-white rounded-xl font-semibold text-sm transition-colors">
                        @if (_testing.ContainsKey("fcm") && _testing["fcm"])
                        {
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span>📱 Send FCM Test</span>
                        }
                    </button>
                </div>
                @if (_results.ContainsKey("fcm"))
                {
                    <div class="mt-3 p-3 rounded-lg text-xs font-mono @(_resultSuccess["fcm"] ? "bg-emerald-900/30 border border-emerald-700 text-emerald-300" : "bg-red-900/30 border border-red-700 text-red-300")">
                        @_results["fcm"]
                    </div>
                }
            </TwCard>

            <!-- Email Only -->
            <TwCard Class="p-6 bg-slate-900 border-slate-800">
                <div class="flex items-center gap-3 mb-4">
                    <div class="p-3 bg-purple-500/10 rounded-xl">
                        <span class="text-2xl">📧</span>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-white">Email</h3>
                        <p class="text-xs text-slate-500">SMTP HTML Email</p>
                    </div>
                </div>
                <p class="text-sm text-slate-400 mb-4">
                    Sends a test email to the configured REPORT_EMAIL_TO address. Uses the same SMTP 
                    settings as the import reports.
                </p>
                <div class="flex items-center gap-3">
                    <button @onclick='() => TestChannel("email")' disabled="@(_testing.ContainsKey("email") && _testing["email"])"
                            class="flex-1 px-4 py-3 bg-purple-600 hover:bg-purple-500 disabled:bg-slate-700 text-white rounded-xl font-semibold text-sm transition-colors">
                        @if (_testing.ContainsKey("email") && _testing["email"])
                        {
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span>📧 Send Email Test</span>
                        }
                    </button>
                </div>
                @if (_results.ContainsKey("email"))
                {
                    <div class="mt-3 p-3 rounded-lg text-xs font-mono @(_resultSuccess["email"] ? "bg-emerald-900/30 border border-emerald-700 text-emerald-300" : "bg-red-900/30 border border-red-700 text-red-300")">
                        @_results["email"]
                    </div>
                }
            </TwCard>
        </TwGrid>

        <!-- Fire All Button -->
        <TwCard Class="p-6 bg-gradient-to-r from-slate-900 to-slate-800 border-slate-700">
            <div class="flex flex-col md:flex-row items-center justify-between gap-4">
                <div>
                    <h3 class="text-xl font-bold text-white">🚀 Test All Channels</h3>
                    <p class="text-sm text-slate-400">Fires a single notification through the full broadcast pipeline (In-App → Push → Email)</p>
                </div>
                <button @onclick='() => TestChannel("all")' disabled="@(_testing.ContainsKey("all") && _testing["all"])"
                        class="px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 disabled:from-slate-700 disabled:to-slate-700 text-white rounded-xl font-bold text-base transition-all shadow-lg shadow-blue-900/30">
                    @if (_testing.ContainsKey("all") && _testing["all"])
                    {
                        <span>Sending to all channels...</span>
                    }
                    else
                    {
                        <span>🚀 Fire All Channels</span>
                    }
                </button>
            </div>
            @if (_results.ContainsKey("all"))
            {
                <div class="mt-4 p-3 rounded-lg text-xs font-mono @(_resultSuccess["all"] ? "bg-emerald-900/30 border border-emerald-700 text-emerald-300" : "bg-red-900/30 border border-red-700 text-red-300")">
                    @_results["all"]
                </div>
            }
        </TwCard>

        <!-- Channel Status -->
        <TwCard Class="p-6 bg-slate-900 border-slate-800">
            <h3 class="text-lg font-bold text-white mb-4">Channel Configuration</h3>
            <p class="text-xs text-slate-500 mb-4">These are read from your backend environment. If a channel shows 0 subscribers/recipients, the test will succeed but nothing will be delivered.</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="p-4 rounded-xl bg-slate-950/50 border border-slate-800 text-center">
                    <div class="text-2xl mb-1">🔔</div>
                    <div class="text-xs text-slate-500">In-App</div>
                    <div class="text-sm font-bold text-emerald-400 mt-1">Always Active</div>
                </div>
                <div class="p-4 rounded-xl bg-slate-950/50 border border-slate-800 text-center">
                    <div class="text-2xl mb-1">🌐</div>
                    <div class="text-xs text-slate-500">Web Push</div>
                    <div class="text-sm font-bold text-slate-400 mt-1">Requires VAPID</div>
                </div>
                <div class="p-4 rounded-xl bg-slate-950/50 border border-slate-800 text-center">
                    <div class="text-2xl mb-1">📱</div>
                    <div class="text-xs text-slate-500">FCM</div>
                    <div class="text-sm font-bold text-slate-400 mt-1">Requires Firebase</div>
                </div>
                <div class="p-4 rounded-xl bg-slate-950/50 border border-slate-800 text-center">
                    <div class="text-2xl mb-1">📧</div>
                    <div class="text-xs text-slate-500">Email</div>
                    <div class="text-sm font-bold text-slate-400 mt-1">Requires SMTP</div>
                </div>
            </div>
        </TwCard>
    </div>
</TwContainer>

@code {
    private Dictionary<string, bool> _testing = new();
    private Dictionary<string, string> _results = new();
    private Dictionary<string, bool> _resultSuccess = new();

    private async Task TestChannel(string channel)
    {
        _testing[channel] = true;
        _results.Remove(channel);
        _resultSuccess.Remove(channel);
        StateHasChanged();

        try
        {
            var response = await MLService.HttpClient.PostAsync(
                $"/admin/notifications/test/{channel}",
                null
            );

            var body = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                _results[channel] = $"✅ Success — {body}";
                _resultSuccess[channel] = true;
            }
            else
            {
                _results[channel] = $"❌ HTTP {(int)response.StatusCode} — {body}";
                _resultSuccess[channel] = false;
            }
        }
        catch (Exception ex)
        {
            _results[channel] = $"❌ Error — {ex.Message}";
            _resultSuccess[channel] = false;
        }
        finally
        {
            _testing[channel] = false;
            StateHasChanged();
        }
    }
}
