@page "/history"
@using SportsBettingAnalyzer.Models
@using SportsBettingAnalyzer.Services
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@inject DataCollectionService DataCollectionService
@inject FileExportService FileExportService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>Bet History</PageTitle>

<TwContainer MaxWidth="extraLarge" Class="mt-8">
    <div class="space-y-6">
        <!-- Header -->
        <TwCard Class="flex flex-col md:flex-row justify-between items-center gap-4 bg-gradient-to-r from-slate-900 to-slate-800 border-slate-700">
            <div>
                <h1 class="text-3xl font-bold text-white mb-2">Bet History</h1>
                <p class="text-slate-400">View your analyzed bets and track results.</p>
            </div>
            <div class="flex gap-3">
                <TwButton Variant="outline" Class="text-red-400 border-red-900/50 hover:bg-red-900/20" 
                           StartIcon="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                           OnClick="ClearAllHistory" 
                           Disabled="@(_historicalBets == null || !_historicalBets.Any())">
                    Clear All
                </TwButton>
                <TwButton Variant="primary" 
                           StartIcon="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                           OnClick="ExportHistory" 
                           Disabled="@(_historicalBets == null || !_historicalBets.Any())">
                    Export CSV
                </TwButton>
            </div>
        </TwCard>

        <!-- Content -->
        <TwCard>
            @if (_isLoading)
            {
                <div class="p-8 flex flex-col items-center justify-center">
                    <TwProgressBar Indeterminate="true" Color="blue" Class="w-1/2 mb-4" />
                    <p class="text-slate-500">Loading history...</p>
                </div>
            }
            else if (_historicalBets != null && _historicalBets.Any())
            {
                <div class="overflow-x-auto rounded-lg border border-slate-800">
                    <table class="w-full text-sm text-left text-slate-300">
                        <thead class="text-xs text-slate-400 uppercase bg-slate-900">
                            <tr>
                                <th class="px-4 py-3">Date</th>
                                <th class="px-4 py-3">Teams/Player</th>
                                <th class="px-4 py-3">Sport</th>
                                <th class="px-4 py-3">Bet Type</th>
                                <th class="px-4 py-3">Odds</th>
                                <th class="px-4 py-3">Wager</th>
                                <th class="px-4 py-3">CLV</th>
                                <th class="px-4 py-3">Recommendation</th>
                                <th class="px-4 py-3">Result</th>
                                <th class="px-4 py-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800 bg-slate-900/30">
                            @foreach (var bet in _historicalBets)
                            {
                                <tr class="hover:bg-slate-800/50 transition-colors">
                                    <td class="px-4 py-3 font-mono text-slate-400">@bet.AnalyzedAt.ToString("MM/dd HH:mm")</td>
                                    <td class="px-4 py-3">
                                        @if (!string.IsNullOrEmpty(bet.Team1))
                                        {
                                            <div class="font-medium text-white">@bet.Team1</div>
                                            @if (!string.IsNullOrEmpty(bet.Team2))
                                            {
                                                <div class="text-slate-500 text-xs">vs @bet.Team2</div>
                                            }
                                        }
                                        else if (!string.IsNullOrEmpty(bet.PlayerName))
                                        {
                                            <div class="font-medium text-white">@bet.PlayerName</div>
                                        }
                                        
                                        @if (bet.IsMock)
                                        {
                                            <div class="mt-1">
                                                <TwChip Color="indigo" Size="xs" Variant="solid">PAPER</TwChip>
                                            </div>
                                        }
                                    </td>
                                    <td class="px-4 py-3">
                                        <TwChip Size="xs" Variant="outline" Color="slate">@bet.Sport.ToUpper()</TwChip>
                                    </td>
                                    <td class="px-4 py-3">@bet.BetType</td>
                                    <td class="px-4 py-3 font-mono">@bet.Odds</td>
                                    <td class="px-4 py-3 text-emerald-400 font-mono">$@bet.WagerAmount.ToString("F2")</td>
                                    <td class="px-4 py-3">
                                        @if (bet.ClvPercent.HasValue)
                                        {
                                            <span class="@(bet.ClvPercent >= 0 ? "text-emerald-400" : "text-amber-500") font-mono text-xs">
                                                @(bet.ClvPercent >= 0 ? "+" : "")@bet.ClvPercent.Value.ToString("F1")%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-600">-</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3">
                                        <TwChip Size="xs" Variant="solid"
                                                Color="@(bet.Recommendation == "GoodBet" ? "emerald" : bet.Recommendation == "BadBet" ? "red" : "amber")">
                                            @bet.Recommendation
                                        </TwChip>
                                    </td>
                                    <td class="px-4 py-3">
                                        @if (bet.Won.HasValue)
                                        {
                                            <TwChip Size="xs" Variant="solid" Color="@(bet.Won.Value ? "emerald" : "red")">
                                                @(bet.Won.Value ? "Won" : "Lost")
                                            </TwChip>
                                        }
                                        else
                                        {
                                            <TwChip Size="xs" Variant="outline" Color="slate">Pending</TwChip>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-right">
                                        <div class="flex justify-end items-center gap-2">
                                            @if (!bet.Won.HasValue)
                                            {
                                                <div class="flex rounded-md shadow-sm" role="group">
                                                    <button @onclick="@(() => UpdateResult(bet.Id, true))" class="px-2 py-1 text-xs font-bold text-white bg-emerald-600 border border-emerald-600 rounded-l hover:bg-emerald-700">W</button>
                                                    <button @onclick="@(() => UpdateResult(bet.Id, false))" class="px-2 py-1 text-xs font-bold text-white bg-red-600 border border-red-600 rounded-r hover:bg-red-700">L</button>
                                                </div>
                                            }
                                            <button @onclick="@(() => DeleteBet(bet.Id))" class="p-1 text-slate-600 hover:text-red-400 transition-colors">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <TwAlert Severity="info" Class="mt-4">
                    No bet history found. Analyze some bets to see them here.
                </TwAlert>
            }
        </TwCard>
    </div>
</TwContainer>

@code {
    private List<HistoricalBet>? _historicalBets;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadHistory();
    }

    private async Task LoadHistory()
    {
        try
        {
            _isLoading = true;
            _historicalBets = await DataCollectionService.GetHistoricalBetsAsync();
        }
        catch (Exception ex)
        {
            // Handle error
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task UpdateResult(int betId, bool won)
    {
        try
        {
            await DataCollectionService.UpdateBetResultAsync(betId, won);
            await LoadHistory();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating result: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteBet(int betId)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Delete Bet", 
            "Are you sure you want to delete this bet?", 
            yesText:"Delete!", cancelText:"Cancel");

        if (result == true)
        {
            try
            {
                await DataCollectionService.DeleteBetAsync(betId);
                await LoadHistory();
                Snackbar.Add("Bet deleted", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting bet: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task ClearAllHistory()
    {
        bool? result = await DialogService.ShowMessageBox(
            "Clear All History", 
            "This will PERMANENTLY delete all bet history. Are you sure?", 
            yesText:"Yes, Clear Everything", cancelText:"Cancel");

        if (result == true)
        {
            try
            {
                _isLoading = true;
                await DataCollectionService.ClearAllBetsAsync();
                await LoadHistory();
                Snackbar.Add("Bet history cleared", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error clearing history: {ex.Message}", Severity.Error);
            }
            finally
            {
                _isLoading = false;
            }
        }
    }

    private async Task ExportHistory()
    {
        if (_historicalBets == null || !_historicalBets.Any()) return;
        await FileExportService.ExportToCsv(_historicalBets, $"bet_history_{DateTime.Now:yyyyMMdd}.csv");
        Snackbar.Add("History exported to CSV", Severity.Success);
    }
}
