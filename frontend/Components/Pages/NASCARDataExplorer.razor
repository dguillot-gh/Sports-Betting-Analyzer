@page "/nascar-data"
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>NASCAR Data Explorer</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudPaper Class="pa-4" Elevation="2" Style="background: linear-gradient(135deg, #0d1117 0%, #161b22 100%);">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <div>
                    <MudText Typo="Typo.h4">
                        <MudIcon Icon="@Icons.Material.Filled.SportsMotorsports" Class="mr-2" />
                        NASCAR Data Explorer
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Powered by pynascar - Race schedules, lap times, pit stops, and driver stats
                    </MudText>
                </div>
                <MudChip T="string" Color="@(_isAvailable ? Color.Success : Color.Error)" Size="Size.Small">
                    @(_isAvailable ? "Connected" : "Unavailable")
                </MudChip>
            </MudStack>
        </MudPaper>

        @if (!_isAvailable)
        {
            <MudAlert Severity="Severity.Warning">
                PyNASCAR package not installed. Install with: <code>pip install pynascar</code>
            </MudAlert>
        }

        <!-- Controls -->
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
                <MudSelect T="string" @bind-Value="_selectedSeries" Label="Series" Variant="Variant.Outlined" 
                           Dense="true" Style="min-width: 200px;">
                    <MudSelectItem Value="@("cup")">Cup Series</MudSelectItem>
                    <MudSelectItem Value="@("xfinity")">Xfinity Series</MudSelectItem>
                    <MudSelectItem Value="@("trucks")">Truck Series</MudSelectItem>
                </MudSelect>
                <MudSelect T="int" @bind-Value="_selectedYear" Label="Year" Variant="Variant.Outlined" 
                           Dense="true" Style="min-width: 120px;">
                    @for (int y = DateTime.Now.Year; y >= 2020; y--)
                    {
                        <MudSelectItem Value="@y">@y</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                           OnClick="@LoadSchedule" Disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Load Schedule
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" 
                           OnClick="@LoadDrivers" Disabled="@_isLoading">
                    Load Drivers
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" 
                           OnClick="@CheckLiveRace" Disabled="@_isLoading">
                    <MudIcon Icon="@Icons.Material.Filled.LiveTv" Class="mr-1" />
                    Check Live
                </MudButton>
            </MudStack>
        </MudPaper>

        <!-- Tabs for different data views -->
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
            <MudTabPanel Text="Schedule" Icon="@Icons.Material.Filled.CalendarMonth">
                @if (_schedule != null && _schedule.RootElement.TryGetProperty("races", out var races))
                {
                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        @GetSeriesName() - @_selectedYear Season
                    </MudText>
                    <MudTable Items="@GetRacesList(races)" Dense="true" Hover="true" Striped="true">
                        <HeaderContent>
                            <MudTh>Race</MudTh>
                            <MudTh>Track</MudTh>
                            <MudTh>Date</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Name</MudTd>
                            <MudTd>@context.Track</MudTd>
                            <MudTd>@context.Date</MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" 
                                         Color="@(context.Status == "completed" ? Color.Success : context.Status == "in_progress" ? Color.Warning : Color.Default)">
                                    @context.Status
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" 
                                               OnClick="@(() => LoadRaceDetails(context.RaceId))" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Color="Color.Secondary">Click "Load Schedule" to fetch race data</MudText>
                }
            </MudTabPanel>

            <MudTabPanel Text="Drivers" Icon="@Icons.Material.Filled.Person">
                @if (_drivers != null && _drivers.RootElement.TryGetProperty("drivers", out var drivers))
                {
                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        @GetSeriesName() Drivers - @_selectedYear
                    </MudText>
                    <MudTable Items="@GetDriversList(drivers)" Dense="true" Hover="true" Striped="true">
                        <HeaderContent>
                            <MudTh>Driver</MudTh>
                            <MudTh>Team</MudTh>
                            <MudTh>No.</MudTh>
                            <MudTh>Points</MudTh>
                            <MudTh>Wins</MudTh>
                            <MudTh>Top 5</MudTh>
                            <MudTh>Top 10</MudTh>
                            <MudTh>Avg Finish</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><strong>@context.Driver</strong></MudTd>
                            <MudTd>@context.Team</MudTd>
                            <MudTd>@context.CarNumber</MudTd>
                            <MudTd>@context.Points</MudTd>
                            <MudTd Style="color: #4caf50; font-weight: bold;">@context.Wins</MudTd>
                            <MudTd>@context.Top5</MudTd>
                            <MudTd>@context.Top10</MudTd>
                            <MudTd>@context.AvgFinish.ToString("F1")</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Color="Color.Secondary">Click "Load Drivers" to fetch driver standings</MudText>
                }
            </MudTabPanel>

            <MudTabPanel Text="Race Details" Icon="@Icons.Material.Filled.Timer">
                @if (_raceDetails != null)
                {
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">@GetRaceProperty("name")</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@GetRaceProperty("track") - @GetRaceProperty("date")</MudText>
                        
                        <MudDivider Class="my-2" />
                        
                        <MudStack Row="true" Spacing="4">
                            <MudPaper Class="pa-3" Elevation="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Laps</MudText>
                                <MudText Typo="Typo.h5">@GetRaceProperty("laps_completed") / @GetRaceProperty("total_laps")</MudText>
                            </MudPaper>
                            <MudPaper Class="pa-3" Elevation="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                                <MudText Typo="Typo.h5">@GetRaceProperty("status")</MudText>
                            </MudPaper>
                        </MudStack>

                        @if (_raceDetails.RootElement.TryGetProperty("results", out var results))
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-4">Results</MudText>
                            <MudSimpleTable Dense="true" Hover="true">
                                <thead>
                                    <tr>
                                        <th>Pos</th>
                                        <th>Driver</th>
                                        <th>Team</th>
                                        <th>Laps</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var result in results.EnumerateArray().Take(10))
                                    {
                                        <tr>
                                            <td><strong>@result.GetProperty("position")</strong></td>
                                            <td>@result.GetProperty("driver")</td>
                                            <td>@result.GetProperty("team")</td>
                                            <td>@result.GetProperty("laps_completed")</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </MudStack>
                }
                else
                {
                    <MudText Color="Color.Secondary">Select a race from the Schedule tab to view details</MudText>
                }
            </MudTabPanel>

            <MudTabPanel Text="Live Race" Icon="@Icons.Material.Filled.LiveTv">
                @if (_liveRace != null)
                {
                    @if (_liveRace.RootElement.TryGetProperty("status", out var status) && status.GetString() == "no_live_race")
                    {
                        <MudAlert Severity="Severity.Info">No race currently in progress</MudAlert>
                    }
                    else
                    {
                        <MudText Typo="Typo.h6" Color="Color.Success">
                            <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Style="color: red;" Class="mr-1" />
                            LIVE: @(_liveRace.RootElement.TryGetProperty("name", out var name) ? name.GetString() : "Unknown Race")
                        </MudText>
                    }
                }
                else
                {
                    <MudText Color="Color.Secondary">Click "Check Live" to see if a race is in progress</MudText>
                }
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudContainer>

@code {
    private bool _isLoading = false;
    private bool _isAvailable = false;
    private string _selectedSeries = "cup";
    private int _selectedYear = DateTime.Now.Year;
    
    private JsonDocument? _schedule;
    private JsonDocument? _drivers;
    private JsonDocument? _raceDetails;
    private JsonDocument? _liveRace;

    protected override async Task OnInitializedAsync()
    {
        await CheckAvailability();
    }

    private async Task CheckAvailability()
    {
        try
        {
            var response = await Http.GetAsync("http://backend:8000/pynascar/status");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var doc = JsonDocument.Parse(json);
                _isAvailable = doc.RootElement.TryGetProperty("available", out var available) && available.GetBoolean();
            }
        }
        catch { _isAvailable = false; }
    }

    private async Task LoadSchedule()
    {
        _isLoading = true;
        try
        {
            var response = await Http.GetAsync($"http://backend:8000/pynascar/schedule?year={_selectedYear}&series={_selectedSeries}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _schedule = JsonDocument.Parse(json);
                Snackbar.Add("Schedule loaded!", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        _isLoading = false;
    }

    private async Task LoadDrivers()
    {
        _isLoading = true;
        try
        {
            var response = await Http.GetAsync($"http://backend:8000/pynascar/drivers?year={_selectedYear}&series={_selectedSeries}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _drivers = JsonDocument.Parse(json);
                Snackbar.Add("Drivers loaded!", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        _isLoading = false;
    }

    private async Task LoadRaceDetails(int raceId)
    {
        _isLoading = true;
        try
        {
            var response = await Http.GetAsync($"http://backend:8000/pynascar/race/{raceId}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _raceDetails = JsonDocument.Parse(json);
                Snackbar.Add("Race details loaded!", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        _isLoading = false;
    }

    private async Task CheckLiveRace()
    {
        _isLoading = true;
        try
        {
            var response = await Http.GetAsync("http://backend:8000/pynascar/live");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _liveRace = JsonDocument.Parse(json);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        _isLoading = false;
    }

    private string GetSeriesName() => _selectedSeries switch
    {
        "cup" => "NASCAR Cup Series",
        "xfinity" => "NASCAR Xfinity Series",
        "trucks" => "NASCAR Truck Series",
        _ => _selectedSeries
    };

    private string GetRaceProperty(string prop)
    {
        if (_raceDetails?.RootElement.TryGetProperty(prop, out var val) == true)
            return val.ToString();
        return "N/A";
    }

    private List<RaceInfo> GetRacesList(JsonElement races)
    {
        var list = new List<RaceInfo>();
        foreach (var race in races.EnumerateArray())
        {
            list.Add(new RaceInfo
            {
                RaceId = race.TryGetProperty("race_id", out var id) ? id.GetInt32() : 0,
                Name = race.TryGetProperty("name", out var name) ? name.GetString() ?? "" : "",
                Track = race.TryGetProperty("track", out var track) ? track.GetString() ?? "" : "",
                Date = race.TryGetProperty("date", out var date) ? date.GetString() ?? "" : "",
                Status = race.TryGetProperty("status", out var status) ? status.GetString() ?? "" : ""
            });
        }
        return list;
    }

    private List<DriverInfo> GetDriversList(JsonElement drivers)
    {
        var list = new List<DriverInfo>();
        foreach (var d in drivers.EnumerateArray())
        {
            list.Add(new DriverInfo
            {
                Driver = d.TryGetProperty("driver", out var name) ? name.GetString() ?? "" : "",
                Team = d.TryGetProperty("team", out var team) ? team.GetString() ?? "" : "",
                CarNumber = d.TryGetProperty("car_number", out var num) ? num.GetString() ?? "" : "",
                Points = d.TryGetProperty("points", out var pts) ? pts.GetInt32() : 0,
                Wins = d.TryGetProperty("wins", out var wins) ? wins.GetInt32() : 0,
                Top5 = d.TryGetProperty("top5", out var t5) ? t5.GetInt32() : 0,
                Top10 = d.TryGetProperty("top10", out var t10) ? t10.GetInt32() : 0,
                AvgFinish = d.TryGetProperty("avg_finish", out var avg) ? avg.GetDouble() : 0
            });
        }
        return list.OrderByDescending(x => x.Points).ToList();
    }

    private class RaceInfo
    {
        public int RaceId { get; set; }
        public string Name { get; set; } = "";
        public string Track { get; set; } = "";
        public string Date { get; set; } = "";
        public string Status { get; set; } = "";
    }

    private class DriverInfo
    {
        public string Driver { get; set; } = "";
        public string Team { get; set; } = "";
        public string CarNumber { get; set; } = "";
        public int Points { get; set; }
        public int Wins { get; set; }
        public int Top5 { get; set; }
        public int Top10 { get; set; }
        public double AvgFinish { get; set; }
    }
}
