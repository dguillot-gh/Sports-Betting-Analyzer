@page "/all-sports"
@using System.Text.Json
@using SportsBettingAnalyzer.Services
@using SportsBettingAnalyzer.Models
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@inject DataCollectionService DataCollectionService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>All Sports Analysis</PageTitle>

<TwContainer MaxWidth="extraLarge" Class="mt-8">
    <div class="p-6 mb-6 rounded-xl shadow-lg bg-gradient-to-br from-indigo-900 to-blue-900 text-white relative overflow-hidden">
        <div class="absolute inset-0 bg-white/5 bg-[radial-gradient(#ffffff15_1px,transparent_1px)] [background-size:16px_16px]"></div>
        <div class="relative z-10 flex flex-col md:flex-row justify-between items-center gap-6">
            <div>
                <h1 class="text-3xl font-bold tracking-tight">Multi-Sport Dashboard</h1>
                <p class="text-indigo-200 mt-1">Running AI analysis across all live markets simultaneously.</p>
            </div>
            <div class="flex flex-wrap items-end gap-3">
                <div class="w-40">
                    <TwSelect TValue="string" @bind-Value="_selectedSportsbook" Label="Sportsbook" FullWidth="true" Class="bg-white/10 border-white/20 text-white">
                        <option value="fanduel">FanDuel</option>
                        <option value="draftkings">DraftKings</option>
                        <option value="betmgm">BetMGM</option>
                    </TwSelect>
                </div>
                <TwButton Variant="secondary" 
                           StartIcon="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" 
                           Size="lg"
                           OnClick="RunFullAnalysis" 
                           IsLoading="@_isLoading"
                           Disabled="@_isLoading"
                           Class="bg-white/10 hover:bg-white/20 border-white/20 text-white font-bold">
                    Scan All Sports
                </TwButton>
                @if (_games.Any(g => g.HasValue))
                {
                    <TwButton Variant="primary" 
                               StartIcon="M13 10V3L4 14h7v7l9-11h-7z" 
                               Size="lg"
                               OnClick="RunDeepAiScan" 
                               IsLoading="@_isLoading"
                               Disabled="@_isLoading"
                               Class="bg-blue-500 hover:bg-blue-600 border-blue-400 font-bold shadow-lg shadow-blue-900/50">
                        Deep AI Scan
                    </TwButton>
                }
            </div>
        </div>

        @if (_analysisResult != null)
        {
            <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-6">
                <div class="p-4 rounded-lg bg-white/10 border border-white/10 backdrop-blur-sm">
                    <span class="text-xs uppercase tracking-wider font-bold opacity-70">Total Games Scanned</span>
                    <div class="text-3xl font-bold mt-1">@_analysisResult.TotalGames</div>
                </div>
                <div class="p-4 rounded-lg bg-white/10 border border-white/10 backdrop-blur-sm">
                    <span class="text-xs uppercase tracking-wider font-bold opacity-70">Value Bets Found</span>
                    <div class="text-3xl font-bold mt-1 text-emerald-300">@_analysisResult.TotalValueBets</div>
                </div>
                <div class="p-4 rounded-lg bg-white/10 border border-white/10 backdrop-blur-sm">
                    <span class="text-xs uppercase tracking-wider font-bold opacity-70">Last Updated</span>
                    <div class="text-xl font-bold mt-1.5">@(_lastUpdate?.ToString("HH:mm:ss"))</div>
                </div>
            </div>
        }
    </div>

    @if (_isLoading)
    {
        <TwCard Class="p-12 flex flex-col items-center justify-center text-center">
            <TwProgressBar IsIndeterminate="true" Color="blue" Class="w-1/2 mb-6" />
            <h3 class="text-xl font-bold text-white">Scanning Odds & Running AI Models...</h3>
            <p class="text-slate-400 mt-2">This may take 10-20 seconds across all sports</p>
        </TwCard>
    }
    else if (_games.Any())
    {
        <TwCard NoPadding="true" Class="overflow-hidden">
             <div class="p-4 border-b border-slate-800 flex flex-wrap gap-4 items-center justify-between bg-slate-900/50">
                <h2 class="text-lg font-bold text-white">Consolidated Value Bets</h2>
                <div class="flex items-center gap-4">
                    <div class="w-64">
                         <TwInput @bind-Value="_searchString" Placeholder="Search teams or sports..." Class="bg-slate-950">
                            <PrefixContent>
                                <TwIcon Icon="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" Class="w-4 h-4 text-slate-500" />
                            </PrefixContent>
                         </TwInput>
                    </div>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" @bind="_onlyValue" class="form-checkbox rounded bg-slate-800 border-slate-700 text-blue-500 focus:ring-blue-500 focus:ring-offset-slate-900 h-4 w-4">
                        <span class="text-sm font-medium text-slate-300">Only Value Bets</span>
                    </label>
                </div>
            </div>

            <TwTable TItem="AnalyzedGame" Items="@_games" Filter="FilterFunc">
                <HeaderContent>
                    <TwTh Class="w-10">
                        <input type="checkbox" 
                               @onchange="ToggleSelectAll"
                               checked="@(_selectedGameIds.Count == _games.Count && _games.Count > 0)"
                               class="w-4 h-4 rounded border-slate-600 bg-slate-800 text-emerald-500 focus:ring-emerald-500" />
                    </TwTh>
                    <TwTh>Sport</TwTh>
                    <TwTh>Matchup</TwTh>
                    <TwTh>Odds (ML)</TwTh>
                    <TwTh>Analysis</TwTh>
                    <TwTh>Edge</TwTh>
                    <TwTh>Action</TwTh>
                </HeaderContent>
                <RowTemplate Context="game">
                    <TwTd>
                        <input type="checkbox" 
                               checked="@_selectedGameIds.Contains(GetGameId(game))"
                               @onchange="@(() => ToggleGameSelection(game))"
                               class="w-4 h-4 rounded border-slate-600 bg-slate-800 text-emerald-500 focus:ring-emerald-500" />
                    </TwTd>
                    <TwTd>
                        <TwChip Color="@GetSportColor(game.SportKey)" Size="xs" Variant="outline" Class="uppercase font-bold tracking-wider">
                            @game.SportKey.Replace("_", " ").ToUpper()
                        </TwChip>
                    </TwTd>
                    <TwTd>
                        <div class="flex flex-col">
                            <span class="font-medium text-white">@game.AwayTeam vs @game.HomeTeam</span>
                            <span class="text-xs text-slate-500">@game.GameTime</span>
                        </div>
                    </TwTd>
                    <TwTd>
                        <div class="flex gap-2">
                            <span class="px-2 py-1 rounded bg-slate-800 text-xs font-mono text-slate-300 border border-slate-700">@FormatML(game.AwayML)</span>
                            <span class="px-2 py-1 rounded bg-slate-800 text-xs font-mono text-slate-300 border border-slate-700">@FormatML(game.HomeML)</span>
                        </div>
                    </TwTd>
                    <TwTd>
                        @if (game.HasValue)
                        {
                            <TwChip Color="emerald" Size="xs" Variant="solid">GOOD BET</TwChip>
                        }
                        else
                        {
                            <TwChip Color="slate" Size="xs" Variant="outline">Neutral</TwChip>
                        }
                    </TwTd>
                    <TwTd>
                        @if (game.Edge > 0)
                        {
                            <span class="font-bold text-emerald-400">+@game.Edge.ToString("F1")%</span>
                        }
                        else
                        {
                            <span class="text-slate-600">--</span>
                        }
                    </TwTd>
                    <TwTd>
                        <TwButton Variant="outline" Size="sm" OnClick="@(() => OpenAnalysisDialog(game))">
                            Analyze Details
                        </TwButton>
                    </TwTd>
                </RowTemplate>

            </TwTable>
        </TwCard>
    }
    else if (!_isLoading)
    {
        <TwAlert Severity="info" Class="mt-4">
            No games found. Click "Scan All Sports" to fetch latest odds.
        </TwAlert>
    }

    <!-- Floating Paper Trading Action Bar -->
    @if (_showPaperTradingBar)
    {
        <div class="fixed bottom-6 left-1/2 transform -translate-x-1/2 z-50">
            <div class="bg-gradient-to-r from-slate-900 to-slate-800 border border-emerald-500/50 rounded-2xl shadow-2xl shadow-emerald-500/20 px-6 py-4 flex items-center gap-6">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-emerald-500/20 rounded-lg">
                        <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="text-white font-semibold">@_selectedGameIds.Count game@(_selectedGameIds.Count != 1 ? "s" : "") selected</div>
                        <div class="text-xs text-slate-400">Ready to add to paper trading</div>
                    </div>
                </div>
                
                <div class="flex gap-3">
                    <button @onclick="AddSelectedToPaperTrading" 
                            class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-lg transition-colors flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                        Add to Deck
                    </button>
                    <button @onclick="ClearSelection" 
                            class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white font-medium rounded-lg transition-colors">
                        Clear
                    </button>
                </div>
            </div>
        </div>
    }

</TwContainer>

@code {
    private bool _isLoading = false;
    private string _selectedSportsbook = "fanduel";
    private string _searchString = "";
    private bool _onlyValue = true;
    private DateTime? _lastUpdate;
    private DataCollectionService.MultiSportAnalysisResponse? _analysisResult;
    private List<AnalyzedGame> _games = new();

    // Paper Trading Selection State
    private HashSet<string> _selectedGameIds = new();
    private bool _showPaperTradingBar => _selectedGameIds.Count > 0;

    private async Task RunFullAnalysis()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            _analysisResult = await DataCollectionService.GetMultiSportAnalysisAsync(_selectedSportsbook);
            if (_analysisResult != null)
            {
                _lastUpdate = DateTime.Now;
                _games.Clear();

                foreach (var g in _analysisResult.AllGames)
                {
                    try
                    {
                        var analyzed = ParseGame(g);
                        analyzed.RawData = g; // Keep raw data for dialog
                        _games.Add(analyzed);
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error parsing game: {ex.Message}");
                    }
                }

                Snackbar.Add($"Scan complete! Found {_analysisResult.TotalValueBets} value bets.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Analysis failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private AnalyzedGame ParseGame(JsonElement g)
    {
        // Handle different property names (snake_case from API)
        string home = g.TryGetProperty("home_team", out var h) ? h.GetString() ?? "Unknown" : "Unknown";
        string away = g.TryGetProperty("away_team", out var a) ? a.GetString() ?? "Unknown" : "Unknown";
        string gameTime = g.TryGetProperty("game_time", out var t) ? t.GetString() ?? "" : "";
        string sport = g.TryGetProperty("sport_key", out var s) ? s.GetString() ?? "" : "";
        
        int homeML = g.TryGetProperty("home_moneyline", out var hml) ? (hml.ValueKind == JsonValueKind.Number ? hml.GetInt32() : 0) : 0;
        int awayML = g.TryGetProperty("away_moneyline", out var aml) ? (aml.ValueKind == JsonValueKind.Number ? aml.GetInt32() : 0) : 0;
        
        bool hasValue = g.TryGetProperty("has_value", out var hv) && hv.GetBoolean();
        
        // Try to get edge from prediction object if it exists
        double edge = 0;
        if (g.TryGetProperty("prediction", out var pred))
        {
            if (pred.TryGetProperty("edge", out var e)) edge = e.GetDouble() * 100;
        }
        else if (g.TryGetProperty("edge", out var e))
        {
            edge = e.GetDouble() * 100;
        }

        return new AnalyzedGame
        {
            HomeTeam = home,
            AwayTeam = away,
            HomeML = homeML,
            AwayML = awayML,
            GameTime = gameTime,
            SportKey = sport,
            HasValue = hasValue,
            Edge = (decimal)edge
        };
    }

    private string GetSportColor(string sport) => sport switch
    {
        "nfl" => "amber",
        "nba" => "indigo",
        "ncaab" => "blue",
        "college-baseball" => "emerald",
        "cfb" => "rose",
        _ => "slate"
    };

    private string FormatML(int ml) => ml > 0 ? $"+{ml}" : ml.ToString();

    private bool FilterFunc(AnalyzedGame element)
    {
        if (_onlyValue && !element.HasValue) return false;
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        if (element.HomeTeam.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (element.AwayTeam.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (element.SportKey.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private async Task RunDeepAiScan()
    {
        var valueGames = _games.Where(g => g.HasValue).ToList();
        if (!valueGames.Any()) return;

        _isLoading = true;
        Snackbar.Add($"Starting Deep AI Scan for {valueGames.Count} value bets...", Severity.Info);
        StateHasChanged();

        int successCount = 0;
        foreach (var game in valueGames)
        {
            try
            {
                // Call AI analysis with short prompt flag
                var aiResult = await DataCollectionService.GetAIAnalysisAsync(game.SportKey, game.HomeTeam, game.AwayTeam, shortPrompt: true);
                if (aiResult.HasValue)
                {
                    // Merge AI result back into RawData
                    game.AiSummary = aiResult.Value.TryGetProperty("llm_insight", out var insight) 
                        && insight.TryGetProperty("rationale", out var rat) ? rat.GetString() : "No insight";
                    successCount++;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Deep scan failed for {game.HomeTeam}: {ex.Message}");
            }
        }

        _isLoading = false;
        Snackbar.Add($"Deep Scan complete! Analyzed {successCount} games.", Severity.Success);
        StateHasChanged();
    }

    private async Task OpenAnalysisDialog(AnalyzedGame game)
    {
        var parameters = new DialogParameters
        {
            { "FullGameData", game.RawData },
             { "Sportsbook", _selectedSportsbook }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<Dialogs.AnalysisDialog>("Detailed AI Matchup Analysis", parameters, options);
    }

    public class AnalyzedGame
    {
        public string HomeTeam { get; set; } = "";
        public string AwayTeam { get; set; } = "";
        public int HomeML { get; set; }
        public int AwayML { get; set; }
        public string GameTime { get; set; } = "";
        public string SportKey { get; set; } = "";
        public bool HasValue { get; set; }
        public decimal Edge { get; set; }
        public JsonElement RawData { get; set; } // Store the raw JSON element for full analysis
        public string? AiSummary { get; set; } // Cache for bulk scan results
    }

    // Paper Trading Selection Functions
    private string GetGameId(AnalyzedGame game) => $"{game.AwayTeam}:{game.HomeTeam}";

    private void ToggleGameSelection(AnalyzedGame game)
    {
        var gameId = GetGameId(game);
        if (_selectedGameIds.Contains(gameId))
            _selectedGameIds.Remove(gameId);
        else
            _selectedGameIds.Add(gameId);
        StateHasChanged();
    }

    private void ToggleSelectAll()
    {
        if (_selectedGameIds.Count == _games.Count)
            _selectedGameIds.Clear();
        else
        {
            foreach (var game in _games)
                _selectedGameIds.Add(GetGameId(game));
        }
        StateHasChanged();
    }

    private void ClearSelection()
    {
        _selectedGameIds.Clear();
        StateHasChanged();
    }

    private void AddSelectedToPaperTrading()
    {
        var gamesParam = string.Join(",", _selectedGameIds);
        NavigationManager.NavigateTo($"/bet-tracker?games={Uri.EscapeDataString(gamesParam)}&sport=multi");
        
        Snackbar.Add($"Opening Paper Trading with {_selectedGameIds.Count} games...", Severity.Success);
        ClearSelection();
    }
}
