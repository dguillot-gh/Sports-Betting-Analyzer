</TwContainer>

@code {
    private VersionInfo? versionInfo;
    private bool isLoading = true;
    private List<DeploymentEntry> deployHistory = new();
    
    // Release form
    private int releaseMajor = 2;
    private int releaseMinor = 0;
    private bool isCreatingRelease = false;
    private string? releaseMessage;
    private bool releaseSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadVersionInfo();
        await LoadDeployHistory();
    }

    private async Task LoadVersionInfo()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            
            versionInfo = await MLService.GetVersionInfoAsync();
            
            // Auto-suggest next major version
            if (versionInfo != null && !string.IsNullOrEmpty(versionInfo.Version))
            {
                var parts = versionInfo.Version.Split('.');
                if (parts.Length > 0 && int.TryParse(parts[0], out var currentMajor))
                {
                    releaseMajor = currentMajor + 1;
                }
            }
        }
        catch (Exception ex)
        {
            versionInfo = new VersionInfo 
            { 
                Version = "error",
                Environment = "error",
                GitSha = "unknown",
                BuildTime = DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ssZ")
            };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadDeployHistory()
    {
        try
        {
            deployHistory = await MLService.GetDeploymentHistoryAsync(10);
            StateHasChanged();
        }
        catch { }
    }

    private async Task CreateRelease()
    {
        isCreatingRelease = true;
        releaseMessage = null;
        StateHasChanged();
        
        try
        {
            var result = await MLService.CreateReleaseAsync(releaseMajor, releaseMinor);
            releaseSuccess = result.Success;
            releaseMessage = result.Success 
                ? $"✅ Release {releaseMajor}.{releaseMinor}.0 created! Next deploy will be {releaseMajor}.{releaseMinor}.1"
                : $"❌ {result.Message}";
            
            // Refresh data
            await LoadVersionInfo();
            await LoadDeployHistory();
        }
        catch (Exception ex)
        {
            releaseSuccess = false;
            releaseMessage = $"❌ {ex.Message}";
        }
        finally
        {
            isCreatingRelease = false;
            StateHasChanged();
        }
    }
}

