@page "/about"
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@using SportsBettingAnalyzer.Services
@inject PythonMLServiceClient MLService
@rendermode InteractiveServer

<PageTitle>About - Sports Betting Analyzer</PageTitle>

<TwContainer MaxWidth="large" Class="mt-8">
    <div class="space-y-8 pb-12">
        <!-- Version Information -->
        <TwCard Class="p-8 bg-slate-900 border-slate-800 shadow-2xl">
            <div class="flex items-center gap-3 mb-6">
                <div class="bg-green-600/20 p-3 rounded-xl">
                    <TwIcon Icon="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" Class="w-6 h-6 text-green-400" />
                </div>
                <h2 class="text-2xl font-bold text-white">Version Information</h2>
            </div>
            
            @if (versionInfo != null)
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div class="p-4 rounded-lg border border-slate-700 bg-slate-800/50">
                        <div class="text-sm font-semibold text-slate-400 mb-1">Version</div>
                        <div class="text-lg font-mono text-white">@versionInfo.Version</div>
                    </div>
                    <div class="p-4 rounded-lg border border-slate-700 bg-slate-800/50">
                        <div class="text-sm font-semibold text-slate-400 mb-1">Environment</div>
                        <div class="text-lg font-mono text-white">@versionInfo.Environment</div>
                    </div>
                    <div class="p-4 rounded-lg border border-slate-700 bg-slate-800/50">
                        <div class="text-sm font-semibold text-slate-400 mb-1">Git SHA</div>
                        <div class="text-lg font-mono text-white text-xs">@(versionInfo.GitSha.Length > 8 ? versionInfo.GitSha.Substring(0, 8) : versionInfo.GitSha)</div>
                    </div>
                    <div class="p-4 rounded-lg border border-slate-700 bg-slate-800/50">
                        <div class="text-sm font-semibold text-slate-400 mb-1">Build Time</div>
                        <div class="text-lg font-mono text-white text-xs">@versionInfo.BuildTime</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(versionInfo.DeploymentId))
                {
                    <div class="mt-6 p-4 rounded-lg border border-blue-700 bg-blue-900/20">
                        <div class="text-sm font-semibold text-blue-400 mb-1">Deployment ID</div>
                        <div class="text-lg font-mono text-blue-300">@versionInfo.DeploymentId</div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-8">
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-700 bg-slate-800/50">
                        <TwIcon Icon="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-5 h-5 text-yellow-400 animate-spin" />
                        <span class="text-slate-400">Loading version information...</span>
                    </div>
                </div>
            }

            <!-- Mark Release Section -->
            <div class="mt-6 pt-6 border-t border-slate-700">
                <div class="flex items-center justify-between flex-wrap gap-4">
                    <div>
                        <h3 class="text-lg font-semibold text-white">Mark Milestone Release</h3>
                        <p class="text-sm text-slate-400">Bump the major version to mark an important milestone. Next deploys auto-increment from here.</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="flex items-center gap-2">
                            <label class="text-sm text-slate-400">Major</label>
                            <input type="number" @bind="releaseMajor" min="1" max="99"
                                   class="w-16 px-2 py-1 rounded-lg border border-slate-600 bg-slate-800 text-white text-center font-mono" />
                        </div>
                        <div class="flex items-center gap-2">
                            <label class="text-sm text-slate-400">Minor</label>
                            <input type="number" @bind="releaseMinor" min="0" max="99"
                                   class="w-16 px-2 py-1 rounded-lg border border-slate-600 bg-slate-800 text-white text-center font-mono" />
                        </div>
                        <button @onclick="CreateRelease" disabled="@isCreatingRelease"
                                class="px-4 py-2 bg-green-600 hover:bg-green-500 disabled:bg-slate-600 text-white rounded-lg font-semibold text-sm transition-colors">
                            @if (isCreatingRelease)
                            {
                                <span>Creating...</span>
                            }
                            else
                            {
                                <span>🚀 Create @(releaseMajor).@(releaseMinor).0</span>
                            }
                        </button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(releaseMessage))
                {
                    <div class="mt-3 p-3 rounded-lg text-sm @(releaseSuccess ? "bg-green-900/30 border border-green-700 text-green-300" : "bg-red-900/30 border border-red-700 text-red-300")">
                        @releaseMessage
                    </div>
                }
            </div>
        </TwCard>

        <!-- Deployment History -->
        @if (deployHistory.Any())
        {
            <TwCard Class="p-8 bg-slate-900 border-slate-800">
                <div class="flex items-center gap-3 mb-6">
                    <div class="bg-purple-600/20 p-3 rounded-xl">
                        <TwIcon Icon="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" Class="w-6 h-6 text-purple-400" />
                    </div>
                    <h2 class="text-2xl font-bold text-white">Deploy History</h2>
                </div>
                <div class="rounded-xl overflow-hidden border border-slate-800">
                    <table class="w-full text-sm">
                        <thead class="bg-slate-800/50">
                            <tr>
                                <th class="text-left px-4 py-3 text-slate-400 font-semibold">Version</th>
                                <th class="text-left px-4 py-3 text-slate-400 font-semibold">Git SHA</th>
                                <th class="text-left px-4 py-3 text-slate-400 font-semibold">Environment</th>
                                <th class="text-left px-4 py-3 text-slate-400 font-semibold">Deployed At</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in deployHistory)
                            {
                                <tr class="border-t border-slate-800 hover:bg-slate-800/30">
                                    <td class="px-4 py-3 font-mono text-white font-semibold">@entry.Version</td>
                                    <td class="px-4 py-3 font-mono text-slate-300 text-xs">@(entry.GitSha.Length > 8 ? entry.GitSha.Substring(0, 8) : entry.GitSha)</td>
                                    <td class="px-4 py-3 text-slate-300">@entry.Environment</td>
                                    <td class="px-4 py-3 text-slate-400 text-xs">@entry.DeployedAt</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </TwCard>
        }

        <!-- Header -->
        <TwCard Class="p-8 bg-slate-900 border-slate-800 shadow-2xl">
            <div class="flex items-center gap-6 mb-6">
                <div class="bg-blue-600/20 p-4 rounded-2xl">
