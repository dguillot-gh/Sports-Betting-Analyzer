        </TwCard>

        <!-- ML Models -->
        <TwGrid Columns="1" ColumnsMd="2" Gap="8">
            <TwCard Class="p-8 bg-slate-900 border-slate-800">
                <div class="flex items-center gap-3 mb-6">
                    <div class="p-2 bg-emerald-500/10 rounded-lg">
                        <TwIcon Icon="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5s3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" Class="w-6 h-6 text-emerald-400" />
