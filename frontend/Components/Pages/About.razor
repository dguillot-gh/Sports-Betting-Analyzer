                <div class="flex flex-col h-full border border-slate-800 rounded-2xl overflow-hidden bg-slate-950/30">
                    <div class="bg-slate-800/30 p-6">
                        <div class="flex items-center gap-3 mb-2">
                             <TwIcon Icon="M13 10V3L4 14h7v7l9-11h-7z" Class="w-6 h-6 text-amber-400" />
