@page "/imports"
@using SportsBettingAnalyzer.Models
@using SportsBettingAnalyzer.Services
@inject PythonMLServiceClient PythonService
@inject IJSRuntime JSRuntime

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1>Automated Data Import</h1>
            <p>Manage data imports, view logs, and configure automation settings.</p>
        </div>
    </div>

    <div class="row mb-4">
        <!-- Control Panel -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Actions</h5>
                </div>
                <div class="card-body">
                    <p>Trigger a full import sequence manually. This runs all active sports in order.</p>
                    
                    @if (isImporting)
                    {
                         <div class="alert alert-info">
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            Import request sent... Check logs for progress.
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-success w-100 mb-3" @onclick="TriggerImport">
                            <i class="oi oi-play-circle me-2"></i> Run Manual Import
                        </button>
                    }

                    <hr />
                    
                    <h6>Status Indicators</h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Scheduler Service
                            <span class="badge bg-success rounded-pill">Active</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Pushover Notifications
                            <span class="badge bg-secondary rounded-pill" title="Check .env file">Unknown</span>
                        </li>
                    </ul>
                </div>
                <div class="card-footer text-muted">
                    <small>Next Scheduled Run: 03:00 AM</small>
                </div>
            </div>
        </div>
        
        <!-- Notifications Setup Guide -->
        <div class="col-md-8">
            <div class="card shadow-sm h-100">
                 <div class="card-header">
                    <h5 class="mb-0">Setup Notifications</h5>
                </div>
                <div class="card-body">
                    <p>To receive instant alerts on your phone when imports finish (or fail), setup Pushover:</p>
                    <ol>
                        <li>Create a free account at <a href="https://pushover.net" target="_blank">Pushover.net</a>.</li>
                        <li>Get your <strong>User Key</strong> from the dashboard.</li>
                        <li>Create an "Application" (e.g., "SportsBettingBot") to get an <strong>API Token</strong>.</li>
                        <li>Add these to your <code>backend/.env</code> file:</li>
                    </ol>
                    <div class="bg-light p-3 rounded font-monospace">
                        PUSHOVER_USER_KEY=your_user_key<br/>
                        PUSHOVER_API_TOKEN=your_api_token
                    </div>
                    <p class="mt-3 text-muted"><small>No restart required; the service loads these dynamically or on next run.</small></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Logs Table -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Import History</h5>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadLogs">
                        <i class="oi oi-reload"></i> Refresh
                    </button>
                </div>
                <table class="table table-hover table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Sport</th>
                            <th>Time</th>
                            <th>Duration</th>
                            <th>Rows</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (logs == null)
                        {
                            <tr><td colspan="6" class="text-center">Loading...</td></tr>
                        }
                        else if (!logs.Any())
                        {
                            <tr><td colspan="6" class="text-center">No logs found.</td></tr>
                        }
                        else
                        {
                            @foreach (var log in logs)
                            {
                                <tr>
                                    <td>
                                        @if (log.Status == "SUCCESS") 
                                        { <span class="badge bg-success">Success</span> }
                                        else if (log.Status == "IN_PROGRESS") 
                                        { <span class="badge bg-warning text-dark">Running</span> }
                                        else 
                                        { <span class="badge bg-danger">Failed</span> }
                                    </td>
                                    <td>@log.Sport.ToUpper()</td>
                                    <td>@log.StartTime.ToLocalTime().ToString("g")</td>
                                    <td>@(log.DurationSeconds.HasValue ? $"{log.DurationSeconds:F1}s" : "-")</td>
                                    <td>@log.RowsImported</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.ErrorMessage))
                                        {
                                            <span class="text-danger" title="@log.ErrorMessage">@log.ErrorMessage.Substring(0, Math.Min(50, log.ErrorMessage.Length))...</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ImportLog> logs;
    private bool isImporting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        logs = await PythonService.GetImportLogsAsync();
    }

    private async Task TriggerImport()
    {
        isImporting = true;
        bool success = await PythonService.RunImportsAsync();
        
        if (success)
        {
            // Wait a sec for the job to register in DB
            await Task.Delay(1000); 
            await LoadLogs();
        }
        else 
        {
            await JSRuntime.InvokeVoidAsync("alert", "Failed to trigger import. Check console.");
        }
        
        isImporting = false;
    }
}
