@page "/imports"
@using SportsBettingAnalyzer.Models
@using SportsBettingAnalyzer.Services
@inject PythonMLServiceClient PythonService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h3" GutterBottom="true">Automated Data Import</MudText>
    <MudText Class="mb-8">Manage data imports, view logs, and configure automation settings.</MudText>

    <MudGrid>
        <!-- Control Panel -->
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Class="h-100">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Actions</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Class="mb-4">Trigger a full import sequence manually. This runs all active sports in order.</MudText>
                    
                    @if (isImporting)
                    {
                        <div class="d-flex align-center justify-center pa-4">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mr-3"/>
                            <MudText>Importing...</MudText>
                        </div>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Success" 
                                   FullWidth="true" 
                                   StartIcon="@Icons.Material.Filled.PlayCircle"
                                   OnClick="TriggerImport"
                                   Class="mb-4 py-3">
                            Run Manual Import
                        </MudButton>
                    }

                    <MudDivider Class="my-4"/>
                    
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Status Indicators</MudText>
                    <MudList T="string" Dense="true">
                        <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                            Scheduler Service: Active
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Notifications" IconColor="Color.Default">
                            Pushover: (Check .env)
                        </MudListItem>
                    </MudList>
                </MudCardContent>
                <MudCardActions>
                    <MudText Typo="Typo.caption" Class="pa-2">Next Run: 03:00 AM</MudText>
                </MudCardActions>
            </MudCard>
        </MudItem>
        
        <!-- Notifications Setup Guide -->
        <MudItem xs="12" md="8">
            <MudCard Elevation="3" Class="h-100">
                 <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Setup Notifications</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Class="mb-2">To receive alerts on your phone:</MudText>
                    <MudList T="string" Dense="true" Class="mb-4">
                        <MudListItem Icon="@Icons.Material.Filled.LooksOne">Create account at <MudLink Href="https://pushover.net" Target="_blank">Pushover.net</MudLink></MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.LooksTwo">Get <strong>User Key</strong> from dashboard</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Looks3">Create App to get <strong>API Token</strong></MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Looks4">Add to <code>backend/.env</code></MudListItem>
                    </MudList>
                    
                    <MudPaper Class="pa-4 mud-theme-dark" Elevation="0">
                        <code style="color: #a6e22e">PUSHOVER_USER_KEY</code>=<code style="color: #e6db74">your_user_key</code><br/>
                        <code style="color: #a6e22e">PUSHOVER_API_TOKEN</code>=<code style="color: #e6db74">your_api_token</code>
                    </MudPaper>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Logs Table -->
        <MudItem xs="12">
            <MudTable Items="@logs" Hover="true" Loading="@(logs == null)" Elevation="3">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Import History</MudText>
                    <MudSpacer />
                    <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadLogs">Refresh</MudButton>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Status</MudTh>
                    <MudTh>Sport</MudTh>
                    <MudTh>Time</MudTh>
                    <MudTh>Duration</MudTh>
                    <MudTh>Rows</MudTh>
                    <MudTh>Details</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Status">
                        @if (context.Status == "SUCCESS") 
                        { <MudChip T="string" Color="Color.Success" Size="Size.Small">Success</MudChip> }
                        else if (context.Status == "IN_PROGRESS") 
                        { <MudChip T="string" Color="Color.Warning" Size="Size.Small" Text="dark">Running</MudChip> }
                        else 
                        { <MudChip T="string" Color="Color.Error" Size="Size.Small">Failed</MudChip> }
                    </MudTd>
                    <MudTd DataLabel="Sport">@context.Sport.ToUpper()</MudTd>
                    <MudTd DataLabel="Time">@context.StartTime.ToLocalTime().ToString("g")</MudTd>
                    <MudTd DataLabel="Duration">@(context.DurationSeconds.HasValue ? $"{context.DurationSeconds:F1}s" : "-")</MudTd>
                    <MudTd DataLabel="Rows">@context.RowsImported</MudTd>
                    <MudTd DataLabel="Details">
                        @if (!string.IsNullOrEmpty(context.ErrorMessage))
                        {
                            <MudTooltip Text="@context.ErrorMessage">
                                <MudText Color="Color.Error" Typo="Typo.body2">
                                    @(context.ErrorMessage.Length > 50 ? context.ErrorMessage.Substring(0, 50) + "..." : context.ErrorMessage)
                                </MudText>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Default">-</MudText>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>No logs found.</MudText>
                </NoRecordsContent>
                <LoadingContent>
                    <MudText>Loading logs...</MudText>
                </LoadingContent>
            </MudTable>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<ImportLog> logs;
    private bool isImporting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        logs = await PythonService.GetImportLogsAsync();
    }

    private async Task TriggerImport()
    {
        isImporting = true;
        // Show immediate feedback
        Snackbar.Add("Import request sent...", Severity.Info);
        
        bool success = await PythonService.RunImportsAsync();
        
        if (success)
        {
            await Task.Delay(1000); // Wait for DB write
            await LoadLogs();
            Snackbar.Add("Import process started in background", Severity.Success);
        }
        else 
        {
            Snackbar.Add("Failed to trigger import", Severity.Error);
        }
        
        isImporting = false;
    }
}
