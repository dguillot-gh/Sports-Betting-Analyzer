@page "/model-lab"
@inject HttpClient Http
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Model Training Lab</MudText>
    <MudText Typo="Typo.subtitle1" Class="mb-6">Experimental Sandbox - Train new models without affecting production</MudText>

    <MudGrid>
        <!-- Configuration Panel -->
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">New Experiment</MudText>
                
                <MudSelect T="string" Label="Sport" @bind-Value="selectedSport" Class="mb-3">
                    <MudSelectItem Value="@("nba")">NBA</MudSelectItem>
                    <MudSelectItem Value="@("nfl")" Disabled="true">NFL (Coming Soon)</MudSelectItem>
                </MudSelect>
                
                <MudSelect T="string" Label="Model Type" @bind-Value="selectedModelType" Class="mb-3">
                    <MudSelectItem Value="@("xgboost")">XGBoost (Gradient Boosting)</MudSelectItem>
                    <MudSelectItem Value="@("neural_network")">Neural Network (MLP)</MudSelectItem>
                </MudSelect>
                
                @if (selectedModelType == "neural_network")
                {
                    <MudTextField Label="Train Season" @bind-Value="trainSeason" Placeholder="2023-2024" Class="mb-3" />
                    <MudTextField Label="Test Season" @bind-Value="testSeason" Placeholder="2024-2025" Class="mb-3" />
                }
                else
                {
                    <MudNumericField Label="Epochs" @bind-Value="epochs" Min="10" Max="5000" Step="10" Class="mb-3" />
                }
                
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartTraining" Disabled="@isTraining" FullWidth="true">
                    @if (isTraining) { <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/> <span class="ms-2">Starting...</span> }
                    else { <span>Start Training</span> }
                </MudButton>
            </MudPaper>
        </MudItem>

        <!-- Active Jobs Panel -->
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4" Style="min-height: 400px;">
                 <MudText Typo="Typo.h6" Class="mb-3">Active Jobs</MudText>
                 
                 @if (jobs == null)
                 {
                     <MudProgressCircular Indeterminate="true" />
                 }
                 else if (jobs.Count == 0)
                 {
                     <MudAlert Severity="Severity.Info">No active training jobs.</MudAlert>
                 }
                 else 
                 {
                     <MudTable Items="jobs" Dense="true" Hover="true">
                         <HeaderContent>
                             <MudTh>ID</MudTh>
                             <MudTh>Sport</MudTh>
                             <MudTh>Status</MudTh>
                             <MudTh>Progress</MudTh>
                             <MudTh>Started</MudTh>
                             <MudTh>Actions</MudTh>
                         </HeaderContent>
                         <RowTemplate>
                             <MudTd DataLabel="ID">@context.id.Substring(0, 8)</MudTd>
                             <MudTd DataLabel="Sport">@context.sport</MudTd>
                             <MudTd DataLabel="Status">
                                 <MudChip T="string" Color="@GetStatusColor(context.status)" Size="Size.Small">@context.status</MudChip>
                             </MudTd>
                             <MudTd DataLabel="Progress">
                                 <MudProgressLinear Value="@context.progress" Color="Color.Success" Class="my-3" />
                                 <MudText Typo="Typo.caption">@context.progress.ToString("0.0")%</MudText>
                             </MudTd>
                             <MudTd DataLabel="Started">@context.start_time</MudTd>
                             <MudTd DataLabel="Actions">
                                 <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => ViewJobDetails(context.id))">Details</MudButton>
                                 @if (context.status == "completed")
                                 {
                                     <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" Class="ms-2" OnClick="@(() => PromoteJob(context.id))">Promote</MudButton>
                                 }
                             </MudTd>
                         </RowTemplate>
                     </MudTable>
                 }
            </MudPaper>
        </MudItem>
    </MudGrid>
    
    <!-- Details Dialog/Area -->
    @if (selectedJob != null)
    {
        <MudCard Class="mt-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">Job Details: @selectedJob.id</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" md="6">
                         <MudText Typo="Typo.h6">Training Logs</MudText>
                         <div style="max-height: 300px; overflow-y: auto; background-color: #1e1e1e; color: #00ff00; font-family: monospace; padding: 10px; border-radius: 4px;">
                             @foreach (var log in selectedJob.logs)
                             {
                                 <div>@log</div>
                             }
                         </div>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.h6">Metrics</MudText>
                        @if (selectedJob.metrics != null && selectedJob.metrics.ContainsKey("accuracy"))
                        {
                            <MudChart ChartType="ChartType.Line" ChartSeries="@GetSeries(selectedJob)" XAxisLabels="@GetLabels(selectedJob)" Width="100%" Height="300px"></MudChart>
                        }
                        else
                        {
                            <MudText>No metrics available yet.</MudText>
                        }
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>
    }

</MudContainer>

@code {
    private string selectedSport = "nba";
    private string selectedModelType = "xgboost";
    private int epochs = 100;
    private string trainSeason = "2023-2024";
    private string testSeason = "2024-2025";
    private bool isTraining = false;
    private List<JobSummary> jobs = new();
    private JobDetails selectedJob;
    private System.Threading.Timer timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadJobs();
        // Poll every 3 seconds for updates
        timer = new System.Threading.Timer(async _ =>
        {
            await LoadJobs();
            if (selectedJob != null)
            {
                await ViewJobDetails(selectedJob.id);
            }
            await InvokeAsync(StateHasChanged);
        }, null, 0, 3000);
    }
    
    private async Task LoadJobs()
    {
        try 
        {
            jobs = await Http.GetFromJsonAsync<List<JobSummary>>("/lab/jobs");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading jobs: {ex.Message}");
        }
    }

    private async Task StartTraining()
    {
        isTraining = true;
        try 
        {
            var config = new { 
                model_type = selectedModelType, 
                epochs = epochs,
                train_season = trainSeason,
                test_season = testSeason
            };
            await Http.PostAsJsonAsync($"/lab/train/{selectedSport}", config);
            await LoadJobs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error starting job: {ex.Message}");
        }
        finally 
        {
            isTraining = false;
        }
    }
    
    private async Task ViewJobDetails(string jobId)
    {
        try 
        {
            selectedJob = await Http.GetFromJsonAsync<JobDetails>($"/lab/jobs/{jobId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading details: {ex.Message}");
        }
    }
    
    private async Task PromoteJob(string jobId)
    {
        try 
        {
            var response = await Http.PostAsync($"/lab/promote/{jobId}", null);
            if (response.IsSuccessStatusCode)
            {
               // Show snackbar? For now just console
               Console.WriteLine("Job promoted successfully");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error promoting job: {ex.Message}");
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "created" => Color.Default,
        "running" => Color.Info,
        "completed" => Color.Success,
        "failed" => Color.Error,
        "stopped" => Color.Warning,
        _ => Color.Default
    };
    
    public class JobSummary
    {
        public string id { get; set; }
        public string sport { get; set; }
        public string status { get; set; }
        public double progress { get; set; }
        public string start_time { get; set; }
    }
    
    public class JobDetails : JobSummary
    {
        public List<string> logs { get; set; }
        public Dictionary<string, List<double>> metrics { get; set; }
        public string output_path { get; set; }
        public string error { get; set; }
    }
    
    private List<ChartSeries> GetSeries(JobDetails job)
    {
        var series = new List<ChartSeries>();
        if (job.metrics.ContainsKey("accuracy"))
        {
            series.Add(new ChartSeries() { Name = "Accuracy", Data = job.metrics["accuracy"].ToArray() });
        }
         if (job.metrics.ContainsKey("mae"))
        {
            series.Add(new ChartSeries() { Name = "MAE", Data = job.metrics["mae"].ToArray() });
        }
        return series;
    }
    
    private string[] GetLabels(JobDetails job)
    {
        if (!job.metrics.ContainsKey("accuracy")) return new string[0];
        int count = job.metrics["accuracy"].Count;
        return Enumerable.Range(1, count).Select(i => i.ToString()).ToArray();
    }
    
    public void Dispose()
    {
        timer?.Dispose();
    }
}
