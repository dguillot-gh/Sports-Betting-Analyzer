@code {
    private int _activeTab = 0;
    private bool _isPythonServiceAvailable = true;

    // Quick Predict State
    private string _nascarSeries = "cup";
    private string _predictionTask = "classification";
    private bool _isPredicting = false;
    private string _predictStatus = "";
    private PredictResponse? _predictionResult;
    private string _driver = "";
    private string _track = "";
    private string _trackType = "";
    private int _year = 2025;
    private int _startPos = 15;

    // Interactive Simulator State
    private string _simSeries = "cup";
    private string _simTask = "classification";
    private bool _isLoadingSimFeatures = false;
    private bool _simFeaturesLoaded = false;
    private bool _isSimPredicting = false;
    private string _simStatus = "";
    private List<string> _simCategoricalFeatures = new();
    private List<string> _simNumericFeatures = new();
    private Dictionary<string, List<object>> _simFeatureValues = new();
    private Dictionary<string, string> _simCategoricalInputs = new();
    private Dictionary<string, double?> _simNumericInputs = new();
    private PredictResponse? _simPredictionResult;

    // Monte Carlo State
    private int _mcYear = DateTime.Now.Year;
    private string _mcTrackType = "Intermediate";
    private int _mcNumSimulations = 1000;
    private List<int> _mcYears = Enumerable.Range(2018, DateTime.Now.Year - 2018 + 1).Reverse().ToList();
    private List<string> _mcAllDrivers = new();
    private IEnumerable<string> _mcSelectedDrivers = new HashSet<string>();
    private bool _mcIsLoading = false;
    private string _mcStatus = "";
    private SimulationResponse? _mcResponse;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isPythonServiceAvailable = await MLClient.IsHealthyAsync();
            _mcAllDrivers = await MLClient.GetDriversAsync("nascar", "cup");
            _mcAllDrivers.Sort();
            MCSelectTop20();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing Simulations page");
        }
    }

    // Quick Predict Methods
    private async Task MakeQuickPrediction()
    {
        _isPredicting = true;
        _predictionResult = null;
        _predictStatus = "Initializing prediction model...";
        StateHasChanged();
        
        try
        {
            _predictStatus = $"Running prediction for {_driver}...";
            StateHasChanged();
            await Task.Delay(50);
            
            var features = new Dictionary<string, object>
            {
                ["driver"] = _driver, ["track"] = _track, ["track_type"] = _trackType,
                ["year"] = _year, ["start"] = _startPos, ["status"] = "running"
            };
            var request = new PredictRequest { Features = features };
            _predictionResult = await MLClient.PredictAsync("nascar", _predictionTask, request, _nascarSeries);
            
            _predictStatus = "";
            Snackbar.Add("Prediction completed!", Severity.Success);
        }
        catch (Exception ex) 
        { 
            _predictStatus = $"Error: {ex.Message}";
            Snackbar.Add($"Prediction failed: {ex.Message}", Severity.Error); 
        }
        finally { _isPredicting = false; }
    }

    // Interactive Simulator Methods
    private async Task LoadSimFeatures()
    {
        _isLoadingSimFeatures = true;
        _simFeaturesLoaded = false;
        try
        {
            var schema = await MLClient.GetSchemaAsync("nascar");
            if (schema.Features != null)
            {
                _simCategoricalFeatures = schema.Features.GetValueOrDefault("categorical", new List<string>());
                _simNumericFeatures = schema.Features.GetValueOrDefault("numeric", new List<string>());
            }
            _simFeatureValues = await MLClient.GetFeatureValuesAsync("nascar", _simSeries);
            _simCategoricalInputs.Clear();
            foreach (var f in _simCategoricalFeatures) _simCategoricalInputs[f] = "";
            _simNumericInputs.Clear();
            foreach (var f in _simNumericFeatures) _simNumericInputs[f] = null;
            _simFeaturesLoaded = true;
        }
        catch (Exception ex) { Snackbar.Add($"Failed to load: {ex.Message}", Severity.Error); }
        finally { _isLoadingSimFeatures = false; }
    }

    private async Task RunSimPrediction()
    {
        _isSimPredicting = true;
        _simPredictionResult = null;
        _simStatus = "Preparing features...";
        StateHasChanged();
        
        try
        {
            _simStatus = "Running model prediction...";
            StateHasChanged();
            await Task.Delay(50);
            
            var features = new Dictionary<string, object>();
            foreach (var kvp in _simCategoricalInputs) if (!string.IsNullOrEmpty(kvp.Value)) features[kvp.Key] = kvp.Value;
            foreach (var kvp in _simNumericInputs) if (kvp.Value.HasValue) features[kvp.Key] = kvp.Value.Value;
            var request = new PredictRequest { Features = features };
            _simPredictionResult = await MLClient.PredictAsync("nascar", _simTask, request, _simSeries);
            
            _simStatus = "";
            Snackbar.Add("Prediction completed!", Severity.Success);
        }
        catch (Exception ex) 
        { 
            _simStatus = $"Error: {ex.Message}";
            Snackbar.Add($"Prediction failed: {ex.Message}", Severity.Error); 
        }
        finally { _isSimPredicting = false; }
    }

    // Monte Carlo Methods
    private void MCSelectAll() => _mcSelectedDrivers = _mcAllDrivers.ToHashSet();
    private void MCDeselectAll() => _mcSelectedDrivers = new HashSet<string>();
