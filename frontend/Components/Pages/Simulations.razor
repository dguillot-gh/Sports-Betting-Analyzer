        { 
            _mcStatus = $"Error: {ex.Message}";
            Snackbar.Add($"Simulation failed: {ex.Message}", Severity.Error); 
        }
        finally { _mcIsLoading = false; }
    }

    private async Task ExportMCResults()
    {
        if (_mcResponse?.Results == null) return;
        await FileExportService.ExportToCsv(_mcResponse.Results, $"simulation_{_mcYear}_{_mcTrackType}.csv");
        Snackbar.Add("Exported to CSV", Severity.Success);
    }

    private string FormatLabel(string name) => 
        System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(name.Replace("_", " "));

    // NFL Season Simulation State
    private int _nflSimulations = 1000;
    private bool _nflIsLoading = false;
    private string _nflSimStatus = "";
    private Dictionary<string, object>? _nflSimResults;
    
    private async Task RunNFLSimulation()
    {
        _nflIsLoading = true;
        _nflSimResults = null;
        _nflSimStatus = "Initializing NFL season simulation...";
        StateHasChanged();
        
        var cts = new CancellationTokenSource();
        
        try
        {
            // Start polling task
            var pollingTask = PollNFLStatus(cts.Token);
            
            using var http = new HttpClient { BaseAddress = new Uri("http://backend:8000"), Timeout = TimeSpan.FromMinutes(5) };
            var payload = new { simulations = _nflSimulations, force_refresh = true };
            
            // Await the long-running simulation
            var response = await http.PostAsJsonAsync("/simulation/nfl/season", payload);
            
            // Stop polling
            cts.Cancel();
            try { await pollingTask; } catch (OperationCanceledException) {}
            
            _nflSimStatus = "Processing results...";
            StateHasChanged();
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                Logger.LogInformation("NFL simulation response: {Json}", json.Substring(0, Math.Min(500, json.Length)));
                
                _nflSimResults = JsonSerializer.Deserialize<Dictionary<string, object>>(json);
                
                Logger.LogInformation("Parsed keys: {Keys}", _nflSimResults != null ? string.Join(", ", _nflSimResults.Keys) : "null");
                
                if (_nflSimResults != null && !HasError(_nflSimResults))
                {
                    Snackbar.Add("NFL simulation complete!", Severity.Success);
                    _nflSimStatus = "";
                }
                else
                {
                    var errorMsg = _nflSimResults?.ContainsKey("message") == true ? _nflSimResults["message"]?.ToString() : "Unknown error";
                    _nflSimStatus = $"Simulation returned an error: {errorMsg}";
                    Logger.LogError("Simulation error: {Error}", errorMsg);
                }
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                Logger.LogError("NFL simulation failed: {Status} - {Body}", response.StatusCode, errorBody);
                Snackbar.Add($"Simulation failed: {response.StatusCode}", Severity.Error);
                _nflSimStatus = $"Failed: {response.StatusCode}";
            }
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add("Simulation timed out - try fewer simulations", Severity.Warning);
            _nflSimStatus = "Timed out";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error running NFL simulation");
            Snackbar.Add($"Simulation failed: {ex.Message}", Severity.Error);
            _nflSimStatus = $"Error: {ex.Message}";
        }
        finally
        {
            cts.Cancel();
            cts.Dispose();
            _nflIsLoading = false;
        }
    }

    private async Task PollNFLStatus(CancellationToken token)
    {
        using var http = new HttpClient { BaseAddress = new Uri("http://backend:8000"), Timeout = TimeSpan.FromSeconds(5) };
        
        while (!token.IsCancellationRequested)
        {
            try
            {
                var status = await http.GetFromJsonAsync<Dictionary<string, object>>("/simulation/nfl/status", token);
                if (status != null && status.ContainsKey("message"))
                {
                    var msg = status["message"].ToString();
                    if (!string.IsNullOrEmpty(msg) && _nflSimStatus != msg)
                    {
                        _nflSimStatus = msg;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                
                await Task.Delay(1000, token);
            }
            catch (Exception)
            {
                // Ignore polling errors to not interrupt main flow
                await Task.Delay(2000, token);
            }
        }
    }
    
    private bool HasError(Dictionary<string, object>? dict)
    {
        if (dict == null) return false;
        if (!dict.ContainsKey("error")) return false;
        
        var errorVal = dict["error"];
        if (errorVal is bool b) return b;
        if (errorVal is JsonElement je)
        {
            if (je.ValueKind == JsonValueKind.True) return true;
            if (je.ValueKind == JsonValueKind.False) return false;
        }
        // If it's a string "true" or has some value, treat as error
        return errorVal?.ToString()?.ToLower() == "true";
    }
    
    private List<Dictionary<string, object>> GetNFLTeamsList()
    {
        if (_nflSimResults == null || !_nflSimResults.ContainsKey("all_teams"))
            return new List<Dictionary<string, object>>();
        
        try
        {
            var element = (JsonElement)_nflSimResults["all_teams"];
            var result = new List<Dictionary<string, object>>();
            
            // Python fallback returns array of team objects
            if (element.ValueKind == JsonValueKind.Array)
            {
                foreach (var team in element.EnumerateArray())
                {
                    var dict = new Dictionary<string, object>();
                    foreach (var prop in team.EnumerateObject())
                    {
                        if (prop.Value.ValueKind == JsonValueKind.String)
                            dict[prop.Name] = prop.Value.GetString() ?? "";
                        else if (prop.Value.ValueKind == JsonValueKind.Number)
                            dict[prop.Name] = prop.Value.GetDouble();
                        else
                            dict[prop.Name] = prop.Value.ToString();
                    }
                    result.Add(dict);
                }
            }
            // nflseedR returns columns as arrays (object format)
            else if (element.ValueKind == JsonValueKind.Object)
            {
                var teamArray = element.GetProperty("team").EnumerateArray().ToList();
                var playoffArray = element.TryGetProperty("playoff_pct", out var p) ? p.EnumerateArray().ToList() : null;
                var confArray = element.TryGetProperty("conf_pct", out var c) ? c.EnumerateArray().ToList() : null;
                var sbArray = element.TryGetProperty("super_bowl_pct", out var sb) ? sb.EnumerateArray().ToList() : null;
                
                for (int i = 0; i < teamArray.Count; i++)
                {
                    result.Add(new Dictionary<string, object>
                    {
                        ["team"] = teamArray[i].GetString() ?? "",
                        ["playoff_pct"] = playoffArray?[i].GetDouble() ?? 0,
                        ["conf_pct"] = confArray?[i].GetDouble() ?? 0,
                        ["super_bowl_pct"] = sbArray?[i].GetDouble() ?? 0
                    });
                }
            }
            
            return result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error parsing NFL teams list: {ex.Message}");
            return new List<Dictionary<string, object>>();
        }
    }
    
    // Get teams for a specific conference (afc or nfc)
    private List<Dictionary<string, object>> GetConferenceTeams(string conf)
    {
        if (_nflSimResults == null || !_nflSimResults.ContainsKey(conf))
            return new List<Dictionary<string, object>>();
        
        try
        {
            var element = (JsonElement)_nflSimResults[conf];
            var result = new List<Dictionary<string, object>>();
            
            // Python fallback returns array of team objects
            if (element.ValueKind == JsonValueKind.Array)
            {
                foreach (var team in element.EnumerateArray())
                {
                    var dict = new Dictionary<string, object>();
                    foreach (var prop in team.EnumerateObject())
                    {
                        if (prop.Value.ValueKind == JsonValueKind.String)
                            dict[prop.Name] = prop.Value.GetString() ?? "";
                        else if (prop.Value.ValueKind == JsonValueKind.Number)
                            dict[prop.Name] = prop.Value.GetDouble();
                        else
                            dict[prop.Name] = prop.Value.ToString();
                    }
                    result.Add(dict);
                }
            }
            
            return result.OrderByDescending(t => GetDouble(t, "playoff_pct")).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error parsing {conf} teams: {ex.Message}");
            return new List<Dictionary<string, object>>();
        }
    }
    
    private double GetDouble(Dictionary<string, object> dict, string key)
    {
        if (!dict.ContainsKey(key)) return 0;
        var val = dict[key];
        if (val is double d) return d;
        if (val is JsonElement je && je.ValueKind == JsonValueKind.Number) return je.GetDouble();
        return 0;
    }
    
