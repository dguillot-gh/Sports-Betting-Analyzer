                                            <th class="pb-3 px-2">Playoff %</th>
                                            <th class="pb-3 px-2">Champ 4 %</th>
                                            <th class="pb-3 px-2">Championship %</th>
                                            <th class="pb-3 px-2 text-right">Avg Wins</th>
