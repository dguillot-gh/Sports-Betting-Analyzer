                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Track Type</label>
                                <select @bind="_racePickTrack" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors">
                                    <option value="Superspeedway">Superspeedway</option>
                                    <option value="Intermediate">Intermediate (1.5 mile)</option>
                                    <option value="Short Track">Short Track</option>
                                    <option value="Road Course">Road Course</option>
                                </select>
                            </div>
                            
                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Simulations</label>
                                <input type="number" @bind="_racePickSims" min="100" max="2000" step="100" 
                                       class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors" />
                            </div>
                            
                            <TwButton Variant="primary" Class="w-full py-4 mt-4 bg-emerald-600 hover:bg-emerald-500 text-white font-bold" OnClick="RunRacePrediction" IsLoading="_racePickLoading" Disabled="@_racePickLoading">
                                🎰 Get Picks!
                            </TwButton>
                        </div>
                    </TwCard>
                    
                    @if (_racePickResults != null)
                    {
                        <div class="mt-6 p-5 bg-emerald-500/10 border border-emerald-500/20 rounded-2xl">
                            <h4 class="text-xs font-bold text-emerald-400 uppercase tracking-widest mb-4">Quick Picks:</h4>
                            <div class="space-y-3">
                                @{
                                    var picks = GetRacePickResults().Take(3).ToList();
                                    for (int i = 0; i < picks.Count; i++)
                                    {
                                        var p = picks[i];
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-2">
                                                <span class="text-slate-500 font-mono text-xs">@(i+1).</span>
                                                <span class="text-white font-bold text-sm">@p.GetValueOrDefault("driver", "")</span>
                                            </div>
                                            <span class="text-emerald-400 font-black text-xs">@GetDoubleRace(p, "win_pct")% win</span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="md:col-span-8">
                    @if (_racePickResults != null)
                    {
                        <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
                            <div class="p-6 flex justify-between items-center border-b border-slate-800">
                                <h3 class="text-lg font-bold text-white flex items-center gap-3">
                                    <TwIcon Icon="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" Class="w-5 h-5 text-blue-400" />
                                    @_racePickTrack Predictions
                                </h3>
                                <TwChip Color="blue" Size="sm" Class="font-bold">@_racePickSims iterations</TwChip>
                            </div>
                            
                            <div class="overflow-x-auto">
                                <table class="w-full text-left">
                                    <thead>
                                        <tr class="text-slate-500 text-[10px] uppercase tracking-widest border-b border-slate-800 bg-slate-950/20">
                                            <th class="py-4 px-6">#</th>
                                            <th class="py-4 px-6">Driver</th>
                                            <th class="py-4 px-6">Win %</th>
                                            <th class="py-4 px-6">Top 5 %</th>
                                            <th class="py-4 px-6">Top 10 %</th>
                                            <th class="py-4 px-6 text-right">Avg Finish</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-800/50">
                                        @{
                                            var results = GetRacePickResults();
                                            var pickRank = 1;
                                            foreach (var driver in results)
                                            {
                                                var winPct = GetDoubleRace(driver, "win_pct");
                                                var top5Pct = GetDoubleRace(driver, "top5_pct");
                                                var top10Pct = GetDoubleRace(driver, "top10_pct");
                                                <tr class="hover:bg-slate-800/30 transition-colors">
                                                    <td class="py-3 px-6 text-slate-600 font-mono text-xs">@pickRank</td>
                                                    <td class="py-3 px-6 text-white font-bold text-sm">@driver.GetValueOrDefault("driver", "")</td>
                                                    <td class="py-3 px-6">
                                                        <TwChip Color="@(winPct >= 10 ? "emerald" : winPct >= 5 ? "blue" : "slate")" Size="sm" Class="font-black text-[11px]">
                                                            @winPct.ToString("F1")%
                                                        </TwChip>
                                                    </td>
                                                    <td class="py-3 px-6 @(top5Pct >= 40 ? "text-emerald-400 font-bold" : "text-slate-400") text-sm">@top5Pct.ToString("F1")%</td>
                                                    <td class="py-3 px-6 @(top10Pct >= 60 ? "text-emerald-400 font-bold" : "text-slate-400") text-sm">@top10Pct.ToString("F1")%</td>
                                                    <td class="py-3 px-6 text-right font-mono text-slate-500 text-sm">@GetDoubleRace(driver, "avg_finish").ToString("F1")</td>
                                                </tr>
                                                pickRank++;
                                            }
