@page "/simulations"
@page "/predictions"
@page "/simulation"
@page "/advanced-predictions"
@rendermode InteractiveServer
@using SportsBettingAnalyzer.Services
@using System.Text.Json
@inject PythonMLServiceClient MLClient
@inject ISnackbar Snackbar
@inject ILogger<Simulations> Logger
@inject SimulationStateService SimulationState
@inject FileExportService FileExportService

<PageTitle>Race Simulations & Predictions</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true">Race Simulations & Predictions</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">NASCAR predictions, interactive simulator, and Monte Carlo simulations</MudText>

    <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
        <!-- Tab 1: Quick Predict -->
        <MudTabPanel Text="Quick Predict" Icon="@Icons.Material.Filled.FlashOn">
            @if (!_isPythonServiceAvailable)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">Python ML Service is not available.</MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2">
                        <MudCardHeader>
                            <MudText Typo="Typo.h6">Make a Prediction</MudText>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudStack Spacing="3">
                                <MudSelect @bind-Value="_nascarSeries" Label="Series" Dense="true">
                                    <MudSelectItem Value="@("cup")">Cup Series</MudSelectItem>
                                    <MudSelectItem Value="@("truck")">Truck Series</MudSelectItem>
                                    <MudSelectItem Value="@("xfinity")">Xfinity Series</MudSelectItem>
                                </MudSelect>
                                <MudSelect @bind-Value="_predictionTask" Label="Prediction Type" Dense="true">
                                    <MudSelectItem Value="@("classification")">Win Probability</MudSelectItem>
                                    <MudSelectItem Value="@("regression")">Finishing Position</MudSelectItem>
                                </MudSelect>
                                <MudDivider />
                                <MudTextField @bind-Value="_driver" Label="Driver Name" />
                                <MudTextField @bind-Value="_track" Label="Track Name" />
                                <MudTextField @bind-Value="_trackType" Label="Track Type" Hint="e.g., superspeedway, short track, road course" />
                                <MudNumericField @bind-Value="_year" Label="Season Year" Min="1949" Max="2025" />
                                <MudNumericField @bind-Value="_startPos" Label="Starting Position" Min="1" Max="40" />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" 
                                           OnClick="MakeQuickPrediction" Disabled="@(_isPredicting || string.IsNullOrEmpty(_driver))">
                                    @if (_isPredicting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                                    Get Prediction
                                </MudButton>
                                
                                @if (_isPredicting && !string.IsNullOrEmpty(_predictStatus))
                                {
                                    <MudPaper Class="pa-3 mt-2" Elevation="0" Style="background: rgba(0,0,0,0.05);">
                                        <div class="d-flex align-center">
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Class="mr-2" />
                                            <MudText Typo="Typo.body2" Color="Color.Primary">@_predictStatus</MudText>
                                        </div>
                                    </MudPaper>
                                }
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6">
                    @if (_predictionResult != null)
                    {
                        <MudCard Elevation="2">
                            <MudCardHeader><MudText Typo="Typo.h6">Prediction Results</MudText></MudCardHeader>
                            <MudCardContent>
                                <MudAlert Severity="Severity.Success" Class="mb-3">Prediction completed!</MudAlert>
                                <MudText Typo="Typo.subtitle2">Driver: <strong>@_driver</strong></MudText>
                                <MudText Typo="Typo.caption" Class="mb-3">Track: @_track (@_trackType)</MudText>
                                <MudDivider Class="my-3" />
                                @if (_predictionTask == "classification")
                                {
                                    var prob = (_predictionResult.Probability ?? 0.5) * 100;
                                    <MudText Typo="Typo.h5">Win Probability: <strong>@prob.ToString("F1")%</strong></MudText>
                                    <MudProgressLinear Color="@(prob >= 50 ? Color.Success : prob >= 30 ? Color.Warning : Color.Error)" Value="@prob" Class="my-3" />
                                }
                                else
                                {
                                    var position = Convert.ToInt32(_predictionResult.Prediction);
                                    <MudText Typo="Typo.h5">Predicted Finish: <MudChip T="string" Color="@(position <= 5 ? Color.Success : position <= 10 ? Color.Info : Color.Warning)">P@position</MudChip></MudText>
                                }
                            </MudCardContent>
                        </MudCard>
                    }
                    else
                    {
                        <MudCard Elevation="1"><MudCardContent Class="pa-8 text-center">
                            <MudText Color="Color.Secondary">Fill in race details and click "Get Prediction"</MudText>
                        </MudCardContent></MudCard>
                    }
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- Tab 2: Interactive Simulator -->
        <MudTabPanel Text="Interactive Simulator" Icon="@Icons.Material.Filled.Tune">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" GutterBottom="true">Model Configuration</MudText>
                        <MudSelect T="string" Label="Series" @bind-Value="_simSeries" Variant="Variant.Outlined" Class="mb-3">
                            <MudSelectItem Value="@("cup")">Cup</MudSelectItem>
                            <MudSelectItem Value="@("truck")">Truck</MudSelectItem>
                            <MudSelectItem Value="@("xfinity")">Xfinity</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="string" Label="Task" @bind-Value="_simTask" Variant="Variant.Outlined" Class="mb-3">
                            <MudSelectItem Value="@("classification")">Classification (Win/Loss)</MudSelectItem>
                            <MudSelectItem Value="@("regression")">Regression (Position)</MudSelectItem>
                        </MudSelect>
                        <MudDivider Class="my-4" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadSimFeatures" 
                                   Disabled="@_isLoadingSimFeatures" FullWidth="true" Class="mb-2">
                            @(_isLoadingSimFeatures ? "Loading..." : "Load Features")
                        </MudButton>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudPaper Class="pa-4" Style="min-height: 400px;">
                        <MudText Typo="Typo.h6" GutterBottom="true">Feature Inputs</MudText>
                        @if (_isLoadingSimFeatures)
                        {
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        }
                        else if (_simFeaturesLoaded)
                        {
                            <MudGrid>
                                @foreach (var feature in _simCategoricalFeatures.Take(6))
                                {
                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="string" Label="@FormatLabel(feature)" @bind-Value="_simCategoricalInputs[feature]" 
                                                   Variant="Variant.Outlined" Dense="true">
                                            @if (_simFeatureValues.ContainsKey(feature))
                                            {
                                                @foreach (var val in _simFeatureValues[feature].Take(50))
                                                {
                                                    <MudSelectItem Value="@val.ToString()">@val</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                    </MudItem>
                                }
                                @foreach (var feature in _simNumericFeatures.Take(6))
                                {
                                    <MudItem xs="12" sm="6">
                                        <MudNumericField T="double?" Label="@FormatLabel(feature)" @bind-Value="_simNumericInputs[feature]" 
                                                         Variant="Variant.Outlined" Dense="true" />
                                    </MudItem>
                                }
                            </MudGrid>
                            <MudDivider Class="my-4" />
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="RunSimPrediction" 
                                       Disabled="@_isSimPredicting" FullWidth="true" Size="Size.Large">
                                @(_isSimPredicting ? "Predicting..." : "Run Prediction")
                            </MudButton>
                            
                            @if (_isSimPredicting && !string.IsNullOrEmpty(_simStatus))
                            {
                                <MudPaper Class="pa-3 mt-3" Elevation="0" Style="background: rgba(0,0,0,0.05);">
                                    <div class="d-flex align-center">
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Class="mr-2" />
                                        <MudText Typo="Typo.body2" Color="Color.Primary">@_simStatus</MudText>
                                    </div>
                                </MudPaper>
                            }
                        }
                        else
                        {
                            <MudText Color="Color.Secondary">Click "Load Features" to start.</MudText>
                        }
                        @if (_simPredictionResult != null)
                        {
                            <MudPaper Class="pa-4 mt-4" Elevation="4">
                                <MudText Typo="Typo.h5" Color="Color.Primary">Prediction: @_simPredictionResult.Prediction</MudText>
                                @if (_simPredictionResult.Probability.HasValue)
                                {
                                    <MudText>Probability: @($"{_simPredictionResult.Probability:P1}")</MudText>
                                }
                            </MudPaper>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- Tab 3: Monte Carlo -->
        <MudTabPanel Text="Monte Carlo" Icon="@Icons.Material.Filled.Casino">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Configuration</MudText>
                        <MudSelect T="int" Label="Year" @bind-Value="_mcYear" Variant="Variant.Outlined" Class="mb-4">
                            @foreach (var year in _mcYears) { <MudSelectItem Value="@year">@year</MudSelectItem> }
                        </MudSelect>
                        <MudSelect T="string" Label="Track Type" @bind-Value="_mcTrackType" Variant="Variant.Outlined" Class="mb-4">
                            <MudSelectItem Value="@("Intermediate")">Intermediate</MudSelectItem>
                            <MudSelectItem Value="@("Short Track")">Short Track</MudSelectItem>
                            <MudSelectItem Value="@("Superspeedway")">Superspeedway</MudSelectItem>
                            <MudSelectItem Value="@("Road Course")">Road Course</MudSelectItem>
                        </MudSelect>
                        <MudNumericField @bind-Value="_mcNumSimulations" Label="Simulations" Variant="Variant.Outlined" 
                                         Min="100" Max="10000" Step="100" Class="mb-4" />
                        <MudDivider Class="my-4" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Driver Selection</MudText>
                        <div class="d-flex gap-2 mb-2">
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="MCSelectAll">All</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="MCDeselectAll">None</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="MCSelectTop20">Top 20</MudButton>
                        </div>
                        <MudText Typo="Typo.caption" Class="mb-2">Selected: @_mcSelectedDrivers.Count()</MudText>
                        <MudSelect T="string" Label="Drivers" MultiSelection="true" @bind-SelectedValues="_mcSelectedDrivers" 
                                   Variant="Variant.Outlined" Class="mb-4">
                            @foreach (var driver in _mcAllDrivers) { <MudSelectItem Value="@driver">@driver</MudSelectItem> }
                        </MudSelect>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="RunMonteCarlo" 
                                   Disabled="@(_mcIsLoading || !_mcSelectedDrivers.Any())">
                            @if (_mcIsLoading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                            Run Simulation
                        </MudButton>
                        
                        @if (_mcIsLoading && !string.IsNullOrEmpty(_mcStatus))
                        {
                            <MudPaper Class="pa-4 mt-3" Elevation="0" Style="background: rgba(0,0,0,0.05);">
                                <div class="d-flex align-center">
                                    <MudProgressCircular Size="Size.Medium" Indeterminate="true" Color="Color.Primary" Class="mr-3" />
                                    <div>
                                        <MudText Typo="Typo.body2" Color="Color.Primary">@_mcStatus</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Processing...</MudText>
                                    </div>
                                </div>
                            </MudPaper>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="8">
                    @if (_mcResponse != null)
                    {
                        <MudPaper Class="pa-4">
                            <div class="d-flex justify-space-between align-center mb-4">
                                <MudText Typo="Typo.h6">Results - @_mcResponse.Metadata.Simulations simulations</MudText>
                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportMCResults">Export</MudButton>
                            </div>
                            <MudTable Items="@_mcResponse.Results" Dense="true" Hover="true" Striped="true">
                                <HeaderContent>
                                    <MudTh>Driver</MudTh><MudTh>Win %</MudTh><MudTh>Top 5 %</MudTh><MudTh>Top 10 %</MudTh><MudTh>Avg Finish</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd><b>@context.Driver</b></MudTd>
                                    <MudTd><MudText Color="@(context.WinProb > 0.1 ? Color.Success : Color.Default)">@($"{context.WinProb:P1}")</MudText></MudTd>
                                    <MudTd>@($"{context.Top5Prob:P1}")</MudTd>
                                    <MudTd>@($"{context.Top10Prob:P1}")</MudTd>
                                    <MudTd>@($"{context.AvgFinish:F1}")</MudTd>
                                </RowTemplate>
                                <PagerContent><MudTablePager /></PagerContent>
                            </MudTable>
                        </MudPaper>
                    }
                    else if (!_mcIsLoading)
                    {
                        <MudPaper Class="pa-16 d-flex justify-center align-center">
                            <MudText Typo="Typo.h6" Color="Color.Secondary">Select drivers and run simulation</MudText>
                        </MudPaper>
                    }
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- Tab 4: NFL Season Simulator -->
        <MudTabPanel Text="NFL Season" Icon="@Icons.Material.Filled.SportsFootball">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">NFL Season Simulation</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">
                            Uses nflseedR to simulate 1000+ NFL seasons and calculate playoff probabilities.
                        </MudText>
                        <MudNumericField @bind-Value="_nflSimulations" Label="Simulations" 
                                         Min="100" Max="10000" Step="100" Variant="Variant.Outlined" Class="mb-4" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" 
                                   OnClick="RunNFLSimulation" Disabled="@_nflIsLoading">
                            @if (_nflIsLoading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                            @(_nflIsLoading ? "Simulating..." : "Run Simulation")
                        </MudButton>
                        
                        @if (_nflIsLoading && !string.IsNullOrEmpty(_nflSimStatus))
                        {
                            <MudPaper Class="pa-4 mt-3" Elevation="0" Style="background: rgba(0,0,0,0.05);">
                                <div class="d-flex align-center">
                                    <MudProgressCircular Size="Size.Medium" Indeterminate="true" Color="Color.Primary" Class="mr-3" />
                                    <div>
                                        <MudText Typo="Typo.body2" Color="Color.Primary">@_nflSimStatus</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">This may take a minute...</MudText>
                                    </div>
                                </div>
                            </MudPaper>
                        }
                        
                        @if (_nflSimResults != null && _nflSimResults.ContainsKey("generated_at"))
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                                Last run: @_nflSimResults["generated_at"]
                                @if (_nflSimResults.ContainsKey("cached") && GetBool(_nflSimResults, "cached"))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Cached</MudChip>
                                }
                            </MudAlert>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="8">
                    @if (_nflSimResults != null && !_nflSimResults.ContainsKey("error"))
                    {
                        <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3">
                            <MudTabPanel Text="Super Bowl Odds" Icon="@Icons.Material.Filled.EmojiEvents">
                                <MudSimpleTable Dense="true" Hover="true" Striped="true">
                                    <thead>
                                        <tr>
                                            <th>Rank</th>
                                            <th>Team</th>
                                            <th>Playoff %</th>
                                            <th>Conf Champ %</th>
                                            <th>Super Bowl %</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (_nflSimResults.ContainsKey("all_teams"))
                                        {
                                            var teams = GetNFLTeamsList();
                                            var rank = 1;
                                            @foreach (var team in teams.OrderByDescending(t => GetDouble(t, "super_bowl_pct")).Take(16))
                                            {
                                                <tr>
                                                    <td>@rank</td>
                                                    <td><strong>@team["team"]</strong></td>
                                                    <td>@GetDouble(team, "playoff_pct").ToString("F1")%</td>
                                                    <td>@GetDouble(team, "conf_pct").ToString("F1")%</td>
                                                    <td><MudChip T="string" Size="Size.Small" Color="@GetSBColor(GetDouble(team, "super_bowl_pct"))">@GetDouble(team, "super_bowl_pct").ToString("F1")%</MudChip></td>
                                                </tr>
                                                rank++;
                                            }
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            </MudTabPanel>
                            <MudTabPanel Text="AFC" Icon="@Icons.Material.Filled.Stadium">
                                @RenderConferenceTable("afc")
                            </MudTabPanel>
                            <MudTabPanel Text="NFC" Icon="@Icons.Material.Filled.Stadium">
                                @RenderConferenceTable("nfc")
                            </MudTabPanel>
                        </MudTabs>
                    }
                    else if (_nflSimResults != null && _nflSimResults.ContainsKey("error"))
                    {
                        <MudAlert Severity="Severity.Error">
                            @(_nflSimResults.ContainsKey("message") ? _nflSimResults["message"].ToString() : "Simulation failed")
                        </MudAlert>
                        @if (_nflSimResults.ContainsKey("install_instructions"))
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-2">
                                <MudText>@_nflSimResults["install_instructions"]</MudText>
                            </MudAlert>
                        }
                    }
                    else if (!_nflIsLoading)
                    {
                        <MudPaper Class="pa-16 d-flex flex-column justify-center align-center" Style="min-height: 300px;">
                            <MudIcon Icon="@Icons.Material.Filled.SportsFootball" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                            <MudText Typo="Typo.h6" Color="Color.Secondary">Click "Run Simulation" to calculate NFL playoff odds</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Requires R and nflseedR package installed</MudText>
                        </MudPaper>
                    }
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        
        <!-- Tab 5: NASCAR Season Simulator -->
        <MudTabPanel Text="NASCAR Season" Icon="@Icons.Material.Filled.DirectionsCar">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-3">NASCAR Season Simulation</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">
                            Simulate full NASCAR seasons with playoffs, points, and championship.
                        </MudText>
                        <MudSelect T="string" @bind-Value="_nascarSeasonSeries" Label="Series" 
                                   Variant="Variant.Outlined" Class="mb-4">
                            <MudSelectItem Value="@("cup")">Cup Series</MudSelectItem>
                            <MudSelectItem Value="@("xfinity")">Xfinity Series</MudSelectItem>
                            <MudSelectItem Value="@("trucks")">Truck Series</MudSelectItem>
                        </MudSelect>
                        <MudNumericField @bind-Value="_nascarSeasonSims" Label="Simulations" 
                                         Min="50" Max="1000" Step="50" Variant="Variant.Outlined" Class="mb-4" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" 
                                   OnClick="RunNASCARSeasonSim" Disabled="@_nascarSeasonLoading">
                            @if (_nascarSeasonLoading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                            @(_nascarSeasonLoading ? "Simulating Season..." : "Run Season Simulation")
                        </MudButton>
                        
                        @if (_nascarSeasonResults != null && _nascarSeasonResults.ContainsKey("generated_at"))
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                                <strong>@_nascarSeasonResults.GetValueOrDefault("series", ""):</strong> 
                                @_nascarSeasonResults.GetValueOrDefault("simulations", 0) simulations
                            </MudAlert>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="8">
                    @if (_nascarSeasonResults != null && _nascarSeasonResults.ContainsKey("results"))
                    {
                        <MudPaper Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-3">
                                @_nascarSeasonResults.GetValueOrDefault("series", "NASCAR") Championship Probabilities
                            </MudText>
                            <MudSimpleTable Dense="true" Hover="true" Striped="true">
                                <thead>
                                    <tr>
                                        <th>Rank</th>
                                        <th>Driver</th>
                                        <th>Playoff %</th>
                                        <th>Champ 4 %</th>
                                        <th>Championship %</th>
                                        <th>Avg Wins</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var nascarResults = GetNASCARSeasonResults();
                                        var rank = 1;
                                        foreach (var driver in nascarResults.Take(20))
                                        {
                                            <tr>
                                                <td>@rank</td>
                                                <td><strong>@driver.GetValueOrDefault("driver", "")</strong></td>
                                                <td>@GetDoubleNascar(driver, "playoff_pct").ToString("F1")%</td>
                                                <td>@GetDoubleNascar(driver, "champ_4_pct").ToString("F1")%</td>
                                                <td>
                                                    <MudChip T="string" Size="Size.Small" 
                                                             Color="@GetChampColor(GetDoubleNascar(driver, "championship_pct"))">
                                                        @GetDoubleNascar(driver, "championship_pct").ToString("F1")%
                                                    </MudChip>
                                                </td>
                                                <td>@GetDoubleNascar(driver, "avg_wins").ToString("F2")</td>
                                            </tr>
                                            rank++;
                                        }
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    }
                    else if (_nascarSeasonResults != null && _nascarSeasonResults.ContainsKey("error"))
                    {
                        <MudAlert Severity="Severity.Error">
                            @(_nascarSeasonResults.GetValueOrDefault("message", "Simulation failed"))
                        </MudAlert>
                    }
                    else if (!_nascarSeasonLoading)
                    {
                        <MudPaper Class="pa-16 d-flex flex-column justify-center align-center" Style="min-height: 300px;">
                            <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                            <MudText Typo="Typo.h6" Color="Color.Secondary">Select series and click "Run Season Simulation"</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Simulates full season with playoffs and championship</MudText>
                        </MudPaper>
                    }
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        
        <!-- Tab 6: Race Predictions (Betting) -->
        <MudTabPanel Text="Race Picks" Icon="@Icons.Material.Filled.Casino">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Casino" Class="mr-2" />
                            Race Predictions
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mb-4" Color="Color.Secondary">
                            Simulate any race to get win, top 5, and top 10 probabilities for betting.
                        </MudText>
                        
                        <MudSelect T="string" @bind-Value="_racePickSeries" Label="Series" 
                                   Variant="Variant.Outlined" Class="mb-3">
