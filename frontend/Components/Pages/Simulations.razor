@page "/simulations"
@page "/predictions"
@page "/simulation"
@page "/advanced-predictions"
@rendermode InteractiveServer
@using SportsBettingAnalyzer.Services
@using System.Text.Json
@inject PythonMLServiceClient MLClient
@inject ISnackbar Snackbar
@inject ILogger<Simulations> Logger
@inject SimulationStateService SimulationState
@inject FileExportService FileExportService

@using SportsBettingAnalyzer.Components.Shared.Tailwind

<PageTitle>Race Simulations & Predictions</PageTitle>

<TwContainer MaxWidth="extraLarge" Class="mt-8 px-4 pb-12">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-white flex items-center gap-3">
            <TwIcon Icon="M13 10V3L4 14h7v7l9-11h-7z" Class="w-8 h-8 text-blue-500" />
            Season Simulations
        </h1>
        <p class="text-slate-400 mt-1">Monte Carlo simulations for NASCAR, NFL, and NBA seasons</p>
    </div>

    <TwTabs @bind-ActivePanelIndex="_activeTab">
        <!-- Tab: NBA Season Simulator -->
        <TwTabPanel Title="NBA Season" TabIcon="@Icons.Material.Filled.SportsBasketball">
            <TwGrid Columns="1" md="12" Gap="6">
                <div class="md:col-span-4">
                    <TwCard Class="p-6 bg-slate-900 border-slate-800">
                        <h3 class="text-lg font-bold text-white mb-2">NBA Season Simulation</h3>
                        <p class="text-slate-400 text-sm mb-6">
                            Monte Carlo simulation of NBA season. Uses Elo ratings to calculate playoff probabilities and seed distributions.
                        </p>
                        
                        <div class="mb-6">
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Number of Simulations</label>
                            <input type="number" @bind="_nbaNumSimulations" min="100" max="10000" step="100" 
                                   class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors" />
                        </div>
                        
                        <TwButton Variant="primary" Class="w-full py-3" OnClick="RunNBASeasonSim" IsLoading="_nbaSeasonLoading" Disabled="@_nbaSeasonLoading">
                            Run Season Simulation
                        </TwButton>
                        
                        @if (_nbaSeasonResults != null)
                        {
                            <TwAlert Color="emerald" Class="mt-4 py-2">
                                <span class="text-xs font-bold">@_nbaSeasonResults.Simulations simulations completed</span>
                            </TwAlert>
                        }
                    </TwCard>
                </div>
                <div class="md:col-span-8">
                    @if (_nbaSeasonResults != null && _nbaSeasonResults.Results != null)
                    {
                        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                            <h3 class="text-lg font-bold text-white mb-6 flex items-center justify-between">
                                Playoff Probabilities
                                <span class="text-xs font-normal text-slate-500 italic">@_nbaSeasonResults.GamesRemaining games remaining</span>
                            </h3>
                            
                            <TwTabs Elevation="0">
                                <TwTabPanel Title="Eastern Conference">
                                    <div class="overflow-x-auto">
                                        <table class="w-full text-left">
                                            <thead>
                                                <tr class="text-slate-500 text-[10px] uppercase tracking-widest border-b border-slate-800">
                                                    <th class="pb-3 px-2">Team</th>
                                                    <th class="pb-3 px-2 border-b border-slate-800">Record</th>
                                                    <th class="pb-3 px-2 border-b border-slate-800">Avg Wins</th>
                                                    <th class="pb-3 px-2 text-right border-b border-slate-800">Playoff %</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-800/50">
                                                @foreach (var team in _nbaSeasonResults.Results.Where(r => r.Conference == "East").OrderByDescending(r => r.PlayoffPct).Take(15))
                                                {
                                                    <tr class="hover:bg-slate-800/30 transition-colors">
                                                        <td class="py-3 px-2 text-white font-bold text-sm">@team.Team</td>
                                                        <td class="py-3 px-2 text-slate-400 text-xs">@team.CurrentWins-@team.CurrentLosses</td>
                                                        <td class="py-3 px-2 text-slate-300 text-sm font-mono">@team.AvgWins</td>
                                                        <td class="py-3 px-2 text-right">
                                                            <span class="px-2 py-0.5 rounded text-[11px] font-black @(team.PlayoffPct > 80 ? "bg-emerald-500/10 text-emerald-400" : team.PlayoffPct > 50 ? "bg-amber-500/10 text-amber-400" : "bg-red-500/10 text-red-400")">
                                                                @team.PlayoffPct%
                                                            </span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </TwTabPanel>
                                <TwTabPanel Title="Western Conference">
                                    <div class="overflow-x-auto">
                                        <table class="w-full text-left">
                                            <thead>
                                                <tr class="text-slate-500 text-[10px] uppercase tracking-widest border-b border-slate-800">
                                                    <th class="pb-3 px-2">Team</th>
                                                    <th class="pb-3 px-2 border-b border-slate-800">Record</th>
                                                    <th class="pb-3 px-2 border-b border-slate-800">Avg Wins</th>
                                                    <th class="pb-3 px-2 text-right border-b border-slate-800">Playoff %</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-800/50">
                                                @foreach (var team in _nbaSeasonResults.Results.Where(r => r.Conference == "West").OrderByDescending(r => r.PlayoffPct).Take(15))
                                                {
                                                    <tr class="hover:bg-slate-800/30 transition-colors">
                                                        <td class="py-3 px-2 text-white font-bold text-sm">@team.Team</td>
                                                        <td class="py-3 px-2 text-slate-400 text-xs">@team.CurrentWins-@team.CurrentLosses</td>
                                                        <td class="py-3 px-2 text-slate-300 text-sm font-mono">@team.AvgWins</td>
                                                        <td class="py-3 px-2 text-right">
                                                            <span class="px-2 py-0.5 rounded text-[11px] font-black @(team.PlayoffPct > 80 ? "bg-emerald-500/10 text-emerald-400" : team.PlayoffPct > 50 ? "bg-amber-500/10 text-amber-400" : "bg-red-500/10 text-red-400")">
                                                                @team.PlayoffPct%
                                                            </span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </TwTabPanel>
                            </TwTabs>
                        </div>
                    }
                    else if (!_nbaSeasonLoading)
                    {
                        <div class="h-[400px] flex flex-col items-center justify-center bg-slate-900/50 border border-dashed border-slate-800 rounded-2xl">
                            <TwIcon Icon="M12 2a10 10 0 1010 10A10 10 0 0012 2zm0 18a8 8 0 118-8 8 8 0 01-8 8z" Class="w-16 h-16 text-slate-700 mb-4" />
                            <h3 class="text-xl font-bold text-slate-300">No Simulation Data</h3>
                            <p class="text-slate-500 text-sm max-w-xs text-center mt-2">Initialize the Monte Carlo engine to calculate NBA playoff probabilities.</p>
                        </div>
                    }
                </div>
            </TwGrid>
        </TwTabPanel>

        <!-- Tab 1: Quick Predict -->
        <TwTabPanel Title="Quick Predict" TabIcon="@Icons.Material.Filled.FlashOn">
            @if (!_isPythonServiceAvailable)
            {
                <TwAlert Color="red" Class="mb-6">Python ML Service is not available.</TwAlert>
            }
            <TwGrid Columns="1" md="2" Gap="6">
                <div>
                    <TwCard Class="p-6 bg-slate-900 border-slate-800">
                        <h3 class="text-lg font-bold text-white mb-6">Make a Prediction</h3>
                        
                        <div class="space-y-6">
                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Series</label>
                                <select @bind="_nascarSeries" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors">
                                    <option value="cup">Cup Series</option>
                                    <option value="truck">Truck Series</option>
                                    <option value="xfinity">Xfinity Series</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Prediction Type</label>
                                <select @bind="_predictionTask" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors">
                                    <option value="classification">Win Probability</option>
                                    <option value="regression">Finishing Position</option>
                                </select>
                            </div>

                            <div class="pt-4 border-t border-slate-800 space-y-4">
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Driver Name</label>
                                    <input @bind="_driver" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors" placeholder="e.g., Kyle Busch" />
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Track Name</label>
                                    <input @bind="_track" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors" placeholder="e.g., Daytona" />
                                </div>
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Track Type</label>
                                        <input @bind="_trackType" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors" placeholder="e.g., Superspeedway" />
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Season Year</label>
                                        <input type="number" @bind="_year" min="1949" max="2025" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors" />
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Starting Position</label>
                                    <input type="number" @bind="_startPos" min="1" max="40" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors" />
                                </div>
                            </div>

                            <TwButton Variant="primary" Class="w-full py-3 mt-4" OnClick="MakeQuickPrediction" IsLoading="_isPredicting" Disabled="@(_isPredicting || string.IsNullOrEmpty(_driver))">
                                Get Prediction
                            </TwButton>
                            
                            @if (_isPredicting && !string.IsNullOrEmpty(_predictStatus))
                            {
                                <div class="flex items-center gap-3 p-3 bg-blue-500/10 border border-blue-500/20 rounded-xl">
                                    <div class="w-4 h-4 border-2 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
                                    <span class="text-sm text-blue-400 font-medium">@_predictStatus</span>
                                </div>
                            }
                        </div>
                    </TwCard>
                </div>

                <div>
                    @if (_predictionResult != null)
                    {
                        <TwCard Class="p-6 bg-slate-900 border-slate-800 border-l-4 border-l-blue-500">
                            <h3 class="text-lg font-bold text-white mb-4">Prediction Results</h3>
                            
                            <TwAlert Color="emerald" Class="mb-6">Model analysis complete!</TwAlert>
                            
                            <div class="space-y-4">
                                <div>
                                    <span class="text-xs text-slate-500 uppercase tracking-widest block mb-1">Driver</span>
                                    <span class="text-xl font-bold text-white">@_driver</span>
                                </div>
                                <div>
                                    <span class="text-xs text-slate-500 uppercase tracking-widest block mb-1">Track Context</span>
                                    <span class="text-slate-300">@_track <span class="text-slate-500 px-2">•</span> @_trackType</span>
                                </div>
                                
                                <div class="pt-6 border-t border-slate-800">
                                    @if (_predictionTask == "classification")
                                    {
                                        var prob = (_predictionResult.Probability ?? 0.5) * 100;
                                        <div class="flex items-end justify-between mb-2">
                                            <span class="text-sm font-bold text-slate-400">Win Probability</span>
                                            <span class="text-3xl font-black text-white">@prob.ToString("F1")%</span>
                                        </div>
                                        <div class="h-3 bg-slate-950 rounded-full overflow-hidden">
                                            <div class="h-full @(prob >= 50 ? "bg-emerald-500" : prob >= 30 ? "bg-amber-500" : "bg-red-500")" style="width: @prob%"></div>
                                        </div>
                                    }
                                    else
                                    {
                                        var position = Convert.ToInt32(_predictionResult.Prediction);
                                        <div class="flex items-center justify-between">
                                            <span class="text-sm font-bold text-slate-400">Predicted Finish</span>
                                            <TwChip Color="@(position <= 5 ? "emerald" : position <= 10 ? "blue" : "amber")" Class="text-xl font-black px-4 py-1">
                                                P@position
                                            </TwChip>
                                        </div>
                                    }
                                </div>
                            </div>
                        </TwCard>
                    }
                    else
                    {
                        <div class="h-full min-h-[400px] flex flex-col items-center justify-center bg-slate-900/50 border border-dashed border-slate-800 rounded-2xl p-8 text-center">
                            <TwIcon Icon="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" Class="w-16 h-16 text-slate-700 mb-4" />
                            <h3 class="text-xl font-bold text-slate-300">Awaiting Inputs</h3>
                            <p class="text-slate-500 text-sm mt-2">Fill in the race details and click "Get Prediction" to run the ML model.</p>
                        </div>
                    }
                </div>
            </TwGrid>
        </TwTabPanel>

        <!-- Tab 2: Interactive Simulator -->
        <TwTabPanel Title="Interactive Simulator" TabIcon="@Icons.Material.Filled.Tune">
            <TwGrid Columns="1" md="12" Gap="6">
                <div class="md:col-span-4">
                    <TwCard Class="p-6 bg-slate-900 border-slate-800">
                        <h3 class="text-lg font-bold text-white mb-6">Model Configuration</h3>
                        
                        <div class="space-y-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Series</label>
                                <select @bind="_simSeries" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors">
                                    <option value="cup">Cup</option>
                                    <option value="truck">Truck</option>
                                    <option value="xfinity">Xfinity</option>
                                </select>
                            </div>
                            
                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Task</label>
                                <select @bind="_simTask" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors">
                                    <option value="classification">Classification (Win/Loss)</option>
                                    <option value="regression">Regression (Position)</option>
                                </select>
                            </div>
                            
                            <TwButton Variant="primary" OnClick="LoadSimFeatures" IsLoading="_isLoadingSimFeatures" Disabled="@_isLoadingSimFeatures" Class="w-full py-3 mt-4">
                                Load Features
                            </TwButton>
                        </div>
                    </TwCard>
                </div>

                <div class="md:col-span-8">
                    <TwCard Class="p-6 bg-slate-900 border-slate-800 min-h-[400px]">
                        <h3 class="text-lg font-bold text-white mb-6">Feature Inputs</h3>
                        
                        @if (_isLoadingSimFeatures)
                        {
                            <div class="flex flex-col items-center justify-center py-12">
                                <TwProgressBar Value="100" IsIndeterminate="true" Color="blue" Class="w-1/2 mb-4" />
                                <span class="text-sm text-slate-500">Loading model features...</span>
                            </div>
                        }
                        else if (_simFeaturesLoaded)
                        {
                            <TwGrid Columns="1" sm="2" Gap="4">
                                @foreach (var feature in _simCategoricalFeatures.Take(6))
                                {
                                    <div>
                                        <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5">@FormatLabel(feature)</label>
                                        <select @bind="_simCategoricalInputs[feature]" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-blue-500 transition-colors">
                                            @if (_simFeatureValues.ContainsKey(feature))
                                            {
                                                @foreach (var val in _simFeatureValues[feature].Take(50))
                                                {
                                                    <option value="@val.ToString()">@val</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                }
                                @foreach (var feature in _simNumericFeatures.Take(6))
                                {
                                    <div>
                                        <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5">@FormatLabel(feature)</label>
                                        <input type="number" @bind="_simNumericInputs[feature]" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-blue-500 transition-colors" />
                                    </div>
                                }
                            </TwGrid>
                            
                            <div class="mt-8 pt-6 border-t border-slate-800">
                                <TwButton Variant="primary" Class="w-full py-4 bg-indigo-600 hover:bg-indigo-500 text-lg" OnClick="RunSimPrediction" Disabled="@_isSimPredicting">
                                    @(_isSimPredicting ? "Predicting..." : "Run Prediction")
                                </TwButton>
                                
                                @if (_isSimPredicting && !string.IsNullOrEmpty(_simStatus))
                                {
                                    <div class="mt-4 p-3 bg-indigo-500/10 border border-indigo-500/20 rounded-xl flex items-center gap-3">
                                        <div class="w-4 h-4 border-2 border-indigo-500 border-t-transparent rounded-full animate-spin"></div>
                                        <span class="text-sm text-indigo-400 font-medium">@_simStatus</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="h-full flex flex-col items-center justify-center py-12 text-center text-slate-500">
                                <TwIcon Icon="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" Class="w-12 h-12 mb-4 opacity-20" />
                                <p>Click "Load Features" to start the simulation setup.</p>
                            </div>
                        }
                        
                        @if (_simPredictionResult != null)
                        {
                            <div class="mt-8 p-6 bg-slate-950 border border-slate-800 rounded-2xl shadow-inner animate-in fade-in slide-in-from-bottom-4 duration-500">
                                <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                                    <div>
                                        <span class="text-xs text-slate-500 uppercase tracking-widest block mb-1">Final Prediction</span>
                                        <span class="text-2xl font-black text-blue-400">@_simPredictionResult.Prediction</span>
                                    </div>
                                    @if (_simPredictionResult.Probability.HasValue)
                                    {
                                        <div class="text-center md:text-right">
                                            <span class="text-xs text-slate-500 uppercase tracking-widest block mb-1">Confidence Score</span>
                                            <span class="text-2xl font-black text-white">@($"{_simPredictionResult.Probability:P1}")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </TwCard>
                </div>
            </TwGrid>
        </TwTabPanel>

        <!-- Tab 3: Monte Carlo -->
        <TwTabPanel Title="Monte Carlo" TabIcon="@Icons.Material.Filled.Casino">
            <TwGrid Columns="1" md="12" Gap="6">
                <div class="md:col-span-4">
                    <TwCard Class="p-6 bg-slate-900 border-slate-800">
                        <h3 class="text-lg font-bold text-white mb-6">Configuration</h3>
                        
                        <div class="space-y-6">
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Year</label>
                                    <select @bind="_mcYear" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors">
                                        @foreach (var year in _mcYears) { <option value="@year">@year</option> }
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Simulations</label>
                                    <input type="number" @bind="_mcNumSimulations" min="100" max="10000" step="100" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors" />
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Track Type</label>
                                <select @bind="_mcTrackType" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors">
                                    <option value="Intermediate">Intermediate</option>
                                    <option value="Short Track">Short Track</option>
                                    <option value="Superspeedway">Superspeedway</option>
                                    <option value="Road Course">Road Course</option>
                                </select>
                            </div>

                            <div class="pt-6 border-t border-slate-800">
                                <span class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-3">Driver Selection</span>
                                <div class="flex flex-wrap gap-2 mb-4">
                                    <button @onclick="MCSelectAll" class="px-3 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded text-xs transition-colors">Select All</button>
                                    <button @onclick="MCDeselectAll" class="px-3 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded text-xs transition-colors">None</button>
                                    <button @onclick="MCSelectTop20" class="px-3 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded text-xs transition-colors">Top 20</button>
                                </div>
                                
                                <div class="relative group">
                                    <select multiple @onchange="@(e => _mcSelectedDrivers = ((string[])e.Value).ToHashSet())" 
                                            class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-white focus:outline-none focus:border-blue-500 transition-colors min-h-[200px]">
                                        @foreach (var driver in _mcAllDrivers) { 
                                            <option value="@driver" selected="@_mcSelectedDrivers.Contains(driver)">@driver</option> 
                                        }
                                    </select>
                                    <div class="absolute bottom-2 right-2 px-2 py-0.5 bg-blue-500/20 text-blue-400 text-[10px] font-bold rounded border border-blue-500/30">
                                        @_mcSelectedDrivers.Count() selected
                                    </div>
                                </div>
                            </div>

                            <TwButton Variant="primary" Class="w-full py-3" OnClick="RunMonteCarlo" Disabled="@(_mcIsLoading || !_mcSelectedDrivers.Any())">
                                @(_mcIsLoading ? "Processing..." : "Run Simulation")
                            </TwButton>
                        </div>

                        @if (_mcIsLoading && !string.IsNullOrEmpty(_mcStatus))
                        {
                            <div class="mt-4 p-4 bg-blue-500/10 border border-blue-500/20 rounded-2xl">
                                <div class="flex items-center gap-4">
                                    <div class="w-8 h-8 border-2 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
                                    <div>
                                        <p class="text-sm font-bold text-blue-400">@_mcStatus</p>
