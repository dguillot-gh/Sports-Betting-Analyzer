                        <th class="pb-3 px-4">Division</th>
                        <th class="pb-3 px-4">W</th>
                        <th class="pb-3 px-4">L</th>
                        <th class="pb-3 px-4">Playoff %</th>
                        <th class="pb-3 px-4 text-right">Div Win %</th>
