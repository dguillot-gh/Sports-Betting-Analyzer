                                            var nascarResults = GetNASCARSeasonResults();
                                            var rank = 1;
                                            foreach (var driver in nascarResults.Take(20))
                                            {
                                                <tr class="hover:bg-slate-800/30 transition-colors">
                                                    <td class="py-3 px-2 text-slate-500 font-mono text-xs">@rank</td>
