    private async Task RunMonteCarlo()
    {
        _mcIsLoading = true;
        _mcResponse = null;
        _mcStatus = "Initializing Monte Carlo simulation...";
        StateHasChanged();
        
        try
        {
            _mcStatus = $"Running {_mcNumSimulations} race simulations with {_mcSelectedDrivers.Count()} drivers...";
            StateHasChanged();
            await Task.Delay(50);
            
            var request = new SimulationRequest
            {
                Drivers = _mcSelectedDrivers.ToList(), Year = _mcYear,
                TrackType = _mcTrackType, NumSimulations = _mcNumSimulations
            };
            
            _mcStatus = "Calculating probabilities...";
            StateHasChanged();
            
            _mcResponse = await MLClient.SimulateRaceAsync("nascar", request, "cup");
            
            _mcStatus = "";
