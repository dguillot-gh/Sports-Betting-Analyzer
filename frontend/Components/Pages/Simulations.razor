                    {
                        <div class="h-[400px] flex flex-col items-center justify-center bg-slate-900/50 border border-slate-800 rounded-2xl p-8">
                            <TwProgressBar Value="100" IsIndeterminate="true" Color="blue" Class="w-1/2 mb-6" />
