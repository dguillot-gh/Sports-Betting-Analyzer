                            <p class="mt-2 max-w-xs mx-auto text-sm">Select your field of drivers and run the simulator to visualize finishing probabilities.</p>
                        </div>
                    }
                </div>
            </TwGrid>
        </TwTabPanel>

        <!-- Tab 4: NFL Season Simulator -->
        <TwTabPanel Title="NFL Season" TabIcon="@Icons.Material.Filled.SportsFootball">
