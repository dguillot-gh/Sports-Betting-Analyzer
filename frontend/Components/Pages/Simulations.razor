                                    </div>
                                </div>
                            </div>
                        }
                        
                        @if (_nflSimResults != null && _nflSimResults.ContainsKey("generated_at"))
                        {
                            <TwAlert Color="blue" Class="mt-6 py-2">
                                <div class="flex items-center justify-between w-full">
                                    <span class="text-[10px] font-bold uppercase text-blue-300">Last run: @_nflSimResults["generated_at"]</span>
                                    @if (_nflSimResults.ContainsKey("cached") && GetBool(_nflSimResults, "cached"))
                                    {
                                        <TwChip Color="amber" Size="sm" Class="font-black text-[9px] uppercase">Cached</TwChip>
                                    }
                                </div>
                            </TwAlert>
                        }
                    </TwCard>
                </div>
                
                <div class="md:col-span-8">
                    @if (_nflSimResults != null && !HasError(_nflSimResults))
                    {
                        <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
                            <TwTabs Elevation="0" Class="p-2">
                                <TwTabPanel Title="Super Bowl Odds" TabIcon="@Icons.Material.Filled.EmojiEvents">
                                    <div class="p-4 overflow-x-auto">
                                        <table class="w-full text-left">
                                            <thead>
                                                <tr class="text-slate-500 text-[10px] uppercase tracking-widest border-b border-slate-800">
                                                    <th class="pb-3 px-4">Rank</th>
                                                    <th class="pb-3 px-4">Team</th>
                                                    <th class="pb-3 px-4">Playoff %</th>
                                                    <th class="pb-3 px-4">Conf Champ %</th>
                                                    <th class="pb-3 px-4 text-right">Super Bowl %</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-slate-800/30">
                                                @if (_nflSimResults.ContainsKey("all_teams"))
                                                {
                                                    var teams = GetNFLTeamsList();
                                                    var rank = 1;
                                                    @foreach (var team in teams.OrderByDescending(t => GetDouble(t, "super_bowl_pct")).Take(16))
                                                    {
                                                        <tr class="hover:bg-slate-800/30 transition-colors">
                                                            <td class="py-3 px-4 text-slate-500 font-mono text-xs">@rank</td>
                                                            <td class="py-3 px-4 text-white font-bold">@team["team"]</td>
                                                            <td class="py-3 px-4 text-slate-300 text-sm">@GetDouble(team, "playoff_pct").ToString("F1")%</td>
                                                            <td class="py-3 px-4 text-slate-400 text-sm">@GetDouble(team, "conf_pct").ToString("F1")%</td>
                                                            <td class="py-3 px-4 text-right">
                                                                <TwChip Color="@GetTailwindSBColor(GetDouble(team, "super_bowl_pct"))" Size="sm" Class="font-black">
                                                                    @GetDouble(team, "super_bowl_pct").ToString("F1")%
                                                                </TwChip>
                                                            </td>
                                                        </tr>
                                                        rank++;
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </TwTabPanel>
                                <TwTabPanel Title="AFC" TabIcon="@Icons.Material.Filled.Stadium">
                                    <div class="p-4">
                                        @RenderTailwindConferenceTable("afc")
                                    </div>
                                </TwTabPanel>
                                <TwTabPanel Title="NFC" TabIcon="@Icons.Material.Filled.Stadium">
                                    <div class="p-4">
                                        @RenderTailwindConferenceTable("nfc")
                                    </div>
                                </TwTabPanel>
                            </TwTabs>
                        </div>
                    }
                    else if (_nflSimResults != null && _nflSimResults.ContainsKey("error"))
                    {
                        <div class="space-y-4">
                            <TwAlert Color="red" Class="flex flex-col items-start gap-2 p-6">
                                <h4 class="font-bold text-red-400 flex items-center gap-2">
                                    <TwIcon Icon="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" Class="w-5 h-5" />
                                    Simulation Failed
                                </h4>
                                <p class="text-sm opacity-80">@(_nflSimResults.ContainsKey("message") ? _nflSimResults["message"].ToString() : "An unexpected error occurred during the NFL simulation engine execution.")</p>
                            </TwAlert>
                            
                            @if (_nflSimResults.ContainsKey("install_instructions"))
                            {
                                <TwAlert Color="blue" Class="p-6">
                                    <h4 class="text-xs font-bold uppercase tracking-widest text-blue-400 mb-2">Installation Required</h4>
                                    <p class="text-sm">@_nflSimResults["install_instructions"]</p>
                                </TwAlert>
                            }
                        </div>
                    }
                    else if (!_nflIsLoading)
                    {
                        <div class="h-full min-h-[400px] flex flex-col items-center justify-center bg-slate-900/50 border border-dashed border-slate-800 rounded-2xl p-8 text-center text-slate-500">
                             <TwIcon Icon="M3 10V4a1 1 0 011-1h16a1 1 0 011 1v6m-18 0v10a1 1 0 001 1h16a1 1 0 001-1V10M3 10h18" Class="w-16 h-16 mb-6 opacity-20" />
                            <h3 class="text-xl font-bold text-slate-300">NFL Engine Ready</h3>
                            <p class="mt-2 max-w-xs mx-auto text-sm">Calculate NFL playoff odds based on current standings and remaining schedule strength.</p>
                            <p class="text-[10px] mt-4 uppercase tracking-tighter text-slate-600 font-bold">Powered by nflseedR</p>
                        </div>
                    }
                </div>
            </TwGrid>
        </TwTabPanel>
        
