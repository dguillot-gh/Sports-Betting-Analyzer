    // Season Schedule State
    private string _schedSeries = "cup";
    private bool _schedLoading = false;
    private List<Dictionary<string, object>>? _schedRaces;
    private int _schedSelectedRace = 0;
    private Dictionary<string, object>? _schedSelectedRaceData;
    
    private async Task LoadSeasonSchedule()
    {
        _schedLoading = true;
        _schedRaces = null;
        _schedSelectedRace = 0;
        _schedSelectedRaceData = null;
        StateHasChanged();
        
        try
        {
            using var http = new HttpClient { BaseAddress = new Uri("http://backend:8000") };
            var response = await http.GetAsync($"/simulation/nascar/season/predictions?series={_schedSeries}&simulations=300");
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<Dictionary<string, object>>(json);
                
                if (result != null && result.ContainsKey("races"))
                {
                    var racesElement = (JsonElement)result["races"];
                    _schedRaces = new List<Dictionary<string, object>>();
                    
                    foreach (var race in racesElement.EnumerateArray())
                    {
                        var raceDict = new Dictionary<string, object>();
                        foreach (var prop in race.EnumerateObject())
                        {
                            if (prop.Value.ValueKind == JsonValueKind.String)
                                raceDict[prop.Name] = prop.Value.GetString() ?? "";
                            else if (prop.Value.ValueKind == JsonValueKind.Number)
                                raceDict[prop.Name] = prop.Value.GetDouble();
                            else if (prop.Value.ValueKind == JsonValueKind.True || prop.Value.ValueKind == JsonValueKind.False)
                                raceDict[prop.Name] = prop.Value.GetBoolean();
                            else if (prop.Value.ValueKind == JsonValueKind.Array)
                                raceDict[prop.Name] = prop.Value.Clone(); // Keep predictions as JsonElement
                            else
                                raceDict[prop.Name] = prop.Value.ToString();
                        }
                        _schedRaces.Add(raceDict);
                    }
                    
                    Snackbar.Add($"Loaded {_schedRaces.Count} race predictions!", Severity.Success);
                    
                    // Auto-select first race
                    if (_schedRaces.Any())
                    {
                        SelectRace(1);
                    }
                }
            }
            else
            {
                Snackbar.Add($"Failed to load schedule: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading season schedule");
            Snackbar.Add($"Failed to load: {ex.Message}", Severity.Error);
        }
        finally
        {
            _schedLoading = false;
        }
    }
    
    private void SelectRace(int raceNum)
    {
        _schedSelectedRace = raceNum;
        _schedSelectedRaceData = _schedRaces?.FirstOrDefault(r => GetInt(r, "race_num") == raceNum);
    }
    
    private int GetInt(Dictionary<string, object> dict, string key)
    {
        if (!dict.ContainsKey(key)) return 0;
        var val = dict[key];
        if (val is double d) return (int)d;
        if (val is int i) return i;
        if (val is JsonElement je && je.ValueKind == JsonValueKind.Number) return je.GetInt32();
        return 0;
    }
    
    private List<Dictionary<string, object>> GetScheduleRacePredictions()
    {
        if (_schedSelectedRaceData == null || !_schedSelectedRaceData.ContainsKey("predictions"))
            return new List<Dictionary<string, object>>();
        
        try
        {
            var element = _schedSelectedRaceData["predictions"];
            JsonElement jsonElement;
            
            if (element is JsonElement je)
                jsonElement = je;
            else
                return new List<Dictionary<string, object>>();
            
            var result = new List<Dictionary<string, object>>();
            
            foreach (var item in jsonElement.EnumerateArray())
            {
                var dict = new Dictionary<string, object>();
                foreach (var prop in item.EnumerateObject())
                {
                    if (prop.Value.ValueKind == JsonValueKind.String)
                        dict[prop.Name] = prop.Value.GetString() ?? "";
                    else if (prop.Value.ValueKind == JsonValueKind.Number)
                        dict[prop.Name] = prop.Value.GetDouble();
                    else
                        dict[prop.Name] = prop.Value.ToString();
                }
                result.Add(dict);
            }
            
            return result;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error parsing schedule predictions");
            return new List<Dictionary<string, object>>();
        }
    }
    
    private bool GetBool(Dictionary<string, object> dict, string key)
    {
        if (!dict.ContainsKey(key))
            return false;
        
        var val = dict[key];
        
        if (val is bool b)
            return b;
        if (val is JsonElement je && je.ValueKind == JsonValueKind.True)
            return true;
        if (val is JsonElement je2 && je2.ValueKind == JsonValueKind.False)
            return false;
        if (val is string s && bool.TryParse(s, out var parsed))
            return parsed;
        
        return false;
    }
