                                                    <td class="py-3 px-2 text-slate-300 text-sm">@GetDoubleNascar(driver, "playoff_pct").ToString("F1")%</td>
                                                    <td class="py-3 px-2 text-slate-400 text-sm">@GetDoubleNascar(driver, "champ_4_pct").ToString("F1")%</td>
