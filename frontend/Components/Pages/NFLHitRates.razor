@page "/nfl-hit-rates"
@using SportsBettingAnalyzer.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILogger<NFLHitRates> Logger
@rendermode InteractiveServer

<PageTitle>NFL Hit Rates</PageTitle>

<div class="min-h-screen bg-slate-950 text-slate-100 p-4 md:p-8 font-sans">
    <TwContainer MaxWidth="7xl">
        
        <!-- Header Section -->
        <header class="mb-8">
            <div class="flex items-center gap-3 mb-2">
                <div class="bg-emerald-600 p-3 rounded-xl shadow-lg shadow-emerald-900/20">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-3xl font-bold tracking-tight">NFL Hit Rates</h1>
                    <p class="text-slate-400 text-sm">Prop bet analysis - Find consistent NFL performers</p>
                </div>
            </div>
        </header>

        <!-- Filters Card -->
        <TwCard Color="emerald" Class="mb-6">
            <div class="flex flex-wrap items-end gap-4">
                <div>
                    <label class="block text-xs text-slate-500 mb-1">Season</label>
                    <TwSelect TValue="int" @bind-Value="_selectedSeason">
                        @foreach (var season in _availableSeasons)
                        {
                            <option value="@season">@season</option>
                        }
                    </TwSelect>
                </div>

                <div class="min-w-[200px]">
                    <label class="block text-xs text-slate-500 mb-1">Player Search</label>
                    <TwInput @bind-Value="_searchPlayer" 
                             Placeholder="Patrick Mahomes, Derrick Henry..." 
                             ShowSearchIcon="true" />
                </div>

                <div>
                    <label class="block text-xs text-slate-500 mb-1">Stat Type</label>
                    <TwSelect TValue="string" Value="_selectedStat" ValueChanged="OnStatChanged">
                        <option value="pass_yds">Pass Yards</option>
                        <option value="rush_yds">Rush Yards</option>
                        <option value="rec_yds">Receiving Yards</option>
                        <option value="rec">Receptions</option>
                        <option value="pass_td">Pass TDs</option>
                        <option value="rush_td">Rush TDs</option>
                        <option value="rec_td">Receiving TDs</option>
                    </TwSelect>
                </div>

                <div>
                    <label class="block text-xs text-slate-500 mb-1">Over Line</label>
                    <TwInput Type="number" @bind-Value="_thresholdString" Placeholder="250" Class="w-24" />
                </div>

                <TwButton Variant="success" OnClick="CalculateHitRates" IsLoading="_isLoading" Disabled="_isLoading">
                    Calculate
                </TwButton>
            </div>

            @if (_isPassingStat)
            {
                <TwAlert Severity="info" Class="mt-4">
                    Filtering to QBs only for passing stats
                </TwAlert>
            }
        </TwCard>

        <!-- Loading State -->
        @if (_isLoading)
        {
            <div class="mb-6">
                <TwProgressBar IsIndeterminate="true" Color="emerald" Size="md" />
            </div>
        }

        @if (_hitRates.Any())
        {
            <!-- Top 3 Summary Cards -->
            <TwGrid Cols="1" ColsMd="3" Gap="6" Class="mb-8">
                @foreach (var player in _hitRates.Take(3))
                {
                    <TwCard Color="@GetCardColor(player.SeasonRate)" Hoverable="true">
                        <div class="flex items-center justify-between mb-4">
                            <div>
                                <h3 class="text-lg font-bold text-white">@player.PlayerName</h3>
                                <p class="text-sm text-slate-400">Over @_threshold @GetStatLabel(_selectedStat) (@_selectedSeason)</p>
                            </div>
                            <div class="@GetRateClasses(player.SeasonRate) w-14 h-14 rounded-full flex items-center justify-center font-bold text-lg">
                                @player.SeasonRate.ToString("P0")
                            </div>
                        </div>
                        <div class="border-t border-slate-700 pt-4">
                            <div class="flex justify-around text-center">
                                <div>
                                    <div class="text-xl font-bold @GetRateTextColor(player.Last5Rate)">@player.Last5Hits/@player.Last5Games</div>
                                    <div class="text-xs text-slate-500">Last 5</div>
                                </div>
                                <div>
                                    <div class="text-xl font-bold @GetRateTextColor(player.Last10Rate)">@player.Last10Hits/@player.Last10Games</div>
                                    <div class="text-xs text-slate-500">Last 10</div>
                                </div>
                                <div>
                                    <div class="text-xl font-bold @GetRateTextColor(player.SeasonRate)">@player.SeasonHits/@player.SeasonGames</div>
                                    <div class="text-xs text-slate-500">Season</div>
                                </div>
                            </div>
                        </div>
                    </TwCard>
                }
            </TwGrid>

            <!-- Full Data Table -->
            <TwCard Color="slate" Class="overflow-hidden">
                <div class="overflow-x-auto">
                    <TwTable TItem="object">
                        <HeaderContent>
                            <TwTh>Player</TwTh>
                            <TwTh>Team</TwTh>
                            <TwTh>Pos</TwTh>
                            <TwTh Class="text-center">L5</TwTh>
                            <TwTh Class="text-center">L10</TwTh>
                            <TwTh Class="text-center">Season</TwTh>
                            <TwTh Class="text-center">Avg</TwTh>
                            <TwTh Class="text-center">Trend</TwTh>
                        </HeaderContent>
                        <ChildContent>
                            @foreach (var player in _hitRates)
                            {
                                <TwTr>
                                    <TwTd>
                                        <TwLink Href="@($"/nfl-player-profiles?player={Uri.EscapeDataString(player.PlayerName)}")">
                                            @player.PlayerName
                                        </TwLink>
                                    </TwTd>
                                    <TwTd>@player.Team</TwTd>
                                    <TwTd>@player.Position</TwTd>
                                    <TwTd Class="text-center">
                                        <TwChip Size="sm" Color="@GetChipColor(player.Last5Rate)">
                                            @player.Last5Hits/@player.Last5Games
                                        </TwChip>
                                    </TwTd>
                                    <TwTd Class="text-center">
                                        <TwChip Size="sm" Color="@GetChipColor(player.Last10Rate)">
                                            @player.Last10Hits/@player.Last10Games
                                        </TwChip>
                                    </TwTd>
                                    <TwTd Class="text-center">
                                        <TwChip Size="sm" Color="@GetChipColor(player.SeasonRate)">
                                            @player.SeasonRate.ToString("P0")
                                        </TwChip>
                                    </TwTd>
                                    <TwTd Class="text-center font-bold text-white">@player.SeasonAvg.ToString("F1")</TwTd>
                                    <TwTd Class="text-center">
                                        @if (player.Last5Rate > player.SeasonRate)
                                        {
                                            <span class="text-emerald-400">↗</span>
                                        }
                                        else if (player.Last5Rate < player.SeasonRate)
                                        {
                                            <span class="text-red-400">↘</span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-500">→</span>
                                        }
                                    </TwTd>
                                </TwTr>
                            }
                        </ChildContent>
                    </TwTable>
                </div>

                <!-- Averages Summary -->
                @if (_hitRates.Any())
                {
                    <div class="border-t border-slate-700 pt-4 mt-4">
                        <h4 class="text-sm font-semibold text-slate-400 mb-4">Season Averages (Selected Players)</h4>
                        <div class="flex flex-wrap gap-4 justify-around">
                            <TwStatCard Value="@GetOverallAvg("pass_yds").ToString("F1")" Label="Avg Pass Yds" Color="blue" />
                            <TwStatCard Value="@GetOverallAvg("rush_yds").ToString("F1")" Label="Avg Rush Yds" Color="emerald" />
                            <TwStatCard Value="@GetOverallAvg("rec_yds").ToString("F1")" Label="Avg Rec Yds" Color="purple" />
                            <TwStatCard Value="@GetOverallAvg("rec").ToString("F1")" Label="Avg Receptions" Color="amber" />
                        </div>
                    </div>
                }
            </TwCard>
        }
        else if (!_isLoading && _searchCompleted)
        {
            <TwAlert Severity="info">
                No hit rate data found. Try searching for a player or adjusting filters.
            </TwAlert>
        }
    </TwContainer>
</div>

@code {
    private string _searchPlayer = "";
    private string _selectedStat = "pass_yds";
    private int _threshold = 250;
    private string _thresholdString = "250";
    private int _selectedSeason = 2025;
    private bool _isLoading = false;
    private bool _searchCompleted = false;
    private bool _isPassingStat => _selectedStat == "pass_yds" || _selectedStat == "pass_td";
    
    private List<int> _availableSeasons = new() { 2025, 2024, 2023 };
    private List<HitRateResult> _hitRates = new();
    private List<GameResult> _allGameResults = new();
    
    protected override async Task OnInitializedAsync()
    {
        await LoadSeasons();
    }
    
    private async Task LoadSeasons()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<SeasonsResponse>(
                "http://backend:8000/db/games/nfl/seasons?series=nfl_weekly");
            if (response?.Seasons?.Any() == true)
            {
                _availableSeasons = response.Seasons;
                _selectedSeason = _availableSeasons.First();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed loading NFL seasons");
        }
    }
    
    private void OnStatChanged(string newStat)
    {
        _selectedStat = newStat;
        _threshold = newStat switch
        {
            "pass_yds" => 250,
            "rush_yds" => 60,
            "rec_yds" => 50,
            "rec" => 4,
            "pass_td" => 2,
            "rush_td" => 1,
            "rec_td" => 1,
            _ => 50
        };
        _thresholdString = _threshold.ToString();
    }
    
    private async Task CalculateHitRates()
    {
        if (int.TryParse(_thresholdString, out var parsed))
            _threshold = parsed;

        try
        {
            _isLoading = true;
            _searchCompleted = false;
            StateHasChanged();
            
            var url = $"http://backend:8000/db/games/nfl/list?limit=1000&season={_selectedSeason}";
            if (!string.IsNullOrEmpty(_searchPlayer))
                url += $"&player={Uri.EscapeDataString(_searchPlayer)}";
            
            var response = await Http.GetAsync(url);
            if (!response.IsSuccessStatusCode)
            {
                _hitRates = new();
                _searchCompleted = true;
                return;
            }
            
            var json = await response.Content.ReadAsStringAsync();
            var games = System.Text.Json.JsonSerializer.Deserialize<GameResultsResponse>(json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            
            if (games?.Results == null || !games.Results.Any())
            {
                _hitRates = new();
                _searchCompleted = true;
                return;
            }
            
            var filteredGames = games.Results.Where(g => !string.IsNullOrEmpty(g.PlayerName));
            if (_isPassingStat)
            {
                filteredGames = filteredGames.Where(g => g.Position == "QB");
            }
            
            _allGameResults = filteredGames.ToList();
            var playerGames = _allGameResults.GroupBy(g => g.PlayerName).ToList();
            
            _hitRates = playerGames.Select(pg =>
            {
                var allGames = pg.OrderByDescending(g => g.Week ?? 0).ToList();
                var last5 = allGames.Take(5).ToList();
                var last10 = allGames.Take(10).ToList();
                
                int GetStatValue(GameResult g) => _selectedStat switch
                {
                    "pass_yds" => g.PassYds ?? 0,
                    "rush_yds" => g.RushYds ?? 0,
                    "rec_yds" => g.RecYds ?? 0,
                    "rec" => g.Rec ?? 0,
                    "pass_td" => g.PassTd ?? 0,
                    "rush_td" => g.RushTd ?? 0,
                    "rec_td" => g.RecTd ?? 0,
                    _ => 0
                };
                
                return new HitRateResult
                {
                    PlayerName = pg.Key!,
                    Team = pg.FirstOrDefault()?.Team ?? "",
                    Position = pg.FirstOrDefault()?.Position ?? "",
                    Last5Games = last5.Count,
                    Last5Hits = last5.Count(g => GetStatValue(g) >= _threshold),
                    Last10Games = last10.Count,
                    Last10Hits = last10.Count(g => GetStatValue(g) >= _threshold),
                    SeasonGames = allGames.Count,
                    SeasonHits = allGames.Count(g => GetStatValue(g) >= _threshold),
                    SeasonAvg = allGames.Count > 0 ? allGames.Average(g => GetStatValue(g)) : 0,
                };
            })
            .Where(h => h.SeasonGames > 0)
            .OrderByDescending(h => h.SeasonRate)
            .ThenByDescending(h => h.SeasonGames)
            .Take(50)
            .ToList();
            
            _searchCompleted = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            _hitRates = new();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
    
    private string GetChipColor(double rate)
    {
        if (rate >= 0.80) return "emerald";
        if (rate >= 0.60) return "amber";
        return "red";
    }

    private string GetCardColor(double rate)
    {
        if (rate >= 0.80) return "emerald";
        if (rate >= 0.60) return "amber";
        return "red";
    }

    private string GetRateClasses(double rate)
    {
        if (rate >= 0.80) return "bg-emerald-600 text-white";
        if (rate >= 0.60) return "bg-amber-600 text-white";
        return "bg-red-600 text-white";
    }

    private string GetRateTextColor(double rate)
    {
        if (rate >= 0.80) return "text-emerald-400";
        if (rate >= 0.60) return "text-amber-400";
        return "text-red-400";
    }
    
    private string GetStatLabel(string stat) => stat switch
    {
        "pass_yds" => "Pass Yds",
        "rush_yds" => "Rush Yds",
        "rec_yds" => "Rec Yds",
        "rec" => "Receptions",
        "pass_td" => "Pass TDs",
        "rush_td" => "Rush TDs",
        "rec_td" => "Rec TDs",
        _ => stat
    };
    
    private double GetOverallAvg(string stat)
    {
        if (!_allGameResults.Any()) return 0;
        
        var values = _allGameResults.Select(g => stat switch
        {
            "pass_yds" => g.PassYds ?? 0,
            "rush_yds" => g.RushYds ?? 0,
            "rec_yds" => g.RecYds ?? 0,
            "rec" => g.Rec ?? 0,
            "pass_td" => g.PassTd ?? 0,
            "rush_td" => g.RushTd ?? 0,
            "rec_td" => g.RecTd ?? 0,
            _ => 0
        }).Where(v => v > 0);
        
        return values.Any() ? values.Average() : 0;
    }
    
    // Models
    public class SeasonsResponse
    {
        public List<int> Seasons { get; set; } = new();
    }
    
    public class HitRateResult
    {
        public string PlayerName { get; set; } = "";
        public string Team { get; set; } = "";
        public string Position { get; set; } = "";
        public int Last5Games { get; set; }
        public int Last5Hits { get; set; }
        public int Last10Games { get; set; }
        public int Last10Hits { get; set; }
        public int SeasonGames { get; set; }
        public int SeasonHits { get; set; }
        public double SeasonAvg { get; set; }
        
        public double Last5Rate => Last5Games > 0 ? (double)Last5Hits / Last5Games : 0;
        public double Last10Rate => Last10Games > 0 ? (double)Last10Hits / Last10Games : 0;
        public double SeasonRate => SeasonGames > 0 ? (double)SeasonHits / SeasonGames : 0;
    }
    
    public class GameResultsResponse
    {
        public List<GameResult> Results { get; set; } = new();
    }
    
    public class GameResult
    {
        [System.Text.Json.Serialization.JsonPropertyName("season")]
        public int Season { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("week")]
        public int? Week { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("player_name")]
        public string? PlayerName { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("team")]
        public string? Team { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("position")]
        public string? Position { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("pass_yds")]
        public int? PassYds { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("rush_yds")]
        public int? RushYds { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("rec_yds")]
        public int? RecYds { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("rec")]
        public int? Rec { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("pass_td")]
        public int? PassTd { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("rush_td")]
        public int? RushTd { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("rec_td")]
        public int? RecTd { get; set; }
    }
}
