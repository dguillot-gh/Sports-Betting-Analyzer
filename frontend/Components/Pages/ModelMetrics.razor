        builder.AddContent(84, $"Total Staked: ${metrics.TotalStaked:F2}");
        builder.CloseElement();
        
        builder.CloseElement();
        builder.CloseElement();

        // Season Breakdown
        if (metrics.BySeason?.Any() == true)
        {
            builder.OpenElement(100, "div");
            builder.OpenElement(101, "h4");
            builder.AddAttribute(102, "class", "text-sm font-bold text-slate-300 mb-3");
            builder.AddContent(103, "Season-by-Season Performance");
