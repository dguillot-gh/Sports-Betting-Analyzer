                builder.CloseComponent();
                
                builder.CloseElement();
            }
            
            builder.CloseElement();
            builder.CloseElement();
        }
    };

    private void RenderMetricCard(RenderTreeBuilder builder, int sequence, string label, string value, string subtitle, string color)
    {
        builder.OpenElement(sequence, "div");
        builder.AddAttribute(sequence + 1, "class", "p-4 rounded-xl bg-slate-900/50 border border-slate-700/50");
        
        builder.OpenElement(sequence + 2, "div");
        builder.AddAttribute(sequence + 3, "class", "text-xs text-slate-500 font-medium uppercase mb-1");
        builder.AddContent(sequence + 4, label);
        builder.CloseElement();
        
        builder.OpenElement(sequence + 5, "div");
        builder.AddAttribute(sequence + 6, "class", $"text-2xl font-bold text-{color}-400");
        builder.AddContent(sequence + 7, value);
        builder.CloseElement();
        
        builder.OpenElement(sequence + 8, "div");
        builder.AddAttribute(sequence + 9, "class", "text-xs text-slate-500 mt-1");
        builder.AddContent(sequence + 10, subtitle);
        builder.CloseElement();
        
        builder.CloseElement();
    }

    private Func<BetHistoryRecord, object> _getBankrollX => e => e.GameDate;
    private Func<BetHistoryRecord, decimal?> _getBankrollY => e => (decimal?)e.Bankroll;

    private ApexCharts.ApexChartOptions<BetHistoryRecord> GetBankrollChartOptions(string colorName)
    {
        string hexColor = colorName switch {
            "purple" => "#a855f7",
            "orange" => "#f97316",
            "green" => "#22c55e",
            "red" => "#ef4444",
            "emerald" => "#10b981",
            "amber" => "#f59e0b",
            _ => "#3b82f6" // blue
        };

        return new ApexCharts.ApexChartOptions<BetHistoryRecord>
        {
            Chart = new ApexCharts.Chart
            {
                Toolbar = new ApexCharts.Toolbar { Show = false },
                Background = "transparent",
                ForeColor = "#94a3b8" // slate-400
            },
            Theme = new ApexCharts.Theme { Mode = ApexCharts.Mode.Dark },
            Stroke = new ApexCharts.Stroke { Curve = ApexCharts.Curve.Smooth, Width = 3 },
            Markers = new ApexCharts.Markers { Size = 0, StrokeWidth = 0 },
            Xaxis = new ApexCharts.XAxis 
            { 
                Title = new ApexCharts.AxisTitle { Text = "" },
                AxisBorder = new ApexCharts.AxisBorder { Show = false },
                AxisTicks = new ApexCharts.AxisTicks { Show = false },
                Labels = new ApexCharts.XAxisLabels { Show = false }
            },
            Yaxis = new List<ApexCharts.YAxis> 
            { 
                new ApexCharts.YAxis 
                { 
                    Title = new ApexCharts.AxisTitle { Text = "Bankroll ($)" },
                    Labels = new ApexCharts.YAxisLabels { Style = new ApexCharts.AxisLabelStyle { Colors = "#64748b" } },
                    DecimalsInFloat = 0
                } 
            },
            Grid = new ApexCharts.Grid 
            { 
                BorderColor = "#334155", // slate-700
                StrokeDashArray = 4 
            },
            Colors = new List<string> { hexColor }
        };
    }

