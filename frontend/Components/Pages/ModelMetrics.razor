            builder.OpenElement(104, "div");
            builder.AddAttribute(105, "class", "grid grid-cols-1 md:grid-cols-2 gap-3");
            
            foreach (var season in metrics.BySeason)
            {
                builder.OpenElement(110, "div");
                builder.AddAttribute(111, "class", "p-3 rounded-lg bg-slate-900/30 border border-slate-700/30 flex justify-between items-center");
                
                builder.OpenElement(112, "span");
                builder.AddAttribute(113, "class", "text-white font-medium");
                builder.AddContent(114, $"{season.Season}: {season.Bets} bets, {season.WinRate}% win rate");
                builder.CloseElement();
                
                builder.OpenComponent<TwChip>(115);
                builder.AddAttribute(116, "Color", season.ROI > 0 ? "emerald" : "red");
