    private class ModelMetricsData
    {
        public int TotalBets { get; set; }
        public int Wins { get; set; }
        public int Losses { get; set; }
        public double WinRate { get; set; }
        public double TotalStaked { get; set; }
        public double TotalProfit { get; set; }
        public double ROI { get; set; }
        public double SharpeRatio { get; set; }
        public double MaxDrawdown { get; set; }
        public double AvgEdge { get; set; }
        public double MLAccuracy { get; set; }
        public double MLAccuracyStd { get; set; }
        public double OUMAE { get; set; }
        public int SamplesCount { get; set; }
        public int CVFolds { get; set; }
        public List<SeasonMetrics>? BySeason { get; set; }
        public List<BetHistoryRecord>? BetHistory { get; set; }
    }

    private class SeasonMetrics
    {
        public int Season { get; set; }
        public int Bets { get; set; }
        public int Wins { get; set; }
        public double WinRate { get; set; }
        public double Profit { get; set; }
        public double ROI { get; set; }
    }

    public class BetHistoryRecord
    {
        [System.Text.Json.Serialization.JsonPropertyName("game_date")] 
        public string GameDate { get; set; } = "";
        
        [System.Text.Json.Serialization.JsonPropertyName("home_team")] 
        public string HomeTeam { get; set; } = "";
        
        [System.Text.Json.Serialization.JsonPropertyName("away_team")] 
        public string AwayTeam { get; set; } = "";
        
        [System.Text.Json.Serialization.JsonPropertyName("bet_on")] 
        public string BetOn { get; set; } = "";
        
        [System.Text.Json.Serialization.JsonPropertyName("profit")] 
        public double Profit { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("bankroll")] 
        public double Bankroll { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("won")] 
        public bool Won { get; set; }
    }
