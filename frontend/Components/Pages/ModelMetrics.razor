@page "/model-metrics"
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.Extensions.Options
@using SportsBettingAnalyzer.Services
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ILogger<ModelMetrics> Logger
@inject IOptions<PythonMLOptions> MLOptions
@rendermode InteractiveServer

<PageTitle>Model Performance Metrics</PageTitle>

<TwContainer MaxWidth="extraLarge">
    <!-- Loading Overlay (using reusable component) -->
    <TwLoadingOverlay 
        IsVisible="@_isBacktestRunning"
        Title="@($"{_currentSport} Backtest Running")"
        Color="@_currentSportColor"
        CurrentStatusMessage="@_currentStatusMessage"
        ShowProgress="true"
        Progress="@_progressPercent"
        CurrentPhase="@_currentPhase"
        OnCancel="@CancelBacktest" />

    <div class="py-8 space-y-8">
        <!-- Header -->
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-white tracking-tight">Model Performance Metrics</h1>
                <p class="text-slate-400 mt-2">Comprehensive backtesting results and methodology for all prediction models</p>
            </div>
            <div class="flex gap-3">
                <TwButton Variant="outline" OnClick="RunAllBacktests" IsLoading="@_isBacktestRunning">
                    <TwIcon Icon="M13 10V3L4 14h7v7l9-11h-7z" Class="w-4 h-4 mr-2" />
                    Run All Backtests
                </TwButton>
                <TwButton Variant="primary" OnClick="RefreshAllMetrics" IsLoading="@_isRefreshing">
                    <TwIcon Icon="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" Class="w-4 h-4 mr-2" />
                    Refresh All
                </TwButton>
            </div>
        </div>

        <!-- Methodology Explanation -->
        <TwCard Class="p-6 bg-gradient-to-br from-blue-900/20 to-purple-900/20 border-blue-500/30">
            <div class="flex items-start gap-4">
                <div class="p-3 bg-blue-500/20 rounded-xl">
                    <TwIcon Icon="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" Class="w-6 h-6 text-blue-400" />
                </div>
                <div class="flex-1">
                    <h3 class="text-lg font-bold text-white mb-2">How Metrics Are Calculated</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-slate-300">
                        <div>
                            <span class="font-semibold text-blue-400">Walk-Forward Validation:</span> 
                            Models tested chronologically to prevent data leakage. Train on past, test on future.
                        </div>
                        <div>
                            <span class="font-semibold text-emerald-400">Win Rate:</span> 
                            (Wins / Total Bets) × 100. Breakeven for -110 odds is ~52.4%.
                        </div>
                        <div>
                            <span class="font-semibold text-purple-400">ROI:</span> 
                            (Total Profit / Total Staked) × 100. Positive = profitable.
                        </div>
                        <div>
                            <span class="font-semibold text-amber-400">Sharpe Ratio:</span> 
                            (Mean Return / Std Dev) × √n. >1.0 good, >2.0 excellent.
                        </div>
                    </div>
                </div>
            </div>
        </TwCard>

        <!-- Tabbed Model Metrics -->
        <TwCard Class="p-6">
            <TwTabs @bind-ActiveTabId="@_activeTab">
                <!-- NHL Tab -->
                <TwTabPanel Id="nhl" Title="NHL XGBoost" TabIcon="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z">
                    @RenderModelMetrics("NHL", _nhlMetrics, "purple", _isBacktestingNHL, () => RunBacktest("nhl"))
                </TwTabPanel>

                <!-- NBA Tab -->
                <TwTabPanel Id="nba" Title="NBA XGBoost" TabIcon="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9">
                    @RenderModelMetrics("NBA", _nbaMetrics, "orange", _isBacktestingNBA, () => RunBacktest("nba"))
                </TwTabPanel>

                <!-- NFL Tab -->
                <TwTabPanel Id="nfl" Title="NFL XGBoost" TabIcon="M13 10V3L4 14h7v7l9-11h-7z">
                    @RenderModelMetrics("NFL", _nflMetrics, "green", _isBacktestingNFL, () => RunBacktest("nfl"))
                </TwTabPanel>

                <!-- NASCAR Tab -->
                <TwTabPanel Id="nascar" Title="NASCAR Ensemble" TabIcon="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6">
                    @RenderModelMetrics("NASCAR", _nascarMetrics, "red", _isBacktestingNASCAR, () => RunBacktest("nascar"))
                </TwTabPanel>
            </TwTabs>
        </TwCard>
    </div>
</TwContainer>

