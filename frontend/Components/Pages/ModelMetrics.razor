        }));
        builder.CloseComponent();
        
        builder.CloseElement();

        // Core Metrics Grid
        builder.OpenElement(30, "div");
        builder.AddAttribute(31, "class", "grid grid-cols-2 md:grid-cols-5 gap-4 mb-6");
        
        RenderMetricCard(builder, 32, "Win Rate", $"{metrics.WinRate}%", $"{metrics.Wins}W-{metrics.Losses}L", "emerald");
        RenderMetricCard(builder, 40, "ROI", $"{(metrics.ROI > 0 ? "+" : "")}{metrics.ROI}%", $"${metrics.TotalProfit:F2}", "blue");
