        builder.OpenElement(72, "h4");
        builder.AddAttribute(73, "class", "text-sm font-bold text-slate-300 mb-3");
        builder.AddContent(74, "Calculation Breakdown");
        builder.CloseElement();
        
        builder.OpenElement(75, "div");
        builder.AddAttribute(76, "class", "grid grid-cols-1 md:grid-cols-2 gap-3 text-xs text-slate-400 font-mono");
        
        builder.OpenElement(77, "div");
        builder.AddContent(78, $"Win Rate: ({metrics.Wins} / {metrics.TotalBets}) × 100 = {metrics.WinRate}%");
        builder.CloseElement();
        
        builder.OpenElement(79, "div");
        builder.AddContent(80, $"ROI: (${metrics.TotalProfit:F2} / ${metrics.TotalStaked:F2}) × 100 = {metrics.ROI}%");
        builder.CloseElement();
        
        builder.OpenElement(81, "div");
        builder.AddContent(82, $"Avg Edge: {metrics.AvgEdge}%");
        builder.CloseElement();
        
