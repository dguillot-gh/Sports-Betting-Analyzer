    private bool _isBacktestingNHL = false;
    private bool _isBacktestingNBA = false;
    private bool _isBacktestingNFL = false;
    private bool _isBacktestingNASCAR = false;

    // Progress dialog state
    private bool _isBacktestRunning = false;
    private string _currentSport = "";
    private string _currentSportColor = "blue";
    private string _currentStatusMessage = "";
    private string _currentPhase = "";
    private int _progressPercent = 0;
    private CancellationTokenSource? _cancellationTokenSource;

    // Clever status messages by sport
