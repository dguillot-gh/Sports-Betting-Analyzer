@page "/ncaab-live-odds"
@using System.Text.Json
@using System.Text.Json.Serialization
@using SportsBettingAnalyzer.Components.Shared.Tailwind
@using SportsBettingAnalyzer.Shared.Services
@implements IDisposable
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ILogger<NCAABLiveOdds> Logger
@inject PythonMLServiceClient MLServiceClient
@inject IServerConfigService ServerConfig
@rendermode InteractiveServer

<PageTitle>NCAAB Live Odds</PageTitle>

<TwContainer>
    <!-- Loading Overlay for Analysis -->
    <TwLoadingOverlay 
        IsVisible="@(_isLoading || _isEspnLoading)"
        Title="@(_isLoading ? "Analyzing Matches..." : "Syncing ESPN BPI...")"
        Color="orange"
        CurrentStatusMessage="@_analysisStatus"
        ShowProgress="false" />

    <div class="flex flex-col gap-6">
        <!-- Header & Loading Status -->
        <TwCard Class="p-1 relative overflow-hidden">
            <div class="px-6"> 
            
            <div class="p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                <div>
                    <h1 class="text-3xl font-bold text-white flex items-center gap-3">
                        <svg class="w-8 h-8 text-orange-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm4.5-9h-9c-.28 0-.5.22-.5.5s.22.5.5.5h9c.28 0 .5-.22 .5-.5s-.22-.5-.5-.5z"></path></svg>
                        NCAAB Live Odds
                        @if (_isLoading || _isEspnLoading)
                        {
                            <span class="text-xs font-normal text-blue-400 animate-pulse ml-2 flex items-center gap-1">
                                <span class="block w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                                @(_isLoading && _isEspnLoading ? "Refreshing all data..." : (_isLoading ? "Fetching live odds..." : "Syncing ESPN BPI..."))
                            </span>
                        }
                    </h1>
                    <p class="text-slate-400 mt-1">Men's College Basketball predictions with value detection.</p>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <TwSelect TValue="string" @bind-Value="_selectedSportsbook" Label="Sportsbook" Class="w-40">
                        <option value="fanduel">FanDuel</option>
                        <option value="draftkings">DraftKings</option>
                        <option value="betmgm">BetMGM</option>
                    </TwSelect>
                    <TwButton Variant="primary" StartIcon="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" 
                               OnClick="@RunAnalysis" IsLoading="@_isLoading" Disabled="@_isLoading">
                        Analyze Games
                    </TwButton>
                    <TwButton Variant="success" StartIcon="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" 
                               OnClick="@SaveAllToCache" IsLoading="@_isSavingAll" Disabled="@(!_games.Any() || _isSavingAll)">
                        Snapshot Results
                    </TwButton>
                    <TwButton Variant="secondary" Href="/data-center" StartIcon="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z">
                        Data Center
                    </TwButton>
                </div>
            </div>
        </div>
    </TwCard>

        @if (_error != null)
        {
            <TwAlert Severity="error">@_error</TwAlert>
        }

        <TwApiQuotaTracker />

        <!-- Summary Stats -->
        @if (_games.Any())
        {
            <div class="bg-slate-900/50 border border-slate-800 rounded-xl px-4 py-3 flex justify-between items-center">
                <span class="text-slate-300">
                    <strong class="text-white">@_games.Count</strong> games found · 
                    <strong class="text-blue-400">@_valueBets</strong> value bets detected
                </span>
                <TwChip Color="blue" Variant="outline" Size="sm">@_source</TwChip>
            </div>
        }

        <div class="px-8 space-y-6">

        <div class="h-px bg-slate-800"></div>
        
        <h2 class="text-lg font-bold text-white">Model Management</h2>
        <TwCard Class="p-6">
            <div class="flex flex-wrap items-center gap-6">
                <TwButton Variant="primary" OnClick="TrainNcaabModel" IsLoading="@_isTraining" Disabled="@_isTraining">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86 1.417l-1.873 1.56a2 2 0 01-1.076.443L6.5 18M3.5 14l1-1.5M13 13l3-1M5 10c2.133 0 4.267.533 6 1.5M15 10c-2.133 0-4.267.533-6 1.5"></path></svg>
                    Train XGBoost Model
                </TwButton>
                
                @if(_trainingMessage != null)
                {
                    <span class="text-blue-400 text-sm">@_trainingMessage</span>
                }
                
                <TwButton Variant="secondary" OnClick="RunBacktest" IsLoading="@_isBacktesting" Disabled="@_isBacktesting" StartIcon="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z">
                    Run Backtest (2023-24)
                </TwButton>

                <TwButton Variant="secondary" OnClick="UpdateTorvikData" IsLoading="@_isUpdatingTorvik" Disabled="@_isUpdatingTorvik" StartIcon="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10">
                    Update Torvik Data
                </TwButton>
            </div>
            
            @if(_backtestReport != null)
            {
                <div class="mt-6 p-4 rounded-xl bg-blue-500/5 border border-blue-500/10">
                    <h3 class="text-white font-bold mb-4">Backtest Results (Season 2023-24)</h3>
                    <TwGrid Columns="2" ColumnsMd="4">
                        <TwStatCard Label="ROI" Value="@($"{_backtestReport.RoiPercent}%")" Color="@(_backtestReport.RoiPercent > 0 ? "emerald" : "red")" />
                        <TwStatCard Label="Units Won" Value="@(_backtestReport.UnitsWon.ToString("F1"))" Color="@(_backtestReport.UnitsWon > 0 ? "emerald" : "red")" />
                        <TwStatCard Label="Hit Rate" Value="@($"{_backtestReport.HitRate * 100}%")" Color="blue" />
                        <TwStatCard Label="Bets" Value="@(_backtestReport.BetsPlaced.ToString())" Color="slate" />
                    </TwGrid>
                </div>
            }
        </TwCard>

        <!-- Games Grid -->
        @if (_games.Any())
        {
            <TwGrid Columns="1" ColumnsMd="2" ColumnsLg="3" Gap="6">
                @foreach (var game in _games)
                {
                    <TwCard NoPadding="true" Class="flex flex-col h-full border-t-4" Style="@(game.HasValue ? "border-t-emerald-500" : "border-t-slate-800")">
                        <div class="p-5 border-b border-slate-800 bg-slate-900/40">
                            <div class="flex justify-between items-start mb-3">
                                <div class="flex flex-col">
                                    <span class="text-lg font-bold text-white">@game.AwayTeam</span>
                                    <span class="text-[10px] text-slate-500 uppercase tracking-widest my-0.5">at</span>
                                    <span class="text-lg font-bold text-white">@game.HomeTeam</span>
                                </div>
                                <div class="flex flex-col items-end gap-2">
                                    @if (game.Prediction != null && game.OverUnder.HasValue)
                                    {
                                        var edge = Math.Abs((double)game.OverUnder.Value - (game.Prediction.V2Available ? game.Prediction.V2Total : game.Prediction.PredictedTotal));
                                        var pick = game.Prediction.V2Available ? (game.Prediction.V2Total > (double)game.OverUnder.Value ? "OVER" : "UNDER") : (game.Prediction.PredictedTotal > (double)game.OverUnder.Value ? "OVER" : "UNDER");
                                        var chipColor = pick == "OVER" ? "emerald" : "blue";
                                        
                                        <TwChip Color="@chipColor" Variant="@(edge >= 5 ? "filled" : "outline")" Size="sm" 
                                               title="@($"Model Edge: {edge:F1} points")">
                                            <div class="flex items-center gap-1 font-bold">
                                                 <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    @if (pick == "OVER") { <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 15l7-7 7 7"></path> }
                                                    else { <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"></path> }
                                                </svg>
                                                @pick @game.OverUnder.Value
                                            </div>
                                        </TwChip>
                                    }
                                    @if (game.HasValue)
                                    {
                                        <TwChip Color="emerald" Size="xs">VALUE</TwChip>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="p-5 flex-1 space-y-4">
                            <!-- Odds Table -->
                            <div class="rounded-lg border border-slate-800 overflow-hidden text-xs">
                                <TwTable TItem="object">
                                    <TwTr>
                                        <TwTd Class="bg-slate-900/20 font-medium text-slate-400">Moneyline</TwTd>
                                        <TwTd Class="text-right">@(game.HomeMoneyline.HasValue ? FormatOdds(game.HomeMoneyline) : "-") / @(game.AwayMoneyline.HasValue ? FormatOdds(game.AwayMoneyline) : "-")</TwTd>
                                    </TwTr>
                                    <TwTr>
                                        <TwTd Class="bg-slate-900/20 font-medium text-slate-400">Spread</TwTd>
                                        <TwTd Class="text-right">@(game.Spread?.ToString("+0.0;-0.0") ?? "-")</TwTd>
                                    </TwTr>
                                    <TwTr>
                                        <TwTd Class="bg-slate-900/20 font-medium text-slate-400">O/U</TwTd>
                                        <TwTd Class="text-right">@(game.OverUnder?.ToString() ?? "-")</TwTd>
                                    </TwTr>
                                    @if (game.Prediction != null)
                                    {
                                        <TwTr>
                                            <TwTd Class="bg-blue-500/5 font-bold text-blue-400">Winner</TwTd>
                                            <TwTd Class="text-right font-bold text-blue-400">@game.Prediction.PredictedWinner (@((game.Prediction.HomeWinProbability * 100).ToString("F0"))%)</TwTd>
                                        </TwTr>
                                    }
                                </TwTable>
                            </div>

                            <!-- Model Comparison -->
                            <div class="rounded-lg border border-slate-800 overflow-hidden text-[10px]">
                                <TwTable TItem="object">
                                    <thead>
                                        <tr class="bg-slate-900/50 border-b border-slate-800">
                                            <TwTh Class="py-1">Metric</TwTh>
                                            <TwTh Class="py-1 text-center">📊 Base</TwTh>
                                            <TwTh Class="py-1 text-center">🤖 XGB v2</TwTh>
                                            <TwTh Class="py-1 text-center">📡 ESPN</TwTh>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var espnMatch = MatchEspnGame(game);
                                            var hasXgb = game.Prediction?.V2Available ?? false;
                                            var baseProb = game.Prediction?.HomeWinProbability ?? 0.5;
                                            var xgbProb = game.Prediction?.V2WinProb ?? 0.5;
                                            var espnProb = espnMatch?.HomeWinProb ?? 0.5;
                                        }
                                        <TwTr>
                                            <TwTd Class="py-1 font-medium text-slate-500 uppercase tracking-tighter">Win Prob</TwTd>
                                            <TwTd Class="@("py-1 text-center font-bold " + _GetColor(baseProb))">@baseProb.ToString("P0")</TwTd>
                                            <TwTd Class="py-1 text-center">
                                                @if (hasXgb) { <span class="font-bold @_GetColor(xgbProb)">@xgbProb.ToString("P0")</span> } else { <span class="text-slate-600">-</span> }
                                            </TwTd>
                                            <TwTd Class="py-1 text-center">
                                                @if (espnMatch != null) { <span class="font-bold @_GetColor(espnProb)">@espnProb.ToString("P0")</span> } else { <span class="text-slate-600">-</span> }
                                            </TwTd>
                                        </TwTr>
                                        <TwTr>
                                            <TwTd Class="py-1 font-medium text-slate-500 uppercase tracking-tighter">Total</TwTd>
                                            <TwTd Class="py-1 text-center">@(game.Prediction?.PredictedTotal.ToString("F1") ?? "-")</TwTd>
                                            <TwTd Class="py-1 text-center">@(hasXgb ? game.Prediction?.V2Total.ToString("F1") : "-")</TwTd>
                                            <TwTd Class="py-1 text-center">-</TwTd>
                                        </TwTr>
                                    </tbody>
                                </TwTable>
                            </div>

                            <!-- SHAP Impact Factors -->
                            <div class="bg-slate-900/30 rounded-xl p-3 border border-slate-800/50">
                                <div class="flex items-center gap-2 mb-2 text-xs font-bold text-slate-300">
                                    <svg class="w-3 h-3 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    Model Impact Factors
                                </div>
                                <div class="flex flex-wrap gap-1.5">
                                    @if (game.Prediction?.V2Factors.Any() == true)
                                    {
                                        @foreach (var factor in game.Prediction.V2Factors)
                                        {
                                            var isPos = factor.Direction == "Positive" || (string.IsNullOrEmpty(factor.Direction) && factor.Impact > 0);
                                            var color = factor.Direction == "Positive" ? "emerald" : factor.Direction == "Negative" ? "red" : (factor.Impact > 0 ? "emerald" : "red");
                                            
                                            <TwChip Color="@color" Variant="outline" Size="xs" title="@($"Impact: {factor.Impact:F4} / Direction: {factor.Direction}")">
                                                @(isPos ? "+" : "")@factor.Label
                                            </TwChip>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-[10px] text-slate-600 italic">No analysis data available</span>
                                    }
                                </div>
                            </div>

                            @if (game.ValueBets.Any())
                            {
                                <div class="flex flex-wrap gap-2 pt-2 border-t border-slate-800">
                                    @foreach (var bet in game.ValueBets)
                                    {
                                        <TwChip Color="amber" Size="xs">@bet</TwChip>
                                    }
                                </div>
                            }

                            <!-- AI Rationale -->
                            <div class="pt-4 border-t border-slate-800">
                                @if (game.GeminiAnalysis == null)
                                {
                                    <TwButton Variant="secondary" Size="sm" OnClick="@(() => GetGeminiAnalysis(game))" IsLoading="@game.IsAnalyzing" FullWidth="true" StartIcon="M13 10V3L4 14h7v7l9-11h-7z">
                                        AI Rationale
                                    </TwButton>
                                }
                                else
                                {
                                    <div class="space-y-3">
                                        @if (game.GeminiAnalysis.Engines?.ContainsKey("XGBoost (ML)") == true && game.GeminiAnalysis.Engines["XGBoost (ML)"] is AiEnginePrediction xgb)
                                        {
                                            <div class="p-3 bg-purple-500/5 rounded-xl border border-purple-500/10">
                                                <div class="flex justify-between items-center mb-1 text-[10px] font-bold text-purple-400 uppercase tracking-wider">
                                                    <span>XGBoost Probability</span>
                                                    <span>@((xgb.HomeWinProb * 100).ToString("F0"))%</span>
                                                </div>
                                                <TwProgressBar Value="@((int)(xgb.HomeWinProb * 100))" Color="purple" Size="xs" />
                                            </div>
                                        }
                                        <div class="bg-slate-900/60 p-4 rounded-xl border border-slate-800 shadow-inner">
                                            <div class="flex items-center gap-2 mb-2 text-xs font-bold text-slate-400">
                                                <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 1k9-11h-7z"></path></svg>
                                                AI INSIGHT
                                            </div>
                                            <div class="text-[11px] leading-relaxed text-slate-300 antialiased">
                                                @((MarkupString)(game.GeminiAnalysis.LlmInsight?.Rationale ?? ""))
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </TwCard>
                }
            </TwGrid>
        }
        else if (!_isLoading)
        {
            <TwAlert Severity="info">
                No NCAAB games found for today. Click "Analyze Games" to fetch live odds.
            </TwAlert>
        }
        </div>
    </div>
</TwContainer>

@code {
    private bool _disposed = false;
    private string _GetColor(double p) => p > 0.5 ? "text-emerald-500" : "text-red-500";


    private bool _isLoading = false;
    private bool _isSavingAll = false; // [NEW]
    private string? _error = null;
    private string _selectedSportsbook = "fanduel";
    private List<GameData> _games = new();
    private int _valueBets = 0;
    private string _source = "";
    private string _analysisStatus = "🏀 Warming up the models...";
    
    // ESPN BPI State
    private EspnResponse? _espnData;
    private bool _isEspnLoading = false;
    private bool _isUpdatingTorvik = false;

    private async Task UpdateTorvikData()
    {
        _isUpdatingTorvik = true;
        try
        {
            var success = await MLServiceClient.UpdateTorvikDataAsync();
            if (success)
            {
                Snackbar.Add("Torvik data updated successfully! Please re-train the model.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to update Torvik data. Check backend logs.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUpdatingTorvik = false;
        }
    }
    
    private ApexChartOptions<RadarPoint> _radarOptions = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false }, ForeColor = "#e0e0e0" },
        PlotOptions = new PlotOptions { Radar = new PlotOptionsRadar { Polygons = new RadarPolygons { StrokeColors = "rgba(255,255,255,0.2)", ConnectorColors = "rgba(255,255,255,0.2)" } } },
        Yaxis = new List<YAxis> { new YAxis { Max = 100, Min = 0, Show = false } },
        Legend = new Legend { Show = true, Position = LegendPosition.Bottom },
        Stroke = new Stroke { Width = 2 },
        Fill = new Fill { Opacity = 0.4 }
    };
    
    public class RadarPoint
    {
        public string Category { get; set; } = "";
        public double Value { get; set; }
    }

    private List<RadarPoint> GetRadarPoints(Dictionary<string, double> radarData)
    {
        var categories = new[] { "Offense", "Defense", "Pace", "SOS", "Depth" };
        var points = new List<RadarPoint>();
        foreach (var cat in categories)
        {
            points.Add(new RadarPoint 
            { 
                Category = cat, 
                Value = radarData.ContainsKey(cat) ? radarData[cat] : 50 
            });
        }
        return points;
    }

    private string _apiBaseUrl = "http://backend:8000";

    protected override async Task OnInitializedAsync()
    {
        _apiBaseUrl = ServerConfig.GetBaseUrl();
        // Load ESPN BPI data in background
        await LoadEspnPredictions();
    }

    private async Task RunAnalysis()
    {
        if (_disposed) return;
        _isLoading = true;
        _error = null;
        _games.Clear();
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync(
                $"{_apiBaseUrl}/odds/ncaab/analyze-all?sportsbook={_selectedSportsbook}", 
                null);
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var doc = JsonDocument.Parse(json);
                var root = doc.RootElement;

                _source = root.TryGetProperty("source", out var src) ? src.GetString() ?? "" : "";
                _valueBets = root.TryGetProperty("value_bets_found", out var vb) ? vb.GetInt32() : 0;

                if (root.TryGetProperty("games", out var gamesArr))
                {
                    foreach (var g in gamesArr.EnumerateArray())
                    {
                        _games.Add(ParseGame(g));
                    }
                }
            }
            else
            {
                _error = $"API Error: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
            Logger.LogError(ex, "Error fetching NCAAB odds");
        }
        finally
        {
            _isLoading = false;
            if (!_disposed) StateHasChanged();
        }
    }
    
    private async Task LoadEspnPredictions()
    {
        _isEspnLoading = true;
        try
        {
            _espnData = await MLServiceClient.GetEspnPredictionsAsync("ncaab");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error loading ESPN predictions");
        }
        finally
        {
            _isEspnLoading = false;
        }
    }
    
    private EspnGame? MatchEspnGame(GameData game)
    {
        if (_espnData?.Games == null) return null;
        
        return _espnData.Games.FirstOrDefault(g => 
            (g.HomeTeam.Contains(game.HomeTeam, StringComparison.OrdinalIgnoreCase) || 
             game.HomeTeam.Contains(g.HomeTeam, StringComparison.OrdinalIgnoreCase)) &&
            (g.AwayTeam.Contains(game.AwayTeam, StringComparison.OrdinalIgnoreCase) || 
             game.AwayTeam.Contains(g.AwayTeam, StringComparison.OrdinalIgnoreCase))
        );
    }

    // Training State
    private bool _isTraining = false;
    private string? _trainingMessage;

    private async Task TrainNcaabModel()
    {
        _isTraining = true;
        _trainingMessage = "Training started in background...";
        try
        {
            await MLServiceClient.TrainNcaabModelAsync();
            Snackbar.Add("Training started! The model will be updated shortly.", Severity.Success);
            _trainingMessage = "Training triggered successfully.";
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Training failed: {ex.Message}", Severity.Error);
            _trainingMessage = "Training failed.";
        }
        finally
        {
            _isTraining = false;
        }
    }

    // Backtest State
    private bool _isBacktesting = false;
    private BacktestReport? _backtestReport;

    private async Task RunBacktest()
    {
        _isBacktesting = true;
        _backtestReport = null;
        try
        {
            _backtestReport = await MLServiceClient.BacktestNcaabAsync();
            if (_backtestReport != null)
            {
                Snackbar.Add($"Backtest Complete! ROI: {_backtestReport.RoiPercent}%", Severity.Success);
            }
            else
            {
                 Snackbar.Add("Backtest failed or returned no data.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Backtest Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isBacktesting = false;
        }
    }

    private GameData ParseGame(JsonElement g)
    {
        var game = new GameData
        {
            HomeTeam = g.TryGetProperty("home_team", out var h) ? h.GetString() ?? "" : "",
            AwayTeam = g.TryGetProperty("away_team", out var a) ? a.GetString() ?? "" : "",
            HasValue = g.TryGetProperty("has_value", out var hv) && hv.GetBoolean(),
        };

        if (g.TryGetProperty("home_moneyline", out var hml) && hml.ValueKind == JsonValueKind.Number)
            game.HomeMoneyline = (int)Math.Round(hml.GetDouble());
        if (g.TryGetProperty("away_moneyline", out var aml) && aml.ValueKind == JsonValueKind.Number)
            game.AwayMoneyline = (int)Math.Round(aml.GetDouble());
        if (g.TryGetProperty("spread", out var sp) && sp.ValueKind == JsonValueKind.Number)
            game.Spread = sp.GetDecimal();
        if (g.TryGetProperty("over_under", out var ou) && ou.ValueKind == JsonValueKind.Number)
            game.OverUnder = ou.GetDecimal();

        if (g.TryGetProperty("value_bets", out var vbArr) && vbArr.ValueKind == JsonValueKind.Array)
        {
            foreach (var vb in vbArr.EnumerateArray())
            {
                if (vb.GetString() is string s)
                    game.ValueBets.Add(s);
            }
        }

        if (g.TryGetProperty("prediction", out var pred) && pred.ValueKind == JsonValueKind.Object)
        {
            game.Prediction = new PredictionData
            {
                PredictedWinner = pred.TryGetProperty("predicted_winner", out var pw) ? pw.GetString() ?? "" : "",
                HomeWinProbability = pred.TryGetProperty("home_win_probability", out var hwp) ? hwp.GetDouble() : 0.5,
                PredictedTotal = pred.TryGetProperty("predicted_total", out var pt) ? pt.GetDouble() : 0,
                Confidence = pred.TryGetProperty("confidence", out var c) ? c.GetDouble() : 0.5,
                OuPick = pred.TryGetProperty("ou_pick", out var oup) ? oup.GetString() ?? "" : "",
                
                // V2 fields
                V2Available = pred.TryGetProperty("v2_available", out var v2a) && v2a.GetBoolean(),
                V2WinProb = pred.TryGetProperty("v2_win_prob", out var v2wp) ? v2wp.GetDouble() : 0,
                V2Total = pred.TryGetProperty("v2_total", out var v2t) ? v2t.GetDouble() : 0,
                V2Factors = new(),
                V2Radar = new RadarTeamComparison()
            };

            if (pred.TryGetProperty("v2_radar", out var radar) && radar.ValueKind == JsonValueKind.Object)
            {
                if (radar.TryGetProperty("home", out var hRadar) && hRadar.ValueKind == JsonValueKind.Object)
                {
                    foreach (var prop in hRadar.EnumerateObject())
                        game.Prediction.V2Radar.Home[prop.Name] = prop.Value.GetDouble();
                }
                if (radar.TryGetProperty("away", out var aRadar) && aRadar.ValueKind == JsonValueKind.Object)
                {
                    foreach (var prop in aRadar.EnumerateObject())
                        game.Prediction.V2Radar.Away[prop.Name] = prop.Value.GetDouble();
                }
            }

            if (pred.TryGetProperty("factors", out var fArray) && fArray.ValueKind == JsonValueKind.Array)
            {
                foreach (var f in fArray.EnumerateArray())
                {
                    game.Prediction.V2Factors.Add(new XgbFactor
                    {
                        Label = f.TryGetProperty("label", out var l) ? l.GetString() ?? "" : "",
                        Impact = f.TryGetProperty("impact", out var i) ? i.GetDouble() : 0,
                        Direction = f.TryGetProperty("direction", out var d) ? d.GetString() ?? "" : ""
                    });
                }
            }
            else if (pred.TryGetProperty("v2_factors", out var factors) && factors.ValueKind == JsonValueKind.Array)
            {
                foreach (var f in factors.EnumerateArray())
                {
                    game.Prediction.V2Factors.Add(new XgbFactor
                    {
                        Label = f.TryGetProperty("label", out var l) ? l.GetString() ?? "" : "",
                        Impact = f.TryGetProperty("impact", out var i) ? i.GetDouble() : 0
                    });
                }
            }
        }

        return game;
    }

    private string FormatOdds(int? odds) => odds switch
    {
        null => "-",
        > 0 => $"+{odds}",
        _ => odds.ToString() ?? "-"
    };

    private string GetCardStyle(GameData game) => game.HasValue
        ? "background: linear-gradient(135deg, #1b5e20 0%, #2e7d32 100%); color: white;"
        : "";

    private class GameData
    {
        public string HomeTeam { get; set; } = "";
        public string AwayTeam { get; set; } = "";
        public int? HomeMoneyline { get; set; }
        public int? AwayMoneyline { get; set; }
        public decimal? Spread { get; set; }
        public decimal? OverUnder { get; set; }
        public bool HasValue { get; set; }
        public List<string> ValueBets { get; set; } = new();
        public PredictionData? Prediction { get; set; }
        public AiAnalysisReport? GeminiAnalysis { get; set; }
        public bool IsAnalyzing { get; set; }
        public bool IsSaving { get; set; }
    }

    private class PredictionData
    {
        public string PredictedWinner { get; set; } = "";
        public double HomeWinProbability { get; set; }
        public double PredictedTotal { get; set; }
        public double Confidence { get; set; }
        public string OuPick { get; set; } = "";
        
        // XGBoost v2 fields
        public bool V2Available { get; set; }
        public double V2WinProb { get; set; }
        public double V2Total { get; set; }
        public List<XgbFactor> V2Factors { get; set; } = new();
        public RadarTeamComparison V2Radar { get; set; } = new();
    }

    private class RadarTeamComparison
    {
        public Dictionary<string, double> Home { get; set; } = new();
        public Dictionary<string, double> Away { get; set; } = new();
    }

    private class XgbFactor
    {
        public string Label { get; set; } = "";
        public double Impact { get; set; }
        public string Direction { get; set; } = "";
    }


    private async Task GetGeminiAnalysis(GameData game)
    {
        if (_disposed) return;
        game.IsAnalyzing = true;
        StateHasChanged();

        try
        {
            var result = await MLServiceClient.GetAiAnalysisAsync("ncaab", game.HomeTeam, game.AwayTeam);
            if (result != null)
            {
                game.GeminiAnalysis = result;
                Snackbar.Add($"Gemini insight loaded for {game.HomeTeam}", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gemini Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            game.IsAnalyzing = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task SaveAllToCache()
    {
        if (_disposed || !_games.Any()) return;

        _isSavingAll = true;
        StateHasChanged();
        
        int successCount = 0;

        try
        {
            // Save in parallel
            var tasks = _games.Select(async game => 
            {
                var analysisData = new Dictionary<string, object>
                {
                    ["consensus_winner"] = game.Prediction?.PredictedWinner ?? game.HomeTeam,
                    ["win_prob"] = game.Prediction?.HomeWinProbability ?? 0.5,
                    ["total_proj"] = game.Prediction?.PredictedTotal ?? 0,
                    ["v2_total"] = game.Prediction?.V2Total ?? 0,
                    ["spread"] = game.Spread ?? 0
                };

                // Snapshot current AI insight if available
                if (game.GeminiAnalysis?.LlmInsight != null)
                {
                    analysisData["ai_rationale"] = game.GeminiAnalysis.LlmInsight.Rationale;
                    analysisData["ai_key_factor"] = game.GeminiAnalysis.LlmInsight.KeyFactor;
                    analysisData["ai_confidence"] = game.GeminiAnalysis.LlmInsight.Confidence;
                    analysisData["ai_winner"] = game.GeminiAnalysis.LlmInsight.Winner;
                }

                if (await MLServiceClient.SaveAnalysisAsync("ncaab", game.HomeTeam, game.AwayTeam, analysisData))
                {
                    System.Threading.Interlocked.Increment(ref successCount);
                }
            });

            await Task.WhenAll(tasks);
            
            if (successCount == _games.Count)
                Snackbar.Add($"All {successCount} games saved to daily cache!", Severity.Success);
            else
                Snackbar.Add($"Saved {successCount}/{_games.Count} games to cache.", Severity.Warning);

        }
        catch (Exception ex)
        {
             Snackbar.Add($"Error saving snapshot: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSavingAll = false;
            if (!_disposed) StateHasChanged();
        }
    }
    
    public void Dispose()
    {
        _disposed = true;
    }
}
