@page "/ncaab-live-odds"
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ILogger<NCAABLiveOdds> Logger
@inject PythonMLServiceClient MLService
@rendermode InteractiveServer

<PageTitle>NCAAB Live Odds</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <div>
                    <MudText Typo="Typo.h4">
                        <MudIcon Icon="@Icons.Material.Filled.SportsBasketball" Class="mr-2" />
                        NCAAB Live Odds
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Men's College Basketball predictions with value detection
                    </MudText>
                </div>
                <MudStack Row="true" Spacing="2">
                    <MudSelect T="string" @bind-Value="_selectedSportsbook" Label="Sportsbook" 
                               Variant="Variant.Outlined" Dense="true" Style="width: 150px;">
                        <MudSelectItem Value="@("fanduel")">FanDuel</MudSelectItem>
                        <MudSelectItem Value="@("draftkings")">DraftKings</MudSelectItem>
                        <MudSelectItem Value="@("betmgm")">BetMGM</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="@RunAnalysis" Disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Analyzing...</span>
                        }
                        else
                        {
                            <span>Analyze Games</span>
                        }
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (_error != null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_error</MudAlert>
        }

        <ApiQuotaTracker />

        <!-- Summary Stats -->
        @if (_games.Any())
        {
            <MudPaper Class="pa-3" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body1">
                        <strong>@_games.Count</strong> games found · 
                        <strong>@_valueBets</strong> value bets detected
                    </MudText>
                    <MudChip T="string" Color="Color.Info" Size="Size.Small">@_source</MudChip>
                </MudStack>
            </MudPaper>
        }

        <MudDivider Class="my-4" />
        
        <MudText Typo="Typo.h6" Class="mb-2">Model Management</MudText>
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex align-center gap-4">
                <MudButton Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.ModelTraining" 
                           OnClick="TrainNcaabModel" Disabled="@_isTraining">
                    @if(_isTraining) {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="ms-2">Training...</MudText>
                    } else {
                        <MudText>Train XGBoost Model</MudText>
                    }
                </MudButton>
                @if(_trainingMessage != null)
                {
                    <MudText Color="Color.Info">@_trainingMessage</MudText>
                }
                
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.History" 
                           OnClick="RunBacktest" Disabled="@_isBacktesting">
                    @if(_isBacktesting) {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="ms-2">Running...</MudText>
                    } else {
                    }
                </MudButton>

                <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.CloudSync" 
                           OnClick="UpdateTorvikData" Disabled="@_isUpdatingTorvik">
                    @if(_isUpdatingTorvik) {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <MudText Class="ms-2">Updating...</MudText>
                    } else {
                        <MudText>Update Torvik Data</MudText>
                    }
                </MudButton>
            </div>
            
            @if(_backtestReport != null)
            {
                <MudCard Class="mt-4 pa-4" Elevation="3" Style="background: rgba(33, 150, 243, 0.05);">
                    <MudText Typo="Typo.h6">Backtest Results (Season 2023-24)</MudText>
                    <div class="d-flex flex-wrap gap-4 mt-2">
                        <MudPaper Class="pa-3 d-flex flex-column align-center" Width="120px">
                            <MudText Typo="Typo.caption">ROI</MudText>
                            <MudText Typo="Typo.h5" Color="@(_backtestReport.RoiPercent > 0 ? Color.Success : Color.Error)">
                                @_backtestReport.RoiPercent%
                            </MudText>
                        </MudPaper>
                        <MudPaper Class="pa-3 d-flex flex-column align-center" Width="120px">
                            <MudText Typo="Typo.caption">Units Won</MudText>
                            <MudText Typo="Typo.h5" Color="@(_backtestReport.UnitsWon > 0 ? Color.Success : Color.Error)">
                                @_backtestReport.UnitsWon
                            </MudText>
                        </MudPaper>
                        <MudPaper Class="pa-3 d-flex flex-column align-center" Width="120px">
                            <MudText Typo="Typo.caption">Hit Rate</MudText>
                            <MudText Typo="Typo.h5">@(_backtestReport.HitRate * 100)%</MudText>
                        </MudPaper>
                        <MudPaper Class="pa-3 d-flex flex-column align-center" Width="120px">
                            <MudText Typo="Typo.caption">Bets</MudText>
                            <MudText Typo="Typo.h5">@_backtestReport.BetsPlaced</MudText>
                        </MudPaper>
                    </div>
                </MudCard>
            }
        </MudPaper>

        <!-- Games Grid -->
        @if (_games.Any())
        {
            <MudGrid Spacing="3">
                @foreach (var game in _games)
                {
                    <MudItem xs="12" md="6" lg="4">
                        <MudCard Elevation="3" Class="h-100">
                            <MudCardHeader Style="@GetCardStyle(game)">
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">@game.AwayTeam</MudText>
                                    <MudText Typo="Typo.caption">at</MudText>
                                    <MudText Typo="Typo.h6">@game.HomeTeam</MudText>
                                </CardHeaderContent>
                                <CardHeaderActions>
                                    @if (game.HasValue)
                                    {
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small">VALUE</MudChip>
                                    }
                                </CardHeaderActions>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudSimpleTable Dense="true" Hover="true">
                                    <tbody>
                                        @if (game.HomeMoneyline.HasValue && game.AwayMoneyline.HasValue)
                                        {
                                            <tr>
                                                <td><strong>Moneyline</strong></td>
                                                <td>@FormatOdds(game.HomeMoneyline) / @FormatOdds(game.AwayMoneyline)</td>
                                            </tr>
                                        }
                                        @if (game.Spread.HasValue)
                                        {
                                            <tr>
                                                <td><strong>Spread</strong></td>
                                                <td>@game.Spread.Value.ToString("+0.0;-0.0")</td>
                                            </tr>
                                        }
                                        @if (game.OverUnder.HasValue)
                                        {
                                            <tr>
                                                <td><strong>O/U</strong></td>
                                                <td>@game.OverUnder.Value</td>
                                            </tr>
                                        }
                                        @if (game.Prediction != null)
                                        {
                                            <tr>
                                                <td><strong>Winner</strong></td>
                                                <td>@game.Prediction.PredictedWinner (@((game.Prediction.HomeWinProbability * 100).ToString("F0"))%)</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Predicted Total</strong></td>
                                                <td>@game.Prediction.PredictedTotal</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                                                                @* Model Predictions Section - Always Visible *@
                                    <div class="mt-3">
                                        @{
                                            var espnMatch = MatchEspnGame(game);
                                        }
                                        
                                        @* XGBoost Prediction (from analyze-all endpoint) *@
                                        @if (game.Prediction != null)
                                        {
                                            var hasXgb = game.Prediction.V2Available;
                                            var prob = hasXgb ? game.Prediction.V2WinProb : game.Prediction.HomeWinProbability;
                                            var total = hasXgb ? game.Prediction.V2Total : game.Prediction.PredictedTotal;
                                            
                                            <div class="mb-2 pa-2 rounded" style="background: rgba(81, 45, 168, 0.1); border-left: 3px solid #512da8;">
                                                <div class="d-flex justify-space-between align-center">
                                                    <MudText Typo="Typo.caption">
                                                        <strong>@(hasXgb ? "XGBoost Model v2" : "Baseline Model")</strong>
                                                        @if (!hasXgb) { <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" Class="ml-1" Title="Model not trained" /> }
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Color="@(prob > 0.5 ? Color.Success : Color.Error)">
                                                        <strong>@(prob > 0.5 ? game.HomeTeam : game.AwayTeam) @((prob > 0.5 ? prob : 1 - prob).ToString("P0"))</strong>
                                                    </MudText>
                                                </div>
                                                <MudProgressLinear Color="@(prob > 0.5 ? Color.Success : Color.Error)" Value="@((prob > 0.5 ? prob : 1 - prob) * 100)" Size="Size.Small" />
                                                <div class="d-flex justify-space-between mt-1">
                                                    <MudText Typo="Typo.caption">Total: @total.ToString("F1")</MudText>
                                                    @if (!hasXgb) { <MudText Typo="Typo.caption" Color="Color.Warning"><em>Retrain required for XGBoost</em></MudText> }
                                                </div>

                                                @* Rationale Factors *@
                                                @if (hasXgb && game.Prediction.V2Factors.Any())
                                                {
                                                    <div class="mt-2 pt-2" style="border-top: 1px solid rgba(255,255,255,0.1);">
                                                        <MudText Typo="Typo.caption" Class="d-block mb-1"><strong>Key Factors:</strong></MudText>
                                                        <div class="d-flex flex-wrap" style="gap: 4px;">
                                                            @foreach (var factor in game.Prediction.V2Factors)
                                                            {
                                                                var isPositive = factor.Impact > 0;
                                                                <MudTooltip Text="@($"Impact: {factor.Impact:F3}")">
                                                                    <MudChip T="string" Size="Size.Small" 
                                                                             Color="@(isPositive ? Color.Success : Color.Error)" 
                                                                             Variant="Variant.Filled"
                                                                             ValidationTooltip="false"
                                                                             Class="px-2 py-0">
                                                                        <MudText Typo="Typo.caption" Style="color: white; font-weight: 700;">
                                                                            @(isPositive ? "+" : "")@factor.Label
                                                                        </MudText>
                                                                    </MudChip>
                                                                </MudTooltip>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    
                                    @* ESPN BPI Prediction *@
                                    @if (espnMatch != null)
                                    {
                                        var homeProb = espnMatch.HomeWinProb;
                                        var awayProb = espnMatch.AwayWinProb;
                                        <div class="mb-2 pa-2 rounded" style="background: rgba(0, 123, 255, 0.08); border-left: 3px solid #2196f3;">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.caption"><strong>ESPN BPI</strong></MudText>
                                                <MudText Typo="Typo.caption" Color="@(homeProb > awayProb ? Color.Success : Color.Error)">
                                                    <strong>@(homeProb > awayProb ? game.HomeTeam : game.AwayTeam) @((homeProb > awayProb ? homeProb : awayProb).ToString("P0"))</strong>
                                                </MudText>
                                            </div>
                                            <MudProgressLinear Color="Color.Info" Value="@((homeProb > awayProb ? homeProb : awayProb) * 100)" Size="Size.Small" />
                                            @if (!string.IsNullOrEmpty(espnMatch.Spread) && espnMatch.Spread != "0")
                                            {
                                                <MudText Typo="Typo.caption" Class="mt-1">Spread: @espnMatch.Spread | O/U: @(espnMatch.OverUnder?.ToString("N1") ?? "-")</MudText>
                                            }
                                        </div>
                                    }
                                    else if (_isEspnLoading)
                                    {
                                        <div class="mb-2 pa-2 rounded" style="background: rgba(0, 123, 255, 0.05);">
                                            <MudText Typo="Typo.caption"><MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> Loading ESPN BPI...</MudText>
                                        </div>
                                    }

                                    @* Radar Chart (Archetype) *@
                                    @if (game.Prediction?.V2Radar != null && game.Prediction.V2Radar.Home.Any())
                                    {
                                        <MudExpansionPanels Elevation="0" Class="mt-2">
                                            <MudExpansionPanel Text="Archetype Radar" Style="background: rgba(255, 64, 129, 0.05); border: 1px dashed #ff4081;">
                                                <div style="height: 250px;">
                                                    <ApexChart TItem="RadarPoint"
                                                               Options="_radarOptions">

                                                        <ApexPointSeries TItem="RadarPoint"
                                                                          Items="GetRadarPoints(game.Prediction.V2Radar.Home)"
                                                                          Name="@game.HomeTeam"
                                                                          XValue="@(e => e.Category)"
                                                                          YValue="@(e => (decimal)e.Value)"
                                                                          SeriesType="SeriesType.Radar"
                                                                          Color="#00c853" />

                                                        <ApexPointSeries TItem="RadarPoint"
                                                                          Items="GetRadarPoints(game.Prediction.V2Radar.Away)"
                                                                          Name="@game.AwayTeam"
                                                                          XValue="@(e => e.Category)"
                                                                          YValue="@(e => (decimal)e.Value)"
                                                                          SeriesType="SeriesType.Radar"
                                                                          Color="#ff4081" />
                                                    </ApexChart>
                                                </div>
                                            </MudExpansionPanel>
                                        </MudExpansionPanels>
                                    }
                                </div>
                                
                                @if (game.ValueBets.Any())
                                {
                                    <MudDivider Class="my-2"/>
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        @foreach (var bet in game.ValueBets)
                                        {
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">@bet</MudChip>
                                        }
                                    </MudStack>
                                }

                                <MudDivider Class="my-2" />
                                <div class="mt-2">
                                    @if (game.GeminiAnalysis == null)
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.AutoFixHigh"
                                                   OnClick="@(() => GetGeminiAnalysis(game))" Disabled="@game.IsAnalyzing">
                                            @if (game.IsAnalyzing)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                                <span>Analyzing...</span>
                                            }
                                            else
                                            {
                                                <span>AI Rationale</span>
                                            }
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <div class="mt-2">
                                            @if (game.GeminiAnalysis.Engines != null && game.GeminiAnalysis.Engines.ContainsKey("XGBoost (ML)") 
                                                 && game.GeminiAnalysis.Engines["XGBoost (ML)"] is AiEnginePrediction xgb)
                                            {
                                                var prob = xgb.HomeWinProb;
                                                <div class="mb-2 pa-2 rounded" style="background: rgba(81, 45, 168, 0.1); border-left: 3px solid #512da8;">
                                                    <div class="d-flex justify-space-between align-center">
                                                        <MudText Typo="Typo.caption"><strong>XGBoost Win Prob:</strong></MudText>
                                                        <MudText Typo="Typo.caption" Color="@(prob > 0.5 ? Color.Success : Color.Error)"><strong>@prob.ToString("P0")</strong></MudText>
                                                    </div>
                                                    <MudProgressLinear Color="@(prob > 0.5 ? Color.Success : Color.Error)" Value="@(prob * 100)" Size="Size.Small" />
                                                    
                                                    @if (xgb.Explanation.HasValue)
                                                    {
                                                        var expl = xgb.Explanation.Value;
                                                        <MudText Typo="Typo.caption" Class="mt-1 d-block" Style="font-size: 0.7rem;">
                                                            Factors: @(string.Join(", ", expl.GetProperty("top_features").EnumerateArray().Take(3).Select(f => f.GetProperty("feature").GetString())))
                                                        </MudText>
                                                    }
                                                </div>
                                            }

                                            <MudPaper Class="pa-3 mt-2" Style="background: #fafafa; border: 1px solid #e0e0e0; border-radius: 8px;">
                                                <div class="d-flex align-center mb-2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" Color="Color.Secondary" Class="mr-2" />
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary"><strong>AI Rationale</strong></MudText>
                                                </div>
                                                <div style="font-family: 'Inter', 'Roboto', sans-serif; font-size: 0.85rem; line-height: 1.7; color: #37474f;">
                                                    @((MarkupString)(game.GeminiAnalysis.LlmInsight?.Rationale ?? ""))
                                                </div>
                                            </MudPaper>
                                        </div>
                                    }
                                </div>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
        else if (!_isLoading)
        {
            <MudAlert Severity="Severity.Info">
                No NCAAB games found for today. Click "Analyze Games" to fetch live odds.
            </MudAlert>
        }
    </MudStack>
</MudContainer>

@code {
    private bool _isLoading = false;
    private string? _error = null;
    private string _selectedSportsbook = "fanduel";
    private List<GameData> _games = new();
    private int _valueBets = 0;
    private string _source = "";
    
    // ESPN BPI State
    private EspnResponse? _espnData;
    private bool _isEspnLoading = false;
    private bool _isUpdatingTorvik = false;

    private async Task UpdateTorvikData()
    {
        _isUpdatingTorvik = true;
        try
        {
            var success = await MLService.UpdateTorvikDataAsync();
            if (success)
            {
                Snackbar.Add("Torvik data updated successfully! Please re-train the model.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to update Torvik data. Check backend logs.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUpdatingTorvik = false;
        }
    }
    
    private ApexChartOptions<RadarPoint> _radarOptions = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        PlotOptions = new PlotOptions { Radar = new PlotOptionsRadar { Polygons = new RadarPolygons { StrokeColors = "#333", ConnectorColors = "#333" } } },
        Yaxis = new List<YAxis> { new YAxis { Max = 100, Min = 0, Show = false } },
        Legend = new Legend { Show = true, Position = LegendPosition.Bottom }
    };
    
    public class RadarPoint
    {
        public string Category { get; set; } = "";
        public double Value { get; set; }
    }

    private List<RadarPoint> GetRadarPoints(Dictionary<string, double> radarData)
    {
        return radarData.Select(kvp => new RadarPoint { Category = kvp.Key, Value = kvp.Value }).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        // Load ESPN BPI and odds in parallel
        await Task.WhenAll(RunAnalysis(), LoadEspnPredictions());
    }

    private async Task RunAnalysis()
    {
        _isLoading = true;
        _error = null;
        _games.Clear();
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync(
                $"http://backend:8000/odds/ncaab/analyze-all?sportsbook={_selectedSportsbook}", 
                null);
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var doc = JsonDocument.Parse(json);
                var root = doc.RootElement;

                _source = root.TryGetProperty("source", out var src) ? src.GetString() ?? "" : "";
                _valueBets = root.TryGetProperty("value_bets_found", out var vb) ? vb.GetInt32() : 0;

                if (root.TryGetProperty("games", out var gamesArr))
                {
                    foreach (var g in gamesArr.EnumerateArray())
                    {
                        _games.Add(ParseGame(g));
                    }
                }
            }
            else
            {
                _error = $"API Error: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
            Logger.LogError(ex, "Error fetching NCAAB odds");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
    
    private async Task LoadEspnPredictions()
    {
        _isEspnLoading = true;
        try
        {
            _espnData = await MLServiceClient.GetEspnPredictionsAsync("ncaab");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error loading ESPN predictions");
        }
        finally
        {
            _isEspnLoading = false;
        }
    }
    
    private EspnGame? MatchEspnGame(GameData game)
    {
        if (_espnData?.Games == null) return null;
        
        return _espnData.Games.FirstOrDefault(g => 
            (g.HomeTeam.Contains(game.HomeTeam, StringComparison.OrdinalIgnoreCase) || 
             game.HomeTeam.Contains(g.HomeTeam, StringComparison.OrdinalIgnoreCase)) &&
            (g.AwayTeam.Contains(game.AwayTeam, StringComparison.OrdinalIgnoreCase) || 
             game.AwayTeam.Contains(g.AwayTeam, StringComparison.OrdinalIgnoreCase))
        );
    }

    // Training State
    private bool _isTraining = false;
    private string? _trainingMessage;

    private async Task TrainNcaabModel()
    {
        _isTraining = true;
        _trainingMessage = "Training started in background...";
        try
        {
            await MLServiceClient.TrainNcaabModelAsync();
            Snackbar.Add("Training started! The model will be updated shortly.", Severity.Success);
            _trainingMessage = "Training triggered successfully.";
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Training failed: {ex.Message}", Severity.Error);
            _trainingMessage = "Training failed.";
        }
        finally
        {
            _isTraining = false;
        }
    }

    // Backtest State
    private bool _isBacktesting = false;
    private BacktestReport? _backtestReport;

    private async Task RunBacktest()
    {
        _isBacktesting = true;
        _backtestReport = null;
        try
        {
            _backtestReport = await MLServiceClient.BacktestNcaabAsync();
            if (_backtestReport != null)
            {
                Snackbar.Add($"Backtest Complete! ROI: {_backtestReport.RoiPercent}%", Severity.Success);
            }
            else
            {
                 Snackbar.Add("Backtest failed or returned no data.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Backtest Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isBacktesting = false;
        }
    }

    private GameData ParseGame(JsonElement g)
    {
        var game = new GameData
        {
            HomeTeam = g.TryGetProperty("home_team", out var h) ? h.GetString() ?? "" : "",
            AwayTeam = g.TryGetProperty("away_team", out var a) ? a.GetString() ?? "" : "",
            HasValue = g.TryGetProperty("has_value", out var hv) && hv.GetBoolean(),
        };

        if (g.TryGetProperty("home_moneyline", out var hml) && hml.ValueKind == JsonValueKind.Number)
            game.HomeMoneyline = (int)Math.Round(hml.GetDouble());
        if (g.TryGetProperty("away_moneyline", out var aml) && aml.ValueKind == JsonValueKind.Number)
            game.AwayMoneyline = (int)Math.Round(aml.GetDouble());
        if (g.TryGetProperty("spread", out var sp) && sp.ValueKind == JsonValueKind.Number)
            game.Spread = sp.GetDecimal();
        if (g.TryGetProperty("over_under", out var ou) && ou.ValueKind == JsonValueKind.Number)
            game.OverUnder = ou.GetDecimal();

        if (g.TryGetProperty("value_bets", out var vbArr) && vbArr.ValueKind == JsonValueKind.Array)
        {
            foreach (var vb in vbArr.EnumerateArray())
            {
                if (vb.GetString() is string s)
                    game.ValueBets.Add(s);
            }
        }

        if (g.TryGetProperty("prediction", out var pred) && pred.ValueKind == JsonValueKind.Object)
        {
            game.Prediction = new PredictionData
            {
                PredictedWinner = pred.TryGetProperty("predicted_winner", out var pw) ? pw.GetString() ?? "" : "",
                HomeWinProbability = pred.TryGetProperty("home_win_probability", out var hwp) ? hwp.GetDouble() : 0.5,
                PredictedTotal = pred.TryGetProperty("predicted_total", out var pt) ? pt.GetDouble() : 0,
                Confidence = pred.TryGetProperty("confidence", out var c) ? c.GetDouble() : 0.5,
                
                // V2 fields
                V2Available = pred.TryGetProperty("v2_available", out var v2a) && v2a.GetBoolean(),
                V2WinProb = pred.TryGetProperty("v2_win_prob", out var v2wp) ? v2wp.GetDouble() : 0,
                V2Total = pred.TryGetProperty("v2_total", out var v2t) ? v2t.GetDouble() : 0,
                V2Factors = new(),
                V2Radar = new RadarTeamComparison()
            };

            if (pred.TryGetProperty("v2_radar", out var radar) && radar.ValueKind == JsonValueKind.Object)
            {
                if (radar.TryGetProperty("home", out var hRadar) && hRadar.ValueKind == JsonValueKind.Object)
                {
                    foreach (var prop in hRadar.EnumerateObject())
                        game.Prediction.V2Radar.Home[prop.Name] = prop.Value.GetDouble();
                }
                if (radar.TryGetProperty("away", out var aRadar) && aRadar.ValueKind == JsonValueKind.Object)
                {
                    foreach (var prop in aRadar.EnumerateObject())
                        game.Prediction.V2Radar.Away[prop.Name] = prop.Value.GetDouble();
                }
            }

            if (pred.TryGetProperty("v2_factors", out var factors) && factors.ValueKind == JsonValueKind.Array)
            {
                foreach (var f in factors.EnumerateArray())
                {
                    game.Prediction.V2Factors.Add(new XgbFactor
                    {
                        Label = f.TryGetProperty("label", out var l) ? l.GetString() ?? "" : "",
                        Impact = f.TryGetProperty("impact", out var i) ? i.GetDouble() : 0
                    });
                }
            }
        }

        return game;
    }

    private string FormatOdds(int? odds) => odds switch
    {
        null => "-",
        > 0 => $"+{odds}",
        _ => odds.ToString() ?? "-"
    };

    private string GetCardStyle(GameData game) => game.HasValue
        ? "background: linear-gradient(135deg, #1b5e20 0%, #2e7d32 100%); color: white;"
        : "";

    private class GameData
    {
        public string HomeTeam { get; set; } = "";
        public string AwayTeam { get; set; } = "";
        public int? HomeMoneyline { get; set; }
        public int? AwayMoneyline { get; set; }
        public decimal? Spread { get; set; }
        public decimal? OverUnder { get; set; }
        public bool HasValue { get; set; }
        public List<string> ValueBets { get; set; } = new();
        public PredictionData? Prediction { get; set; }
        public AiAnalysisReport? GeminiAnalysis { get; set; }
        public bool IsAnalyzing { get; set; }
    }

    private class PredictionData
    {
        public string PredictedWinner { get; set; } = "";
        public double HomeWinProbability { get; set; }
        public double PredictedTotal { get; set; }
        public double Confidence { get; set; }
        
        // XGBoost v2 fields
        public bool V2Available { get; set; }
        public double V2WinProb { get; set; }
        public double V2Total { get; set; }
        public List<XgbFactor> V2Factors { get; set; } = new();
        public RadarTeamComparison V2Radar { get; set; } = new();
    }

    private class RadarTeamComparison
    {
        public Dictionary<string, double> Home { get; set; } = new();
        public Dictionary<string, double> Away { get; set; } = new();
    }

    private class XgbFactor
    {
        public string Label { get; set; } = "";
        public double Impact { get; set; }
    }

    [Inject] private PythonMLServiceClient MLServiceClient { get; set; } = default!;

    private async Task GetGeminiAnalysis(GameData game)
    {
        game.IsAnalyzing = true;
        StateHasChanged();

        try
        {
            var result = await MLServiceClient.GetAiAnalysisAsync("ncaab", game.HomeTeam, game.AwayTeam);
            if (result != null)
            {
                game.GeminiAnalysis = result;
                Snackbar.Add($"Gemini insight loaded for {game.HomeTeam}", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gemini Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            game.IsAnalyzing = false;
            StateHasChanged();
        }
    }
}
