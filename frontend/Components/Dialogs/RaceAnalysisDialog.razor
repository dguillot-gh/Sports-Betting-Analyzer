@using MudBlazor
@using SportsBettingAnalyzer.Components.Shared.Tailwind

<MudDialog>
    <DialogContent>
        <div class="p-2">
            <h3 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-3">AI Race Report</h3>
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 text-sm text-slate-300 leading-relaxed font-mono whitespace-pre-wrap max-h-[60vh] overflow-y-auto custom-scrollbar">
                @AnalysisText
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="px-6 pb-6">
            <TwButton Variant="primary" OnClick="Close">Dismiss Report</TwButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public string AnalysisText { get; set; } = "";

    private void Close() => MudDialog?.Cancel();
}
