@using MudBlazor
@using System.Text.RegularExpressions
@using SportsBettingAnalyzer.Models
@using SportsBettingAnalyzer.Components.Shared.Tailwind

<MudDialog>
    <DialogContent>
        <div class="space-y-4 py-2">
            <p class="text-sm text-slate-300">
                Enter odds manually. Format: <span class="font-bold text-white">Driver Name +Odds</span> (one per line).
                <br />
                <span class="text-[10px] text-slate-500 italic">Example: Kyle Larson +500</span>
            </p>
            
            <div class="flex flex-col gap-1">
                <label class="text-xs font-medium text-slate-400 uppercase tracking-wider">Paste Odds Here</label>
                <textarea class="w-full h-48 bg-slate-900 border border-slate-800 rounded-lg p-3 text-sm text-white focus:ring-1 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all placeholder:text-slate-600"
                          placeholder="Kyle Larson +500&#10;Ryan Blaney +600&#10;..."
                          @bind="_rawText" @bind:event="oninput" @onkeyup="OnKeyUp"></textarea>
            </div>
            
            @if (_previewDrivers.Any())
            {
                <div class="space-y-2">
                    <p class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Found @_previewDrivers.Count drivers:</p>
                    <div class="flex flex-wrap gap-1">
                        @foreach(var d in _previewDrivers.Take(10))
                        {
                            <TwChip Color="slate" Size="xs" Variant="outline">@d.DriverName (@d.MarketOdds)</TwChip>
                        }
                        @if(_previewDrivers.Count > 10) { <span class="text-[10px] text-slate-500 py-1">...+@(_previewDrivers.Count-10) more</span> }
                    </div>
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="flex items-center gap-3 p-4">
            <TwButton Variant="outline" OnClick="Cancel">Cancel</TwButton>
            <TwButton Variant="primary" OnClick="Submit" Disabled="@(!_previewDrivers.Any())">Add Odds</TwButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }

    private string _rawText = "";
    private List<DriverPrediction> _previewDrivers = new();

    private void OnKeyUp()
    {
        ParseText(_rawText);
    }

    private void ParseText(string text)
    {
        _previewDrivers.Clear();
        if (string.IsNullOrWhiteSpace(text)) return;

        var lines = text.Split('\n');
        foreach (var line in lines)
        {
            var clean = line.Trim();
            if (string.IsNullOrEmpty(clean)) continue;

            // Regex: Last token is number (optionally signed), rest is name
            var match = Regex.Match(clean, @"^(.*?)(\s+[\+\-]?\d+)$");
            if (match.Success)
            {
                var name = match.Groups[1].Value.Trim();
                var odds = match.Groups[2].Value.Trim();
                
                // Remove common junk like "Odds" if pasted
                name = name.Replace("Odds", "").Trim();

                if (!string.IsNullOrEmpty(name))
                {
                    _previewDrivers.Add(new DriverPrediction 
                    { 
                        DriverName = name, 
                        MarketOdds = odds,
                        Confidence = "Manual"
                    });
                }
            }
        }
    }

    private void Submit()
    {
        MudDialog?.Close(DialogResult.Ok(_previewDrivers));
    }

    private void Cancel() => MudDialog?.Cancel();
}
