@using MudBlazor
@using System.Text.RegularExpressions
@using SportsBettingAnalyzer.Models

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-4">
            Enter odds manually. Format: <b>Driver Name +Odds</b> (one per line).
            <br />
            <i>Example: Kyle Larson +500</i>
        </MudText>
        <MudTextField T="string" Label="Paste Odds Here" Variant="Variant.Outlined" Lines="10" 
                      TextChanged="TextChanged" Immediate="true"
                      Placeholder="Kyle Larson +500&#10;Ryan Blaney +600&#10;..." />
        
        @if (_previewDrivers.Any())
        {
            <MudText Class="mt-4" Color="Color.Success">Found @_previewDrivers.Count drivers:</MudText>
            <MudChipSet T="string" ReadOnly="true" Class="mt-2">
                @foreach(var d in _previewDrivers.Take(5))
                {
                    <MudChip T="string" Size="Size.Small">@d.DriverName (@d.MarketOdds)</MudChip>
                }
                @if(_previewDrivers.Count > 5) { <MudChip T="string" Size="Size.Small">...+@(_previewDrivers.Count-5) more</MudChip> }
            </MudChipSet>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!_previewDrivers.Any())">Add Odds</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance? MudDialog { get; set; }

    private string _rawText = "";
    private List<DriverPrediction> _previewDrivers = new();

    private void TextChanged(string val)
    {
        _rawText = val;
        ParseText(val);
    }

    private void ParseText(string text)
    {
        _previewDrivers.Clear();
        if (string.IsNullOrWhiteSpace(text)) return;

        var lines = text.Split('\n');
        foreach (var line in lines)
        {
            var clean = line.Trim();
            if (string.IsNullOrEmpty(clean)) continue;

            // Regex: Last token is number (optionally signed), rest is name
            var match = Regex.Match(clean, @"^(.*?)(\s+[\+\-]?\d+)$");
            if (match.Success)
            {
                var name = match.Groups[1].Value.Trim();
                var odds = match.Groups[2].Value.Trim();
                
                // Remove common junk like "Odds" if pasted
                name = name.Replace("Odds", "").Trim();

                if (!string.IsNullOrEmpty(name))
                {
                    _previewDrivers.Add(new DriverPrediction 
                    { 
                        DriverName = name, 
                        MarketOdds = odds,
                        Confidence = "Manual"
                    });
                }
            }
        }
    }

    private void Submit()
    {
        MudDialog?.Close(DialogResult.Ok(_previewDrivers));
    }

    private void Cancel() => MudDialog?.Cancel();
}
