# ============================================
# Sports Betting Analyzer - Environment Variables
# ============================================
# Copy this file to .env and fill in your API keys
# NEVER commit the .env file to git!

# Google Gemini AI (get key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# The Odds API (get key from https://the-odds-api.com)
ODDS_API_KEY=your_odds_api_key_here

# College Football Data (get key from https://collegefootballdata.com/key)
CFBD_API_KEY=your_college_football_data_api_key_here

# Groq AI - Optional, faster LLM (get key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/sports_betting

