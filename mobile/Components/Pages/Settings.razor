@page "/settings"
@using SportsBettingAnalyzer.Shared.Services
@inject IServerConfigService ConfigService

<div class="p-6 max-w-md mx-auto bg-white rounded-xl shadow-md mt-4">
    <h2 class="text-xl font-bold mb-4 text-gray-800">App Settings</h2>

    <div class="mb-4">
        <label class="block text-gray-700 text-sm font-bold mb-2" for="serverUrl">
            Python Backend URL
        </label>
        <input class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" 
               id="serverUrl" 
               type="text" 
               @bind="serverUrl" 
               placeholder="e.g. http://192.168.1.50:8003" />
        <p class="text-xs text-gray-500 mt-1">Include http:// and port number.</p>
    </div>

    <button class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline w-full" 
            @onclick="SaveSettings">
        Save Configuration
    </button>

    @if (showSuccessMessage)
    {
        <div class="mt-4 p-3 bg-green-100 border border-green-400 text-green-700 rounded text-sm text-center">
            Settings saved successfully! Restart app to apply backend changes everywhere.
        </div>
    }
</div>

@code {
    private string serverUrl = "";
    private bool showSuccessMessage = false;

    protected override void OnInitialized()
    {
        serverUrl = ConfigService.GetBaseUrl();
    }

    private async Task SaveSettings()
    {
        ConfigService.SetBaseUrl(serverUrl);
        showSuccessMessage = true;
        
        // Hide message after 3 seconds
        await Task.Delay(3000);
        showSuccessMessage = false;
        StateHasChanged();
    }
}
