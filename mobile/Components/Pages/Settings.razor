@page "/settings"
@using SportsBettingAnalyzer.Shared.Services
@using SportsBettingAnalyzer.Shared.Models
@using SportsBettingAnalyzer.Mobile.Models
@using System.Net.Http.Json
@inject IServerConfigService ConfigService
@inject IAppSettingsService AppSettings
@inject NavigationManager Nav

<div class="app-card settings-card">
    <div class="app-card-header">
        <h2>&#9881; Settings</h2>
        <p>App configuration and preferences</p>
    </div>

    <div class="app-card-body">
        <!-- Backend Selection -->
        <div class="settings-section">
            <h3 class="settings-title">📡 Backend Connection</h3>
            <div class="settings-field">
                <label class="app-label" for="serverUrl">Python Backend URL</label>
                <input class="app-input"
                       id="serverUrl"
                       type="text"
                       @bind="serverUrl"
                       placeholder="e.g. http://192.168.1.50:8003" />
                <p class="settings-hint">Include http:// and port number. Use 10.0.2.2 for Android emulator.</p>
            </div>
        </div>

        <hr class="settings-divider" />

        <!-- Navigation Customization -->
        <div class="settings-section">
            <h3 class="settings-title">📱 Bottom Navigation</h3>
            <p class="settings-hint mb-3">Select up to 5 items to show on your mobile bottom bar.</p>
            
            <div class="nav-picker">
                @foreach (var available in _allAvailable)
                {
                    var isSelected = _selectedItems.Any(i => i.Url == available.Url);
                    <div class="nav-picker-item @(isSelected ? "selected" : "")" @onclick="() => ToggleItem(available)">
                        <span class="picker-icon">@available.Icon</span>
                        <span class="picker-label">@available.Label</span>
                        @if (isSelected)
                        {
                            <span class="picker-check">✓</span>
                        }
                    </div>
                }
            </div>
            
            @if (_selectedItems.Count >= 5)
            {
                <p class="limit-warning">⚠️ Maximum of 5 items reached.</p>
            }
        </div>

        <button class="app-btn app-btn-primary mt-4" @onclick="SaveSettings" style="width: 100%;">
            Save All Settings
        </button>

        @if (showSuccessMessage)
        {
            <div class="app-alert app-alert-success mt-3">
                &#10003; Settings saved!
            </div>
        }
    </div>
</div>

<!-- Version Information Section -->
<div class="app-card settings-card mt-4">
    <div class="app-card-header">
        <h2>&#128128; App Version</h2>
        <p>Current deployment and version information</p>
    </div>

    <div class="app-card-body">
        @if (versionInfo != null)
        {
            <div class="version-grid">
                <div class="version-item">
                    <div class="version-label">Version</div>
                    <div class="version-value">@versionInfo.Version</div>
                </div>
                <div class="version-item">
                    <div class="version-label">Environment</div>
                    <div class="version-value">@versionInfo.Environment</div>
                </div>
                <div class="version-item">
                    <div class="version-label">Git SHA</div>
                    <div class="version-value small">@(versionInfo.GitSha.Length > 8 ? versionInfo.GitSha.Substring(0, 8) : versionInfo.GitSha)</div>
                </div>
                <div class="version-item">
                    <div class="version-label">Build Time</div>
                    <div class="version-value small">@versionInfo.BuildTime</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(versionInfo.DeploymentId))
            {
                <div class="deployment-id">
                    <div class="version-label">Deployment ID</div>
                    <div class="version-value small">@versionInfo.DeploymentId</div>
                </div>
            }

            @if (versionInfo.Components.Any())
            {
                <div class="components-section">
                    <div class="version-label">Components</div>
                    @foreach (var component in versionInfo.Components)
                    {
                        <div class="component-item">
                            <div class="flex items-center gap-2">
                                <div class="status-dot @(component.Status == "success" || component.Status == "running" ? "success" : "warning")"></div>
                                <span class="component-name">@component.ComponentName</span>
                            </div>
                            <div class="component-version">@component.ComponentVersion</div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="loading-version">
                <div class="loading-spinner"></div>
                <span>Loading version information...</span>
            </div>
        }
    </div>
</div>

<style>
    .settings-section { margin-bottom: 24px; }
    .settings-title { font-size: 16px; font-weight: 800; margin-bottom: 16px; color: var(--text-primary); }
    .settings-divider { border: 0; border-top: 1px solid var(--border-light); margin: 24px 0; }
    .nav-picker { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 10px; }
    
    .nav-picker-item { 
        background: var(--surface-raised); 
        border: 1px solid var(--border); 
        border-radius: 8px; 
        padding: 12px 8px; 
        display: flex; 
        flex-direction: column; 
        align-items: center; 
        cursor: pointer;
        position: relative;
        transition: all 0.2s;
    }
    
    .nav-picker-item.selected { 
        border-color: #60a5fa; 
        background: rgba(96, 165, 250, 0.1); 
    }
    
    .picker-icon { font-size: 24px; margin-bottom: 4px; }
    .picker-label { font-size: 11px; font-weight: 700; color: var(--text-secondary); text-align: center; }
    .picker-check { position: absolute; top: 4px; right: 4px; color: #60a5fa; font-weight: 900; font-size: 12px; }
    
    .limit-warning { font-size: 11px; color: var(--danger); font-weight: 700; margin-top: 12px; }
    
    .mt-4 { margin-top: 24px; }
    .mb-3 { margin-bottom: 12px; }
    
    /* Version Information Styles */
    .version-grid { 
        display: grid; 
        grid-template-columns: 1fr 1fr; 
        gap: 12px; 
        margin-bottom: 16px; 
    }
    
    .version-item { 
        background: var(--surface-raised); 
        border: 1px solid var(--border); 
        border-radius: 8px; 
        padding: 12px; 
        text-align: center; 
    }
    
    .version-label { 
        font-size: 11px; 
        font-weight: 700; 
        color: var(--text-secondary); 
        margin-bottom: 4px; 
        text-transform: uppercase; 
    }
    
    .version-value { 
        font-size: 14px; 
        font-weight: 700; 
        color: var(--text-primary); 
        font-family: monospace; 
    }
    
    .version-value.small { 
        font-size: 11px; 
        word-break: break-all; 
    }
    
    .deployment-id { 
        background: var(--surface-raised); 
        border: 1px solid var(--border); 
        border-radius: 8px; 
        padding: 12px; 
        margin-bottom: 16px; 
        text-align: center; 
    }
    
    .components-section { 
        background: var(--surface-raised); 
        border: 1px solid var(--border); 
        border-radius: 8px; 
        padding: 12px; 
    }
    
    .component-item { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        padding: 8px 0; 
        border-bottom: 1px solid var(--border-light); 
    }
    
    .component-item:last-child { 
        border-bottom: none; 
    }
    
    .status-dot { 
        width: 8px; 
        height: 8px; 
        border-radius: 50%; 
        display: inline-block; 
    }
    
    .status-dot.success { 
        background: #10b981; 
    }
    
    .status-dot.warning { 
        background: #f59e0b; 
    }
    
    .component-name { 
        font-weight: 700; 
        color: var(--text-primary); 
        font-size: 13px; 
    }
    
    .component-version { 
        font-family: monospace; 
        font-size: 11px; 
        color: var(--text-secondary); 
    }
    
    .loading-version { 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        gap: 8px; 
        padding: 20px; 
        color: var(--text-secondary); 
    }
    
    .loading-spinner { 
        width: 16px; 
        height: 16px; 
        border: 2px solid var(--border-light); 
        border-top: 2px solid var(--primary); 
        border-radius: 50%; 
        animation: spin 1s linear infinite; 
    }
    
    @@keyframes spin { 
        0% { transform: rotate(0deg); } 
        100% { transform: rotate(360deg); } 
    }
    
    .flex { display: flex; }
    .items-center { align-items: center; }
    .gap-2 { gap: 8px; }
</style>

@code {
    private string serverUrl = "";
    private bool showSuccessMessage = false;
    private List<NavItem> _allAvailable = new();
    private List<NavItem> _selectedItems = new();
    private DeploymentVersionInfo? versionInfo;
    private bool isLoadingVersion = true;

    protected override async Task OnInitializedAsync()
    {
        serverUrl = ConfigService.GetBaseUrl();
        _allAvailable = AppSettings.GetAvailableNavItems();
        _selectedItems = await AppSettings.GetBottomNavItemsAsync();
        
        // Load version information
        await LoadVersionInfo();
        
        // Ensure menu toggle is always at least available internally even if not in _allAvailable list
        // (For now I added it to the default but not to the 'available' picker to keep it clean)
    }

    private async Task LoadVersionInfo()
    {
        try
        {
            isLoadingVersion = true;
            StateHasChanged();
            
            // Create HTTP client to call backend
            using var httpClient = new HttpClient();
            httpClient.BaseAddress = new Uri(ConfigService.GetBaseUrl());
            httpClient.Timeout = TimeSpan.FromSeconds(10);
            
            var response = await httpClient.GetFromJsonAsync<DeploymentVersionInfo>("/deployments/current");
            versionInfo = response;
        }
        catch (Exception ex)
        {
            // Handle error gracefully - show default info
            versionInfo = new DeploymentVersionInfo 
            { 
                Version = "unknown",
                Environment = "offline",
                GitSha = "unknown",
                BuildTime = DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ssZ"),
                Components = new List<DeploymentComponent>
                {
                    new DeploymentComponent 
                    { 
                        ComponentName = "mobile", 
                        ComponentVersion = "1.0.0", 
                        Status = "offline" 
                    }
                }
            };
        }
        finally
        {
            isLoadingVersion = false;
            StateHasChanged();
        }
    }

    private void ToggleItem(NavItem item)
    {
        var existing = _selectedItems.FirstOrDefault(i => i.Url == item.Url);
        if (existing != null)
        {
            _selectedItems.Remove(existing);
        }
        else if (_selectedItems.Count < 5)
        {
            _selectedItems.Add(item);
        }
    }

    private async Task SaveSettings()
    {
        ConfigService.SetBaseUrl(serverUrl);
        
        // Ensure we preserve the "Menu" toggle if it was there but not in picker
        // Or better yet, just let the user pick it too if they want.
        // For simplicity, we'll just save what they selected.
        await AppSettings.SaveBottomNavItemsAsync(_selectedItems);
        
        showSuccessMessage = true;
        StateHasChanged();

        await Task.Delay(2000);
        showSuccessMessage = false;
        
        // Immediate reload to apply Nav changes
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }
}
