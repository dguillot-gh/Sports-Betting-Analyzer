@code {
    private string _todayLabel = DateTime.Now.ToString("dddd, MMMM d");
    private int _totalGames = 0;
    private int _liveGames = 0;
    private int _finalGames = 0;
    private int _upcomingGames = 0;
    private int _sportCount = 0;
    private bool _isHealthy = false;
    private int _unreadNotifications = 0;
    private List<FreshnessItem> _freshness = new();
    
    private List<ProfitPoint> _profitData = new();
    private decimal _sparklineRoi = 0m;
    private ApexCharts.ApexChartOptions<ProfitPoint> _sparklineOptions = new();

    // 60-second static cache to prevent API spam on mobile tab switching
    private static DateTime _lastLoadTime = DateTime.MinValue;
    private static int _cachedTotalGames = 0;
    private static int _cachedLiveGames = 0;
    private static int _cachedFinalGames = 0;
    private static int _cachedUpcomingGames = 0;
    private static int _cachedSportCount = 0;
    private static bool _cachedIsHealthy = false;
    private static int _cachedUnreadNotifications = 0;
    private static List<FreshnessItem> _cachedFreshness = new();
    private static List<ProfitPoint> _cachedProfitData = new();
    private static decimal _cachedSparklineRoi = 0m;

    protected override async Task OnInitializedAsync()
    {
        if (DateTime.Now - _lastLoadTime < TimeSpan.FromSeconds(60))
        {
            _totalGames = _cachedTotalGames;
            _liveGames = _cachedLiveGames;
            _finalGames = _cachedFinalGames;
            _upcomingGames = _cachedUpcomingGames;
            _sportCount = _cachedSportCount;
            _isHealthy = _cachedIsHealthy;
            _unreadNotifications = _cachedUnreadNotifications;
            _freshness = _cachedFreshness;
            _profitData = new List<ProfitPoint>(_cachedProfitData);
            _sparklineRoi = _cachedSparklineRoi;
            InitializeSparklineOptions();
            return;
        }

        await Task.WhenAll(LoadGameCounts(), CheckHealth(), LoadFreshness(), LoadUnreadNotifications());

        _cachedTotalGames = _totalGames;
        _cachedLiveGames = _liveGames;
        _cachedFinalGames = _finalGames;
        _cachedUpcomingGames = _upcomingGames;
        _cachedSportCount = _sportCount;
        _cachedIsHealthy = _isHealthy;
        _cachedUnreadNotifications = _unreadNotifications;
        _cachedFreshness = _freshness;
        
        await LoadSparklineData();
        
        _cachedProfitData = new List<ProfitPoint>(_profitData);
        _cachedSparklineRoi = _sparklineRoi;
        _lastLoadTime = DateTime.Now;
    }

    private async Task LoadSparklineData()
    {
        if (_profitData.Any()) return;
        
        try
        {
            var baseUrl = ServerConfig.GetBaseUrl();
            var resp = await Http.GetFromJsonAsync<JsonElement>($"{baseUrl}/bets/stats/chart-data?days=7");
            if (resp.TryGetProperty("daily_data", out var daily))
            {
                foreach (var d in daily.EnumerateArray())
                {
                    var dateStr = d.GetProperty("date").GetString() ?? "";
                    if (DateTime.TryParse(dateStr, out var dt))
                    {
                        var profit = (decimal)d.GetProperty("cumulative_profit").GetDouble();
                        _profitData.Add(new ProfitPoint { Date = dt.ToString("MMM dd"), Amount = profit });
                    }
                }
            }
            if (resp.TryGetProperty("summary", out var summary) && summary.TryGetProperty("roi", out var roiProp))
            {
                _sparklineRoi = (decimal)roiProp.GetDouble();
            }
        }
        catch { }
        InitializeSparklineOptions();
    }

    private void InitializeSparklineOptions()
    {
        _sparklineOptions = new ApexCharts.ApexChartOptions<ProfitPoint>
        {
            Chart = new ApexCharts.Chart
            {
                Type = ApexCharts.ChartType.Area,
                Sparkline = new ApexCharts.ChartSparkline { Enabled = true },
                Toolbar = new ApexCharts.Toolbar { Show = false },
                Background = "transparent",
                Animations = new ApexCharts.Animations { Enabled = false }
            },
            Theme = new ApexCharts.Theme { Mode = ApexCharts.Mode.Dark },
            Stroke = new ApexCharts.Stroke { Curve = ApexCharts.Curve.Smooth, Width = 2 },
            Colors = new List<string> { "#10b981" },
            Fill = new ApexCharts.Fill { Opacity = 0.2 },
            Tooltip = new ApexCharts.Tooltip { Fixed = new ApexCharts.TooltipFixed { Enabled = false }, X = new ApexCharts.TooltipX { Show = false } }
        };
    }

    public class ProfitPoint { public string Date { get; set; } = ""; public decimal Amount { get; set; } }

    private async Task LoadFreshness()
    {
        try
        {
            var baseUrl = ServerConfig.GetBaseUrl();
            var items = await Http.GetFromJsonAsync<List<FreshnessItem>>($"{baseUrl}/admin/data-freshness");
            if (items != null) _freshness = items;
        }
        catch { }
    }

    private async Task LoadUnreadNotifications()
    {
        try
        {
            var baseUrl = ServerConfig.GetBaseUrl();
            var countResponse = await Http.GetFromJsonAsync<UnreadCount>($"{baseUrl}/admin/notifications/unread-count");
            _unreadNotifications = countResponse?.Count ?? 0;
        }
        catch
        {
            _unreadNotifications = 0;
        }
    }

    private class FreshnessItem
    {
        [JsonPropertyName("sport")]               public string Sport           { get; set; } = "";
        [JsonPropertyName("total_records")]        public long   TotalRecords    { get; set; }
        [JsonPropertyName("freshness_status")]     public string FreshnessStatus { get; set; } = "never";
    }

    private class UnreadCount
    {
        [JsonPropertyName("count")] public int Count { get; set; }
    }
    
    private async Task CheckHealth()
    {
        try
        {
            var baseUrl = ServerConfig.GetBaseUrl();
            var response = await Http.GetAsync($"{baseUrl}/health");
            _isHealthy = response.IsSuccessStatusCode;
        }
        catch { _isHealthy = false; }
    }

    private async Task LoadGameCounts()
    {
        try
        {
            var baseUrl = ServerConfig.GetBaseUrl();
            var sports = new[] { "nba", "nfl", "nhl", "ncaab" };
            int total = 0, live = 0, final_ = 0, upcoming = 0, sportsWith = 0;

            var tasks = sports.Select(async sport =>
            {
                try
                {
                    var json = await Http.GetStringAsync($"{baseUrl}/espn/{sport}");
                    using var doc = JsonDocument.Parse(json);
                    if (doc.RootElement.TryGetProperty("games", out var games))
                    {
                        var count = games.GetArrayLength();
                        if (count == 0) return (0, 0, 0, 0);
                        int l = 0, f = 0, u = 0;
                        foreach (var g in games.EnumerateArray())
                        {
                            var status = g.TryGetProperty("status", out var st) ? st.GetString() ?? "" : "";
                            if (status.Contains("Final", StringComparison.OrdinalIgnoreCase) || status.Contains("Postponed", StringComparison.OrdinalIgnoreCase))
                                f++;
                            else if (status.Contains("In Progress", StringComparison.OrdinalIgnoreCase) || status.Contains("Halftime", StringComparison.OrdinalIgnoreCase) || status.Contains("End of", StringComparison.OrdinalIgnoreCase) || (status.Contains("Quarter", StringComparison.OrdinalIgnoreCase) && !status.Contains("Final")) || (status.Contains("Period", StringComparison.OrdinalIgnoreCase) && !status.Contains("Final")))
                                l++;
                            else
                                u++;
                        }
                        return (count, l, f, u);
                    }
                }
                catch { }
                return (0, 0, 0, 0);
            }).ToArray();

            var results = await Task.WhenAll(tasks);
            foreach (var (count, l, f, u) in results)
            {
                total += count;
                live += l;
                final_ += f;
                upcoming += u;
                if (count > 0) sportsWith++;
            }

            _totalGames = total;
            _liveGames = live;
            _finalGames = final_;
            _upcomingGames = upcoming;
            _sportCount = sportsWith;
        }
        catch { }
    }
}
