        font-weight: 700;
        color: var(--text-muted);
        margin-bottom: 12px;
        padding-left: 4px;
    }
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }
    /* Overriding feature card for this grid */
    .feature-card.compact {
        flex-direction: column;
        align-items: flex-start;
        padding: 16px;
        gap: 12px;
    }
    .feature-card.compact .feature-text h3 {
        font-size: 15px;
