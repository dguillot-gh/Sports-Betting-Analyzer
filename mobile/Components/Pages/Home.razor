</style>

@code {
    private int _totalGames = 0;
    private int _liveGames = 0;
    private int _finalGames = 0;
    private int _upcomingGames = 0;
    private int _sportCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadGameCounts();
    }

    private async Task LoadGameCounts()
    {
        try
        {
            var baseUrl = ServerConfig.GetBaseUrl();
            var sports = new[] { "nba", "nfl", "nhl", "ncaab" };
            int total = 0, live = 0, final_ = 0, upcoming = 0, sportsWith = 0;

            var tasks = sports.Select(async sport =>
            {
                try
                {
                    var json = await Http.GetStringAsync($"{baseUrl}/espn/{sport}");
                    using var doc = JsonDocument.Parse(json);
                    if (doc.RootElement.TryGetProperty("games", out var games))
                    {
                        var count = games.GetArrayLength();
                        if (count == 0) return (0, 0, 0, 0);
                        int l = 0, f = 0, u = 0;
                        foreach (var g in games.EnumerateArray())
                        {
                            var status = g.TryGetProperty("status", out var st) ? st.GetString() ?? "" : "";
                            if (status.Contains("Final", StringComparison.OrdinalIgnoreCase) || status.Contains("Postponed", StringComparison.OrdinalIgnoreCase))
                                f++;
                            else if (status.Contains("In Progress", StringComparison.OrdinalIgnoreCase) || status.Contains("Halftime", StringComparison.OrdinalIgnoreCase) || status.Contains("End of", StringComparison.OrdinalIgnoreCase) || (status.Contains("Quarter", StringComparison.OrdinalIgnoreCase) && !status.Contains("Final")) || (status.Contains("Period", StringComparison.OrdinalIgnoreCase) && !status.Contains("Final")))
                                l++;
                            else
                                u++;
                        }
                        return (count, l, f, u);
                    }
                }
                catch { }
                return (0, 0, 0, 0);
            }).ToArray();

            var results = await Task.WhenAll(tasks);
            foreach (var (count, l, f, u) in results)
            {
                total += count;
                live += l;
                final_ += f;
                upcoming += u;
                if (count > 0) sportsWith++;
            }

            _totalGames = total;
            _liveGames = live;
            _finalGames = final_;
            _upcomingGames = upcoming;
            _sportCount = sportsWith;
        }
        catch { }
    }
}
