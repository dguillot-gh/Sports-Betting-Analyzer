@page "/"
@using System.Text.Json
@using System.Text.Json.Serialization
@inject HttpClient Http
@inject SportsBettingAnalyzer.Shared.Services.IServerConfigService ServerConfig

<div class="home-hero" style="position: relative;">
    <h1>Sports Betting Analyzer</h1>
    <p>@_todayLabel</p>
    <div class="mini-status @(_isHealthy ? "online" : "offline")" style="position: absolute; right: 16px; top: 32px;">
        <span class="status-dot"></span>
    </div>
</div>

<!-- Live Slate Banner -->
<a class="slate-banner" href="/mobile-todays-slate">
    <div class="slate-banner-icon">📅</div>
    <div class="slate-banner-text">
        <h3>Today's Slate</h3>
        @if (_totalGames > 0)
        {
            <p>@_totalGames games today@(_liveGames > 0 ? $" — {_liveGames} LIVE" : "") across @_sportCount sports</p>
        }
        else
        {
            <p>All games across NFL, NBA, NHL & more — live scores, odds, and status</p>
        }
    </div>
    <div class="slate-banner-arrow">›</div>
</a>

@if (_totalGames > 0)
{
    <div class="home-stats-row">
        <div class="home-stat">
            <span class="home-stat-num">@_totalGames</span>
            <span class="home-stat-lbl">Games</span>
        </div>
        <div class="home-stat">
            <span class="home-stat-num @(_liveGames > 0 ? "live" : "")">@_liveGames</span>
            <span class="home-stat-lbl">Live</span>
        </div>
        <div class="home-stat">
            <span class="home-stat-num">@_finalGames</span>
            <span class="home-stat-lbl">Final</span>
        </div>
        <div class="home-stat">
            <span class="home-stat-num">@_upcomingGames</span>
            <span class="home-stat-lbl">Upcoming</span>
        </div>
    </div>
}

<!-- Data Freshness Widget -->
@if (_freshness.Any())
{
    <a href="/mobile-data-health" class="freshness-widget">
        <div class="fw-header">
            <span class="fw-title">📊 Data Freshness</span>
            <span class="fw-link">View all ›</span>
        </div>
        <div class="fw-dots">
            @foreach (var f in _freshness)
            {
                var dotClass = f.FreshnessStatus == "fresh" ? "fwd-green" : f.FreshnessStatus == "stale" ? "fwd-amber" : f.FreshnessStatus == "very_stale" ? "fwd-red" : "fwd-gray";
                <div class="fw-dot-item">
                    <span class="fw-dot @dotClass"></span>
                    <span class="fw-sport">@f.Sport.ToUpper()</span>
                </div>
            }
        </div>
    </a>
}

<div class="dashboard-section px-4 mt-2">
    <div class="flex justify-between items-center mb-2 px-1">
        <h2 class="section-title" style="margin: 0;">Performance Trend</h2>
        @if (_profitData.Any())
        {
            <span style="font-size: 11px; @(_sparklineRoi >= 0 ? "color: #10b981;" : "color: #ef4444;") font-weight: bold;">
                @((_sparklineRoi >= 0 ? "+" : ""))@_sparklineRoi.ToString("F1")% ROI
            </span>
        }
    </div>
    <div style="background: var(--surface, #1e1e2e); border: 1px solid var(--border, #2e2e44); border-radius: 12px; padding: 8px 12px 0;">
        @if (_profitData.Any())
        {
            <div style="height: 80px; width: 100%">
                <ApexChart TItem="ProfitPoint" Options="@_sparklineOptions">
                    <ApexPointSeries TItem="ProfitPoint"
                                     Items="@_profitData"
                                     Name="Profit"
                                     SeriesType="SeriesType.Area"
                                     XValue="@(e => e.Date)"
                                     YValue="@(e => e.Amount)" />
                </ApexChart>
            </div>
        }
        else
        {
            <div style="height: 80px; display: flex; align-items: center; justify-content: center;">
                <span style="font-size: 12px; color: var(--text-tertiary, #475569);">No betting data yet — place tracked bets to see trends</span>
            </div>
        }
    </div>
</div>

