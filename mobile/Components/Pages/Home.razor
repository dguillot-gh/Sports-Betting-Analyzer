    }

    .home-stats-row {
        display: flex;
        justify-content: space-around;
        margin: 0 16px 12px;
        padding: 12px 8px;
        background: var(--surface, #1e1e2e);
        border: 1px solid var(--border, #2e2e44);
        border-radius: 10px;
    }
