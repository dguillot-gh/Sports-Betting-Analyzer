<!-- Live Slate Banner -->
<a class="slate-banner" href="/todays-slate">
    <div class="slate-banner-icon">📅</div>
    <div class="slate-banner-text">
        <h3>Today's Slate</h3>
        @if (_totalGames > 0)
        {
            <p>@_totalGames games today@(_liveGames > 0 ? $" — {_liveGames} LIVE" : "") across @_sportCount sports</p>
        }
        else
        {
            <p>All games across NFL, NBA, NHL & more — live scores, odds, and status</p>
        }
    </div>
    <div class="slate-banner-arrow">›</div>
</a>

