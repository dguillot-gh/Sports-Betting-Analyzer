@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="content-wrapper">
            <article class="content px-4">
                <ErrorBoundary>
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <div class="blazor-error-boundary">
                            <h3>An unhandled exception occurred!</h3>
                            <pre>@ex.ToString()</pre>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </article>
        </div>
    </main>

    <BottomNav />
</div>
