@using SportsBettingAnalyzer.Shared.Models
@using SportsBettingAnalyzer.Shared.Services
@inject IAppSettingsService AppSettings
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="bottom-nav">
    @foreach (var item in _navItems)
    {
        <div class="nav-item-bottom @(NavPathMatcher.IsActive(item.Url, CurrentPath) ? "active" : "")" @onclick="() => HandleNavigation(item)">
            <span class="nav-icon">@item.Icon</span>
            <span class="nav-label">@item.Label</span>
        </div>
    }
</div>

@code {
    private List<NavItem> _navItems = new();

    private string CurrentPath => Nav.ToBaseRelativePath(Nav.Uri);

    protected override async Task OnInitializedAsync()
    {
        _navItems = await AppSettings.GetBottomNavItemsAsync();
    }

    private async Task HandleNavigation(NavItem item)
    {
        if (item.Url == NavPathMatcher.MenuToggle)
        {
            await JS.InvokeVoidAsync("toggleNavbar");
        }
        else
        {
            Nav.NavigateTo(NavPathMatcher.ToAbsolutePath(item.Url));
        }
    }
}
